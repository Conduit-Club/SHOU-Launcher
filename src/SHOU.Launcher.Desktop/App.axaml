<Application xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="SHOU.Launcher.Desktop.App" RequestedThemeVariant="Default">
  <Application.Resources>
    <ResourceDictionary><ResourceDictionary.MergedDictionaries>
      <ResourceInclude Source="avares://SHOU.Launcher.Desktop/Themes/ClubPalette.axaml" />
    </ResourceDictionary.MergedDictionaries></ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme DensityStyle="Compact" />
    <StyleInclude Source="avares://SHOU.Launcher.Desktop/Themes/ClubStyles.axaml" />
  </Application.Styles>
</Application>
