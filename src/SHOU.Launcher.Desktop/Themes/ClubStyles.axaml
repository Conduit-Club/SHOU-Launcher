<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Window"><Setter Property="Background" Value="{DynamicResource ClubBackground}" /><Setter Property="Foreground" Value="{DynamicResource ClubForeground}" /><Setter Property="FontFamily" Value="Inter, PingFang SC, Microsoft YaHei, Noto Sans CJK SC, sans-serif" /><Setter Property="FontSize" Value="14" /></Style>
  <Style Selector="Border.card"><Setter Property="Background" Value="{DynamicResource ClubSurface}" /><Setter Property="BorderBrush" Value="{DynamicResource ClubBorder}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="12" /><Setter Property="Padding" Value="22" /></Style>
  <Style Selector="TextBlock.pageTitle"><Setter Property="FontSize" Value="27" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
  <Style Selector="TextBlock.sectionTitle"><Setter Property="FontSize" Value="18" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
  <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{DynamicResource ClubMuted}" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
  <Style Selector="TextBlock.label"><Setter Property="FontWeight" Value="Medium" /><Setter Property="Margin" Value="0,8,0,4" /></Style>
  <Style Selector="Button"><Setter Property="MinHeight" Value="36" /><Setter Property="CornerRadius" Value="7" /></Style>
  <Style Selector="Button.primary"><Setter Property="Background" Value="{DynamicResource ClubAccent}" /><Setter Property="Foreground" Value="{DynamicResource ClubBackground}" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
  <Style Selector="TextBox"><Setter Property="MinHeight" Value="36" /><Setter Property="CornerRadius" Value="6" /></Style>
  <Style Selector="ComboBox"><Setter Property="MinHeight" Value="36" /><Setter Property="HorizontalAlignment" Value="Stretch" /></Style>
  <Style Selector="ListBox.navigation"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /></Style>
  <Style Selector="ListBox.navigation ListBoxItem"><Setter Property="Padding" Value="16,12" /><Setter Property="Margin" Value="0,3" /><Setter Property="CornerRadius" Value="8" /></Style>
</Styles>
