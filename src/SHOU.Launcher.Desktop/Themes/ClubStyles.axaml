<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
  <Style Selector="Window">
    <Setter Property="Background" Value="{DynamicResource ClubBackground}" /><Setter Property="Foreground" Value="{DynamicResource ClubForeground}" />
    <Setter Property="FontFamily" Value="Microsoft YaHei UI, PingFang SC, Noto Sans CJK SC, sans-serif" /><Setter Property="FontSize" Value="13" />
  </Style>
  <Style Selector="TextBlock"><Setter Property="Foreground" Value="{DynamicResource ClubForeground}" /></Style>
  <Style Selector="Border.card">
    <Setter Property="Background" Value="{DynamicResource ClubSurface}" /><Setter Property="BorderBrush" Value="{DynamicResource ClubBorder}" />
    <Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="6" /><Setter Property="Padding" Value="15" /><Setter Property="BoxShadow" Value="0 0 3 0 #15000000" />
  </Style>
  <Style Selector="TextBlock.pageTitle"><Setter Property="FontSize" Value="20" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
  <Style Selector="TextBlock.sectionTitle"><Setter Property="FontSize" Value="14" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
  <Style Selector="TextBlock.muted"><Setter Property="Foreground" Value="{DynamicResource ClubMuted}" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
  <Style Selector="TextBlock.label"><Setter Property="FontWeight" Value="Normal" /><Setter Property="Margin" Value="0,4,0,3" /></Style>
  <Style Selector="TextBlock.contextHeading"><Setter Property="FontSize" Value="12" /><Setter Property="Foreground" Value="{DynamicResource ClubMuted}" /><Setter Property="Margin" Value="13,15,8,5" /></Style>
  <Style Selector="TextBlock.capability"><Setter Property="Foreground" Value="{DynamicResource ClubMuted}" /><Setter Property="FontSize" Value="12" /><Setter Property="TextWrapping" Value="Wrap" /></Style>
  <Style Selector="Button">
    <Setter Property="MinHeight" Value="28" /><Setter Property="Padding" Value="11,5" /><Setter Property="CornerRadius" Value="3" />
    <Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource ClubForeground}" /><Setter Property="BorderBrush" Value="{DynamicResource ClubForeground}" /><Setter Property="BorderThickness" Value="1" />
    <Setter Property="HorizontalContentAlignment" Value="Center" /><Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template"><ControlTemplate><ContentPresenter Name="PART_ContentPresenter" Foreground="{TemplateBinding Foreground}" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" /></ControlTemplate></Setter>
  </Style>
  <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource ClubHover}" /></Style>
  <Style Selector="Button:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource ClubSelection}" /></Style>
  <Style Selector="Button:disabled"><Setter Property="Opacity" Value="0.5" /></Style>
  <Style Selector="Button.primary"><Setter Property="Foreground" Value="{DynamicResource ClubAccent}" /><Setter Property="BorderBrush" Value="{DynamicResource ClubAccent}" /></Style>
  <Style Selector="Button.flat"><Setter Property="BorderThickness" Value="0" /></Style>
  <Style Selector="TextBox">
    <Setter Property="MinHeight" Value="28" /><Setter Property="Padding" Value="7,3" /><Setter Property="CornerRadius" Value="3" /><Setter Property="BorderThickness" Value="1" />
    <Setter Property="BorderBrush" Value="{DynamicResource ClubInputBorder}" /><Setter Property="Background" Value="{DynamicResource ClubSidebar}" /><Setter Property="Foreground" Value="{DynamicResource ClubForeground}" />
    <Setter Property="CaretBrush" Value="{DynamicResource ClubForeground}" /><Setter Property="PlaceholderForeground" Value="{DynamicResource ClubMuted}" /><Setter Property="SelectionBrush" Value="{DynamicResource ClubSelection}" /><Setter Property="SelectionForegroundBrush" Value="{DynamicResource ClubSelectionForeground}" />
  </Style>
  <Style Selector="ComboBox">
    <Setter Property="MinHeight" Value="28" /><Setter Property="Padding" Value="7,3" /><Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="CornerRadius" Value="3" />
    <Setter Property="BorderBrush" Value="{DynamicResource ClubInputBorder}" /><Setter Property="Background" Value="{DynamicResource ClubSidebar}" /><Setter Property="Foreground" Value="{DynamicResource ClubForeground}" /><Setter Property="PlaceholderForeground" Value="{DynamicResource ClubMuted}" />
  </Style>
  <Style Selector="NumericUpDown"><Setter Property="MinHeight" Value="28" /><Setter Property="Padding" Value="7,3" /><Setter Property="CornerRadius" Value="3" /><Setter Property="BorderBrush" Value="{DynamicResource ClubInputBorder}" /><Setter Property="Background" Value="{DynamicResource ClubSidebar}" /><Setter Property="Foreground" Value="{DynamicResource ClubForeground}" /><Setter Property="PlaceholderForeground" Value="{DynamicResource ClubMuted}" /></Style>
  <Style Selector="CheckBox"><Setter Property="MinHeight" Value="24" /><Setter Property="Padding" Value="0" /><Setter Property="Foreground" Value="{DynamicResource ClubForeground}" /></Style>
  <Style Selector="RadioButton"><Setter Property="MinHeight" Value="24" /><Setter Property="Foreground" Value="{DynamicResource ClubForeground}" /></Style>
  <!-- Fluent 12.1.5 templates, NuGet repository commit 5825bf8c66fba0c11e67c980d8ece6444576bffa.
       Keep the framework templates and interaction states; replace their part-level color setters.
       The enabled-state activators also cover rest: ordinary styles rank below template values. -->
  <Style Selector="CheckBox:checked, CheckBox:indeterminate"><Setter Property="Foreground" Value="{DynamicResource ClubForeground}" /></Style>
  <Style Selector="CheckBox:not(:disabled) /template/ ContentPresenter#PART_ContentPresenter, CheckBox:pointerover /template/ ContentPresenter#PART_ContentPresenter, CheckBox:pressed /template/ ContentPresenter#PART_ContentPresenter, CheckBox:checked /template/ ContentPresenter#PART_ContentPresenter, CheckBox:indeterminate /template/ ContentPresenter#PART_ContentPresenter, RadioButton:not(:disabled) /template/ ContentPresenter#PART_ContentPresenter, RadioButton:pointerover /template/ ContentPresenter#PART_ContentPresenter, RadioButton:pressed /template/ ContentPresenter#PART_ContentPresenter">
    <Setter Property="Foreground" Value="{DynamicResource ClubForeground}" />
  </Style>
  <Style Selector="CheckBox:not(:disabled) /template/ Border#PART_Border, CheckBox:pointerover /template/ Border#PART_Border, CheckBox:pressed /template/ Border#PART_Border, CheckBox:checked /template/ Border#PART_Border, CheckBox:indeterminate /template/ Border#PART_Border, CheckBox:disabled /template/ Border#PART_Border, RadioButton:not(:disabled) /template/ Border#RootBorder, RadioButton:pointerover /template/ Border#RootBorder, RadioButton:pressed /template/ Border#RootBorder, RadioButton:disabled /template/ Border#RootBorder">
    <Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" />
  </Style>
  <Style Selector="CheckBox:not(:disabled) /template/ Border#NormalRectangle"><Setter Property="Background" Value="{DynamicResource ClubSidebar}" /><Setter Property="BorderBrush" Value="{DynamicResource ClubInputBorder}" /></Style>
  <Style Selector="CheckBox:pointerover /template/ Border#NormalRectangle, CheckBox:pressed /template/ Border#NormalRectangle"><Setter Property="Background" Value="{DynamicResource ClubHover}" /><Setter Property="BorderBrush" Value="{DynamicResource ClubAccent}" /></Style>
  <Style Selector="CheckBox:checked /template/ Border#NormalRectangle, CheckBox:indeterminate /template/ Border#NormalRectangle"><Setter Property="Background" Value="{DynamicResource ClubSelection}" /><Setter Property="BorderBrush" Value="{DynamicResource ClubSelectionForeground}" /></Style>
  <Style Selector="CheckBox:focus-visible /template/ Border#NormalRectangle"><Setter Property="BorderBrush" Value="{DynamicResource ClubSelectionForeground}" /></Style>
  <Style Selector="CheckBox:not(:disabled) /template/ Path#CheckGlyph, CheckBox:pointerover /template/ Path#CheckGlyph, CheckBox:pressed /template/ Path#CheckGlyph, CheckBox:checked /template/ Path#CheckGlyph, CheckBox:indeterminate /template/ Path#CheckGlyph"><Setter Property="Fill" Value="{DynamicResource ClubSelectionForeground}" /></Style>
  <Style Selector="RadioButton:not(:disabled) /template/ Ellipse#OuterEllipse"><Setter Property="Fill" Value="{DynamicResource ClubSidebar}" /><Setter Property="Stroke" Value="{DynamicResource ClubInputBorder}" /></Style>
  <Style Selector="RadioButton:pointerover /template/ Ellipse#OuterEllipse, RadioButton:pressed /template/ Ellipse#OuterEllipse"><Setter Property="Fill" Value="{DynamicResource ClubHover}" /><Setter Property="Stroke" Value="{DynamicResource ClubAccent}" /></Style>
  <Style Selector="RadioButton:not(:disabled) /template/ Ellipse#CheckOuterEllipse, RadioButton:pointerover /template/ Ellipse#CheckOuterEllipse, RadioButton:pressed /template/ Ellipse#CheckOuterEllipse"><Setter Property="Fill" Value="{DynamicResource ClubSelection}" /><Setter Property="Stroke" Value="{DynamicResource ClubSelectionForeground}" /></Style>
  <Style Selector="RadioButton:not(:disabled) /template/ Ellipse#CheckGlyph, RadioButton:pointerover /template/ Ellipse#CheckGlyph, RadioButton:pressed /template/ Ellipse#CheckGlyph"><Setter Property="Fill" Value="{DynamicResource ClubSelectionForeground}" /><Setter Property="Stroke" Value="{DynamicResource ClubSelectionForeground}" /></Style>
  <Style Selector="RadioButton:focus-visible /template/ Ellipse#OuterEllipse"><Setter Property="Stroke" Value="{DynamicResource ClubSelectionForeground}" /></Style>
  <Style Selector="CheckBox:disabled /template/ ContentPresenter#PART_ContentPresenter, RadioButton:disabled /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Foreground" Value="{DynamicResource ClubMuted}" /></Style>
  <Style Selector="CheckBox:disabled TextBlock, RadioButton:disabled TextBlock"><Setter Property="Foreground" Value="{DynamicResource ClubMuted}" /></Style>
  <Style Selector="CheckBox:disabled /template/ Border#NormalRectangle"><Setter Property="Background" Value="{DynamicResource ClubSurface}" /><Setter Property="BorderBrush" Value="{DynamicResource ClubBorder}" /></Style>
  <Style Selector="CheckBox:disabled /template/ Path#CheckGlyph"><Setter Property="Fill" Value="{DynamicResource ClubMuted}" /></Style>
  <Style Selector="RadioButton:disabled /template/ Ellipse#OuterEllipse, RadioButton:disabled /template/ Ellipse#CheckOuterEllipse"><Setter Property="Fill" Value="{DynamicResource ClubSurface}" /><Setter Property="Stroke" Value="{DynamicResource ClubBorder}" /></Style>
  <Style Selector="RadioButton:disabled /template/ Ellipse#CheckGlyph"><Setter Property="Fill" Value="{DynamicResource ClubMuted}" /><Setter Property="Stroke" Value="{DynamicResource ClubMuted}" /></Style>

  <Style Selector="ComboBox:not(:disabled) /template/ ContentControl#ContentPresenter, ComboBox:pointerover /template/ ContentControl#ContentPresenter, ComboBox:pressed /template/ ContentControl#ContentPresenter, ComboBox:focus-visible /template/ ContentControl#ContentPresenter, ComboBox:focus:pressed /template/ ContentControl#ContentPresenter, ComboBox:not(:disabled) /template/ PathIcon#DropDownGlyph, ComboBox:focus-visible /template/ PathIcon#DropDownGlyph, ComboBox:focus:pressed /template/ PathIcon#DropDownGlyph"><Setter Property="Foreground" Value="{DynamicResource ClubForeground}" /></Style>
  <Style Selector="ComboBox:not(:disabled) /template/ Border#Background"><Setter Property="Background" Value="{DynamicResource ClubSidebar}" /><Setter Property="BorderBrush" Value="{DynamicResource ClubInputBorder}" /></Style>
  <Style Selector="ComboBox:pointerover /template/ Border#Background"><Setter Property="Background" Value="{DynamicResource ClubHover}" /><Setter Property="BorderBrush" Value="{DynamicResource ClubAccent}" /></Style>
  <Style Selector="ComboBox:pressed /template/ Border#Background"><Setter Property="Background" Value="{DynamicResource ClubSelection}" /><Setter Property="BorderBrush" Value="{DynamicResource ClubSelectionForeground}" /></Style>
  <Style Selector="ComboBox:not(:disabled) /template/ Border#HighlightBackground, ComboBox:focus-visible /template/ Border#HighlightBackground"><Setter Property="Background" Value="{DynamicResource ClubSidebar}" /><Setter Property="BorderBrush" Value="{DynamicResource ClubSelectionForeground}" /></Style>
  <Style Selector="ComboBox:not(:disabled) /template/ TextBlock#PlaceholderTextBlock, ComboBox:focus-visible /template/ TextBlock#PlaceholderTextBlock, ComboBox:focus:pressed /template/ TextBlock#PlaceholderTextBlock"><Setter Property="Foreground" Value="{DynamicResource ClubMuted}" /></Style>
  <Style Selector="ComboBox:not(:disabled) /template/ Border#PopupBorder"><Setter Property="Background" Value="{DynamicResource ClubSidebar}" /><Setter Property="BorderBrush" Value="{DynamicResource ClubInputBorder}" /></Style>
  <Style Selector="ComboBox:disabled /template/ Border#Background"><Setter Property="Background" Value="{DynamicResource ClubSurface}" /><Setter Property="BorderBrush" Value="{DynamicResource ClubBorder}" /></Style>
  <Style Selector="ComboBox:disabled /template/ Border#HighlightBackground"><Setter Property="IsVisible" Value="False" /></Style>
  <Style Selector="ComboBox:disabled /template/ ContentControl#ContentPresenter, ComboBox:disabled /template/ PathIcon#DropDownGlyph"><Setter Property="Foreground" Value="{DynamicResource ClubMuted}" /></Style>
  <Style Selector="ComboBox:disabled TextBlock"><Setter Property="Foreground" Value="{DynamicResource ClubMuted}" /></Style>
  <Style Selector="ComboBoxItem"><Setter Property="Foreground" Value="{DynamicResource ClubForeground}" /><Setter Property="Background" Value="{DynamicResource ClubSidebar}" /></Style>
  <Style Selector="ComboBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter, ComboBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Foreground" Value="{DynamicResource ClubForeground}" /><Setter Property="Background" Value="{DynamicResource ClubHover}" /><Setter Property="BorderBrush" Value="Transparent" /></Style>
  <Style Selector="ComboBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ComboBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter, ComboBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Foreground" Value="{DynamicResource ClubSelectionForeground}" /><Setter Property="Background" Value="{DynamicResource ClubSelection}" /><Setter Property="BorderBrush" Value="Transparent" /></Style>
  <Style Selector="ComboBoxItem:selected TextBlock"><Setter Property="Foreground" Value="{DynamicResource ClubSelectionForeground}" /></Style>
  <Style Selector="ComboBoxItem:disabled /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Foreground" Value="{DynamicResource ClubMuted}" /><Setter Property="Background" Value="{DynamicResource ClubSurface}" /><Setter Property="BorderBrush" Value="Transparent" /></Style>
  <Style Selector="ComboBoxItem:disabled TextBlock"><Setter Property="Foreground" Value="{DynamicResource ClubMuted}" /></Style>

  <Style Selector="TextBox:pointerover, TextBox:focus"><Setter Property="Foreground" Value="{DynamicResource ClubForeground}" /></Style>
  <Style Selector="TextBox:not(:disabled) /template/ TextPresenter#PART_TextPresenter"><Setter Property="TextElement.Foreground" Value="{DynamicResource ClubForeground}" /></Style>
  <Style Selector="TextBox:disabled /template/ TextPresenter#PART_TextPresenter"><Setter Property="TextElement.Foreground" Value="{DynamicResource ClubMuted}" /></Style>
  <Style Selector="TextBox:pointerover /template/ Border#PART_BorderElement"><Setter Property="Background" Value="{DynamicResource ClubHover}" /><Setter Property="BorderBrush" Value="{DynamicResource ClubAccent}" /></Style>
  <Style Selector="TextBox:focus /template/ Border#PART_BorderElement"><Setter Property="Background" Value="{DynamicResource ClubSidebar}" /><Setter Property="BorderBrush" Value="{DynamicResource ClubSelectionForeground}" /><Setter Property="BorderThickness" Value="1" /></Style>
  <Style Selector="TextBox:disabled /template/ Border#PART_BorderElement"><Setter Property="Background" Value="{DynamicResource ClubSurface}" /><Setter Property="BorderBrush" Value="{DynamicResource ClubBorder}" /></Style>
  <Style Selector="NumericUpDown:pointerover"><Setter Property="Background" Value="{DynamicResource ClubHover}" /><Setter Property="BorderBrush" Value="{DynamicResource ClubAccent}" /></Style>
  <Style Selector="NumericUpDown:focus-within"><Setter Property="Background" Value="{DynamicResource ClubSidebar}" /><Setter Property="BorderBrush" Value="{DynamicResource ClubSelectionForeground}" /></Style>
  <Style Selector="NumericUpDown:not(:disabled) /template/ ButtonSpinner#PART_Spinner"><Setter Property="Foreground" Value="{DynamicResource ClubForeground}" /></Style>
  <Style Selector="NumericUpDown:disabled"><Setter Property="Background" Value="{DynamicResource ClubSurface}" /><Setter Property="BorderBrush" Value="{DynamicResource ClubBorder}" /></Style>
  <Style Selector="NumericUpDown:disabled /template/ ButtonSpinner#PART_Spinner"><Setter Property="Foreground" Value="{DynamicResource ClubMuted}" /></Style>
  <Style Selector="NumericUpDown:not(:disabled) /template/ TextBox#PART_TextBox /template/ Border#PART_BorderElement, NumericUpDown /template/ TextBox#PART_TextBox:pointerover /template/ Border#PART_BorderElement, NumericUpDown /template/ TextBox#PART_TextBox:focus /template/ Border#PART_BorderElement, NumericUpDown /template/ TextBox#PART_TextBox:disabled /template/ Border#PART_BorderElement, ComboBox:not(:disabled) /template/ TextBox#PART_EditableTextBox /template/ Border#PART_BorderElement, ComboBox /template/ TextBox#PART_EditableTextBox:pointerover /template/ Border#PART_BorderElement, ComboBox /template/ TextBox#PART_EditableTextBox:focus /template/ Border#PART_BorderElement, ComboBox /template/ TextBox#PART_EditableTextBox:disabled /template/ Border#PART_BorderElement"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="Transparent" /></Style>
  <Style Selector="NumericUpDown:not(:disabled) /template/ ButtonSpinner#PART_Spinner /template/ RepeatButton /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource ClubForeground}" /></Style>
  <Style Selector="NumericUpDown /template/ ButtonSpinner#PART_Spinner /template/ RepeatButton:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource ClubHover}" /></Style>
  <Style Selector="NumericUpDown /template/ ButtonSpinner#PART_Spinner /template/ RepeatButton:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource ClubSelection}" /></Style>
  <Style Selector="NumericUpDown /template/ ButtonSpinner#PART_Spinner /template/ RepeatButton:disabled /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource ClubMuted}" /></Style>
  <Style Selector="CheckBox:disabled, RadioButton:disabled, ComboBox:disabled, ComboBoxItem:disabled, NumericUpDown:disabled, TextBox:disabled"><Setter Property="Foreground" Value="{DynamicResource ClubMuted}" /></Style>
  <Style Selector="TextBox:error /template/ Border#PART_BorderElement, ComboBox:error /template/ Border#Background, ComboBox:error /template/ Border#HighlightBackground"><Setter Property="BorderBrush" Value="{DynamicResource ClubErrorForeground}" /></Style>
  <Style Selector="NumericUpDown:error"><Setter Property="BorderBrush" Value="{DynamicResource ClubErrorForeground}" /></Style>
  <Style Selector="Expander"><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Background" Value="{DynamicResource ClubSurface}" /><Setter Property="BorderBrush" Value="{DynamicResource ClubBorder}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="CornerRadius" Value="6" /></Style>
  <Style Selector="Expander /template/ ToggleButton"><Setter Property="MinHeight" Value="40" /><Setter Property="Padding" Value="15,9" /><Setter Property="FontSize" Value="14" /><Setter Property="FontWeight" Value="SemiBold" /></Style>
  <Style Selector="ListBox.navigation"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="0" /></Style>
  <Style Selector="ListBox.navigation ListBoxItem"><Setter Property="Padding" Value="14,7" /><Setter Property="Margin" Value="0" /><Setter Property="MinHeight" Value="29" /><Setter Property="CornerRadius" Value="0" /></Style>
  <Style Selector="ListBox.navigation ListBoxItem:selected"><Setter Property="Background" Value="{DynamicResource ClubSelection}" /><Setter Property="Foreground" Value="{DynamicResource ClubSelectionForeground}" /></Style>
  <Style Selector="ToggleButton.topNavigation, ToggleButton.contextNavigation">
    <Setter Property="BorderThickness" Value="0" /><Setter Property="Background" Value="Transparent" /><Setter Property="HorizontalContentAlignment" Value="Left" /><Setter Property="VerticalContentAlignment" Value="Center" />
    <Setter Property="Template"><ControlTemplate><ContentPresenter Name="PART_ContentPresenter" Foreground="{TemplateBinding Foreground}" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" /></ControlTemplate></Setter>
  </Style>
  <Style Selector="ToggleButton.topNavigation"><Setter Property="MinHeight" Value="28" /><Setter Property="Height" Value="28" /><Setter Property="MinWidth" Value="78" /><Setter Property="Padding" Value="14,3" /><Setter Property="FontSize" Value="14" /><Setter Property="CornerRadius" Value="20" /><Setter Property="Foreground" Value="{DynamicResource ClubTitleForeground}" /></Style>
  <Style Selector="ToggleButton.topNavigation:checked"><Setter Property="Background" Value="{DynamicResource ClubTitleForeground}" /><Setter Property="Foreground" Value="{DynamicResource ClubSelectionForeground}" /></Style>
  <Style Selector="ToggleButton.topNavigation:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#25FFFFFF" /></Style>
  <Style Selector="ToggleButton.topNavigation:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource ClubTitleForeground}" /></Style>
  <Style Selector="ToggleButton.topNavigation /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource ClubTitleForeground}" /><Setter Property="BorderBrush" Value="Transparent" /></Style>
  <Style Selector="ToggleButton.topNavigation:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.topNavigation:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#25FFFFFF" /><Setter Property="Foreground" Value="{DynamicResource ClubTitleForeground}" /><Setter Property="BorderBrush" Value="Transparent" /></Style>
  <Style Selector="ToggleButton.topNavigation:checked /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.topNavigation:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.topNavigation:checked:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource ClubTitleForeground}" /><Setter Property="Foreground" Value="{DynamicResource ClubSelectionForeground}" /><Setter Property="BorderBrush" Value="Transparent" /></Style>
  <Style Selector="ToggleButton.topNavigation TextBlock"><Setter Property="Foreground" Value="{DynamicResource ClubTitleForeground}" /></Style>
  <Style Selector="ToggleButton.topNavigation:checked TextBlock"><Setter Property="Foreground" Value="{DynamicResource ClubSelectionForeground}" /></Style>
  <Style Selector="Path.navigationIcon"><Setter Property="Width" Value="16" /><Setter Property="Height" Value="16" /><Setter Property="Stretch" Value="Uniform" /><Setter Property="StrokeThickness" Value="1.5" /><Setter Property="Stroke" Value="{DynamicResource ClubTitleForeground}" /></Style>
  <Style Selector="ToggleButton.topNavigation:checked Path.navigationIcon"><Setter Property="Stroke" Value="{DynamicResource ClubSelectionForeground}" /></Style>
  <Style Selector="ToggleButton.contextNavigation"><Setter Property="MinHeight" Value="32" /><Setter Property="Padding" Value="15,5" /><Setter Property="CornerRadius" Value="0" /><Setter Property="Foreground" Value="{DynamicResource ClubForeground}" /></Style>
  <Style Selector="ToggleButton.contextNavigation:checked"><Setter Property="Foreground" Value="{DynamicResource ClubSelectionForeground}" /><Setter Property="BorderThickness" Value="4,0,0,0" /><Setter Property="BorderBrush" Value="{DynamicResource ClubSelectionForeground}" /><Setter Property="Padding" Value="11,5,15,5" /></Style>
  <Style Selector="ToggleButton.contextNavigation:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource ClubHover}" /></Style>
  <Style Selector="ToggleButton.contextNavigation /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.contextNavigation:checked /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource ClubForeground}" /><Setter Property="BorderBrush" Value="{DynamicResource ClubSelectionForeground}" /></Style>
  <Style Selector="ToggleButton.contextNavigation:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.contextNavigation:checked:pointerover /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.contextNavigation:pressed /template/ ContentPresenter#PART_ContentPresenter, ToggleButton.contextNavigation:checked:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource ClubHover}" /><Setter Property="Foreground" Value="{DynamicResource ClubSelectionForeground}" /><Setter Property="BorderBrush" Value="{DynamicResource ClubSelectionForeground}" /></Style>
  <Style Selector="ToggleButton.contextNavigation TextBlock"><Setter Property="Foreground" Value="{DynamicResource ClubForeground}" /></Style>
  <Style Selector="ToggleButton.contextNavigation:checked TextBlock"><Setter Property="Foreground" Value="{DynamicResource ClubSelectionForeground}" /></Style>
  <Style Selector="Button.primary TextBlock:not(.muted)"><Setter Property="Foreground" Value="{DynamicResource ClubAccent}" /></Style>
  <Style Selector="Path.contextIcon"><Setter Property="Width" Value="18" /><Setter Property="Height" Value="18" /><Setter Property="Stretch" Value="Uniform" /><Setter Property="StrokeThickness" Value="1.5" /><Setter Property="Stroke" Value="{DynamicResource ClubForeground}" /></Style>
  <Style Selector="ToggleButton.contextNavigation:checked Path.contextIcon"><Setter Property="Stroke" Value="{DynamicResource ClubSelectionForeground}" /></Style>
  <Style Selector="Button.windowControl"><Setter Property="MinWidth" Value="32" /><Setter Property="Width" Value="32" /><Setter Property="Height" Value="40" /><Setter Property="Padding" Value="8" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Foreground" Value="{DynamicResource ClubTitleForeground}" /></Style>
  <Style Selector="Button.windowControl:pointerover /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="#25FFFFFF" /></Style>
  <Style Selector="ListBox.serverCards"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Padding" Value="0" /></Style>
  <Style Selector="ListBox.serverCards ListBoxItem"><Setter Property="Padding" Value="12,15" /><Setter Property="Margin" Value="5" /><Setter Property="MinHeight" Value="70" /><Setter Property="CornerRadius" Value="7" /><Setter Property="BorderBrush" Value="{DynamicResource ClubBorder}" /><Setter Property="BorderThickness" Value="1" /><Setter Property="Background" Value="{DynamicResource ClubSidebar}" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style>
  <Style Selector="ListBox.serverCards ListBoxItem:selected"><Setter Property="Background" Value="{DynamicResource ClubSelection}" /><Setter Property="BorderBrush" Value="{DynamicResource ClubAccent}" /><Setter Property="BorderThickness" Value="2" /><Setter Property="Padding" Value="11,14" /></Style>
  <Style Selector="ListBox.serverCards ListBoxItem /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource ClubSidebar}" /><Setter Property="Foreground" Value="{DynamicResource ClubForeground}" /><Setter Property="BorderBrush" Value="{DynamicResource ClubBorder}" /></Style>
  <Style Selector="ListBox.serverCards ListBoxItem:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBox.serverCards ListBoxItem:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource ClubHover}" /><Setter Property="Foreground" Value="{DynamicResource ClubForeground}" /><Setter Property="BorderBrush" Value="{DynamicResource ClubAccent}" /></Style>
  <Style Selector="ListBox.serverCards ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBox.serverCards ListBoxItem:selected:not(:focus) /template/ ContentPresenter#PART_ContentPresenter, ListBox.serverCards ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBox.serverCards ListBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource ClubSelection}" /><Setter Property="Foreground" Value="{DynamicResource ClubForeground}" /><Setter Property="BorderBrush" Value="{DynamicResource ClubAccent}" /></Style>
  <Style Selector="ListBox.navigation ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter, ListBox.navigation ListBoxItem:selected:not(:focus) /template/ ContentPresenter#PART_ContentPresenter, ListBox.navigation ListBoxItem:selected:pointerover /template/ ContentPresenter#PART_ContentPresenter, ListBox.navigation ListBoxItem:selected:pressed /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource ClubSelection}" /><Setter Property="Foreground" Value="{DynamicResource ClubSelectionForeground}" /></Style>
</Styles>
