<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="using:SHOU.Launcher.Desktop.Views" x:Class="SHOU.Launcher.Desktop.Views.DownloadsView" AttachedToVisualTree="DownloadsView_AttachedToVisualTree" DetachedFromVisualTree="DownloadsView_DetachedFromVisualTree" DataContextChanged="DownloadsView_DataContextChanged" KeyDown="DownloadsView_KeyDown">
  <UserControl.Resources>
    <DataTemplate x:Key="ModrinthPackImportTemplate">
      <Border Classes="card"><StackPanel Spacing="8" IsEnabled="{Binding CanEdit}">
        <TextBlock Text="安装本机整合包" Classes="sectionTitle" />
        <WrapPanel><Button Name="ReadModrinthPackButton" Content="选择整合包…" ToolTip.Tip="也可将 .zip 或 .mrpack 拖入窗口；确认清单后安装到独立新实例。" Click="PickModrinthPack_Click" IsEnabled="{Binding PackServiceAvailable}" Margin="0,0,8,0" /><Button Content="读取已下载的整合包" Command="{Binding ReadCachedPackCommand}" IsVisible="{Binding HasDownloadedFile}" /></WrapPanel>
        <TextBlock Text="{Binding LocalPackPath}" Classes="muted" LineHeight="16" FontSize="11" TextTrimming="CharacterEllipsis" />
        <StackPanel IsVisible="{Binding HasPackInspection}" Spacing="6"><TextBlock Text="新实例名称" /><TextBox Name="ModrinthPackInstanceName" Text="{Binding PackInstanceName}" />
          <Expander Header="客户端可选文件（默认不安装）" IsVisible="{Binding HasOptionalPackFiles}"><ItemsControl ItemsSource="{Binding OptionalPackFiles}" Margin="12"><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Path}" IsChecked="{Binding Selected}" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Expander>
          <Button Name="ImportModrinthPackButton" Content="导入到独立新实例" Classes="primary" Command="{Binding ImportLocalPackCommand}" HorizontalAlignment="Left" />
        </StackPanel>
        <TextBlock Name="ModrinthPackImportStatus" Text="{Binding PackStatus}" Classes="status muted" />
        <Expander Name="LocalPackDetails" Header="安装提示与未完成项" IsVisible="{Binding HasPackDetails}"><TextBlock Text="{Binding PackDetails}" Classes="muted" Margin="12" /></Expander>
      </StackPanel></Border>
    </DataTemplate>
    <DataTemplate x:Key="AdditionalLoaderTemplate">
      <Expander Classes="loaderChoice" Header="{Binding Title}" Margin="0,0,0,12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
        <Expander.HeaderTemplate><DataTemplate><Grid ColumnDefinitions="32,100,*,24" VerticalAlignment="Center">
          <Image Source="{Binding DataContext.Icon, RelativeSource={RelativeSource AncestorType=Expander}}" Width="24" Height="24" RenderOptions.BitmapInterpolationMode="None" />
          <TextBlock Grid.Column="1" Text="{Binding}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="2" Text="{Binding DataContext.Summary, RelativeSource={RelativeSource AncestorType=Expander}}" Classes="muted" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          <views:LoadingGlyph Grid.Column="3" Width="18" Height="18" IsVisible="{Binding DataContext.IsLoading, RelativeSource={RelativeSource AncestorType=Expander}}" Foreground="{DynamicResource ClubAccent}" />
        </Grid></DataTemplate></Expander.HeaderTemplate>
        <StackPanel Spacing="8" Margin="15,4,15,15">
          <ListBox Name="AdditionalLoaderVersions" Classes="additionalLoaders" ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}" IsEnabled="{Binding CanEdit}" MaxHeight="360" BorderThickness="0" Background="Transparent">
            <ListBox.ItemTemplate><DataTemplate><Grid ColumnDefinitions="36,*,Auto" MinHeight="38" ToolTip.Tip="{Binding Detail}">
              <Image Source="{Binding DataContext.Icon, RelativeSource={RelativeSource AncestorType=ListBox}}" Width="28" Height="28" RenderOptions.BitmapInterpolationMode="None" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2"><TextBlock Text="{Binding Version}" FontSize="14" LineHeight="20" /><TextBlock Text="{Binding Detail}" Classes="status muted" FontSize="11" /></StackPanel>
              <TextBlock Grid.Column="2" Text="正式版" IsVisible="{Binding Stable}" Classes="muted" FontSize="11" VerticalAlignment="Center" />
            </Grid></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Text="{Binding Status}" Classes="status muted" TextWrapping="Wrap" />
          <WrapPanel><Button Classes="flat" Command="{Binding RefreshCommand}" Content="刷新" Margin="0,0,8,0" /><Button Content="取消选择" Command="{Binding ClearCommand}" IsVisible="{Binding HasSelection}" /></WrapPanel>
        </StackPanel>
      </Expander>
    </DataTemplate>
    <DataTemplate x:Key="DownloadCategoryTemplate">
      <ToggleButton Classes="contextNavigation" IsChecked="{Binding IsSelected, Mode=OneWay}" Command="{Binding SelectCommand}" HorizontalAlignment="Stretch" MinHeight="35">
        <Grid ColumnDefinitions="24,6,*"><views:ClubIcon Classes="contextIcon" Kind="{Binding IconKind}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" /><TextBlock Grid.Column="2" Classes="navigationLabel" Text="{Binding Title}" /></Grid>
      </ToggleButton>
    </DataTemplate>
    <DataTemplate x:Key="GameVersionTemplate">
      <Button Classes="flat" Command="{Binding SelectCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="7,4" MinHeight="43" ToolTip.Tip="{Binding Detail}">
        <Grid ColumnDefinitions="36,*">
          <Image Source="{Binding Icon}" Width="28" Height="28" VerticalAlignment="Center" RenderOptions.BitmapInterpolationMode="None" />
          <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center"><TextBlock Text="{Binding Id}" LineHeight="20" FontSize="14" /><TextBlock Text="{Binding Detail}" Classes="muted" LineHeight="18" FontSize="12" /></StackPanel>
        </Grid>
      </Button>
    </DataTemplate>
    <DataTemplate x:Key="ContentProjectTemplate">
      <Button Classes="flat contentProjectRow" Command="{Binding OpenCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="5,6" MinHeight="64" ToolTip.Tip="{Binding Detail}">
        <Grid ColumnDefinitions="52,*">
          <Border Width="42" Height="42" CornerRadius="5" Background="{DynamicResource ClubSelection}" ClipToBounds="True" VerticalAlignment="Center"><Grid><TextBlock Text="{Binding Tile}" FontSize="22" Foreground="{DynamicResource ClubSelectionForeground}" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasIcon}"/><Image Source="{Binding Icon}" Stretch="Uniform" IsVisible="{Binding HasIcon}"/></Grid></Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
            <TextBlock Text="{Binding Title}" FontSize="14" LineHeight="20" TextTrimming="CharacterEllipsis"/>
            <Grid ColumnDefinitions="Auto,*"><Border IsVisible="{Binding HasTags}" Background="{DynamicResource ClubSelection}" CornerRadius="2" Padding="3,0" Margin="0,0,6,0" MaxWidth="140" VerticalAlignment="Center"><TextBlock Text="{Binding Tags}" Classes="muted" FontSize="11" LineHeight="16" TextTrimming="CharacterEllipsis"/></Border><TextBlock Grid.Column="1" Text="{Binding Description}" Classes="muted" FontSize="12" LineHeight="18" TextTrimming="CharacterEllipsis"/></Grid>
            <Grid ColumnDefinitions="*,100,105,88" ColumnSpacing="6">
              <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding HasCompatibility}"><views:ClubIcon Kind="list" Width="13" Height="13"/><TextBlock Text="{Binding Compatibility}" Classes="muted" FontSize="11" LineHeight="16" TextTrimming="CharacterEllipsis" MaxWidth="220"/></StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"><views:ClubIcon Kind="download" Width="13" Height="13"/><TextBlock Text="{Binding Downloads}" Classes="muted" FontSize="11" LineHeight="16"/></StackPanel>
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" IsVisible="{Binding HasUpdated}"><views:ClubIcon Kind="arrow-up-from-line" Width="13" Height="13"/><TextBlock Text="{Binding Updated}" Classes="muted" FontSize="11" LineHeight="16"/></StackPanel>
              <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4"><views:ClubIcon Kind="globe" Width="13" Height="13"/><TextBlock Text="Modrinth" Classes="muted" FontSize="11" LineHeight="16"/></StackPanel>
            </Grid>
          </StackPanel>
        </Grid>
      </Button>
    </DataTemplate>
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="Button.contentProjectRow TextBlock.muted"><Setter Property="TextWrapping" Value="NoWrap" /></Style>
    <Style Selector="Expander.loaderChoice TextBlock.muted"><Setter Property="FontWeight" Value="Normal" /></Style>
    <Style Selector="ListBox.additionalLoaders ListBoxItem"><Setter Property="IsEnabled" Value="{Binding CanInstall}" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="6,3" /></Style>
    <Style Selector="ListBox.installerVersions ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/></Style>
    <Style Selector="Expander.loaderChoice"><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style>
    <Style Selector="Expander.loaderChoice /template/ ToggleButton#ExpanderHeader"><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style>
  </UserControl.Styles>
  <Grid ColumnDefinitions="Auto,*">
    <Border Name="DownloadsCategoryPanel" Width="180" Background="{DynamicResource ClubSidebar}" BorderBrush="{DynamicResource ClubBorder}" BorderThickness="0,0,1,0" IsVisible="{Binding ShowCategorySidebar}">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,12,0,15">
        <ContentControl Content="{Binding MinecraftCategory}" ContentTemplate="{StaticResource DownloadCategoryTemplate}" HorizontalContentAlignment="Stretch" />
        <TextBlock Text="社区资源" Classes="contextHeading" />
        <ItemsControl ItemsSource="{Binding CommunityCategories}" ItemTemplate="{StaticResource DownloadCategoryTemplate}" />
        <TextBlock Text="安装包" Classes="contextHeading" />
        <ItemsControl ItemsSource="{Binding InstallerCategories}" ItemTemplate="{StaticResource DownloadCategoryTemplate}" />
        <TextBlock Text="任务" Classes="contextHeading" />
        <ContentControl Content="{Binding TasksCategory}" ContentTemplate="{StaticResource DownloadCategoryTemplate}" HorizontalContentAlignment="Stretch" />
      </StackPanel></ScrollViewer>
    </Border>
    <ScrollViewer Grid.Column="1" Name="DownloadsPageScroller" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding !ShowFullPageLoading}">
      <Grid Margin="24">
        <StackPanel Name="MinecraftCatalogPage" IsVisible="{Binding IsCatalogPage}" Spacing="15">

          <Border Classes="card"><StackPanel Spacing="10">
            <DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6"><Button Name="RefreshGameCatalogButton" ToolTip.Tip="{Binding CatalogSource}" Classes="flat" Content="刷新" Command="{Binding RefreshCatalogCommand}" Padding="6,3" /><StackPanel Orientation="Horizontal" Spacing="5" IsVisible="{Binding ShowLoadingBadge}"><views:LoadingGlyph Width="18" Height="18" Foreground="{DynamicResource ClubAccent}"/><Button Name="CancelCatalogRefreshButton" Classes="flat" Content="×" Command="{Binding CancelBrowseCommand}" AutomationProperties.Name="取消读取" ToolTip.Tip="取消读取（Esc）" Padding="3" MinWidth="24"/></StackPanel></StackPanel><TextBlock Text="最新版本" Classes="sectionTitle" VerticalAlignment="Center" ToolTip.Tip="{Binding CatalogPurpose}" /></DockPanel>
            <ItemsControl Name="LatestGameVersions" ItemsSource="{Binding LatestVersions}" ItemTemplate="{StaticResource GameVersionTemplate}" />
            <TextBlock Text="{Binding RequestStatus}" IsVisible="{Binding ShowRequestStatus}" Classes="muted" LineHeight="16" FontSize="11" />

          </StackPanel></Border>
          <ItemsControl Name="GameVersionGroups" ItemsSource="{Binding VersionGroups}"><ItemsControl.ItemTemplate><DataTemplate><Expander Header="{Binding Header}" HorizontalAlignment="Stretch" Margin="0,0,0,12"><ItemsControl ItemsSource="{Binding Versions}" ItemTemplate="{StaticResource GameVersionTemplate}" Margin="15,0,15,15" /></Expander></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </StackPanel>
        <StackPanel Name="MinecraftInstallConfiguration" IsVisible="{Binding IsConfiguration}" Spacing="12">
          <Border Classes="card"><StackPanel Spacing="8"><Grid ColumnDefinitions="34,*"><Button Classes="flat" Command="{Binding BackToListCommand}" Padding="4" AutomationProperties.Name="返回版本列表" ><views:ClubIcon Kind="arrow-left" Width="16" Height="16" /></Button><TextBox Grid.Column="1" Name="CatalogInstallationName" Text="{Binding InstallationName}" IsEnabled="{Binding CanEdit}" /></Grid><TextBlock Text="{Binding InstallationValidation}" IsVisible="{Binding HasInstallationValidation}" Classes="muted" Margin="34,0,0,0" /></StackPanel></Border>

          <ItemsControl Name="AdditionalLoaderCatalogs" ItemsSource="{Binding AdditionalLoaders}" ItemTemplate="{StaticResource AdditionalLoaderTemplate}" />
          <Expander Classes="loaderChoice" Header="Fabric" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <Expander.HeaderTemplate><DataTemplate><Grid ColumnDefinitions="32,100,*,24"><Image Source="avares://SHOU.Launcher.Desktop/Assets/Minecraft/Fabric.png" Width="24" Height="24" RenderOptions.BitmapInterpolationMode="None"/><TextBlock Grid.Column="1" Text="Fabric" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="{Binding DataContext.FabricSummary, RelativeSource={RelativeSource AncestorType=Expander}}" Classes="muted" VerticalAlignment="Center"/><views:LoadingGlyph Grid.Column="3" Width="18" Height="18" IsVisible="{Binding DataContext.FabricLoading, RelativeSource={RelativeSource AncestorType=Expander}}" Foreground="{DynamicResource ClubAccent}"/></Grid></DataTemplate></Expander.HeaderTemplate>
            <StackPanel Spacing="8" Margin="15,4,15,15">
              <ListBox Name="FabricCatalogSelector" ItemsSource="{Binding FabricVersions}" SelectedItem="{Binding SelectedFabric}" IsEnabled="{Binding CanEdit}" MaxHeight="360" BorderThickness="0" Background="Transparent"><ListBox.ItemTemplate><DataTemplate><Grid ColumnDefinitions="36,*,Auto" MinHeight="38"><Image Source="avares://SHOU.Launcher.Desktop/Assets/Minecraft/Fabric.png" Width="28" Height="28" RenderOptions.BitmapInterpolationMode="None"/><TextBlock Grid.Column="1" Text="{Binding Version}" VerticalAlignment="Center" FontSize="14"/><TextBlock Grid.Column="2" Text="正式版" Classes="muted" FontSize="11" VerticalAlignment="Center" IsVisible="{Binding Stable}"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
              <TextBlock Text="{Binding FabricStatus}" Classes="status muted" TextWrapping="Wrap" />
              <WrapPanel><Button Name="RefreshFabricCatalogButton" Content="刷新" Command="{Binding RefreshFabricCommand}" Classes="flat" Margin="0,0,8,0"/><Button Content="取消选择" Command="{Binding ClearFabricCommand}" /></WrapPanel>
            </StackPanel>
          </Expander>
          <Border Classes="card" Padding="15,9"><Grid ColumnDefinitions="32,100,*"><Image Source="avares://SHOU.Launcher.Desktop/Assets/Minecraft/Fabric.png" Width="24" Height="24"/><TextBlock Grid.Column="1" Text="Fabric API" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="暂不支持" Classes="muted" VerticalAlignment="Center" ToolTip.Tip="{Binding AdditionalLoaderCapability}"/></Grid></Border>
          <Border Classes="card" Padding="15,9"><Grid ColumnDefinitions="32,100,*"><views:ClubIcon Kind="cat" Width="22" Height="22"/><TextBlock Grid.Column="1" Text="LabyMod" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="暂不支持" Classes="muted" VerticalAlignment="Center"/></Grid></Border>
          <Border Classes="card" Padding="15,9"><Grid ColumnDefinitions="32,100,*"><views:ClubIcon Kind="gauge" Width="22" Height="22"/><TextBlock Grid.Column="1" Text="OptiFine" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="暂不支持" Classes="muted" VerticalAlignment="Center"/></Grid></Border>
          <TextBlock Name="CatalogInstallStatus" Text="{Binding InstallStatus}" Classes="muted" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12" Margin="0,8"><Button Name="InstallCatalogVersionButton" Classes="primary" Content="下载并安装" Command="{Binding InstallVersionCommand}" Height="42" MinWidth="135" /><Button Content="查看已安装游戏" Command="{Binding ShowCreatedInstanceCommand}" IsVisible="{Binding HasCreatedInstance}" Height="42" /></StackPanel>
        </StackPanel>
        <StackPanel Name="MinecraftPackagePage" IsVisible="{Binding IsPackageDetail}" Spacing="15">
          <Border Classes="card"><StackPanel Spacing="10"><DockPanel><Button DockPanel.Dock="Left" Classes="flat" Command="{Binding BackToListCommand}" AutomationProperties.Name="返回 Minecraft 版本列表" Margin="0,0,10,0" ><views:ClubIcon Kind="arrow-left" Width="16" Height="16" /></Button><TextBlock Name="MinecraftPackageVersionTitle" Text="{Binding PackageVersionId}" Classes="sectionTitle" VerticalAlignment="Center"  ToolTip.Tip="下载官方客户端或服务端 JAR 文件，保存到所选位置。要安装可启动的基础游戏，请使用左侧顶部的 Minecraft。"/></DockPanel></StackPanel></Border>
          <TextBlock Text="{Binding RequestStatus}" IsVisible="{Binding ShowRequestStatus}" Classes="muted" />
          <ItemsControl Name="MinecraftPackageFiles" ItemsSource="{Binding MinecraftPackages}" IsEnabled="{Binding CanEdit}"><ItemsControl.ItemTemplate><DataTemplate><Border Classes="card" Margin="0,0,0,12"><Grid ColumnDefinitions="*,12,Auto"><StackPanel Spacing="6"><TextBlock Text="{Binding Title}" Classes="sectionTitle" /><TextBlock Text="{Binding Detail}" TextWrapping="Wrap" /></StackPanel><Button Grid.Column="2" Name="SaveMinecraftPackageButton" Content="下载文件…" Click="SaveMinecraftPackage_Click" VerticalAlignment="Center" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </StackPanel>
        <StackPanel Name="CommunitySearchPage" IsVisible="{Binding IsSearchPage}" Spacing="15">
          <Border Classes="card" Padding="12,5"><Grid ColumnDefinitions="*,10,60,Auto"><TextBox KeyDown="ContentSearch_KeyDown" Name="ContentSearchQuery" Text="{Binding QueryText}" PlaceholderText="{Binding SearchPlaceholder}" BorderThickness="0" Background="Transparent" IsEnabled="{Binding CanQuery}" /><Button Grid.Column="2" Name="SearchContentButton" Classes="primary" Content="搜索" Command="{Binding SearchCommand}" /><Border Grid.Column="3" Margin="8,0,0,0" IsVisible="{Binding ShowLoadingBadge}"><StackPanel Orientation="Horizontal" Spacing="5" IsVisible="{Binding ShowLoadingBadge}"><views:LoadingGlyph Width="18" Height="18" Foreground="{DynamicResource ClubAccent}"/><Button Name="CancelSearchRefreshButton" Classes="flat" Content="×" Command="{Binding CancelBrowseCommand}" AutomationProperties.Name="取消读取" ToolTip.Tip="取消读取（Esc）" Padding="3" MinWidth="24"/></StackPanel></Border></Grid></Border>
          <Border Classes="card" Padding="12,8"><StackPanel Spacing="8"><Grid ColumnDefinitions="32,*,12,45,*,12,58,*,26"><TextBlock Text="来源" VerticalAlignment="Center" /><ComboBox Grid.Column="1" SelectedIndex="0" IsEnabled="False" ToolTip.Tip="{Binding QueryCapabilityReason}"><ComboBoxItem Content="Modrinth" /></ComboBox><TextBlock Grid.Column="3" Text="标签" VerticalAlignment="Center" /><ComboBox Grid.Column="4" Name="ContentCategoryFilter" ItemsSource="{Binding ContentCategoryChoices}" SelectedItem="{Binding SelectedContentCategory}" IsEnabled="{Binding HasContentCategoryChoices}" ToolTip.Tip="{Binding CategoryStatus}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><TextBlock Grid.Column="6" Text="排序方式" VerticalAlignment="Center" /><ComboBox Grid.Column="7" Name="ContentSortSelector" ItemsSource="{Binding SortChoices}" SelectedItem="{Binding SelectedSort}" IsEnabled="{Binding CanEdit}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox><Button Grid.Column="8" Classes="flat" Command="{Binding ResetFiltersCommand}" Padding="3" ToolTip.Tip="重置筛选"  AutomationProperties.Name="重置筛选" ><views:ClubIcon Kind="rotate-ccw" Width="16" Height="16" /></Button></Grid>
          <Grid ColumnDefinitions="32,*,12,45,*,12,58,*"><TextBlock Text="版本" VerticalAlignment="Center" /><TextBox Grid.Column="1" Name="ContentGameVersionFilter" Text="{Binding GameVersionFilter}" PlaceholderText="任意" IsEnabled="{Binding CanEdit}" /><TextBlock Grid.Column="3" Text="加载器" VerticalAlignment="Center" /><ComboBox Grid.Column="4" Name="ContentLoaderFilter" ItemsSource="{Binding LoaderFilters}" SelectedItem="{Binding LoaderFilter}" IsEnabled="{Binding CanEdit}" /></Grid></StackPanel></Border>
          <ContentControl Name="LocalModrinthPackImport" Content="{Binding}" ContentTemplate="{StaticResource ModrinthPackImportTemplate}" IsVisible="{Binding ShowPackImport}" HorizontalContentAlignment="Stretch" />
          <TextBlock Text="{Binding RequestStatus}" IsVisible="{Binding ShowRequestStatus}" Classes="muted" />
          <Border Classes="card" IsVisible="{Binding HasProjects}"><ItemsControl Name="ContentSearchResults" ItemsSource="{Binding Projects}" ItemTemplate="{StaticResource ContentProjectTemplate}" /></Border>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12"><Button Content="上一页" Command="{Binding PreviousPageCommand}" /><TextBlock Text="{Binding PageSummary}" VerticalAlignment="Center" /><Button Content="下一页" Command="{Binding NextPageCommand}" /></StackPanel>
        </StackPanel>
        <StackPanel Name="ResourceDetailPage" IsVisible="{Binding IsResourceDetail}" Spacing="15">
          <Border Classes="card"><StackPanel Spacing="12"><DockPanel><Button DockPanel.Dock="Left" Classes="flat" Command="{Binding BackToListCommand}" Margin="0,0,10,0" AutomationProperties.Name="返回资源列表" ><views:ClubIcon Kind="arrow-left" Width="16" Height="16" /></Button><Border DockPanel.Dock="Left" Width="50" Height="50" CornerRadius="6" Background="{DynamicResource ClubSelection}" Margin="0,0,10,0"><TextBlock Text="{Binding ProjectTile}" LineHeight="36" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource ClubSelectionForeground}" /></Border><StackPanel Spacing="3"><TextBlock Text="{Binding ProjectTitle}" LineHeight="24" FontSize="16" /><TextBlock Text="{Binding ProjectDescription}" Classes="muted" LineHeight="18" FontSize="12" /><TextBlock Text="{Binding ProjectDetail}" Classes="muted" LineHeight="18" FontSize="12" /></StackPanel></DockPanel>
          <WrapPanel><Button Content="Modrinth" Command="{Binding OpenProjectPageCommand}" Margin="0,0,8,0" /><Button Content="复制名称" Click="CopyProjectName_Click" Margin="0,0,8,0" /><Button Content="复制链接" Click="CopyProjectLink_Click" Margin="0,0,8,0" /><Button Name="FavoriteProjectButton" Content="{Binding FavoriteAction}" Command="{Binding ToggleFavoriteCommand}" /></WrapPanel><TextBlock Text="{Binding FavoriteStatus}" Classes="muted" LineHeight="16" FontSize="11" /></StackPanel></Border>
          <Border Classes="card"><Grid ColumnDefinitions="36,*,12,50,*,12,Auto,Auto"><TextBlock Text="版本" VerticalAlignment="Center" /><TextBox Grid.Column="1" Text="{Binding GameVersionFilter}" PlaceholderText="任意" IsEnabled="{Binding CanEdit}" /><TextBlock Grid.Column="3" Text="加载器" VerticalAlignment="Center" /><ComboBox Grid.Column="4" ItemsSource="{Binding LoaderFilters}" SelectedItem="{Binding LoaderFilter}" IsEnabled="{Binding CanEdit}" /><Button Grid.Column="6" Name="RefreshContentReleasesButton" Content="筛选文件" Command="{Binding RefreshReleasesCommand}" /><StackPanel Grid.Column="7" Orientation="Horizontal" Spacing="5" IsVisible="{Binding ShowLoadingBadge}" Margin="8,0,0,0"><views:LoadingGlyph Width="18" Height="18" Foreground="{DynamicResource ClubAccent}"/><Button Name="CancelContentReleasesButton" Classes="flat" Content="×" Command="{Binding CancelBrowseCommand}" AutomationProperties.Name="取消读取" Padding="3" MinWidth="24"/></StackPanel></Grid></Border>
          <Border Name="ResourceInstallTargetPanel" Classes="card" IsVisible="{Binding ShowResourceInstall}"><StackPanel Spacing="8"><TextBlock Text="装入实例" Classes="sectionTitle" /><ComboBox Name="ContentInstallTargetSelector" ItemsSource="{Binding ContentInstallTargets}" SelectedItem="{Binding SelectedInstallTarget}" IsEnabled="{Binding CanEdit}" PlaceholderText="选择明确的兼容实例"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox><TextBlock Name="ResourceInstallStatus" Text="{Binding ResourceInstallStatus}" Classes="muted" /></StackPanel></Border>
          <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ModrinthPackImportTemplate}" IsVisible="{Binding ShowPackImport}" HorizontalContentAlignment="Stretch" />
          <TextBlock Name="ContentReleaseStatus" Text="{Binding RequestStatus}" IsVisible="{Binding ShowRequestStatus}" Classes="muted" />
          <ItemsControl Name="ContentReleaseGroups" ItemsSource="{Binding ReleaseGroups}"><ItemsControl.ItemTemplate><DataTemplate><Expander Header="{Binding Header}" Margin="0,0,0,12"><ItemsControl ItemsSource="{Binding Releases}" Margin="15,0,15,15"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Spacing="4" Margin="0,0,0,12"><TextBlock Text="{Binding Name}" LineHeight="20" FontSize="14" /><TextBlock Text="{Binding Detail}" Classes="muted" LineHeight="16" FontSize="11" /><ItemsControl ItemsSource="{Binding Files}"><ItemsControl.ItemTemplate><DataTemplate><Grid ColumnDefinitions="*,10,104,8,92" Margin="5,4"><StackPanel Spacing="2"><TextBlock Text="{Binding Name}" TextWrapping="Wrap" /><TextBlock Text="{Binding Detail}" Classes="muted" LineHeight="16" FontSize="11" /></StackPanel><Button Grid.Column="2" Name="DownloadResourceFileButton" Content="下载到缓存" Command="{Binding DownloadCommand}" /><Button Grid.Column="4" Name="InstallResourceFileButton" Content="装入实例" Command="{Binding InstallCommand}" IsVisible="{Binding ShowInstallButton}" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Expander></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          <Border Classes="card" IsVisible="{Binding HasDownloadedFile}"><StackPanel Spacing="8" ToolTip.Tip="文件已校验并保存到缓存；尚未自动装入实例或存档。"><TextBlock Text="{Binding LastDownloadPath}" Classes="muted" /><Button Content="打开下载目录" Command="{Binding OpenDownloadDirectoryCommand}" HorizontalAlignment="Left" /></StackPanel></Border>
        </StackPanel>
        <StackPanel Name="InstallerCatalogPage" IsVisible="{Binding IsInstallerPage}" Spacing="15">
          <Border Classes="card"><StackPanel Spacing="10"><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6"><Button Name="RefreshInstallerCatalogButton" Classes="flat" Content="刷新" Command="{Binding RefreshInstallerCatalogCommand}"/><StackPanel Orientation="Horizontal" Spacing="5" IsVisible="{Binding ShowLoadingBadge}"><views:LoadingGlyph Width="18" Height="18" Foreground="{DynamicResource ClubAccent}"/><Button Name="CancelInstallerRefreshButton" Classes="flat" Content="×" Command="{Binding CancelBrowseCommand}" AutomationProperties.Name="取消读取" ToolTip.Tip="取消读取（Esc）" Padding="3" MinWidth="24"/></StackPanel></StackPanel><TextBlock Text="{Binding InstallerTitle, StringFormat={}{0} 简介}" Classes="sectionTitle"/></DockPanel><TextBlock Text="{Binding InstallerIntroduction}" TextWrapping="Wrap"/><Button Content="打开官网" Command="{Binding OpenInstallerPageCommand}" HorizontalAlignment="Left"/></StackPanel></Border>
          <TextBlock Name="InstallerCatalogStatus" Text="{Binding InstallerStatus}" Classes="status muted" TextWrapping="Wrap"/>
          <ItemsControl Name="InstallerVersionGroups" ItemsSource="{Binding InstallerVersionGroups}"><ItemsControl.ItemTemplate><DataTemplate><Expander Header="{Binding Header}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}" HorizontalAlignment="Stretch" Margin="0,0,0,12"><ListBox Classes="installerVersions" ItemsSource="{Binding Versions}" MaxHeight="380" Background="Transparent" BorderThickness="0"><ListBox.ItemTemplate><DataTemplate><Button Name="SaveInstallerFileButton" Classes="flat" Click="SaveInstaller_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="7,5" ToolTip.Tip="下载并另存安装器"><Grid ColumnDefinitions="36,*" MinHeight="38"><Image Source="{Binding Icon}" Width="28" Height="28" RenderOptions.BitmapInterpolationMode="None"/><StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Title}" FontSize="14" LineHeight="20"/><TextBlock Text="{Binding Detail}" Classes="status muted" FontSize="11"/></StackPanel></Grid></Button></DataTemplate></ListBox.ItemTemplate></ListBox></Expander></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </StackPanel>
        <StackPanel Name="FavoritesPage" IsVisible="{Binding IsFavoritesPage}" Spacing="15"><Border Classes="card"><StackPanel Spacing="10"><TextBlock Text="收藏夹" Classes="sectionTitle" /><TextBlock Text="{Binding FavoriteStatus}" Classes="muted" /><ItemsControl Name="FavoriteResources" ItemsSource="{Binding FavoriteProjects}" ItemTemplate="{StaticResource ContentProjectTemplate}" /></StackPanel></Border></StackPanel>
        <StackPanel Name="DownloadsTaskPage" IsVisible="{Binding IsTasksPage}" Spacing="14"><TextBlock Text="{Binding Summary}" Classes="muted" />
          <Border Classes="card" IsVisible="{Binding IsEmpty}"><StackPanel Spacing="8"><TextBlock Text="还没有下载任务" Classes="sectionTitle"  ToolTip.Tip="取消或重试会作用于任务所属实例的整次安装，或当前资源下载。"/></StackPanel></Border>
          <ItemsControl Name="DownloadTasks" ItemsSource="{Binding Tasks}"><ItemsControl.ItemTemplate><DataTemplate><Border Classes="card" Margin="0,0,0,12"><StackPanel Spacing="10"><DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding State}" Classes="muted" /><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" /></DockPanel><ProgressBar Value="{Binding Progress}" IsIndeterminate="{Binding IsIndeterminate}" Minimum="0" Maximum="100" Height="5" /><TextBlock Text="{Binding Transfer}" /><TextBlock Text="{Binding Source}" Classes="muted" LineHeight="18" FontSize="12" /><TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" Foreground="{DynamicResource ClubErrorForeground}" TextWrapping="Wrap" /><StackPanel Orientation="Horizontal" Spacing="8"><Button Name="CancelDownloadButton" Content="取消所属安装" Command="{Binding CancelCommand}" /><Button Name="RetryDownloadButton" Content="重试所属安装" Command="{Binding RetryCommand}" /></StackPanel></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </StackPanel>
      </Grid>
    </ScrollViewer>
    <Grid Grid.Column="1" IsVisible="{Binding ShowFullPageLoading}" Name="DownloadLoadingPage">
      <Border Classes="card" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="170" MaxWidth="300" Padding="22,18"><StackPanel Spacing="12" HorizontalAlignment="Center"><views:LoadingGlyph Foreground="{DynamicResource ClubAccent}"/><TextBlock Text="{Binding PageLoadingText}" FontSize="15" LineHeight="22" Foreground="{DynamicResource ClubAccent}" TextWrapping="Wrap" TextAlignment="Center"/><Button Name="CancelBrowseLoadingButton" Content="取消" Command="{Binding CancelBrowseCommand}" Classes="flat" HorizontalAlignment="Center" FontSize="12"/></StackPanel></Border>
    </Grid>

  </Grid>
</UserControl>
