<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="using:SHOU.Launcher.Desktop.Localization" xmlns:views="using:SHOU.Launcher.Desktop.Views" x:Class="SHOU.Launcher.Desktop.Views.DownloadsView" AttachedToVisualTree="DownloadsView_AttachedToVisualTree" DetachedFromVisualTree="DownloadsView_DetachedFromVisualTree" DataContextChanged="DownloadsView_DataContextChanged" KeyDown="DownloadsView_KeyDown">
  <UserControl.Resources>
    <DataTemplate x:Key="ModrinthPackImportTemplate">
      <Border Classes="card"><StackPanel Spacing="8" IsEnabled="{Binding CanEdit}">
        <TextBlock Text="{loc:Loc tdbf22f72fa0d766c}" Classes="sectionTitle" />
        <WrapPanel><Button Name="ReadModrinthPackButton" Content="{loc:Loc ta0f13f9c9a3cdaeb}" ToolTip.Tip="{loc:Loc t019054bc54c62289}" Click="PickModrinthPack_Click" IsEnabled="{Binding PackServiceAvailable}" Margin="0,0,8,0" /><Button Content="{loc:Loc td1c6ac73e5b58311}" Command="{Binding ReadCachedPackCommand}" IsVisible="{Binding HasDownloadedFile}" /></WrapPanel>
        <TextBlock Text="{Binding LocalPackPath}" Classes="muted" LineHeight="16" FontSize="11" TextTrimming="CharacterEllipsis" />
        <StackPanel IsVisible="{Binding HasPackInspection}" Spacing="6"><TextBlock Text="{loc:Loc t8bfc11ae086390df}" /><TextBox Name="ModrinthPackInstanceName" Text="{Binding PackInstanceName}" />
          <Expander Header="{loc:Loc t4440a2db7c16efb9}" IsVisible="{Binding HasOptionalPackFiles}"><ItemsControl ItemsSource="{Binding OptionalPackFiles}" Margin="12"><ItemsControl.ItemTemplate><DataTemplate><CheckBox Content="{Binding Path}" IsChecked="{Binding Selected}" /></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Expander>
          <CheckBox Name="PreparePackAfterImport" Content="同时下载并安装游戏文件" IsChecked="{Binding PreparePackAfterImport}"/>
          <Button Name="ImportModrinthPackButton" Content="{loc:Loc tb8d398d9ffed439a}" Classes="primary" Command="{Binding ImportLocalPackCommand}" HorizontalAlignment="Left" />
        </StackPanel>
        <TextBlock Name="ModrinthPackImportStatus" Text="{Binding PackStatus}" Classes="status muted" />
        <Expander Name="LocalPackDetails" Header="{loc:Loc t23f33d1709458503}" IsVisible="{Binding HasPackDetails}"><TextBlock Text="{Binding PackDetails}" Classes="muted" Margin="12" /></Expander>
      </StackPanel></Border>
    </DataTemplate>
    <DataTemplate x:Key="AdditionalLoaderTemplate">
      <Expander Classes="loaderChoice" Header="{Binding Title}" Margin="0,0,0,12" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
        <Expander.HeaderTemplate><DataTemplate><Grid ColumnDefinitions="32,100,*,24" VerticalAlignment="Center">
          <Image Source="{Binding DataContext.Icon, RelativeSource={RelativeSource AncestorType=Expander}}" Width="24" Height="24" RenderOptions.BitmapInterpolationMode="None" />
          <TextBlock Grid.Column="1" Text="{Binding}" VerticalAlignment="Center" />
          <TextBlock Grid.Column="2" Text="{Binding DataContext.Summary, RelativeSource={RelativeSource AncestorType=Expander}}" Classes="muted" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          <views:LoadingGlyph Grid.Column="3" Width="18" Height="18" IsVisible="{Binding DataContext.IsLoading, RelativeSource={RelativeSource AncestorType=Expander}}" Foreground="{DynamicResource ClubAccent}" />
        </Grid></DataTemplate></Expander.HeaderTemplate>
        <StackPanel Spacing="8" Margin="15,4,15,15">
          <ListBox Name="AdditionalLoaderVersions" Classes="additionalLoaders" ItemsSource="{Binding Versions}" SelectedItem="{Binding SelectedVersion}" IsEnabled="{Binding CanEdit}" MaxHeight="360" BorderThickness="0" Background="Transparent">
            <ListBox.ItemTemplate><DataTemplate><Grid ColumnDefinitions="36,*,Auto" MinHeight="38" ToolTip.Tip="{Binding Detail}">
              <Image Source="{Binding DataContext.Icon, RelativeSource={RelativeSource AncestorType=ListBox}}" Width="28" Height="28" RenderOptions.BitmapInterpolationMode="None" VerticalAlignment="Center" />
              <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2"><TextBlock Text="{Binding DisplayVersion}" FontSize="14" LineHeight="20" /><TextBlock Text="{Binding Detail}" Classes="status muted" FontSize="11" /></StackPanel>
              <TextBlock Grid.Column="2" Text="{loc:Loc t93a48223a516e074}" IsVisible="{Binding Stable}" Classes="muted" FontSize="11" VerticalAlignment="Center" />
            </Grid></DataTemplate></ListBox.ItemTemplate>
          </ListBox>
          <TextBlock Text="{Binding Status}" Classes="status muted" TextWrapping="Wrap" />
          <WrapPanel><Button Classes="flat" Command="{Binding RefreshCommand}" Content="{loc:Loc taee88743413144a2}" Margin="0,0,8,0" /><Button Content="{loc:Loc t74966e20df2ea9fd}" Command="{Binding ClearCommand}" IsVisible="{Binding HasSelection}" /></WrapPanel>
        </StackPanel>
      </Expander>
    </DataTemplate>
    <DataTemplate x:Key="InstallerVersionTemplate">
      <Button Name="SaveInstallerFileButton" Classes="flat" Click="SaveInstaller_Click" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="7,5" ToolTip.Tip="{Binding Verification}">
        <Grid ColumnDefinitions="36,*" MinHeight="38"><Image Source="{Binding Icon}" Width="28" Height="28" RenderOptions.BitmapInterpolationMode="None"/>
          <StackPanel Grid.Column="1" VerticalAlignment="Center"><TextBlock Text="{Binding Title}" FontSize="14" LineHeight="20"/><TextBlock Text="{Binding Detail}" Classes="status muted" FontSize="11"/></StackPanel>
        </Grid>
      </Button>
    </DataTemplate>
    <DataTemplate x:Key="DownloadCategoryTemplate">
      <ToggleButton Classes="contextNavigation" IsChecked="{Binding IsSelected, Mode=OneWay}" Command="{Binding SelectCommand}" HorizontalAlignment="Stretch" MinHeight="35">
        <Grid ColumnDefinitions="24,6,*"><views:ClubIcon Classes="contextIcon" Kind="{Binding IconKind}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" /><TextBlock Grid.Column="2" Classes="navigationLabel" Text="{Binding Title}" /></Grid>
      </ToggleButton>
    </DataTemplate>
    <DataTemplate x:Key="GameVersionTemplate">
      <Button Classes="flat" Command="{Binding SelectCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="7,4" MinHeight="43" ToolTip.Tip="{Binding Detail}">
        <Grid ColumnDefinitions="36,*">
          <Image Source="{Binding Icon}" Width="28" Height="28" VerticalAlignment="Center" RenderOptions.BitmapInterpolationMode="None" />
          <StackPanel Grid.Column="1" Spacing="1" VerticalAlignment="Center"><TextBlock Text="{Binding Id}" LineHeight="20" FontSize="14" /><TextBlock Text="{Binding Detail}" Classes="muted" LineHeight="18" FontSize="12" /></StackPanel>
        </Grid>
      </Button>
    </DataTemplate>
    <DataTemplate x:Key="ContentProjectTemplate">
      <Button Classes="flat contentProjectRow" Command="{Binding OpenCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch" Padding="5,6" MinHeight="64" ToolTip.Tip="{Binding Detail}">
        <Grid ColumnDefinitions="52,*">
          <Border Width="42" Height="42" CornerRadius="5" Background="{DynamicResource ClubSelection}" ClipToBounds="True" VerticalAlignment="Center"><Grid><TextBlock Text="{Binding Tile}" FontSize="22" Foreground="{DynamicResource ClubSelectionForeground}" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !HasIcon}"/><Image Source="{Binding Icon}" Stretch="Uniform" IsVisible="{Binding HasIcon}"/></Grid></Border>
          <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
            <TextBlock Text="{Binding Title}" FontSize="14" LineHeight="20" TextTrimming="CharacterEllipsis"/>
            <Grid ColumnDefinitions="Auto,*"><Border IsVisible="{Binding HasTags}" Background="{DynamicResource ClubSelection}" CornerRadius="2" Padding="3,0" Margin="0,0,6,0" MaxWidth="140" VerticalAlignment="Center"><TextBlock Text="{Binding Tags}" Classes="muted" FontSize="11" LineHeight="16" TextTrimming="CharacterEllipsis"/></Border><TextBlock Grid.Column="1" Text="{Binding Description}" Classes="muted" FontSize="12" LineHeight="18" TextTrimming="CharacterEllipsis"/></Grid>
            <Grid ColumnDefinitions="*,100,105,88" ColumnSpacing="6">
              <StackPanel Orientation="Horizontal" Spacing="4" IsVisible="{Binding HasCompatibility}"><views:ClubIcon Kind="list" Width="13" Height="13"/><TextBlock Text="{Binding Compatibility}" Classes="muted" FontSize="11" LineHeight="16" TextTrimming="CharacterEllipsis" MaxWidth="220"/></StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4"><views:ClubIcon Kind="download" Width="13" Height="13"/><TextBlock Text="{Binding Downloads}" Classes="muted" FontSize="11" LineHeight="16"/></StackPanel>
              <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" IsVisible="{Binding HasUpdated}"><views:ClubIcon Kind="arrow-up-from-line" Width="13" Height="13"/><TextBlock Text="{Binding Updated}" Classes="muted" FontSize="11" LineHeight="16"/></StackPanel>
              <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="4"><views:ClubIcon Kind="globe" Width="13" Height="13"/><TextBlock Text="{Binding SourceName}" Classes="muted" FontSize="11" LineHeight="16"/></StackPanel>
            </Grid>
          </StackPanel>
        </Grid>
      </Button>
    </DataTemplate>
  </UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="Button.contentProjectRow TextBlock.muted"><Setter Property="TextWrapping" Value="NoWrap" /></Style>
    <Style Selector="Expander.loaderChoice TextBlock.muted"><Setter Property="FontWeight" Value="Normal" /></Style>
    <Style Selector="ListBox.additionalLoaders ListBoxItem"><Setter Property="IsEnabled" Value="{Binding CanInstall}" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="Padding" Value="6,3" /></Style>
    <Style Selector="ListBox.installerVersions ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/></Style>
    <Style Selector="Expander.loaderChoice"><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style>
    <Style Selector="Expander.loaderChoice /template/ ToggleButton#ExpanderHeader"><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style>
  </UserControl.Styles>
  <Grid ColumnDefinitions="Auto,*">
    <Border Name="DownloadsCategoryPanel" Width="180" Background="{DynamicResource ClubSidebar}" BorderBrush="{DynamicResource ClubBorder}" BorderThickness="0,0,1,0" IsVisible="{Binding ShowCategorySidebar}">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,12,0,15">
        <ContentControl Content="{Binding MinecraftCategory}" ContentTemplate="{StaticResource DownloadCategoryTemplate}" HorizontalContentAlignment="Stretch" />
        <TextBlock Text="{loc:Loc tb6ed713343309e14}" Classes="contextHeading" />
        <ItemsControl ItemsSource="{Binding CommunityCategories}" ItemTemplate="{StaticResource DownloadCategoryTemplate}" />
        <TextBlock Text="{loc:Loc t4ef515abfdb8690d}" Classes="contextHeading" />
        <ItemsControl ItemsSource="{Binding InstallerCategories}" ItemTemplate="{StaticResource DownloadCategoryTemplate}" />
        <TextBlock Text="{loc:Loc t5253040db8643c85}" Classes="contextHeading" />
        <ContentControl Content="{Binding TasksCategory}" ContentTemplate="{StaticResource DownloadCategoryTemplate}" HorizontalContentAlignment="Stretch" />
      </StackPanel></ScrollViewer>
    </Border>
    <ScrollViewer Grid.Column="1" Name="DownloadsPageScroller" HorizontalScrollBarVisibility="Disabled" IsVisible="{Binding !ShowFullPageLoading}">
      <Grid Margin="24">
        <StackPanel Name="MinecraftCatalogPage" IsVisible="{Binding IsCatalogPage}" Spacing="15">

          <Border Classes="card"><StackPanel Spacing="10">
            <DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6"><Button Name="RefreshGameCatalogButton" ToolTip.Tip="{Binding CatalogSource}" Classes="flat" Content="{loc:Loc taee88743413144a2}" Command="{Binding RefreshCatalogCommand}" Padding="6,3" /><StackPanel Orientation="Horizontal" Spacing="5" IsVisible="{Binding ShowLoadingBadge}"><views:LoadingGlyph Width="18" Height="18" Foreground="{DynamicResource ClubAccent}"/><Button Name="CancelCatalogRefreshButton" Classes="flat" Content="×" Command="{Binding CancelBrowseCommand}" AutomationProperties.Name="{loc:Loc tcaf06adff4f18c9e}" ToolTip.Tip="{loc:Loc t171f673bb4e265b5}" Padding="3" MinWidth="24"/></StackPanel></StackPanel><TextBlock Text="{loc:Loc tc2a497830ef74215}" Classes="sectionTitle" VerticalAlignment="Center" ToolTip.Tip="{Binding CatalogPurpose}" /></DockPanel>
            <ItemsControl Name="LatestGameVersions" ItemsSource="{Binding LatestVersions}" ItemTemplate="{StaticResource GameVersionTemplate}" />
            <TextBlock Text="{Binding RequestStatus}" IsVisible="{Binding ShowRequestStatus}" Classes="muted" LineHeight="16" FontSize="11" />

          </StackPanel></Border>
          <ItemsControl Name="GameVersionGroups" ItemsSource="{Binding VersionGroups}"><ItemsControl.ItemTemplate><DataTemplate><Expander Header="{Binding Header}" HorizontalAlignment="Stretch" Margin="0,0,0,12"><ItemsControl ItemsSource="{Binding Versions}" ItemTemplate="{StaticResource GameVersionTemplate}" Margin="15,0,15,15" /></Expander></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </StackPanel>
        <StackPanel Name="MinecraftInstallConfiguration" IsVisible="{Binding IsConfiguration}" Spacing="12">
          <Border Classes="card"><StackPanel Spacing="8"><Grid ColumnDefinitions="34,*"><Button Classes="flat" Command="{Binding BackToListCommand}" Padding="4" AutomationProperties.Name="{loc:Loc t133251e05068cbab}" ><views:ClubIcon Kind="arrow-left" Width="16" Height="16" /></Button><TextBox Grid.Column="1" Name="CatalogInstallationName" Text="{Binding InstallationName}" IsEnabled="{Binding CanEdit}" /></Grid><TextBlock Text="{Binding InstallationValidation}" IsVisible="{Binding HasInstallationValidation}" Classes="muted" Margin="34,0,0,0" /></StackPanel></Border>

          <ItemsControl Name="AdditionalLoaderCatalogs" ItemsSource="{Binding AdditionalLoaders}" ItemTemplate="{StaticResource AdditionalLoaderTemplate}" />
          <Expander Classes="loaderChoice" Header="Fabric" HorizontalAlignment="Stretch" HorizontalContentAlignment="Stretch">
            <Expander.HeaderTemplate><DataTemplate><Grid ColumnDefinitions="32,100,*,24"><Image Source="avares://SHOU.Launcher.Desktop/Assets/Minecraft/Fabric.png" Width="24" Height="24" RenderOptions.BitmapInterpolationMode="None"/><TextBlock Grid.Column="1" Text="Fabric" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="{Binding DataContext.FabricSummary, RelativeSource={RelativeSource AncestorType=Expander}}" Classes="muted" VerticalAlignment="Center"/><views:LoadingGlyph Grid.Column="3" Width="18" Height="18" IsVisible="{Binding DataContext.FabricLoading, RelativeSource={RelativeSource AncestorType=Expander}}" Foreground="{DynamicResource ClubAccent}"/></Grid></DataTemplate></Expander.HeaderTemplate>
            <StackPanel Spacing="8" Margin="15,4,15,15">
              <ListBox Name="FabricCatalogSelector" ItemsSource="{Binding FabricVersions}" SelectedItem="{Binding SelectedFabric}" IsEnabled="{Binding CanEdit}" MaxHeight="360" BorderThickness="0" Background="Transparent"><ListBox.ItemTemplate><DataTemplate><Grid ColumnDefinitions="36,*,Auto" MinHeight="38"><Image Source="avares://SHOU.Launcher.Desktop/Assets/Minecraft/Fabric.png" Width="28" Height="28" RenderOptions.BitmapInterpolationMode="None"/><TextBlock Grid.Column="1" Text="{Binding Version}" VerticalAlignment="Center" FontSize="14"/><TextBlock Grid.Column="2" Text="{loc:Loc t93a48223a516e074}" Classes="muted" FontSize="11" VerticalAlignment="Center" IsVisible="{Binding Stable}"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
              <TextBlock Text="{Binding FabricStatus}" Classes="status muted" TextWrapping="Wrap" />
              <WrapPanel><Button Name="RefreshFabricCatalogButton" Content="{loc:Loc taee88743413144a2}" Command="{Binding RefreshFabricCommand}" Classes="flat" Margin="0,0,8,0"/><Button Content="{loc:Loc t74966e20df2ea9fd}" Command="{Binding ClearFabricCommand}" /></WrapPanel>
            </StackPanel>
          </Expander>
          <Border Classes="card" Padding="15,9"><Grid ColumnDefinitions="32,100,*"><Image Source="avares://SHOU.Launcher.Desktop/Assets/Minecraft/Fabric.png" Width="24" Height="24"/><TextBlock Grid.Column="1" Text="Fabric API" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="{loc:Loc t374930f1453fcd3e}" Classes="muted" VerticalAlignment="Center" ToolTip.Tip="{Binding AdditionalLoaderCapability}"/></Grid></Border>
          <Border Classes="card" Padding="15,9"><Grid ColumnDefinitions="32,100,*"><views:ClubIcon Kind="cat" Width="22" Height="22"/><TextBlock Grid.Column="1" Text="LabyMod" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="{loc:Loc t374930f1453fcd3e}" Classes="muted" VerticalAlignment="Center"/></Grid></Border>
          <Border Classes="card" Padding="15,9"><Grid ColumnDefinitions="32,100,*"><views:ClubIcon Kind="gauge" Width="22" Height="22"/><TextBlock Grid.Column="1" Text="OptiFine" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Text="{loc:Loc t374930f1453fcd3e}" Classes="muted" VerticalAlignment="Center"/></Grid></Border>
          <TextBlock Name="CatalogInstallStatus" Text="{Binding InstallStatus}" Classes="muted" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12" Margin="0,8"><Button Name="InstallCatalogVersionButton" Classes="primary" Content="{loc:Loc tac69f68b7010ec79}" Command="{Binding InstallVersionCommand}" Height="42" MinWidth="135" /><Button Content="{loc:Loc t972a0ba2828d5d53}" Command="{Binding ShowCreatedInstanceCommand}" IsVisible="{Binding HasCreatedInstance}" Height="42" /></StackPanel>
        </StackPanel>
        <StackPanel Name="MinecraftPackagePage" IsVisible="{Binding IsPackageDetail}" Spacing="15">
          <Border Classes="card"><StackPanel Spacing="10"><DockPanel><Button DockPanel.Dock="Left" Classes="flat" Command="{Binding BackToListCommand}" AutomationProperties.Name="{loc:Loc t95ac6efa1b546add}" Margin="0,0,10,0" ><views:ClubIcon Kind="arrow-left" Width="16" Height="16" /></Button><TextBlock Name="MinecraftPackageVersionTitle" Text="{Binding PackageVersionId}" Classes="sectionTitle" VerticalAlignment="Center"  ToolTip.Tip="{loc:Loc t6e6d499730c42429}"/></DockPanel></StackPanel></Border>
          <TextBlock Text="{Binding RequestStatus}" IsVisible="{Binding ShowRequestStatus}" Classes="muted" />
          <ItemsControl Name="MinecraftPackageFiles" ItemsSource="{Binding MinecraftPackages}" IsEnabled="{Binding CanEdit}"><ItemsControl.ItemTemplate><DataTemplate><Border Classes="card" Margin="0,0,0,12"><Grid ColumnDefinitions="*,12,Auto"><StackPanel Spacing="6"><TextBlock Text="{Binding Title}" Classes="sectionTitle" /><TextBlock Text="{Binding Detail}" TextWrapping="Wrap" /></StackPanel><Button Grid.Column="2" Name="SaveMinecraftPackageButton" Content="{loc:Loc td683d1f7d649b079}" Click="SaveMinecraftPackage_Click" VerticalAlignment="Center" /></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </StackPanel>
        <StackPanel Name="CommunitySearchPage" IsVisible="{Binding IsSearchPage}" Spacing="15">
          <Border Classes="card" Padding="12,5"><Grid ColumnDefinitions="*,10,60,Auto"><TextBox KeyDown="ContentSearch_KeyDown" Name="ContentSearchQuery" Text="{Binding QueryText}" PlaceholderText="{Binding SearchPlaceholder}" BorderThickness="0" Background="Transparent" IsEnabled="{Binding CanQuery}" /><Button Grid.Column="2" Name="SearchContentButton" Classes="primary" Content="{loc:Loc t44ce7ae909bbb28b}" Command="{Binding SearchCommand}" /><Border Grid.Column="3" Margin="8,0,0,0" IsVisible="{Binding ShowLoadingBadge}"><StackPanel Orientation="Horizontal" Spacing="5" IsVisible="{Binding ShowLoadingBadge}"><views:LoadingGlyph Width="18" Height="18" Foreground="{DynamicResource ClubAccent}"/><Button Name="CancelSearchRefreshButton" Classes="flat" Content="×" Command="{Binding CancelBrowseCommand}" AutomationProperties.Name="{loc:Loc tcaf06adff4f18c9e}" ToolTip.Tip="{loc:Loc t171f673bb4e265b5}" Padding="3" MinWidth="24"/></StackPanel></Border></Grid></Border>
          <Border Classes="card" Padding="12,8"><StackPanel Spacing="8"><Grid ColumnDefinitions="32,*,12,45,*,12,58,*,26"><TextBlock Text="{loc:Loc ta488e93d69cc1296}" VerticalAlignment="Center" /><ComboBox Grid.Column="1" Name="ContentSourceSelector" ItemsSource="{Binding ContentSourceChoices}" SelectedItem="{Binding SelectedSource}" IsEnabled="{Binding CanQuery}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><TextBlock Grid.Column="3" Text="{loc:Loc t1d0fd5f9336d9103}" VerticalAlignment="Center" /><ComboBox Grid.Column="4" Name="ContentCategoryFilter" ItemsSource="{Binding ContentCategoryChoices}" SelectedItem="{Binding SelectedContentCategory}" IsEnabled="{Binding HasContentCategoryChoices}" ToolTip.Tip="{Binding CategoryStatus}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox><TextBlock Grid.Column="6" Text="{loc:Loc t1ce6b1d7c95ce2ee}" VerticalAlignment="Center" /><ComboBox Grid.Column="7" Name="ContentSortSelector" ItemsSource="{Binding SortChoices}" SelectedItem="{Binding SelectedSort}" IsEnabled="{Binding CanEdit}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox><Button Grid.Column="8" Classes="flat" Command="{Binding ResetFiltersCommand}" Padding="3" ToolTip.Tip="{loc:Loc t13a431e59b658d16}"  AutomationProperties.Name="{loc:Loc t13a431e59b658d16}" ><views:ClubIcon Kind="rotate-ccw" Width="16" Height="16" /></Button></Grid>
          <Grid ColumnDefinitions="32,*,12,45,*,12,58,*"><TextBlock Text="{loc:Loc t5f76b2bf82dd2c5d}" VerticalAlignment="Center" /><TextBox Grid.Column="1" Name="ContentGameVersionFilter" Text="{Binding GameVersionFilter}" PlaceholderText="{loc:Loc t5d7906f5af429022}" IsEnabled="{Binding CanEdit}" /><TextBlock Grid.Column="3" Text="{loc:Loc t7a2bd8b6cb0ed3bf}" VerticalAlignment="Center" /><ComboBox Grid.Column="4" Name="ContentLoaderFilter" ItemsSource="{Binding LoaderFilters}" SelectedItem="{Binding LoaderFilter}" IsEnabled="{Binding CanEdit}" /></Grid></StackPanel></Border>
          <ContentControl Name="LocalModrinthPackImport" Content="{Binding}" ContentTemplate="{StaticResource ModrinthPackImportTemplate}" IsVisible="{Binding ShowPackImport}" HorizontalContentAlignment="Stretch" />
          <TextBlock Text="{Binding RequestStatus}" IsVisible="{Binding ShowRequestStatus}" Classes="muted" />
          <Border Classes="card" IsVisible="{Binding HasProjects}"><ItemsControl Name="ContentSearchResults" ItemsSource="{Binding Projects}" ItemTemplate="{StaticResource ContentProjectTemplate}" /></Border>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="12"><Button Content="{loc:Loc tc9b9ae7a61444ab7}" Command="{Binding PreviousPageCommand}" /><TextBlock Text="{Binding PageSummary}" VerticalAlignment="Center" /><Button Content="{loc:Loc t8a8542f6964852dc}" Command="{Binding NextPageCommand}" /></StackPanel>
        </StackPanel>
        <StackPanel Name="ResourceDetailPage" IsVisible="{Binding IsResourceDetail}" Spacing="15">
          <Border Classes="card"><StackPanel Spacing="12"><DockPanel><Button DockPanel.Dock="Left" Classes="flat" Command="{Binding BackToListCommand}" Margin="0,0,10,0" AutomationProperties.Name="{loc:Loc t4f62a614fb8f01a4}" ><views:ClubIcon Kind="arrow-left" Width="16" Height="16" /></Button><Border DockPanel.Dock="Left" Width="50" Height="50" CornerRadius="6" Background="{DynamicResource ClubSelection}" Margin="0,0,10,0"><TextBlock Text="{Binding ProjectTile}" LineHeight="36" FontSize="26" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource ClubSelectionForeground}" /></Border><StackPanel Spacing="3"><TextBlock Text="{Binding ProjectTitle}" LineHeight="24" FontSize="16" /><TextBlock Text="{Binding ProjectDescription}" Classes="muted" LineHeight="18" FontSize="12" /><TextBlock Text="{Binding ProjectDetail}" Classes="muted" LineHeight="18" FontSize="12" /></StackPanel></DockPanel>
          <WrapPanel><Button Content="{Binding ProjectSourceName}" Command="{Binding OpenProjectPageCommand}" Margin="0,0,8,0" /><Button Content="{loc:Loc ta77a6cca3ce275e0}" Click="CopyProjectName_Click" Margin="0,0,8,0" /><Button Content="{loc:Loc t8e86f9b1d54f2c51}" Click="CopyProjectLink_Click" Margin="0,0,8,0" /><Button Name="FavoriteProjectButton" Content="{Binding FavoriteAction}" Command="{Binding ToggleFavoriteCommand}" /></WrapPanel><TextBlock Text="{Binding FavoriteStatus}" Classes="muted" LineHeight="16" FontSize="11" /></StackPanel></Border>
          <Border Classes="card"><Grid ColumnDefinitions="36,*,12,50,*,12,Auto,Auto"><TextBlock Text="{loc:Loc t5f76b2bf82dd2c5d}" VerticalAlignment="Center" /><TextBox Grid.Column="1" Text="{Binding GameVersionFilter}" PlaceholderText="{loc:Loc t5d7906f5af429022}" IsEnabled="{Binding CanEdit}" /><TextBlock Grid.Column="3" Text="{loc:Loc t7a2bd8b6cb0ed3bf}" VerticalAlignment="Center" /><ComboBox Grid.Column="4" ItemsSource="{Binding LoaderFilters}" SelectedItem="{Binding LoaderFilter}" IsEnabled="{Binding CanEdit}" /><Button Grid.Column="6" Name="RefreshContentReleasesButton" Content="{loc:Loc taba83d2af8177a74}" Command="{Binding RefreshReleasesCommand}" /><StackPanel Grid.Column="7" Orientation="Horizontal" Spacing="5" IsVisible="{Binding ShowLoadingBadge}" Margin="8,0,0,0"><views:LoadingGlyph Width="18" Height="18" Foreground="{DynamicResource ClubAccent}"/><Button Name="CancelContentReleasesButton" Classes="flat" Content="×" Command="{Binding CancelBrowseCommand}" AutomationProperties.Name="{loc:Loc tcaf06adff4f18c9e}" Padding="3" MinWidth="24"/></StackPanel></Grid></Border>
          <Border Name="ResourceInstallTargetPanel" Classes="card" IsVisible="{Binding ShowResourceInstall}"><StackPanel Spacing="8"><TextBlock Text="{loc:Loc t8624c13ae5d21b79}" Classes="sectionTitle" /><ComboBox Name="ContentInstallTargetSelector" ItemsSource="{Binding ContentInstallTargets}" SelectedItem="{Binding SelectedInstallTarget}" IsEnabled="{Binding CanEdit}" PlaceholderText="{loc:Loc t6e531b4433a5db79}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox><TextBlock Name="ResourceInstallStatus" Text="{Binding ResourceInstallStatus}" Classes="muted" /></StackPanel></Border>
          <Border Name="WorldContentTargetPanel" Classes="card" IsVisible="{Binding ShowWorldContentInstall}"><StackPanel Spacing="10">
            <TextBlock Text="安装到存档" Classes="sectionTitle"/>
            <ComboBox Name="WorldContentInstanceSelector" ItemsSource="{Binding ContentInstallTargets}" SelectedItem="{Binding SelectedInstallTarget}" IsEnabled="{Binding CanEdit}" PlaceholderText="选择目标实例"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
            <Grid ColumnDefinitions="*,Auto" IsVisible="{Binding IsDatapackInstall}">
              <ComboBox Name="DatapackWorldTargetSelector" ItemsSource="{Binding WorldContentTargets}" SelectedItem="{Binding SelectedWorldContentTarget}" IsEnabled="{Binding CanEdit}" PlaceholderText="选择存档"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
              <Button Grid.Column="1" Content="刷新" Command="{Binding RefreshWorldContentTargetsCommand}" Margin="8,0,0,0"/>
            </Grid>
            <TextBox Name="NewWorldDirectoryName" Text="{Binding NewWorldDirectoryName}" IsVisible="{Binding IsWorldDownloadInstall}" IsEnabled="{Binding CanEdit}" PlaceholderText="新存档文件夹名"/>
            <TextBlock Name="WorldContentStatus" Text="{Binding WorldContentStatus}" Classes="muted" TextWrapping="Wrap"/>
            <StackPanel Name="WorldContentPreviewPanel" IsVisible="{Binding HasWorldContentPreview}" Spacing="8">
              <TextBlock Text="{Binding WorldContentPreviewText}" TextWrapping="Wrap"/>
              <WrapPanel><Button Name="ConfirmWorldContentInstallButton" Content="确认安装" Command="{Binding ConfirmWorldContentInstallCommand}"/><Button Content="取消" Command="{Binding CancelWorldContentPreviewCommand}" Margin="8,0,0,0"/></WrapPanel>
            </StackPanel>
          </StackPanel></Border>
          <ContentControl Content="{Binding}" ContentTemplate="{StaticResource ModrinthPackImportTemplate}" IsVisible="{Binding ShowPackImport}" HorizontalContentAlignment="Stretch" />
          <TextBlock Name="ContentReleaseStatus" Text="{Binding RequestStatus}" IsVisible="{Binding ShowRequestStatus}" Classes="muted" />
          <ItemsControl Name="ContentReleaseGroups" ItemsSource="{Binding ReleaseGroups}"><ItemsControl.ItemTemplate><DataTemplate><Expander Header="{Binding Header}" Margin="0,0,0,12"><ItemsControl ItemsSource="{Binding Releases}" Margin="15,0,15,15"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Spacing="4" Margin="0,0,0,12"><TextBlock Text="{Binding Name}" LineHeight="20" FontSize="14" /><TextBlock Text="{Binding Detail}" Classes="muted" LineHeight="16" FontSize="11" /><TextBlock Text="{Binding Notice}" IsVisible="{Binding HasNotice}" Classes="muted" TextWrapping="Wrap"/><ItemsControl ItemsSource="{Binding Files}"><ItemsControl.ItemTemplate><DataTemplate><Grid ColumnDefinitions="*,10,104,8,92" Margin="5,4"><StackPanel Spacing="2"><TextBlock Text="{Binding Name}" TextWrapping="Wrap" /><TextBlock Text="{Binding Detail}" Classes="muted" LineHeight="16" FontSize="11" /></StackPanel><Button Grid.Column="2" Name="DownloadResourceFileButton" Content="{loc:Loc td63ff645f191855a}" Command="{Binding DownloadCommand}" /><Button Grid.Column="4" Name="InstallResourceFileButton" Content="{Binding InstallCaption}" Command="{Binding InstallCommand}" IsVisible="{Binding ShowInstallButton}" /></Grid></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Expander></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          <Border Classes="card" IsVisible="{Binding HasDownloadedFile}"><StackPanel Spacing="8" ToolTip.Tip="{loc:Loc t5f55a3d754902c7e}"><TextBlock Text="{Binding LastDownloadPath}" Classes="muted" /><Button Content="{loc:Loc t982450485bc451c9}" Command="{Binding OpenDownloadDirectoryCommand}" HorizontalAlignment="Left" /></StackPanel></Border>
        </StackPanel>
        <StackPanel Name="InstallerCatalogPage" IsVisible="{Binding IsInstallerPage}" Spacing="15">
          <Border Classes="card"><StackPanel Spacing="10"><DockPanel><StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6"><Button Name="RefreshInstallerCatalogButton" Classes="flat" Content="{loc:Loc taee88743413144a2}" Command="{Binding RefreshInstallerCatalogCommand}"/><StackPanel Orientation="Horizontal" Spacing="5" IsVisible="{Binding ShowLoadingBadge}"><views:LoadingGlyph Width="18" Height="18" Foreground="{DynamicResource ClubAccent}"/><Button Name="CancelInstallerRefreshButton" Classes="flat" Content="×" Command="{Binding CancelBrowseCommand}" AutomationProperties.Name="{loc:Loc tcaf06adff4f18c9e}" ToolTip.Tip="{loc:Loc t171f673bb4e265b5}" Padding="3" MinWidth="24"/></StackPanel></StackPanel><TextBlock Text="{Binding InstallerTitle, StringFormat={}{0} 简介}" Classes="sectionTitle"/></DockPanel><TextBlock Text="{Binding InstallerIntroduction}" TextWrapping="Wrap"/><Button Content="{loc:Loc t2a387b9dca2585fc}" Command="{Binding OpenInstallerPageCommand}" HorizontalAlignment="Left"/></StackPanel></Border>
          <TextBlock Name="InstallerCatalogStatus" Text="{Binding InstallerStatus}" Classes="status muted" TextWrapping="Wrap"/>
          <ItemsControl Name="InstallerVersionGroups" ItemsSource="{Binding InstallerVersionGroups}"><ItemsControl.ItemTemplate><DataTemplate>
            <Expander Header="{Binding Header}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}" HorizontalAlignment="Stretch" Margin="0,0,0,12">
              <StackPanel Margin="15,0,15,15" Spacing="8">
                <ItemsControl Name="InstallerHighlights" ItemsSource="{Binding Highlights}" ItemTemplate="{StaticResource InstallerVersionTemplate}" IsVisible="{Binding HasHighlights}"/>
                <TextBlock Text="{Binding AllVersionsHeader}" IsVisible="{Binding HasHighlights}" Classes="muted" Margin="7,4,0,0"/>
                <ListBox Classes="installerVersions" ItemsSource="{Binding Versions}" MaxHeight="380" Background="Transparent" BorderThickness="0" ItemTemplate="{StaticResource InstallerVersionTemplate}"/>
              </StackPanel>
            </Expander>
          </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </StackPanel>
        <StackPanel Name="FavoritesPage" IsVisible="{Binding IsFavoritesPage}" Spacing="15"><Border Classes="card"><StackPanel Spacing="10"><TextBlock Text="{loc:Loc t796d20e915884195}" Classes="sectionTitle" /><TextBlock Text="{Binding FavoriteStatus}" Classes="muted" /><ItemsControl Name="FavoriteResources" ItemsSource="{Binding FavoriteProjects}" ItemTemplate="{StaticResource ContentProjectTemplate}" /></StackPanel></Border></StackPanel>
        <StackPanel Name="DownloadsTaskPage" IsVisible="{Binding IsTasksPage}" Spacing="14"><TextBlock Text="{loc:Translate Summary}" Classes="muted" />
          <Border Classes="card" IsVisible="{Binding IsEmpty}"><StackPanel Spacing="8"><TextBlock Text="{loc:Loc t1640d50f8dbf6fa3}" Classes="sectionTitle"  ToolTip.Tip="{loc:Loc t8ba03fba98587c3d}"/></StackPanel></Border>
          <ItemsControl Name="DownloadTasks" ItemsSource="{Binding Tasks}"><ItemsControl.ItemTemplate><DataTemplate><Border Classes="card" Margin="0,0,0,12"><StackPanel Spacing="10"><DockPanel><TextBlock DockPanel.Dock="Right" Text="{Binding State}" Classes="muted" /><TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" /></DockPanel><ProgressBar Value="{Binding Progress}" IsIndeterminate="{Binding IsIndeterminate}" Minimum="0" Maximum="100" Height="5" /><TextBlock Text="{Binding Transfer}" /><TextBlock Text="{Binding Source}" Classes="muted" LineHeight="18" FontSize="12" /><TextBlock Text="{Binding Error}" IsVisible="{Binding HasError}" Foreground="{DynamicResource ClubErrorForeground}" TextWrapping="Wrap" /><StackPanel Orientation="Horizontal" Spacing="8"><Button Name="CancelDownloadButton" Content="{loc:Loc t05406efd909a359b}" Command="{Binding CancelCommand}" /><Button Name="RetryDownloadButton" Content="{loc:Loc t6bf755b50acb9ac7}" Command="{Binding RetryCommand}" /></StackPanel></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        </StackPanel>
      </Grid>
    </ScrollViewer>
    <Grid Grid.Column="1" IsVisible="{Binding ShowFullPageLoading}" Name="DownloadLoadingPage">
      <Border Classes="card" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="170" MaxWidth="300" Padding="22,18"><StackPanel Spacing="12" HorizontalAlignment="Center"><views:LoadingGlyph Foreground="{DynamicResource ClubAccent}"/><TextBlock Text="{Binding PageLoadingText}" FontSize="15" LineHeight="22" Foreground="{DynamicResource ClubAccent}" TextWrapping="Wrap" TextAlignment="Center"/><Button Name="CancelBrowseLoadingButton" Content="{loc:Loc t2cd0f3be8738a86c}" Command="{Binding CancelBrowseCommand}" Classes="flat" HorizontalAlignment="Center" FontSize="12"/></StackPanel></Border>
    </Grid>

  </Grid>
</UserControl>
