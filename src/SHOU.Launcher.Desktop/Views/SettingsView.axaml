<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="using:SHOU.Launcher.Desktop.Localization"
             xmlns:local="using:SHOU.Launcher.Desktop.Views" xmlns:views="using:SHOU.Launcher.Desktop.Views" x:Class="SHOU.Launcher.Desktop.Views.SettingsView" FontSize="13">
  <UserControl.Resources><local:SettingsPreferenceLabelConverter x:Key="PreferenceLabel" /><DataTemplate x:Key="GameChoiceTemplate"><TextBlock Text="{loc:Translate ., Converter={StaticResource PreferenceLabel}}" /></DataTemplate><DataTemplate x:Key="AboutCreditTemplate"><Grid ColumnDefinitions="44,12,*,Auto" Margin="8,8" ColumnSpacing="0"><Grid><Image Source="{Binding Portrait}" IsVisible="{Binding HasPortrait}" Width="36" Height="36"/><views:ClubIcon Kind="user" IsVisible="{Binding !HasPortrait}" Width="28" Height="28"/></Grid><StackPanel Grid.Column="2" Spacing="4" Margin="0,0,12,0"><TextBlock Text="{loc:Translate Name}" FontSize="15"/><TextBlock Text="{loc:Translate Description}" Classes="muted" TextWrapping="Wrap"/></StackPanel><Button Grid.Column="3" IsVisible="{Binding HasAction}" Content="{loc:Translate ActionLabel}" Command="{Binding OpenCommand}" VerticalAlignment="Center"/></Grid></DataTemplate></UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /></Style>
    <Style Selector="Border.card"><Setter Property="Padding" Value="15,12" /><Setter Property="CornerRadius" Value="6" /></Style>
    <Style Selector="Button.contextNavigation"><Setter Property="Height" Value="36" /><Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="Padding" Value="14,0" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="CornerRadius" Value="0" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Background" Value="Transparent" /></Style>
    <Style Selector="Button.contextNavigation.selected"><Setter Property="Foreground" Value="{DynamicResource ClubSelectionForeground}" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="{DynamicResource ClubSelectionForeground}" /><Setter Property="BorderThickness" Value="3,0,0,0" /><Setter Property="Padding" Value="11,0,14,0" /></Style>
    <Style Selector="TextBlock.contextHeading"><Setter Property="Margin" Value="13,9,0,4" /><Setter Property="FontSize" Value="12" /><Setter Property="Foreground" Value="{DynamicResource ClubMuted}" /></Style>
    <Style Selector="TextBlock.settingLabel"><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="Margin" Value="9,0,8,0" /></Style>
    <Style Selector="TextBlock.sectionTitle"><Setter Property="FontSize" Value="14" /><Setter Property="Margin" Value="0,0,0,5" /></Style>
    <Style Selector="Expander"><Setter Property="HorizontalAlignment" Value="Stretch" /></Style>
    <Style Selector="TextBlock.capability"><Setter Property="FontSize" Value="12" /><Setter Property="Foreground" Value="{DynamicResource ClubMuted}" /></Style>
    <Style Selector="Button.contextNavigation.selected TextBlock"><Setter Property="Foreground" Value="{DynamicResource ClubSelectionForeground}"/></Style>
    <Style Selector="Button.contextNavigation.selected:not(:disabled) /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="BorderBrush" Value="{DynamicResource ClubSelectionForeground}" /><Setter Property="BorderThickness" Value="3,0,0,0" /></Style>
  </UserControl.Styles>
  <Grid Name="SettingsLayout" ColumnDefinitions="135,*">
    <Border Name="SettingsContextNavigation" Background="{DynamicResource ClubSurface}" BorderBrush="{DynamicResource ClubBorder}" BorderThickness="0,0,1,0">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,6,0,12">
        <TextBlock Classes="contextHeading" Text="{loc:Loc t847c5f681ce955a0}" />
        <Button Name="SettingsLaunchNavigation" IsVisible="{Binding Root.VisibleFeatures[settings-launch]}" Classes="contextNavigation" Classes.selected="{Binding IsLaunchSection}" Command="{Binding SelectSectionCommand}" CommandParameter="launch">
          <Grid ColumnDefinitions="24,6,*"><views:ClubIcon Classes="contextIcon" Kind="rocket" /><TextBlock Grid.Column="2" Classes="navigationLabel" Text="{loc:Loc t56410fc65314dfb5}" VerticalAlignment="Center"  /></Grid>
        </Button>
        <Button Name="SettingsJavaNavigation" IsVisible="{Binding Root.VisibleFeatures[settings-java]}" Classes="contextNavigation" Classes.selected="{Binding IsJavaSection}" Command="{Binding SelectSectionCommand}" CommandParameter="java">
          <Grid ColumnDefinitions="24,6,*"><views:ClubIcon Classes="contextIcon" Kind="coffee" /><TextBlock Grid.Column="2" Classes="navigationLabel" Text="Java" VerticalAlignment="Center"  /></Grid>
        </Button>
        <Button Name="SettingsManageNavigation" IsVisible="{Binding Root.VisibleFeatures[settings-manage]}" Classes="contextNavigation" Classes.selected="{Binding IsManageSection}" Command="{Binding SelectSectionCommand}" CommandParameter="manage">
          <Grid ColumnDefinitions="24,6,*"><views:ClubIcon Classes="contextIcon" Kind="book-marked" /><TextBlock Grid.Column="2" Classes="navigationLabel" Text="{loc:Loc tbb6d995724f49a72}" VerticalAlignment="Center"  /></Grid>
        </Button>
        <TextBlock Classes="contextHeading" Text="{loc:Loc td6965cf52f76549a}" />
        <Button Name="SettingsAppearanceNavigation" IsVisible="{Binding Root.VisibleFeatures[settings-appearance]}" Classes="contextNavigation" Classes.selected="{Binding IsAppearanceSection}" Command="{Binding SelectSectionCommand}" CommandParameter="appearance">
          <Grid ColumnDefinitions="24,6,*"><views:ClubIcon Classes="contextIcon" Kind="palette" /><TextBlock Grid.Column="2" Classes="navigationLabel" Text="{loc:Loc t38c043e08502e710}" VerticalAlignment="Center"  /></Grid>
        </Button>
        <Button Name="SettingsLanguageNavigation" IsVisible="{Binding Root.VisibleFeatures[settings-language]}" Classes="contextNavigation" Classes.selected="{Binding IsLanguageSection}" Command="{Binding SelectSectionCommand}" CommandParameter="language">
          <Grid ColumnDefinitions="24,6,*"><views:ClubIcon Classes="contextIcon" Kind="earth" /><TextBlock Grid.Column="2" Classes="navigationLabel" Text="{loc:Loc t9f6fee1aba17a565}" VerticalAlignment="Center"  /></Grid>
        </Button>
        <Button Name="SettingsMiscNavigation" IsVisible="{Binding Root.VisibleFeatures[settings-misc]}" Classes="contextNavigation" Classes.selected="{Binding IsMiscSection}" Command="{Binding SelectSectionCommand}" CommandParameter="misc">
          <Grid ColumnDefinitions="24,6,*"><views:ClubIcon Classes="contextIcon" Kind="monitor-cog" /><TextBlock Grid.Column="2" Classes="navigationLabel" Text="{loc:Loc t887d938275c72602}" VerticalAlignment="Center"  /></Grid>
        </Button>
        <TextBlock Classes="contextHeading" Text="{loc:Loc t52d25a9e30ba94f1}" />
        <Button Name="SettingsAboutNavigation" IsVisible="{Binding Root.VisibleFeatures[settings-about]}" Classes="contextNavigation" Classes.selected="{Binding IsAboutSection}" Command="{Binding SelectSectionCommand}" CommandParameter="about">
          <Grid ColumnDefinitions="24,6,*"><views:ClubIcon Classes="contextIcon" Kind="info" /><TextBlock Grid.Column="2" Classes="navigationLabel" Text="{loc:Loc t0fe8acdee57bdb1f}" VerticalAlignment="Center"  /></Grid>
        </Button>
        <Button Name="SettingsUpdatesNavigation" IsVisible="{Binding Root.VisibleFeatures[settings-updates]}" Classes="contextNavigation" Classes.selected="{Binding IsUpdatesSection}" Command="{Binding SelectSectionCommand}" CommandParameter="updates">
          <Grid ColumnDefinitions="24,6,*"><views:ClubIcon Classes="contextIcon" Kind="refresh-cw" /><TextBlock Grid.Column="2" Classes="navigationLabel" Text="{loc:Loc t651f274470153a05}" VerticalAlignment="Center"  /></Grid>
        </Button>
        <Button Name="SettingsFeedbackNavigation" IsVisible="{Binding Root.VisibleFeatures[settings-feedback]}" Classes="contextNavigation" Classes.selected="{Binding IsFeedbackSection}" Command="{Binding SelectSectionCommand}" CommandParameter="feedback">
          <Grid ColumnDefinitions="24,6,*"><views:ClubIcon Classes="contextIcon" Kind="message-circle" /><TextBlock Grid.Column="2" Classes="navigationLabel" Text="{loc:Loc t8b2106ca13719cb2}" VerticalAlignment="Center"  /></Grid>
        </Button>
        <Button Name="SettingsLogsNavigation" IsVisible="{Binding Root.VisibleFeatures[settings-logs]}" Classes="contextNavigation" Classes.selected="{Binding IsLogsSection}" Command="{Binding SelectSectionCommand}" CommandParameter="logs">
          <Grid ColumnDefinitions="24,6,*"><views:ClubIcon Classes="contextIcon" Kind="scroll-text" /><TextBlock Grid.Column="2" Classes="navigationLabel" Text="{loc:Loc t6598755879490792}" VerticalAlignment="Center"  /></Grid>
        </Button>
      </StackPanel></ScrollViewer>
    </Border>
    <DockPanel Grid.Column="1">
      <ScrollViewer Name="SettingsPageScroller" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="14" Margin="24,24,24,8">
          <TextBlock Name="SettingsAutoSaveFeedback" Text="{loc:Translate AutoSaveFeedback}" IsVisible="{Binding HasAutoSaveFeedback}" Foreground="{DynamicResource ClubErrorForeground}" TextWrapping="Wrap"/>
          <StackPanel Name="LaunchSettingsSection" IsVisible="{Binding IsLaunchSection}" Spacing="14">
            <Border Classes="card"><StackPanel Spacing="9" IsEnabled="{Binding CanEdit}">
              <TextBlock Classes="sectionTitle" Text="{loc:Loc t8dd0655d53256a1f}" />
              <Grid ColumnDefinitions="118,*"><TextBlock Classes="settingLabel" Text="{loc:Loc t90fc54a0fbd0fbb8}" /><ComboBox Name="InstanceIsolationSetting" Grid.Column="1" ItemsSource="{Binding IsolationChoices}" SelectedItem="{Binding Isolation}" ItemTemplate="{StaticResource GameChoiceTemplate}" ToolTip.Tip="{loc:Loc t333b1712d7ed78bf}" /></Grid>
              <Grid ColumnDefinitions="118,*"><TextBlock Classes="settingLabel" Text="{loc:Loc tcd959f842f08bb65}" /><TextBox Name="GameWindowTitleSetting" Grid.Column="1" Text="{Binding GameTitle}" IsEnabled="{Binding CanCustomizeGameTitle}" PlaceholderText="{loc:Loc t41df7510d2775a1a}" ToolTip.Tip="{loc:Loc t9ae9aa477efccbc1}" /></Grid>
              <Grid ColumnDefinitions="118,*"><TextBlock Classes="settingLabel" Text="{loc:Loc tabc00290e88e742c}" /><TextBox Name="CustomInfoSetting" Grid.Column="1" Text="{Binding CustomInfo}" PlaceholderText="{loc:Loc tfd7131f788ac5cc5}" /></Grid>
              <Grid ColumnDefinitions="118,*"><TextBlock Classes="settingLabel" Text="{loc:Loc t87f5b03f0660fc3e}" /><ComboBox Name="LauncherVisibilitySetting" Grid.Column="1" ItemsSource="{Binding VisibilityChoices}" SelectedItem="{Binding Visibility}" ItemTemplate="{StaticResource GameChoiceTemplate}" /></Grid>
              <Grid ColumnDefinitions="118,*"><TextBlock Classes="settingLabel" Text="{loc:Loc t6dfa4ea7d8c811fd}" /><ComboBox Name="GamePrioritySetting" Grid.Column="1" ItemsSource="{Binding PriorityChoices}" SelectedItem="{Binding Priority}" ItemTemplate="{StaticResource GameChoiceTemplate}" /></Grid>
              <Grid ColumnDefinitions="118,*"><TextBlock Classes="settingLabel" Text="{loc:Loc tc3cc36f628b16596}" /><StackPanel Grid.Column="1" Spacing="6"><StackPanel Orientation="Horizontal" Spacing="14"><CheckBox Name="UseCustomWindowSetting" Content="{loc:Loc t4eafa9e925b30bcd}" IsChecked="{Binding UseCustomWindow}" /><CheckBox Name="GameFullscreenSetting" Content="{loc:Loc t22ea3f47fee80536}" IsChecked="{Binding GameFullscreen}" /></StackPanel><Grid IsVisible="{Binding UseCustomWindow}" ColumnDefinitions="*,20,*"><NumericUpDown Name="GameWindowWidthSetting" Value="{Binding GameWindowWidth}" Minimum="320" Maximum="16384" FormatString="0" /><TextBlock Grid.Column="1" Text="×" VerticalAlignment="Center" HorizontalAlignment="Center" /><NumericUpDown Name="GameWindowHeightSetting" Grid.Column="2" Value="{Binding GameWindowHeight}" Minimum="320" Maximum="16384" FormatString="0" /></Grid></StackPanel></Grid>
              <Grid ColumnDefinitions="118,*"><TextBlock Classes="settingLabel" Text="{loc:Loc t1eea28ef2a1611c7}" /><TextBlock Grid.Column="1" Text="{loc:Loc tc7579b98de9a840a}" VerticalAlignment="Center" MinHeight="28" /></Grid>
              <Grid ColumnDefinitions="118,*"><TextBlock Classes="settingLabel" Text="{loc:Loc t3f85718d9a70a26b}" /><ComboBox Name="GameIpPreferenceSetting" Grid.Column="1" ItemsSource="{Binding IpChoices}" SelectedItem="{Binding IpPreference}" ItemTemplate="{StaticResource GameChoiceTemplate}" /></Grid>
            </StackPanel></Border>
            <Border Classes="card"><StackPanel Spacing="8" IsEnabled="{Binding CanEdit}"><TextBlock Classes="sectionTitle" Text="{loc:Loc t75067b871c5a21ae}" ToolTip.Tip="{loc:Loc t77fe8531d263922b}" />
              <RadioButton Name="AutomaticMemorySetting" GroupName="MemoryMode" Content="{loc:Loc t83550872e202b15b}" IsChecked="{Binding AutomaticMemory}" Margin="9,0" />
              <RadioButton Name="CustomMemorySetting" GroupName="MemoryMode" Content="{loc:Loc t4eafa9e925b30bcd}" IsChecked="{Binding CustomMemory}" Margin="9,0" />
              <Grid ColumnDefinitions="140,*,140" IsEnabled="{Binding CustomMemory}"><TextBlock Classes="settingLabel" Text="{loc:Loc tf5d370fa5dfd1c7f}" /><Slider Grid.Column="1" Value="{Binding DisplayMemoryMiB}" Minimum="512" Maximum="32768" TickFrequency="256" IsSnapToTickEnabled="True" VerticalAlignment="Center" /><NumericUpDown Name="MaximumMemorySetting" Grid.Column="2" MinWidth="130" Value="{Binding DisplayMemoryMiB}" Minimum="512" Maximum="32768" Increment="256" FormatString="0" Margin="10,0,0,0" /></Grid>
              <Grid ColumnDefinitions="140,*"><TextBlock Classes="settingLabel" Text="{loc:Loc tbab6ef9ef8b6f431}" /><StackPanel Grid.Column="1" Spacing="5"><CheckBox Name="UseMinimumMemorySetting" Content="{loc:Loc t51cbd61f5f6ca602}" IsChecked="{Binding UseMinimumMemory}" /><NumericUpDown Name="MinimumMemorySetting" IsVisible="{Binding UseMinimumMemory}" Value="{Binding MinimumMemoryMiB}" Minimum="512" Maximum="32768" Increment="128" FormatString="0" /></StackPanel></Grid>
              <TextBlock Name="SystemMemorySummary" Text="{Binding SystemMemorySummary}" Classes="muted" Margin="9,0" /><ProgressBar Name="SystemMemoryUsage" Value="{Binding UsedMemoryPercent}" Maximum="100" Height="4" Margin="9,0" Foreground="{DynamicResource ClubAccent}" /><TextBlock Name="MemoryAllocationSummary" Text="{loc:Translate MemorySummary}" Foreground="{DynamicResource ClubAccent}" Margin="9,0" />
            </StackPanel></Border>
            <Border Classes="card"><Expander Header="{loc:Loc tf9991a30a894a021}"><StackPanel Margin="8,10" Spacing="8"><Grid ColumnDefinitions="118,*"><TextBlock Classes="settingLabel" Text="{loc:Loc t5eea85049ec9d7ce}" /><ComboBox Grid.Column="1" IsEnabled="False" PlaceholderText="{loc:Loc t00e24be033f5005f}"  ToolTip.Tip="{loc:Loc t3b863b9361682509}"/></Grid><TextBlock Classes="label" Text="{loc:Loc tc9173ee83b6a7e8c}" /><TextBox Name="JvmArgumentsSetting" Text="{Binding JvmArguments}" IsEnabled="{Binding CanEdit}" ToolTip.Tip="{loc:Loc tfebb5a932e21b5eb}" AcceptsReturn="True" MinHeight="78" /><Grid ColumnDefinitions="118,*"><TextBlock Classes="settingLabel" Text="{loc:Loc t50509f2f2741a776}" /><TextBox Name="GameArgumentsSetting" Grid.Column="1" Text="{Binding GameArguments}" IsEnabled="{Binding CanEdit}" ToolTip.Tip="{loc:Loc tb0cb1125219c82b5}" /></Grid><Grid ColumnDefinitions="118,*"><TextBlock Classes="settingLabel" Text="{loc:Loc tb46fa9936f0c2ef4}" /><TextBox Name="BeforeLaunchExecutableSetting" Grid.Column="1" Text="{Binding BeforeLaunchExecutable}" IsEnabled="{Binding CanEdit}" ToolTip.Tip="{loc:Loc td54704d887666fc3}" /></Grid><Grid ColumnDefinitions="118,*"><TextBlock Classes="settingLabel" Text="{loc:Loc t96cce502c0bf0fee}" /><TextBox Name="BeforeLaunchArgumentsSetting" Grid.Column="1" Text="{Binding BeforeLaunchArguments}" IsEnabled="{Binding CanEdit}" /></Grid><CheckBox IsEnabled="False" Content="{loc:Loc tb67c8dc9b5108377}" /><CheckBox IsEnabled="False" Content="{loc:Loc ta4ac6f2b9461508e}" /><CheckBox IsEnabled="False" Content="{loc:Loc tc14354ebc33a17bb}" /><CheckBox IsEnabled="False" Content="{loc:Loc t9e61db66bd99366b}" /><CheckBox IsEnabled="False" Content="{loc:Loc t70aac975eb3883d0}" /><CheckBox IsEnabled="False" Content="{loc:Loc tbac6d69c75030d00}" /><CheckBox Name="LockMemorySetting" Content="{loc:Loc ta5faf266c2bf4bd1}" IsChecked="{Binding LockMemory}" /></StackPanel></Expander></Border>
          </StackPanel>
          <StackPanel Name="JavaSettingsSection" IsVisible="{Binding IsJavaSection}" Spacing="14">
            <Border Classes="card"><StackPanel Spacing="8"><DockPanel><views:LoadingGlyph DockPanel.Dock="Right" Width="24" Height="24" IsVisible="{Binding IsLauncherBusy}"/><TextBlock Classes="sectionTitle" Text="{loc:Loc t43620c97105740c8}"  ToolTip.Tip="{loc:Loc t183725f0b131915a}"/></DockPanel><TextBlock Name="CurrentJavaSelectionSummary" Text="{loc:Translate JavaSelectionSummary}" FontWeight="SemiBold" />

              <Grid ColumnDefinitions="*,Auto"><TextBox Name="GlobalJavaExecutableSetting" Text="{Binding JavaExecutable}" PlaceholderText="{loc:Loc t88b02b0b6281fb23}" IsEnabled="{Binding CanEdit}" /><Button Grid.Column="1" Content="{loc:Loc t16242928cc42a717}" Click="PickJava_Click" Margin="8,0,0,0" IsEnabled="{Binding CanEdit}" /></Grid>
              <WrapPanel><Button Content="{loc:Loc t0d71b2213b336f25}" Command="{Binding UseAutomaticJavaCommand}" Margin="0,3,8,3" /><Button Content="{loc:Loc t9c584b2a81873930}" Command="{Binding DiscoverJavaCommand}" Margin="0,3,8,3" /></WrapPanel>
            </StackPanel></Border>
            <Border Classes="card"><Expander Header="{loc:Translate DiscoveredJavaTitle}"><StackPanel Spacing="8" Margin="8,10"><ListBox Name="SettingsJavaSelector" ItemsSource="{Binding JavaInstallations}" SelectedItem="{Binding SelectedJava}" MaxHeight="210"><ListBox.ItemTemplate><DataTemplate><StackPanel Spacing="2" Margin="2,4"><TextBlock Text="{Binding FullVersion}" FontWeight="SemiBold" /><WrapPanel><TextBlock Text="{Binding Vendor}" Classes="muted" Margin="0,0,8,0"/><TextBlock Text="{loc:Translate RuntimeArchitecture, Converter={StaticResource PreferenceLabel}}" Classes="muted"/></WrapPanel><TextBlock Text="{Binding ExecutablePath}" Classes="muted" LineHeight="18" FontSize="12" /><TextBlock Text="{loc:Translate Source, Converter={StaticResource PreferenceLabel}}" Classes="muted" LineHeight="16" FontSize="11" /></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><Button Content="{loc:Loc t238772bfd1b0ebf5}" Command="{Binding UseSelectedJavaCommand}" /></StackPanel></Expander></Border>
            <Border Name="JavaSelectionConflictPanel" Classes="card" IsVisible="{Binding HasJavaSelectionConflict}"><StackPanel Spacing="8"><TextBlock Text="{loc:Loc t0cc79543609929dc}" Classes="sectionTitle" /><TextBlock Text="{loc:Loc t6400aabc00f964f4}" /><SelectableTextBlock Text="{Binding SavedJavaSelection}" TextWrapping="Wrap" /><TextBlock Text="{loc:Loc t3243d28fbdc5937a}" Classes="muted" /><WrapPanel><Button Name="UseSavedJavaSelectionButton" Content="{loc:Loc t6b43c116c5d6b350}" Command="{Binding UseSavedJavaSelectionCommand}" Margin="0,0,10,0" /><Button Name="KeepJavaDraftButton" Content="{loc:Loc t7127277219f30299}" Command="{Binding KeepJavaDraftCommand}" /></WrapPanel></StackPanel></Border>
            <Button Name="OpenJavaTrustToolsButton" Content="{loc:Loc td731ef0e7fd6bc2b}" Command="{Binding OpenJavaTrustToolsCommand}" HorizontalAlignment="Left" />
          </StackPanel>
          <StackPanel Name="ManageSettingsSection" IsVisible="{Binding IsManageSection}" Spacing="14">
            <Border Classes="card"><StackPanel Spacing="9" IsEnabled="{Binding CanEdit}"><TextBlock Classes="sectionTitle" Text="{loc:Loc t28447a978045e72d}" ToolTip.Tip="{loc:Loc tae7548c9c2ef3e7f}" />
              <Grid ColumnDefinitions="130,*"><TextBlock Classes="settingLabel" Text="{loc:Loc t294a1ac5cd9ffa49}" /><ComboBox Name="DownloadSourcePreferenceSetting" Grid.Column="1" ItemsSource="{Binding SourcePreferenceChoices}" SelectedItem="{Binding SourcePreference}" ItemTemplate="{StaticResource GameChoiceTemplate}" /></Grid>
              <Grid ColumnDefinitions="130,*"><TextBlock Classes="settingLabel" Text="{loc:Loc tea5763857dc4580e}" /><CheckBox Name="PreferOfficialCatalogSetting" Grid.Column="1" Content="{loc:Loc td095e4ae28cbd58d}" IsChecked="{Binding PreferOfficialCatalog}" /></Grid>
              <Grid ColumnDefinitions="130,*"><TextBlock Classes="settingLabel" Text="{loc:Loc t95290f113039e4e8}" /><CheckBox Name="HttpsOnlySetting" Grid.Column="1" Content="{loc:Loc t48c0b7fb7feac616}" IsChecked="{Binding HttpsOnly}" ToolTip.Tip="{loc:Loc tb0c53f9de9c6e6cc}" /></Grid>
              <Grid ColumnDefinitions="130,*,95"><TextBlock Classes="settingLabel" Text="{loc:Loc t3dfb1049a37f1fa2}" /><Slider Grid.Column="1" Value="{Binding MaximumConnections}" Minimum="1" Maximum="64" TickFrequency="1" IsSnapToTickEnabled="True" /><NumericUpDown Name="DownloadConnectionsSetting" Grid.Column="2" Value="{Binding MaximumConnections}" Minimum="1" Maximum="64" FormatString="0" Margin="8,0,0,0" /></Grid>
              <Grid ColumnDefinitions="130,*"><TextBlock Classes="settingLabel" Text="{loc:Loc te604577bf629c51d}" /><NumericUpDown Name="DownloadSpeedSetting" Grid.Column="1" Value="{Binding MaximumKiBPerSecond}" Minimum="0" Maximum="1048576" Increment="256" FormatString="0" ToolTip.Tip="{loc:Loc t50ea92c5c6824e17}" /></Grid>
              <CheckBox Name="SelectInstalledInstanceSetting" Content="{loc:Loc ta0e12a3c655398f1}" IsChecked="{Binding SelectInstalledInstance}" Margin="9,0" />
              <Grid ColumnDefinitions="130,*"><TextBlock Classes="settingLabel" Text="{loc:Loc t860e2c49d628b5cc}" /><Grid Grid.Column="1" ColumnDefinitions="*,Auto"><TextBox Name="GameRootSetting" Text="{Binding GameRoot}" PlaceholderText="{loc:Loc t692bd6062260efc9}" /><Button Grid.Column="1" Content="{loc:Loc t0617557e7bbc153d}" Click="PickGameRoot_Click" Margin="8,0,0,0" /></Grid></Grid>

            </StackPanel></Border>
            <Border Classes="card"><StackPanel Spacing="9" IsEnabled="{Binding CanEdit}"><TextBlock Classes="sectionTitle" Text="{loc:Loc t258118497e278bf1}" ToolTip.Tip="{loc:Loc t316504774a90e71b}" /><CheckBox Name="UseCustomDownloadSourcesSetting" Content="{loc:Loc t68a317bb52086bfd}" IsChecked="{Binding UseCustomSources}" /><TextBlock Text="{Binding SourceEditorSummary}" Classes="status muted" />
              <UniformGrid Columns="3"><Button Content="{loc:Loc t49336686595ee9ff}" Command="{Binding SelectSourceCategoryCommand}" CommandParameter="Minecraft" Classes.selected="{Binding IsMinecraftSources}" HorizontalAlignment="Stretch" /><Button Content="{loc:Loc t43c212a5e3442086}" Command="{Binding SelectSourceCategoryCommand}" CommandParameter="Mod" Classes.selected="{Binding IsModSources}" HorizontalAlignment="Stretch" Margin="5,0" /><Button Content="Mod Loader" Command="{Binding SelectSourceCategoryCommand}" CommandParameter="Loader" Classes.selected="{Binding IsLoaderSources}" HorizontalAlignment="Stretch" /></UniformGrid>
              <ListBox Name="DownloadSourceSelector" ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}" MaxHeight="190"><ListBox.ItemTemplate><DataTemplate><Grid ColumnDefinitions="Auto,*" Margin="3,3"><CheckBox IsChecked="{Binding Enabled}" Margin="0,0,7,0" /><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" /><TextBlock Text="{Binding BaseUrl}" Classes="muted" LineHeight="16" FontSize="11" /></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
              <WrapPanel><Button Content="{loc:Loc tf853a70b120418be}" Command="{Binding MoveSourceUpCommand}" Margin="0,0,6,4" /><Button Content="{loc:Loc te75e8b4e5c971227}" Command="{Binding MoveSourceDownCommand}" Margin="0,0,6,4" /><Button Content="{loc:Loc t1b93e0c54996e98c}" Command="{Binding AddSourceCommand}" Margin="0,0,6,4" /><Button Content="{loc:Loc teb7fbeb35a4d44d0}" Command="{Binding RemoveSourceCommand}" Margin="0,0,6,4" /><Button Content="{loc:Loc tba2e93e73037c71e}" Command="{Binding ResetSourcesCommand}" Margin="0,0,6,4" /></WrapPanel>
              <Expander Header="{loc:Loc t4dfd07a6a8cdf83a}" IsVisible="{Binding HasSelectedSource}"><StackPanel DataContext="{Binding SelectedSource}" Spacing="7" Margin="8,10"><Grid ColumnDefinitions="86,*"><TextBlock Classes="settingLabel" Text="{loc:Loc tf5a07dbcfaad08aa}"  ToolTip.Tip="{loc:Loc tc994d898f007ab95}"/><TextBox Grid.Column="1" Text="{Binding Name}" /></Grid><Grid ColumnDefinitions="86,*"><TextBlock Classes="settingLabel" Text="{loc:Loc t38e1e77b3ef39016}" /><ComboBox Grid.Column="1" ItemsSource="{Binding LayoutChoices}" SelectedItem="{Binding Layout}" /></Grid><Grid ColumnDefinitions="86,*" IsVisible="{Binding IsAddressEditable}"><TextBlock Classes="settingLabel" Text="{loc:Loc tb1968db970026087}" /><TextBox Grid.Column="1" Text="{Binding BaseUrl}" /></Grid><Grid ColumnDefinitions="86,*" IsVisible="{Binding IsPrefix}"><TextBlock Classes="settingLabel" Text="{loc:Loc t866ffdbfc224214b}" /><TextBox Grid.Column="1" Text="{Binding OriginPrefix}" /></Grid><Grid ColumnDefinitions="86,*"><TextBlock Classes="settingLabel" Text="{loc:Loc t565d64601d4d174f}" /><NumericUpDown Grid.Column="1" Value="{Binding Priority}" Minimum="0" Maximum="10000" FormatString="0" /></Grid></StackPanel></Expander>
              <Expander Header="{loc:Loc tf63270e872062f0e}"><TextBox Name="DownloadSourcesSetting" Text="{Binding DownloadSourcesJson}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="130" Margin="8,10" PlaceholderText="{loc:Loc ta3e6c2a7d284a679}" /></Expander>
            </StackPanel></Border>
            <Border Classes="card"><StackPanel Spacing="8"><TextBlock Classes="sectionTitle" Text="{loc:Loc t7605b03f359674ca}"  ToolTip.Tip="{loc:Loc tf61eb0b7e86ac239}"/><StackPanel Spacing="8" IsEnabled="False"><Grid ColumnDefinitions="130,*"><TextBlock Classes="settingLabel" Text="{loc:Loc td343ee3cdcd01563}" /><ComboBox Grid.Column="1" PlaceholderText="{loc:Loc t49d444fc81195b19}" /></Grid><Grid ColumnDefinitions="130,*"><TextBlock Classes="settingLabel" Text="{loc:Loc ta81c476b36158de7}" /><ComboBox Grid.Column="1" PlaceholderText="{loc:Loc t0bb652a958ecc6a0}" /></Grid><CheckBox Content="{loc:Loc t262aba8abbc29843}" /><CheckBox Content="{loc:Loc t808c417cbe281fb4}" /></StackPanel></StackPanel></Border>
            <Border Classes="card"><StackPanel Spacing="8"><TextBlock Classes="sectionTitle" Text="{loc:Loc tb8f88aeead1520c8}"  ToolTip.Tip="{loc:Loc t10d062fa5e2f3d3d}"/><StackPanel IsEnabled="False" Spacing="6"><StackPanel Orientation="Horizontal" Spacing="16"><CheckBox Content="{loc:Loc tdfe304b06f22b322}" /><CheckBox Content="{loc:Loc t78dc05c3affaba2e}" /></StackPanel><CheckBox Content="{loc:Loc te1f3694014dd30ae}" /></StackPanel></StackPanel></Border>
            <Border Classes="card"><StackPanel Spacing="8" IsEnabled="{Binding CanEdit}">
              <TextBlock Name="Aria2SectionTitle" Classes="sectionTitle" Text="Aria2 下载引擎" ToolTip.Tip="连接失败或产物校验失败时回退内部下载器，并显示实际后端。"/>
              <CheckBox Content="优先使用已启动的 Aria2" IsChecked="{Binding Aria2Enabled}"/>
              <TextBlock Text="请先在 aria2 或 GUI 软件中开启 RPC。启动器按端口连接，不负责查找、安装或启动外部程序。" Classes="muted" TextWrapping="Wrap"/>
              <TextBlock Text="本机 RPC 地址" Classes="label"/>
              <TextBox Name="Aria2EndpointSetting" Text="{Binding Aria2Endpoint}" PlaceholderText="http://localhost:6800/jsonrpc"/>
              <TextBlock Text="RPC 密钥（服务未设置则留空）" Classes="label"/>
              <TextBox Name="Aria2SecretSetting" Text="{Binding Aria2Secret, UpdateSourceTrigger=LostFocus}" PasswordChar="●"/>
              <TextBlock Text="{loc:Translate CredentialsSummary}" Classes="muted" TextWrapping="Wrap"/>
              <Button Name="TestAria2ConnectionButton" Content="测试连接" Command="{Binding TestAria2ConnectionCommand}" HorizontalAlignment="Left"/>
              <TextBlock Name="Aria2ConnectionStatus" Text="{Binding Aria2ConnectionSummary}" TextWrapping="Wrap" Classes="muted"/>
            </StackPanel></Border>
