<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:SHOU.Launcher.Desktop.Views" xmlns:views="using:SHOU.Launcher.Desktop.Views" x:Class="SHOU.Launcher.Desktop.Views.SettingsView" FontSize="13">
  <UserControl.Resources><local:SettingsPreferenceLabelConverter x:Key="PreferenceLabel" /></UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /></Style>
    <Style Selector="Border.card"><Setter Property="Padding" Value="15,12" /><Setter Property="CornerRadius" Value="6" /></Style>
    <Style Selector="Button.contextNavigation"><Setter Property="Height" Value="36" /><Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="Padding" Value="14,0" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /><Setter Property="CornerRadius" Value="0" /><Setter Property="BorderThickness" Value="0" /><Setter Property="Background" Value="Transparent" /></Style>
    <Style Selector="Button.contextNavigation.selected"><Setter Property="Foreground" Value="{DynamicResource ClubSelectionForeground}" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderBrush" Value="{DynamicResource ClubSelectionForeground}" /><Setter Property="BorderThickness" Value="3,0,0,0" /><Setter Property="Padding" Value="11,0,14,0" /></Style>
    <Style Selector="TextBlock.contextHeading"><Setter Property="Margin" Value="13,9,0,4" /><Setter Property="FontSize" Value="12" /><Setter Property="Foreground" Value="{DynamicResource ClubMuted}" /></Style>
    <Style Selector="TextBlock.settingLabel"><Setter Property="VerticalAlignment" Value="Center" /><Setter Property="Margin" Value="9,0,8,0" /></Style>
    <Style Selector="TextBlock.sectionTitle"><Setter Property="FontSize" Value="14" /><Setter Property="Margin" Value="0,0,0,5" /></Style>
    <Style Selector="Expander"><Setter Property="HorizontalAlignment" Value="Stretch" /></Style>
    <Style Selector="TextBlock.capability"><Setter Property="FontSize" Value="12" /><Setter Property="Foreground" Value="{DynamicResource ClubMuted}" /></Style>
    <Style Selector="Button.contextNavigation.selected TextBlock"><Setter Property="Foreground" Value="{DynamicResource ClubSelectionForeground}"/></Style>
  </UserControl.Styles>
  <Grid ColumnDefinitions="135,*">
    <Border Name="SettingsContextNavigation" Background="{DynamicResource ClubSurface}" BorderBrush="{DynamicResource ClubBorder}" BorderThickness="0,0,1,0">
      <ScrollViewer HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="0,6,0,12">
        <TextBlock Classes="contextHeading" Text="游戏" />
        <Button Name="SettingsLaunchNavigation" Classes="contextNavigation" Classes.selected="{Binding IsLaunchSection}" Command="{Binding SelectSectionCommand}" CommandParameter="launch">
          <Grid ColumnDefinitions="24,6,*"><views:ClubIcon Classes="contextIcon" Kind="rocket" /><TextBlock Grid.Column="2" Classes="navigationLabel" Text="启动" VerticalAlignment="Center"  /></Grid>
        </Button>
        <Button Name="SettingsJavaNavigation" Classes="contextNavigation" Classes.selected="{Binding IsJavaSection}" Command="{Binding SelectSectionCommand}" CommandParameter="java">
          <Grid ColumnDefinitions="24,6,*"><views:ClubIcon Classes="contextIcon" Kind="coffee" /><TextBlock Grid.Column="2" Classes="navigationLabel" Text="Java" VerticalAlignment="Center"  /></Grid>
        </Button>
        <Button Name="SettingsManageNavigation" Classes="contextNavigation" Classes.selected="{Binding IsManageSection}" Command="{Binding SelectSectionCommand}" CommandParameter="manage">
          <Grid ColumnDefinitions="24,6,*"><views:ClubIcon Classes="contextIcon" Kind="book-marked" /><TextBlock Grid.Column="2" Classes="navigationLabel" Text="管理" VerticalAlignment="Center"  /></Grid>
        </Button>
        <TextBlock Classes="contextHeading" Text="启动器" />
        <Button Name="SettingsAppearanceNavigation" Classes="contextNavigation" Classes.selected="{Binding IsAppearanceSection}" Command="{Binding SelectSectionCommand}" CommandParameter="appearance">
          <Grid ColumnDefinitions="24,6,*"><views:ClubIcon Classes="contextIcon" Kind="palette" /><TextBlock Grid.Column="2" Classes="navigationLabel" Text="个性化" VerticalAlignment="Center"  /></Grid>
        </Button>
        <Button Name="SettingsLanguageNavigation" Classes="contextNavigation" Classes.selected="{Binding IsLanguageSection}" Command="{Binding SelectSectionCommand}" CommandParameter="language">
          <Grid ColumnDefinitions="24,6,*"><views:ClubIcon Classes="contextIcon" Kind="earth" /><TextBlock Grid.Column="2" Classes="navigationLabel" Text="语言" VerticalAlignment="Center"  /></Grid>
        </Button>
        <Button Name="SettingsMiscNavigation" Classes="contextNavigation" Classes.selected="{Binding IsMiscSection}" Command="{Binding SelectSectionCommand}" CommandParameter="misc">
          <Grid ColumnDefinitions="24,6,*"><views:ClubIcon Classes="contextIcon" Kind="monitor-cog" /><TextBlock Grid.Column="2" Classes="navigationLabel" Text="杂项" VerticalAlignment="Center"  /></Grid>
        </Button>
        <TextBlock Classes="contextHeading" Text="关于" />
        <Button Name="SettingsAboutNavigation" Classes="contextNavigation" Classes.selected="{Binding IsAboutSection}" Command="{Binding SelectSectionCommand}" CommandParameter="about">
          <Grid ColumnDefinitions="24,6,*"><views:ClubIcon Classes="contextIcon" Kind="info" /><TextBlock Grid.Column="2" Classes="navigationLabel" Text="软件信息" VerticalAlignment="Center"  /></Grid>
        </Button>
        <Button Name="SettingsUpdatesNavigation" Classes="contextNavigation" Classes.selected="{Binding IsUpdatesSection}" Command="{Binding SelectSectionCommand}" CommandParameter="updates">
          <Grid ColumnDefinitions="24,6,*"><views:ClubIcon Classes="contextIcon" Kind="refresh-cw" /><TextBlock Grid.Column="2" Classes="navigationLabel" Text="软件更新" VerticalAlignment="Center"  /></Grid>
        </Button>
        <Button Name="SettingsFeedbackNavigation" Classes="contextNavigation" Classes.selected="{Binding IsFeedbackSection}" Command="{Binding SelectSectionCommand}" CommandParameter="feedback">
          <Grid ColumnDefinitions="24,6,*"><views:ClubIcon Classes="contextIcon" Kind="message-circle" /><TextBlock Grid.Column="2" Classes="navigationLabel" Text="反馈" VerticalAlignment="Center"  /></Grid>
        </Button>
        <Button Name="SettingsLogsNavigation" Classes="contextNavigation" Classes.selected="{Binding IsLogsSection}" Command="{Binding SelectSectionCommand}" CommandParameter="logs">
          <Grid ColumnDefinitions="24,6,*"><views:ClubIcon Classes="contextIcon" Kind="scroll-text" /><TextBlock Grid.Column="2" Classes="navigationLabel" Text="查看日志" VerticalAlignment="Center"  /></Grid>
        </Button>
      </StackPanel></ScrollViewer>
    </Border>
    <DockPanel Grid.Column="1">
      <Border Name="SettingsSaveBar" DockPanel.Dock="Bottom" Background="{DynamicResource ClubSurface}" BorderBrush="{DynamicResource ClubBorder}" BorderThickness="0,1,0,0" Padding="0,3,0,0" Margin="24,2,24,4">
        <Grid ColumnDefinitions="*,Auto">
          <StackPanel VerticalAlignment="Center" Margin="0,0,10,0"><TextBlock Name="SettingsDraftStatus" IsVisible="{Binding IsDirty}" Text="{Binding SaveSummary}" ToolTip.Tip="{Binding SaveSummary}" Classes="muted" LineHeight="16" FontSize="11" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Feedback}" ToolTip.Tip="{Binding Feedback}" Classes="status muted" LineHeight="14" FontSize="10" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" /></StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8"><Button Name="SaveSettingsButton" Classes="primary" Content="保存设置" Command="{Binding SaveCommand}" /><Button Name="DiscardSettingsButton" Content="放弃草稿" Command="{Binding DiscardDraftCommand}" /></StackPanel>
        </Grid>
      </Border>
      <ScrollViewer Name="SettingsPageScroller" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Spacing="14" Margin="24,24,24,8">
          <StackPanel Name="LaunchSettingsSection" IsVisible="{Binding IsLaunchSection}" Spacing="14">
            <Border Classes="card"><StackPanel Spacing="9" IsEnabled="{Binding CanEdit}">
              <TextBlock Classes="sectionTitle" Text="启动选项" ToolTip.Tip="实例独立目录与设备代码授权已启用。窗口标题、启动器隐藏、优先级与 IP 偏好尚未接入。" />
              <Grid ColumnDefinitions="118,*"><TextBlock Classes="settingLabel" Text="默认实例隔离" /><ComboBox Grid.Column="1" IsEnabled="False" SelectedIndex="0"><ComboBoxItem Content="隔离所有实例" /></ComboBox></Grid>
              <Grid ColumnDefinitions="118,*"><TextBlock Classes="settingLabel" Text="游戏窗口标题" /><ComboBox Grid.Column="1" IsEnabled="False" PlaceholderText="使用游戏默认标题" /></Grid>
              <Grid ColumnDefinitions="118,*"><TextBlock Classes="settingLabel" Text="自定义信息" /><TextBox Name="CustomInfoSetting" Grid.Column="1" Text="{Binding CustomInfo}" PlaceholderText="显示为游戏版本类型" /></Grid>
              <Grid ColumnDefinitions="118,*"><TextBlock Classes="settingLabel" Text="启动器可见性" /><ComboBox Grid.Column="1" IsEnabled="False" PlaceholderText="游戏启动后仍保持不变" /></Grid>
              <Grid ColumnDefinitions="118,*"><TextBlock Classes="settingLabel" Text="进程优先级" /><ComboBox Grid.Column="1" IsEnabled="False" PlaceholderText="系统默认" /></Grid>
              <Grid ColumnDefinitions="118,*"><TextBlock Classes="settingLabel" Text="窗口大小" /><StackPanel Grid.Column="1" Spacing="6"><StackPanel Orientation="Horizontal" Spacing="14"><CheckBox Name="UseCustomWindowSetting" Content="自定义" IsChecked="{Binding UseCustomWindow}" /><CheckBox Name="GameFullscreenSetting" Content="全屏" IsChecked="{Binding GameFullscreen}" /></StackPanel><Grid IsVisible="{Binding UseCustomWindow}" ColumnDefinitions="*,20,*"><NumericUpDown Name="GameWindowWidthSetting" Value="{Binding GameWindowWidth}" Minimum="320" Maximum="16384" FormatString="0" /><TextBlock Grid.Column="1" Text="×" VerticalAlignment="Center" HorizontalAlignment="Center" /><NumericUpDown Name="GameWindowHeightSetting" Grid.Column="2" Value="{Binding GameWindowHeight}" Minimum="320" Maximum="16384" FormatString="0" /></Grid></StackPanel></Grid>
              <Grid ColumnDefinitions="118,*"><TextBlock Classes="settingLabel" Text="正版验证方式" /><ComboBox Grid.Column="1" IsEnabled="False" SelectedIndex="0"><ComboBoxItem Content="设备代码流" /></ComboBox></Grid>
              <Grid ColumnDefinitions="118,*"><TextBlock Classes="settingLabel" Text="IP 协议偏好" /><ComboBox Grid.Column="1" IsEnabled="False" PlaceholderText="Java 默认" /></Grid>
            </StackPanel></Border>
            <Border Classes="card"><StackPanel Spacing="8" IsEnabled="{Binding CanEdit}"><TextBlock Classes="sectionTitle" Text="游戏内存" />
              <TextBlock Text="自定义最大内存；实例自己的内存设置优先。" Classes="muted" />
              <Grid ColumnDefinitions="118,*,140"><TextBlock Classes="settingLabel" Text="最大内存（-Xmx）" /><Slider Grid.Column="1" Value="{Binding MemoryMiB}" Minimum="512" Maximum="32768" TickFrequency="256" IsSnapToTickEnabled="True" VerticalAlignment="Center" /><NumericUpDown Name="MaximumMemorySetting" Grid.Column="2" MinWidth="130" Value="{Binding MemoryMiB}" Minimum="512" Maximum="32768" Increment="256" FormatString="0" Margin="10,0,0,0" /></Grid>
              <Grid ColumnDefinitions="118,*"><TextBlock Classes="settingLabel" Text="初始内存（-Xms）" /><StackPanel Grid.Column="1" Spacing="5"><CheckBox Name="UseMinimumMemorySetting" Content="指定初始内存" IsChecked="{Binding UseMinimumMemory}" /><NumericUpDown Name="MinimumMemorySetting" IsVisible="{Binding UseMinimumMemory}" Value="{Binding MinimumMemoryMiB}" Minimum="128" Maximum="32768" Increment="128" FormatString="0" /></StackPanel></Grid>
              <Border Background="{DynamicResource ClubSelection}" Height="4" Margin="9,4" /><TextBlock Name="MemoryAllocationSummary" Text="{Binding MemorySummary}" Foreground="{DynamicResource ClubAccent}" Margin="9,0" />
            </StackPanel></Border>
            <Border Classes="card"><Expander Header="高级启动设置"><StackPanel Margin="8,10" Spacing="8"><Grid ColumnDefinitions="118,*"><TextBlock Classes="settingLabel" Text="渲染器" /><ComboBox Grid.Column="1" IsEnabled="False" PlaceholderText="游戏默认"  ToolTip.Tip="任意参数、预执行命令和校验开关暂不可用；当前启动使用经过验证的参数与引导链。"/></Grid><TextBlock Classes="label" Text="JVM 参数头部" /><TextBox Name="UnsupportedJvmArgumentsSetting" IsEnabled="False" PlaceholderText="由受保护的启动计划生成" AcceptsReturn="True" MinHeight="78" /><Grid ColumnDefinitions="118,*"><TextBlock Classes="settingLabel" Text="游戏参数尾部" /><TextBox Grid.Column="1" IsEnabled="False" /></Grid><Grid ColumnDefinitions="118,*"><TextBlock Classes="settingLabel" Text="启动前执行命令" /><TextBox Grid.Column="1" IsEnabled="False" /></Grid><CheckBox IsEnabled="False" Content="禁用 Java Launch Wrapper" /><CheckBox IsEnabled="False" Content="禁用 LegacyFix" /><CheckBox IsEnabled="False" Content="要求 Java 使用高性能显卡" /><CheckBox IsEnabled="False" Content="使用 java.exe 而不是 javaw.exe" /><CheckBox IsEnabled="False" Content="禁用 LWJGL Unsafe Agent" /><CheckBox IsEnabled="False" Content="禁用自动崩溃分析" /><CheckBox IsEnabled="False" Content="锁定内存分配（-Xms = -Xmx）" /></StackPanel></Expander></Border>
          </StackPanel>
          <StackPanel Name="JavaSettingsSection" IsVisible="{Binding IsJavaSection}" Spacing="14">
            <Border Classes="card"><StackPanel Spacing="8"><TextBlock Classes="sectionTitle" Text="当前 Java"  ToolTip.Tip="启动游戏时按实例要求选择兼容版本。全局选择可被实例单独设置覆盖。"/><TextBlock Name="CurrentJavaSelectionSummary" Text="{Binding JavaSelectionSummary}" FontWeight="SemiBold" />

              <Grid ColumnDefinitions="*,Auto"><TextBox Name="GlobalJavaExecutableSetting" Text="{Binding JavaExecutable}" PlaceholderText="留空自动选择" IsEnabled="{Binding CanEdit}" /><Button Grid.Column="1" Content="添加…" Click="PickJava_Click" Margin="8,0,0,0" IsEnabled="{Binding CanEdit}" /></Grid>
              <WrapPanel><Button Content="使用自动选择" Command="{Binding UseAutomaticJavaCommand}" Margin="0,3,8,3" /><Button Content="重新发现 Java" Command="{Binding DiscoverJavaCommand}" Margin="0,3,8,3" /></WrapPanel>
            </StackPanel></Border>
            <Border Classes="card"><Expander Header="{Binding DiscoveredJavaTitle}"><StackPanel Spacing="8" Margin="8,10"><ListBox Name="SettingsJavaSelector" ItemsSource="{Binding JavaInstallations}" SelectedItem="{Binding SelectedJava}" MaxHeight="210"><ListBox.ItemTemplate><DataTemplate><StackPanel Spacing="2" Margin="2,4"><TextBlock Text="{Binding FullVersion}" FontWeight="SemiBold" /><TextBlock Text="{Binding ExecutablePath}" Classes="muted" LineHeight="18" FontSize="12" /><TextBlock Text="{Binding Source}" Classes="muted" LineHeight="16" FontSize="11" /></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><Button Content="选用此 Java" Command="{Binding UseSelectedJavaCommand}" /></StackPanel></Expander></Border>
            <Border Name="JavaSelectionConflictPanel" Classes="card" IsVisible="{Binding HasJavaSelectionConflict}"><StackPanel Spacing="8"><TextBlock Text="默认 Java 已在工具页更新" Classes="sectionTitle" /><TextBlock Text="已保存的选择：" /><SelectableTextBlock Text="{Binding SavedJavaSelection}" TextWrapping="Wrap" /><TextBlock Text="当前 Java 草稿已保留。保存其它设置前，请选择要使用的 Java。" Classes="muted" /><WrapPanel><Button Name="UseSavedJavaSelectionButton" Content="使用已保存的选择" Command="{Binding UseSavedJavaSelectionCommand}" Margin="0,0,10,0" /><Button Name="KeepJavaDraftButton" Content="保留我的 Java 草稿" Command="{Binding KeepJavaDraftCommand}" /></WrapPanel></StackPanel></Border>
            <Button Name="OpenJavaTrustToolsButton" Content="打开 Java 证书工具" Command="{Binding OpenJavaTrustToolsCommand}" HorizontalAlignment="Left" />
          </StackPanel>
          <StackPanel Name="ManageSettingsSection" IsVisible="{Binding IsManageSection}" Spacing="14">
            <Border Classes="card"><StackPanel Spacing="9" IsEnabled="{Binding CanEdit}"><TextBlock Classes="sectionTitle" Text="游戏资源获取行为"  ToolTip.Tip="保存路径不会搬移已有实例或存档。并发与限速暂由下载器管理，尚不支持手动配置。"/><TextBlock Classes="muted" Text="文件、版本列表与 Mod 的来源按下方分类顺序回退。" />
              <Grid ColumnDefinitions="130,*"><TextBlock Classes="settingLabel" Text="文件下载源" /><ComboBox Grid.Column="1" IsEnabled="False" PlaceholderText="使用下方来源顺序" /></Grid><Grid ColumnDefinitions="130,*"><TextBlock Classes="settingLabel" Text="版本列表源" /><ComboBox Grid.Column="1" IsEnabled="False" PlaceholderText="优先完整官方清单" /></Grid>
              <Grid ColumnDefinitions="130,*"><TextBlock Classes="settingLabel" Text="文件下载协议" /><ComboBox Grid.Column="1" IsEnabled="False" PlaceholderText="按来源使用 HTTPS" /></Grid>
              <Grid ColumnDefinitions="130,*"><TextBlock Classes="settingLabel" Text="最大并发连接数" /><Slider Grid.Column="1" IsEnabled="False" /></Grid><Grid ColumnDefinitions="130,*"><TextBlock Classes="settingLabel" Text="速度限制" /><Slider Grid.Column="1" IsEnabled="False" /></Grid>
              <Grid ColumnDefinitions="130,*"><TextBlock Classes="settingLabel" Text="游戏根目录" /><Grid Grid.Column="1" ColumnDefinitions="*,Auto"><TextBox Name="GameRootSetting" Text="{Binding GameRoot}" PlaceholderText="留空使用启动器管理的实例目录" /><Button Grid.Column="1" Content="浏览…" Click="PickGameRoot_Click" Margin="8,0,0,0" /></Grid></Grid>

            </StackPanel></Border>
            <Border Classes="card"><StackPanel Spacing="9" IsEnabled="{Binding CanEdit}"><TextBlock Classes="sectionTitle" Text="自定义下载源与优先级" /><TextBlock Text="{Binding SourceEditorSummary}" Classes="muted" />
              <UniformGrid Columns="3"><Button Content="Minecraft 游戏本体" Command="{Binding SelectSourceCategoryCommand}" CommandParameter="Minecraft" Classes.selected="{Binding IsMinecraftSources}" HorizontalAlignment="Stretch" /><Button Content="Mod / 整合包" Command="{Binding SelectSourceCategoryCommand}" CommandParameter="Mod" Classes.selected="{Binding IsModSources}" HorizontalAlignment="Stretch" Margin="5,0" /><Button Content="Mod Loader" Command="{Binding SelectSourceCategoryCommand}" CommandParameter="Loader" Classes.selected="{Binding IsLoaderSources}" HorizontalAlignment="Stretch" /></UniformGrid>
              <ListBox Name="DownloadSourceSelector" ItemsSource="{Binding Sources}" SelectedItem="{Binding SelectedSource}" MaxHeight="190"><ListBox.ItemTemplate><DataTemplate><Grid ColumnDefinitions="Auto,*" Margin="3,3"><CheckBox IsChecked="{Binding Enabled}" Margin="0,0,7,0" /><StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" /><TextBlock Text="{Binding BaseUrl}" Classes="muted" LineHeight="16" FontSize="11" /></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
              <WrapPanel><Button Content="上移" Command="{Binding MoveSourceUpCommand}" Margin="0,0,6,4" /><Button Content="下移" Command="{Binding MoveSourceDownCommand}" Margin="0,0,6,4" /><Button Content="添加来源" Command="{Binding AddSourceCommand}" Margin="0,0,6,4" /><Button Content="移除来源" Command="{Binding RemoveSourceCommand}" Margin="0,0,6,4" /><Button Content="恢复默认" Command="{Binding ResetSourcesCommand}" Margin="0,0,6,4" /></WrapPanel>
              <Expander Header="来源高级参数" IsVisible="{Binding HasSelectedSource}"><StackPanel DataContext="{Binding SelectedSource}" Spacing="7" Margin="8,10"><Grid ColumnDefinitions="86,*"><TextBlock Classes="settingLabel" Text="来源名称"  ToolTip.Tip="自定义 URL 前缀替换要求接口与官方响应格式兼容。"/><TextBox Grid.Column="1" Text="{Binding Name}" /></Grid><Grid ColumnDefinitions="86,*"><TextBlock Classes="settingLabel" Text="来源类型" /><ComboBox Grid.Column="1" ItemsSource="{Binding LayoutChoices}" SelectedItem="{Binding Layout}" /></Grid><Grid ColumnDefinitions="86,*" IsVisible="{Binding IsAddressEditable}"><TextBlock Classes="settingLabel" Text="基础地址" /><TextBox Grid.Column="1" Text="{Binding BaseUrl}" /></Grid><Grid ColumnDefinitions="86,*" IsVisible="{Binding IsPrefix}"><TextBlock Classes="settingLabel" Text="官方 URL 前缀" /><TextBox Grid.Column="1" Text="{Binding OriginPrefix}" /></Grid><Grid ColumnDefinitions="86,*"><TextBlock Classes="settingLabel" Text="优先级" /><NumericUpDown Grid.Column="1" Value="{Binding Priority}" Minimum="0" Maximum="10000" FormatString="0" /></Grid></StackPanel></Expander>
              <Expander Header="高级下载源 JSON"><TextBox Name="DownloadSourcesSetting" Text="{Binding DownloadSourcesJson}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="130" Margin="8,10" PlaceholderText="留空使用内置来源" /></Expander>
            </StackPanel></Border>
            <Border Classes="card"><StackPanel Spacing="8"><TextBlock Classes="sectionTitle" Text="社区资源获取行为"  ToolTip.Tip="快速下载策略与依赖自动安装尚未接入。"/><StackPanel Spacing="8" IsEnabled="False"><Grid ColumnDefinitions="130,*"><TextBlock Classes="settingLabel" Text="下载源" /><ComboBox Grid.Column="1" PlaceholderText="使用上方 Mod 分类来源" /></Grid><Grid ColumnDefinitions="130,*"><TextBlock Classes="settingLabel" Text="快速下载行为" /><ComboBox Grid.Column="1" PlaceholderText="选择后确认安装" /></Grid><CheckBox Content="不显示 Quilt 加载器" /><CheckBox Content="下载模组时自动检查并安装必需前置" /></StackPanel></StackPanel></Border>
            <Border Classes="card"><StackPanel Spacing="8"><TextBlock Classes="sectionTitle" Text="辅助功能"  ToolTip.Tip="后台版本提醒与自动崩溃分析尚未接入。"/><StackPanel IsEnabled="False" Spacing="6"><StackPanel Orientation="Horizontal" Spacing="16"><CheckBox Content="正式版更新提示" /><CheckBox Content="测试版更新提示" /></StackPanel><CheckBox Content="自动检测游戏崩溃" /></StackPanel></StackPanel></Border>
            <Border Classes="card"><StackPanel Spacing="8" IsEnabled="{Binding CanEdit}"><TextBlock Name="Aria2SectionTitle" Classes="sectionTitle" Text="aria2 RPC - 外部下载加速"  ToolTip.Tip="仅支持本机 aria2，需自行运行；连接或本机输出校验失败会回退内部下载器。"/><CheckBox Content="启用本机 aria2 下载" IsChecked="{Binding Aria2Enabled}" /><Expander Header="RPC 地址、密钥与连接说明" IsExpanded="{Binding Aria2DetailsExpanded}" /><StackPanel Spacing="8" Margin="8,10" IsVisible="{Binding Aria2DetailsExpanded}"><TextBlock Classes="label" Text="RPC 地址" /><TextBox Name="Aria2EndpointSetting" Text="{Binding Aria2Endpoint}" PlaceholderText="http://localhost:6800/jsonrpc" /><TextBlock Classes="label" Text="RPC Secret（留空保留）" /><TextBox Name="Aria2SecretSetting" Text="{Binding Aria2Secret}" PasswordChar="●" PlaceholderText="新密钥" /><TextBlock Text="{Binding CredentialsSummary}" Classes="muted" LineHeight="18" FontSize="12" /></StackPanel></StackPanel></Border>
          </StackPanel>
          <StackPanel Name="AppearanceSettingsSection" IsVisible="{Binding IsAppearanceSection}" Spacing="14">
            <Border Classes="card"><StackPanel Spacing="8" IsEnabled="{Binding CanEdit}"><TextBlock Classes="sectionTitle" Text="首页定制"  ToolTip.Tip="关闭服务器切换后只启动游戏，不自动进入此前选择的社团服务器。"/><CheckBox Name="ShowClubIntroductionSetting" Content="显示社团介绍与顶部提示" IsChecked="{Binding ShowClubIntroduction}" /><CheckBox Name="ShowClubServersSetting" Content="显示社团服务器切换" IsChecked="{Binding ShowClubServers}" /><WrapPanel><Button IsEnabled="False" Content="替换首页轮播图片" Margin="0,4,8,4" /><Button IsEnabled="False" Content="恢复内置轮播" Margin="0,4,8,4" /></WrapPanel></StackPanel></Border>
            <Border Classes="card"><StackPanel Spacing="8" IsEnabled="{Binding CanEdit}"><TextBlock Classes="sectionTitle" Text="基础"  ToolTip.Tip="大小锁定、提示与高级材质尚未接入。"/><Grid ColumnDefinitions="82,*,65"><TextBlock Classes="settingLabel" Text="不透明度" /><Slider Grid.Column="1" Minimum="50" Maximum="100" Value="{Binding WindowOpacity}" TickFrequency="1" IsSnapToTickEnabled="True" /><NumericUpDown Name="WindowOpacitySetting" Grid.Column="2" Minimum="50" Maximum="100" Value="{Binding WindowOpacity}" FormatString="0" /></Grid><Grid ColumnDefinitions="82,*"><TextBlock Classes="settingLabel" Text="主题" /><ComboBox Name="ThemeSetting" Grid.Column="1" ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding ., Converter={StaticResource PreferenceLabel}}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox></Grid><CheckBox IsEnabled="False" Content="锁定启动器大小" /><CheckBox IsEnabled="False" Content="在启动游戏时显示“你知道吗”" /><CheckBox IsEnabled="False" Content="启动时提示社团更新日志" /><CheckBox IsEnabled="False" Content="高级材质" /></StackPanel></Border>
            <Border Classes="card"><StackPanel Spacing="8"><TextBlock Classes="sectionTitle" Text="字体" /><Grid ColumnDefinitions="82,*" IsEnabled="False"><TextBlock Classes="settingLabel" Text="字体" /><ComboBox Grid.Column="1" PlaceholderText="默认" /></Grid></StackPanel></Border>
            <Border Classes="card"><StackPanel Spacing="8"><TextBlock Classes="sectionTitle" Text="背景图片 / 视频"  ToolTip.Tip="当前仅显示内置背景，轮播与视频播放尚未接入。"/><CheckBox Content="允许背景轮播" IsChecked="{Binding RotateHomeBackground}" IsEnabled="False" /><WrapPanel><Button Content="打开图片目录" IsEnabled="False" Margin="0,3,8,3" /><Button Content="刷新背景" IsEnabled="False" Margin="0,3,8,3" /></WrapPanel></StackPanel></Border>
            <Border Classes="card"><StackPanel Spacing="8"><TextBlock Classes="sectionTitle" Text="背景音乐"  ToolTip.Tip="音频播放尚未接入。"/><WrapPanel><Button Content="打开音乐目录" IsEnabled="False" Margin="0,3,8,3" /><Button Content="刷新音乐" IsEnabled="False" Margin="0,3,8,3" /></WrapPanel></StackPanel></Border>
            <Border Classes="card"><StackPanel Spacing="8"><TextBlock Classes="sectionTitle" Text="标题栏 / 主页 / 功能隐藏"  ToolTip.Tip="自定义标题栏、主页来源与功能隐藏尚未接入。"/><StackPanel IsEnabled="False" Spacing="7"><StackPanel Orientation="Horizontal" Spacing="18"><RadioButton Content="无" /><RadioButton Content="默认" IsChecked="True" /><RadioButton Content="文本" /><RadioButton Content="图片" /></StackPanel><StackPanel Orientation="Horizontal" Spacing="18"><RadioButton Content="默认主页" IsChecked="True" /><RadioButton Content="本地文件" /><RadioButton Content="网络地址" /></StackPanel><UniformGrid Columns="4"><CheckBox Content="启动" /><CheckBox Content="下载" /><CheckBox Content="设置" /><CheckBox Content="工具" /></UniformGrid></StackPanel></StackPanel></Border>
          </StackPanel>
          <StackPanel Name="LanguageSettingsSection" IsVisible="{Binding IsLanguageSection}" Spacing="14"><Border Classes="card"><StackPanel Spacing="9" IsEnabled="{Binding CanEdit}"><TextBlock Classes="sectionTitle" Text="语言" /><Grid ColumnDefinitions="90,*"><TextBlock Classes="settingLabel" Text="界面语言" /><ComboBox Name="LanguageSetting" Grid.Column="1" ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding ., Converter={StaticResource PreferenceLabel}}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox></Grid><Grid ColumnDefinitions="90,*"><TextBlock Classes="settingLabel" Text="区域格式" /><ComboBox Grid.Column="1" IsEnabled="False" PlaceholderText="跟随系统区域格式" /></Grid><Border Background="{DynamicResource ClubSelection}" CornerRadius="5" Padding="24" Margin="9,0"><StackPanel Spacing="16"><TextBlock Text="让潮涌核心社启动器&#10;走向国际化。" LineHeight="35" FontSize="25" FontWeight="SemiBold"  ToolTip.Tip="语言偏好会真实保存。当前界面仍为简体中文，完整本地化与独立区域格式尚未完成。"/><Button Content="参与本地化贡献" Command="{Binding OpenProjectCommand}" /></StackPanel></Border></StackPanel></Border></StackPanel>
          <StackPanel Name="MiscSettingsSection" IsVisible="{Binding IsMiscSection}" Spacing="14">
            <Border Classes="card"><StackPanel Spacing="8"><TextBlock Classes="sectionTitle" Text="系统"  ToolTip.Tip="公告、渲染参数、日志容量与配置导入导出尚未接入。"/><StackPanel IsEnabled="False" Spacing="8"><Grid ColumnDefinitions="118,*"><TextBlock Classes="settingLabel" Text="启动器公告" /><ComboBox Grid.Column="1" PlaceholderText="当前未启用" /></Grid><Grid ColumnDefinitions="118,*"><TextBlock Classes="settingLabel" Text="最高动画帧率" /><Slider Grid.Column="1" /></Grid><Grid ColumnDefinitions="118,*"><TextBlock Classes="settingLabel" Text="实时日志行数" /><Slider Grid.Column="1" /></Grid><CheckBox Content="禁用硬件加速" /><WrapPanel><Button Content="导出设置" Margin="0,3,8,3" /><Button Content="导入设置" Margin="0,3,8,3" /></WrapPanel></StackPanel></StackPanel></Border>
            <Border Classes="card"><StackPanel Spacing="8" IsEnabled="{Binding CanEdit}"><TextBlock Classes="sectionTitle" Text="网络"  ToolTip.Tip="{Binding CredentialsSummary}"/><CheckBox Content="使用 DoH 解析地址" IsEnabled="False" /><Grid ColumnDefinitions="92,*"><TextBlock Classes="settingLabel" Text="HTTP 代理" /><ComboBox Name="ProxyModeSetting" Grid.Column="1" ItemsSource="{Binding ProxyModes}" SelectedItem="{Binding ProxyMode}" /></Grid><StackPanel IsVisible="{Binding IsCustomProxy}" Spacing="7" Margin="9,0"><TextBox Name="ProxyAddressSetting" Text="{Binding ProxyAddress}" PlaceholderText="http://127.0.0.1:7890" /><TextBox Name="ProxySecretSetting" Text="{Binding ProxySecret}" PasswordChar="●" PlaceholderText="username:password（留空保留已有凭据）" /></StackPanel></StackPanel></Border>
            <Border Classes="card"><Expander Header="调试选项"><StackPanel Spacing="8" Margin="8,10"><TextBlock Classes="label" Text="应用数据目录" /><TextBlock Text="{Binding DataDirectory}" Classes="muted" /><TextBlock Classes="label" Text="缓存目录" /><TextBlock Text="{Binding CacheDirectory}" Classes="muted" /><Button Content="打开数据目录" Command="{Binding OpenDataDirectoryCommand}" /><TextBlock Classes="label" Text="Microsoft public Client ID 覆盖" /><TextBox Name="MicrosoftClientIdSetting" Text="{Binding MicrosoftClientId}" IsEnabled="{Binding CanEdit}" PlaceholderText="留空使用发行包内置配置" /><TextBlock Classes="muted" Text="本启动器不收集遥测。连接密钥仅写入系统安全存储。" /></StackPanel></Expander></Border>
          </StackPanel>
          <StackPanel Name="AboutSettingsSection" IsVisible="{Binding IsAboutSection}" Spacing="14">
            <Border Classes="card"><StackPanel Spacing="10"><TextBlock Classes="sectionTitle" Text="关于潮涌核心社" /><Grid ColumnDefinitions="48,*" Margin="9,6"><Image Source="/Assets/Conduit/club-logo.png" Width="38" Height="38" /><StackPanel Grid.Column="1" Spacing="5"><TextBlock Text="{Binding SoftwareName}" LineHeight="32" FontSize="23" FontWeight="SemiBold" /><TextBlock Text="Conduit Club · 上海海洋大学 Minecraft 社团" /><TextBlock Text="{Binding SoftwareVersion}" Classes="muted" /></StackPanel></Grid><WrapPanel Margin="9,0"><Button Content="社团主页" Command="{Binding OpenClubCommand}" Margin="0,3,10,3" /><Button Content="社团启动器源代码" Command="{Binding OpenProjectCommand}" Margin="0,3,10,3" /></WrapPanel></StackPanel></Border>
            <Border Classes="card"><StackPanel Spacing="9"><TextBlock Classes="sectionTitle" Text="版本与运行环境" /><TextBlock Text="{Binding BuildDetails}" Classes="muted" Margin="9,0" /><TextBlock Text="{Binding CredentialCapability}" Margin="9,0" /></StackPanel></Border>
            <Border Classes="card"><StackPanel Spacing="9"><TextBlock Classes="sectionTitle" Text="贡献与版权" /><TextBlock Text="感谢 Plain Craft Launcher 原作者、PCL Community 与所有开源项目贡献者。潮涌核心社独立维护本启动器，历史来源与许可随发行包提供。" Margin="9,0" /><TextBlock Text="社团标识和实景素材归其原作者及社团所有。" Classes="muted" Margin="9,0" /></StackPanel></Border>
            <Border Classes="card"><Expander Header="法律信息与开源许可"><StackPanel Spacing="9" Margin="9,10"><TextBlock Text="Minecraft 是 Mojang Studios 的商标。本项目未获 Mojang 或 Microsoft 官方认可。" /><TextBlock Text="Avalonia · CommunityToolkit.Mvvm · .NET" FontWeight="SemiBold" /><TextBlock Text="完整依赖许可、源码来源和资源归属请查阅随包文件与仓库中的许可说明。" Classes="muted" /><Button Content="查看项目许可与说明" Command="{Binding OpenProjectCommand}" /></StackPanel></Expander></Border>
          </StackPanel>
          <StackPanel Name="UpdatesSettingsSection" IsVisible="{Binding IsUpdatesSection}" Spacing="14"><Border Classes="card"><StackPanel Spacing="9"><TextBlock Classes="sectionTitle" Text="潮涌核心社启动器"  ToolTip.Tip="{Binding UpdateCapability}"/><TextBlock Text="{Binding SoftwareVersion}" LineHeight="30" FontSize="21" FontWeight="SemiBold" Margin="9,0" /><TextBlock Text="{Binding BuildDetails}" Classes="muted" Margin="9,0" /><WrapPanel Margin="9,0"><Button Content="检查社团更新" IsEnabled="False" Margin="0,3,8,3" /><Button Content="打开发行页面" Command="{Binding OpenReleasesCommand}" Margin="0,3,8,3" /></WrapPanel></StackPanel></Border></StackPanel>
          <StackPanel Name="FeedbackSettingsSection" IsVisible="{Binding IsFeedbackSection}" Spacing="14"><Border Classes="card"><StackPanel Spacing="9"><TextBlock Classes="sectionTitle" Text="反馈与建议" /><TextBlock Text="遇到问题、希望改进或提交建议时，请附上版本与脱敏日志，勿提交密码和令牌。" Margin="9,0" /><Button Content="打开社团问题列表" Command="{Binding OpenFeedbackCommand}" Margin="9,0" /></StackPanel></Border><Border Classes="card"><StackPanel Spacing="9"><TextBlock Classes="sectionTitle" Text="反馈列表"  ToolTip.Tip="{Binding FeedbackCapability}"/><TextBox IsEnabled="False" PlaceholderText="检索反馈" /></StackPanel></Border></StackPanel>
          <StackPanel Name="LogFilesSettingsSection" IsVisible="{Binding IsLogsSection}" Spacing="14">
            <Border Classes="card"><StackPanel Spacing="8"><TextBlock Classes="sectionTitle" Text="日志操作"  ToolTip.Tip="批量导出与历史清理尚未接入；原始日志文件可能含隐私，分享前请检查。"/><WrapPanel><Button Content="查看并导出脱敏日志" Command="{Binding ShowLiveLogsCommand}" Margin="9,3,8,3" /><Button Content="导出全部日志" IsEnabled="False" Margin="0,3,8,3" /><Button Content="打开日志目录" Command="{Binding OpenLogsDirectoryCommand}" Margin="0,3,8,3" /><Button Content="清理历史日志" IsEnabled="False" Margin="0,3,8,3" /><Button Content="刷新列表" Command="{Binding RefreshLogFilesCommand}" Margin="0,3,8,3" /></WrapPanel></StackPanel></Border>
            <Border Classes="card"><StackPanel Spacing="9"><TextBlock Classes="sectionTitle" Text="所有日志" /><TextBlock Text="{Binding LogFilesSummary}" Classes="muted" Margin="9,0" /><ItemsControl Name="SettingsLogFileList" ItemsSource="{Binding LogFiles}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Spacing="3" Margin="9,7"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding Modified}" /><TextBlock Grid.Column="1" Text="{Binding Size}" Classes="muted" /></Grid><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding Path}" Classes="muted" LineHeight="18" FontSize="12" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></StackPanel></Border>
          </StackPanel>
        </StackPanel>
      </ScrollViewer>
    </DockPanel>
  </Grid>
</UserControl>
