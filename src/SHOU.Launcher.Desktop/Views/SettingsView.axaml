<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="SHOU.Launcher.Desktop.Views.SettingsView">
  <DockPanel>
    <Border DockPanel.Dock="Bottom" Background="{DynamicResource ClubBackground}" BorderBrush="{DynamicResource ClubBorder}" BorderThickness="0,1,0,0" Padding="0,12,0,0">
      <StackPanel Spacing="8"><TextBlock Name="SettingsDraftStatus" Text="{Binding SaveSummary}" Classes="muted" /><TextBlock Text="{Binding Feedback}" Classes="muted" /><StackPanel Orientation="Horizontal" Spacing="8"><Button Name="SaveSettingsButton" Classes="primary" Content="保存设置" Command="{Binding SaveCommand}" /><Button Content="放弃草稿" Command="{Binding DiscardDraftCommand}" /></StackPanel></StackPanel>
    </Border>
    <ScrollViewer HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="18" Margin="0,0,0,16">
      <Border Classes="card"><StackPanel Spacing="8" IsEnabled="{Binding CanEdit}"><TextBlock Classes="sectionTitle" Text="游戏与运行时" />
        <TextBlock Classes="label" Text="游戏根目录" /><Grid ColumnDefinitions="*,Auto"><TextBox Name="GameRootSetting" Text="{Binding GameRoot}" PlaceholderText="留空使用启动器管理的实例目录" /><Button Grid.Column="1" Content="浏览…" Click="PickGameRoot_Click" Margin="8,0,0,0" /></Grid>
        <TextBlock Classes="label" Text="全局 Java 可执行文件" /><Grid ColumnDefinitions="*,Auto"><TextBox Name="GlobalJavaExecutableSetting" Text="{Binding JavaExecutable}" PlaceholderText="留空自动选择" /><Button Grid.Column="1" Content="浏览…" Click="PickJava_Click" Margin="8,0,0,0" /></Grid>
        <TextBlock Classes="label" Text="最大内存（MiB）" /><NumericUpDown Value="{Binding MemoryMiB}" Minimum="512" Maximum="32768" Increment="256" />
        <TextBlock Text="实例自己的 Java、内存和游戏目录设置仍优先；保存不会搬移已有实例或存档。" Classes="muted" FontSize="12" />
      </StackPanel></Border>
      <Border Classes="card"><StackPanel Spacing="10"><TextBlock Classes="sectionTitle" Text="Java 信任配置" />
        <CheckBox Name="JavaTrustAutoRepairSetting" Content="为新下载的官方 Java 自动创建独立修复副本" IsChecked="{Binding ConduitJavaTrustAutoRepair}" IsEnabled="{Binding CanEdit}" />
        <TextBlock Text="自动修复偏好随设置保存。仅修改启动器创建的新派生副本，官方原始 Java 和 manifest 校验保持不变。已有外部 Java 可手动扫描或创建副本。" Classes="muted" FontSize="12" />
        <TextBlock Text="操作目标：上方明确填写的全局 Java 可执行文件。留空自动选择时不执行扫描或修复。" Classes="muted" FontSize="12" />
        <WrapPanel><Button Name="InspectJavaTrustButton" Content="只读扫描所选 Java" Command="{Binding InspectJavaTrustCommand}" Margin="0,4,8,4" /><Button Name="CreateRepairedJavaCopyButton" Content="创建修复副本并选用" Command="{Binding CreateRepairedJavaCopyCommand}" Margin="0,4,8,4" /></WrapPanel>
        <TextBlock Name="JavaTrustStatusText" Text="{Binding JavaTrustStatus}" Classes="muted" />
        <ItemsControl Name="JavaTrustFindings" ItemsSource="{Binding JavaTrustFindings}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Spacing="4" Margin="0,6"><TextBlock Text="{Binding Summary}" FontWeight="SemiBold" /><TextBlock Text="{Binding Path}" Classes="muted" FontSize="12" /><TextBlock Text="{Binding Hash}" Classes="muted" FontSize="11" /><TextBlock Text="{Binding Details}" Classes="muted" FontSize="12" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        <TextBox Name="JavaTrustProvenanceText" Text="{Binding JavaTrustProvenance}" IsVisible="{Binding HasJavaTrustProvenance}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120" />
        <TextBlock Text="原始 Java 不改动；可从原路径或实例页的发现列表重新选用。本页不执行原地修复，也不提供还原原始 Java 的操作。" Classes="muted" FontSize="12" />
      </StackPanel></Border>
      <Border Classes="card"><StackPanel Spacing="8" IsEnabled="{Binding CanEdit}"><TextBlock Classes="sectionTitle" Text="界面" /><Grid ColumnDefinitions="*,*" RowDefinitions="Auto,Auto"><TextBlock Text="语言偏好" Classes="label" /><TextBlock Grid.Column="1" Text="主题（System / Light / Dark）" Classes="label" Margin="12,8,0,4" /><ComboBox Grid.Row="1" ItemsSource="{Binding Languages}" SelectedItem="{Binding Language}" /><ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Themes}" SelectedItem="{Binding Theme}" Margin="12,0,0,0" /></Grid><TextBlock Text="本候选保留语言偏好，界面文案暂为简体中文；完整本地化尚未完成。" Classes="muted" FontSize="12" /></StackPanel></Border>
      <Border Classes="card"><StackPanel Spacing="8" IsEnabled="{Binding CanEdit}"><TextBlock Classes="sectionTitle" Text="下载源" /><TextBlock Text="留空沿用默认来源顺序。高级配置按分类保存，可调整各来源的启用状态与优先级。" Classes="muted" />
        <Expander Header="高级下载源 JSON"><TextBox Name="DownloadSourcesSetting" Text="{Binding DownloadSourcesJson}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="160" Margin="0,10,0,0" PlaceholderText="留空使用默认下载源" /></Expander>
      </StackPanel></Border>
      <Border Classes="card"><StackPanel Spacing="8" IsEnabled="{Binding CanEdit}"><TextBlock Classes="sectionTitle" Text="代理" /><TextBlock Text="Direct = 直连；System = 系统代理；Custom = 自定义代理。" Classes="muted" FontSize="12" /><ComboBox ItemsSource="{Binding ProxyModes}" SelectedItem="{Binding ProxyMode}" />
        <StackPanel IsVisible="{Binding IsCustomProxy}" Spacing="8"><TextBox Text="{Binding ProxyAddress}" PlaceholderText="http://127.0.0.1:7890" /><TextBox Text="{Binding ProxySecret}" PasswordChar="●" PlaceholderText="代理凭据 username:password（留空保留已有值）" /></StackPanel>
      </StackPanel></Border>
      <Border Classes="card"><StackPanel Spacing="8" IsEnabled="{Binding CanEdit}"><TextBlock Classes="sectionTitle" Text="本机 aria2 RPC" /><CheckBox Content="为后续下载任务尝试使用本机 aria2" IsChecked="{Binding Aria2Enabled}" /><StackPanel IsVisible="{Binding Aria2Enabled}" Spacing="8"><TextBox Name="Aria2EndpointSetting" Text="{Binding Aria2Endpoint}" PlaceholderText="http://localhost:6800/jsonrpc" /><TextBox Name="Aria2SecretSetting" Text="{Binding Aria2Secret}" PasswordChar="●" PlaceholderText="新 RPC 密钥（留空保留已有值）" /></StackPanel><TextBlock Text="{Binding CredentialsSummary}" Classes="muted" FontSize="12" /><TextBlock Name="Aria2CapabilityHint" Text="本候选仅支持本机 aria2，不支持远程 RPC；aria2 需自行运行，连接或本机输出校验失败会回退内部下载器。" Classes="muted" FontSize="12" /></StackPanel></Border>
      <Expander Header="应用数据与开发选项"><StackPanel Spacing="8" Margin="0,10"><TextBlock Text="数据目录" Classes="label" /><TextBlock Text="{Binding DataDirectory}" Classes="muted" /><TextBlock Text="缓存" Classes="label" /><TextBlock Text="{Binding CacheDirectory}" Classes="muted" /><TextBlock Text="日志" Classes="label" /><TextBlock Text="{Binding LogsDirectory}" Classes="muted" /><Button Content="打开数据目录" Command="{Binding OpenDataDirectoryCommand}" /><TextBlock Text="Microsoft public Client ID 覆盖（普通用户可留空）" Classes="label" /><TextBox Text="{Binding MicrosoftClientId}" IsEnabled="{Binding CanEdit}" PlaceholderText="留空使用发行包内置配置" /><TextBlock Text="本启动器不收集遥测。社团素材与原作者署名见随包许可和资源说明。" Classes="muted" /></StackPanel></Expander>
    </StackPanel></ScrollViewer>
  </DockPanel>
</UserControl>
