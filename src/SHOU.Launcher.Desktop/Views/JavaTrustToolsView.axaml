<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="using:SHOU.Launcher.Desktop.Localization" x:Class="SHOU.Launcher.Desktop.Views.JavaTrustToolsView">
  <StackPanel Spacing="15">
    <Border Classes="card"><StackPanel Spacing="10">
      <TextBlock Text="{loc:Loc t06b7bd3a89f54974}" Classes="sectionTitle"  ToolTip.Tip="{loc:Loc t840ec7ba032619cc}"/>
      <Grid ColumnDefinitions="*,10,Auto"><TextBox Name="JavaTrustTargetPath" Text="{Binding TargetJava}" IsEnabled="{Binding CanEdit}" PlaceholderText="{loc:Loc t1e209a0e433d17b0}" /><Button Name="BrowseTrustJavaButton" Grid.Column="2" Content="{loc:Loc t63e81e40a2465d67}" Click="BrowseJava_Click" IsEnabled="{Binding CanEdit}" /></Grid>

      <Button Content="{loc:Loc t2ae8f2e5dd7122c1}" Command="{Binding UseDefaultTargetCommand}" HorizontalAlignment="Left" />
    </StackPanel></Border>
    <Border Classes="card"><StackPanel Spacing="10">
      <TextBlock Text="{loc:Loc t7feaebd0b48c79a0}" Classes="sectionTitle"  ToolTip.Tip="{loc:Loc t64ffaaa46969a7c1}"/>
      <TextBlock Name="JavaTrustStatusText" Text="{Binding Status}" TextWrapping="Wrap"  Classes="status" />
      <TextBlock Text="{loc:Loc t06533ab1fb98647f}" FontWeight="SemiBold" /><SelectableTextBlock Name="JavaTrustCurrentDefault" Text="{Binding CurrentDefaultJava}" TextWrapping="Wrap" />
      <WrapPanel><Button Name="InspectJavaTrustButton" Content="{loc:Loc te983a7b097c6008d}" Command="{Binding InspectCommand}" Margin="0,0,10,8" /><Button Name="CreateRepairedJavaCopyButton" Content="{loc:Loc ta01a770f844c6645}" Command="{Binding PrepareCopyCommand}" Margin="0,0,10,8" /><Button Name="RestoreSourceJavaButton" Content="{Binding RollbackLabel}" Command="{Binding RestoreSelectionCommand}" IsVisible="{Binding HasRollback}" Margin="0,0,0,8" /></WrapPanel>
      <Border Name="PreparedJavaCopyPanel" IsVisible="{Binding HasPrepared}" BorderBrush="{DynamicResource ClubAccent}" BorderThickness="1" CornerRadius="6" Padding="12"><StackPanel Spacing="8">
        <TextBlock Text="{loc:Loc t33d56791e4425c56}" FontWeight="SemiBold"  ToolTip.Tip="{loc:Loc t7a6d65ebf34126d5}"/><SelectableTextBlock Name="PreparedJavaPath" Text="{Binding PreparedJava}" TextWrapping="Wrap" />

        <Button Name="SelectRepairedJavaCopyButton" Content="{loc:Loc t59069443798153f9}" Command="{Binding SelectCopyCommand}" HorizontalAlignment="Left" />
      </StackPanel></Border>

      <Expander HorizontalAlignment="Stretch" Header="{loc:Loc tad9bdc77353ad92e}" IsExpanded="{Binding DetailsExpanded}"><StackPanel Spacing="8" Margin="0,10,0,0">
        <ItemsControl Name="JavaTrustFindings" ItemsSource="{Binding Findings}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Spacing="3" Margin="0,6"><TextBlock Text="{loc:Translate Summary}" FontWeight="SemiBold" /><TextBlock Text="{Binding Details}" Classes="muted" /><TextBlock Text="{Binding Path}" Classes="muted" LineHeight="18" FontSize="12" /><TextBlock Text="{Binding Hash}" Classes="muted" LineHeight="16" FontSize="11" /></StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
        <TextBox Name="JavaTrustProvenanceText" Text="{Binding Provenance}" IsVisible="{Binding HasProvenance}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="120" />
      </StackPanel></Expander>
    </StackPanel></Border>
    <Border Classes="card"><StackPanel Spacing="10"><TextBlock Text="{loc:Loc td7add3476bfb793b}" Classes="sectionTitle" />
      <CheckBox Name="JavaTrustAutoRepairSetting" Content="{loc:Loc t501dbfb083e4710e}" IsChecked="{Binding AutoRepair}" IsEnabled="{Binding CanEdit}" />
      <DockPanel><Button Name="SaveJavaTrustPreferenceButton" DockPanel.Dock="Right" Content="{loc:Loc t13c6f205d3052965}" Command="{Binding SavePreferenceCommand}" Margin="10,0,0,0" /><TextBlock Text="{Binding PreferenceSummary}" TextWrapping="Wrap" VerticalAlignment="Center"  Classes="status" /></DockPanel>
    </StackPanel></Border>
  </StackPanel>
</UserControl>
