<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="SHOU.Launcher.Desktop.Views.ClubUpdatesOverlay" Focusable="True" KeyDown="Updates_KeyDown">
  <Grid Background="#66000000" KeyboardNavigation.TabNavigation="Cycle">
    <Border Name="ClubUpdatesCard" Background="{DynamicResource ClubSurface}" CornerRadius="9" Padding="28,20" Margin="24" MaxWidth="700" MaxHeight="440" BoxShadow="0 8 24 0 #55000000">
      <Grid RowDefinitions="Auto,3,Auto,*,Auto" RowSpacing="10">
        <Grid ColumnDefinitions="*,Auto"><TextBlock Text="社团更新日志" FontSize="23" FontWeight="Bold" Foreground="{DynamicResource ClubAccent}" /><Button Name="CloseClubUpdatesButton" Grid.Column="1" Content="关闭" Command="{Binding CloseUpdatesCommand}" /></Grid>
        <Border Grid.Row="1" Background="{DynamicResource ClubAccent}" />
        <TextBlock Grid.Row="2" Name="ClubUpdatesStatus" Text="{Binding UpdatesStatus}" TextWrapping="Wrap" />
        <ScrollViewer Grid.Row="3" Name="ClubUpdatesScroller" HorizontalScrollBarVisibility="Disabled">
          <StackPanel>
            <ItemsControl ItemsSource="{Binding UpdateItems}"><ItemsControl.ItemTemplate><DataTemplate>
              <Expander Header="{Binding Header}" IsExpanded="{Binding IsExpanded, Mode=TwoWay}" HorizontalAlignment="Stretch" Margin="0,0,0,8">
                <StackPanel Margin="14,4,14,12" Spacing="8">
                  <ProgressBar IsIndeterminate="True" IsVisible="{Binding IsLoading}" Height="3" Foreground="{DynamicResource ClubAccent}" />
                  <ScrollViewer MaxHeight="240" HorizontalScrollBarVisibility="Disabled"><SelectableTextBlock Name="ClubUpdateBody" Text="{Binding Body}" TextWrapping="Wrap" FontSize="14" LineHeight="21" /></ScrollViewer>
                  <Button Content="重新读取正文" Command="{Binding RetryCommand}" HorizontalAlignment="Left" MinHeight="25" FontSize="12" />
                </StackPanel>
              </Expander>
            </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            <TextBlock Text="尚无可阅读记录，可刷新或在社团网站阅读。" IsVisible="{Binding !HasUpdates}" TextWrapping="Wrap" Foreground="{DynamicResource ClubMuted}" />
          </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="4" ColumnDefinitions="*,Auto,Auto" ColumnSpacing="10">
          <TextBlock Text="{Binding UpdatesCacheSummary}" VerticalAlignment="Center" FontSize="11" TextWrapping="Wrap" />
          <Button Grid.Column="1" Content="社团网站" Command="{Binding OpenUpdatesWebsiteCommand}" />
          <Button Name="RefreshClubUpdatesButton" Grid.Column="2" Content="刷新" Command="{Binding RefreshUpdatesCommand}" />
        </Grid>
      </Grid>
    </Border>
  </Grid>
</UserControl>
