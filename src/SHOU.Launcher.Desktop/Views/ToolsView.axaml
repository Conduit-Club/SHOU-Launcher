<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:themes="using:SHOU.Launcher.Desktop.Themes" xmlns:views="using:SHOU.Launcher.Desktop.Views" x:Class="SHOU.Launcher.Desktop.Views.ToolsView">
  <UserControl.Styles>
    <Style Selector="TextBlock"><Setter Property="LineHeight" Value="18" /></Style>
    <Style Selector="Button"><Setter Property="Height" Value="28" /><Setter Property="Padding" Value="11,4" /></Style>
    <Style Selector="TextBox"><Setter Property="Height" Value="28" /></Style>
    <Style Selector="ComboBox"><Setter Property="Height" Value="28" /></Style>
    <Style Selector="Expander.toolGenerator /template/ ToggleButton"><Setter Property="MinHeight" Value="39" /></Style>
  </UserControl.Styles>
  <Grid ColumnDefinitions="121,*">
    <Border Background="{DynamicResource ClubSidebar}" BorderBrush="{DynamicResource ClubBorder}" BorderThickness="0,0,1,0">
      <StackPanel>
        <TextBlock Classes="contextHeading" Text="运行环境" />
        <ToggleButton Name="JavaTrustNavigationButton" Classes="contextNavigation" IsChecked="{Binding IsJavaTrust, Mode=OneWay}" Command="{Binding ShowJavaTrustCommand}">
          <StackPanel Orientation="Horizontal" Spacing="10"><Path Classes="contextIcon" Data="{x:Static themes:ClubIcons.Settings}" /><TextBlock Text="Java 证书" FontSize="15" LineHeight="20" VerticalAlignment="Center" /></StackPanel>
        </ToggleButton>
        <TextBlock Classes="contextHeading" Text="奇妙小工具" />
        <ToggleButton Name="ToolboxNavigationButton" Classes="contextNavigation" IsChecked="{Binding IsToolbox, Mode=OneWay}" Command="{Binding ShowToolboxCommand}">
          <StackPanel Orientation="Horizontal" Spacing="10"><Path Classes="contextIcon" Data="{x:Static themes:ClubIcons.Toolbox}" /><TextBlock Text="百宝箱" FontSize="15" LineHeight="20" VerticalAlignment="Center" /></StackPanel>
        </ToggleButton>
      </StackPanel>
    </Border>
    <ScrollViewer Grid.Column="1" Name="JavaTrustPage" IsVisible="{Binding IsJavaTrust}" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="25" Spacing="15">
        <Border Classes="card"><StackPanel Spacing="10"><TextBlock Text="Java 证书诊断与修复" Classes="sectionTitle" /><TextBlock Text="先检查选定的 Java。需要修复时创建独立副本，通过核验后再选用；保留源 Java 和其它证书。" TextWrapping="Wrap" /><Button Content="Java 设置与自动修复偏好" Command="{Binding ShowJavaSettingsCommand}" HorizontalAlignment="Left" /></StackPanel></Border>
        <views:JavaTrustToolsView DataContext="{Binding Root.Settings}" />
      </StackPanel>
    </ScrollViewer>
    <ScrollViewer Grid.Column="1" Name="ToolboxPage" IsVisible="{Binding IsToolbox}" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="25" Spacing="15">
        <Border Name="ToolboxActionsCard" Classes="card"><StackPanel Spacing="10">
          <DockPanel><TextBlock DockPanel.Dock="Right" Text="这些工具尚未迁移" Classes="capability" LineHeight="18" ToolTip.Tip="{Binding ToolboxCapabilityReason}" /><TextBlock Text="百宝箱" Classes="sectionTitle" LineHeight="18" /></DockPanel>
          <WrapPanel Margin="10,0,0,0"><Button Content="清理游戏垃圾" IsEnabled="False" MinWidth="120" Height="35" Margin="0,0,15,0" /><Button Content="今日人品" IsEnabled="False" MinWidth="100" Height="35" Margin="0,0,15,0" /><Button Content="创建快捷方式" IsEnabled="False" MinWidth="120" Height="35" Margin="0,0,15,0" /><Button Content="查看启动计数" IsEnabled="False" MinWidth="120" Height="35" /></WrapPanel>
        </StackPanel></Border>
        <Border Name="CustomDownloadCard" Classes="card" MinHeight="240"><StackPanel Spacing="10" VerticalAlignment="Top">
          <TextBlock Text="下载自定义文件" Classes="sectionTitle" LineHeight="18" />
          <TextBlock Text="自定义文件下载尚未迁移；当前可打开数据目录。" TextWrapping="Wrap" LineHeight="18" Margin="10,0" />
          <Grid ColumnDefinitions="78,*" RowDefinitions="Auto,10,Auto,10,Auto" Margin="10,0">
            <TextBlock Text="下载地址" VerticalAlignment="Center" /><TextBox Height="28" Grid.Column="1" Name="CustomDownloadUrl" IsEnabled="False" />
            <TextBlock Grid.Row="2" Text="保存到" VerticalAlignment="Center" /><Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*,8,45"><TextBox Height="28" Text="{Binding DataDirectory}" IsReadOnly="True" IsEnabled="False" /><Button Grid.Column="2" Classes="flat" Content="选择" IsEnabled="False" /></Grid>
            <TextBlock Grid.Row="4" Text="文件名" VerticalAlignment="Center" /><TextBox Height="28" Grid.Row="4" Grid.Column="1" IsEnabled="False" />
          </Grid>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="15" Margin="0"><Button Name="CustomDownloadButton" Content="开始下载" IsEnabled="False" MinWidth="140" Height="35" /><Button Content="打开文件夹" Command="{Binding Root.Home.OpenDataDirectoryCommand}" MinWidth="140" Height="35" /></StackPanel>
        </StackPanel></Border>
        <Border Name="SkinDownloadCard" Classes="card" MinHeight="149"><StackPanel Spacing="12"><DockPanel><TextBlock DockPanel.Dock="Right" Text="皮肤获取与保存尚未迁移" Classes="capability" LineHeight="18" /><TextBlock Text="下载正版玩家的皮肤" Classes="sectionTitle" LineHeight="18" /></DockPanel><Grid ColumnDefinitions="90,*" Margin="10,10,10,0"><TextBlock Text="正版玩家名" VerticalAlignment="Center" /><TextBox Height="28" Grid.Column="1" IsEnabled="False" /></Grid><Button Content="保存皮肤" IsEnabled="False" MinWidth="140" HorizontalAlignment="Left" Margin="10,0" Height="35" /></StackPanel></Border>
        <Border Name="ServerQueryCard" Classes="card"><StackPanel Spacing="6"><DockPanel><TextBlock DockPanel.Dock="Right" Text="自定义查询尚未迁移" Classes="capability" LineHeight="18" /><TextBlock Text="瞅眼服务器" Classes="sectionTitle" LineHeight="18" /></DockPanel><Grid ColumnDefinitions="*,15,60"><TextBox Height="28" Name="ToolServerAddress" PlaceholderText="输入服务器地址" IsEnabled="False" /><Button Grid.Column="2" Content="查询" IsEnabled="False" /></Grid></StackPanel></Border>
        <Expander Name="AchievementGenerator" Classes="toolGenerator" Header="自定义成就图片生成器（仅支持英文）"><StackPanel Margin="25,0,25,20" Spacing="10">
          <Grid ColumnDefinitions="116,*" RowDefinitions="Auto,10,Auto,10,Auto,10,Auto"><TextBlock Text="物品名（ID）" VerticalAlignment="Center" /><TextBox Grid.Column="1" IsEnabled="False" /><TextBlock Grid.Row="2" Text="成就名" VerticalAlignment="Center" /><TextBox Grid.Row="2" Grid.Column="1" IsEnabled="False" /><TextBlock Grid.Row="4" Text="第一行" VerticalAlignment="Center" /><TextBox Height="28" Grid.Row="4" Grid.Column="1" IsEnabled="False" /><TextBlock Grid.Row="6" Text="第二行（可选）" VerticalAlignment="Center" /><TextBox Grid.Row="6" Grid.Column="1" IsEnabled="False" /></Grid>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="15" Margin="0,7,0,0"><Button Content="预览成就图像" Classes="primary" IsEnabled="False" MinWidth="140" Height="35" /><Button Content="保存图片" IsEnabled="False" MinWidth="140" Height="35" /></StackPanel><TextBlock Text="成就图片生成与导出尚未迁移。" Classes="capability" />
        </StackPanel></Expander>
        <Expander Name="AvatarGenerator" Classes="toolGenerator" Header="皮肤头像生成器"><StackPanel Margin="25,0,25,20" Spacing="10"><Grid ColumnDefinitions="76,*"><TextBlock Text="头像大小：" VerticalAlignment="Center" /><ComboBox Grid.Column="1" SelectedIndex="0" IsEnabled="False"><ComboBoxItem Content="64×64" /><ComboBoxItem Content="128×128" /><ComboBoxItem Content="256×256" /></ComboBox></Grid><StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10"><Button Content="选择皮肤" IsEnabled="False" MinWidth="140" Height="35" /><Button Content="保存头像" IsEnabled="False" MinWidth="140" Height="35" /></StackPanel><TextBlock Text="皮肤头像生成与导出尚未迁移。" Classes="capability" /></StackPanel></Expander>
        <Border Classes="card"><StackPanel Spacing="10"><TextBlock Text="社团入口" Classes="sectionTitle" /><WrapPanel><Button Content="社团 Wiki" Command="{Binding Root.Home.OpenWikiCommand}" Margin="0,0,10,0" /><Button Content="登录与入服指南" Command="{Binding Root.Home.OpenGuideCommand}" Margin="0,0,10,0" /><Button Content="查看日志" Command="{Binding Root.ShowLogsCommand}" /></WrapPanel></StackPanel></Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
