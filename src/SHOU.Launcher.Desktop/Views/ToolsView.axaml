<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="using:SHOU.Launcher.Desktop.Localization" xmlns:themes="using:SHOU.Launcher.Desktop.Themes" xmlns:views="using:SHOU.Launcher.Desktop.Views" x:Class="SHOU.Launcher.Desktop.Views.ToolsView">
  <UserControl.Styles>

    <Style Selector="Expander.toolGenerator /template/ ToggleButton"><Setter Property="MinHeight" Value="39" /></Style>
  </UserControl.Styles>
  <Grid ColumnDefinitions="121,*">
    <Border Background="{DynamicResource ClubSidebar}" BorderBrush="{DynamicResource ClubBorder}" BorderThickness="0,0,1,0">
      <StackPanel>
        <TextBlock Classes="contextHeading" Text="{loc:Loc t423f51a286789ed3}" />
        <ToggleButton Name="JavaTrustNavigationButton" IsVisible="{Binding Root.VisibleFeatures[tools-java]}" Classes="contextNavigation" IsChecked="{Binding IsJavaTrust, Mode=OneWay}" Command="{Binding ShowJavaTrustCommand}">
          <StackPanel Orientation="Horizontal" Spacing="10"><views:ClubIcon Classes="contextIcon" Kind="{x:Static themes:ClubIcons.Settings}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" /><TextBlock Text="{loc:Loc te60b6a604415f87d}" Classes="navigationLabel" /></StackPanel>
        </ToggleButton>
        <TextBlock Classes="contextHeading" Text="{loc:Loc t7ff4ff7f1107e506}" />
        <ToggleButton Name="ToolboxNavigationButton" IsVisible="{Binding Root.VisibleFeatures[tools-toolbox]}" Classes="contextNavigation" IsChecked="{Binding IsToolbox, Mode=OneWay}" Command="{Binding ShowToolboxCommand}">
          <StackPanel Orientation="Horizontal" Spacing="10"><views:ClubIcon Classes="contextIcon" Kind="{x:Static themes:ClubIcons.Toolbox}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" /><TextBlock Text="{loc:Loc t7b2a5133349a7018}" Classes="navigationLabel" /></StackPanel>
        </ToggleButton>
      </StackPanel>
    </Border>
    <ScrollViewer Grid.Column="1" Name="JavaTrustPage" IsVisible="{Binding IsJavaTrust}" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="25" Spacing="15">
        <Border Classes="card"><StackPanel Spacing="10"><TextBlock Text="{loc:Loc t67df947ba5c5c474}" Classes="sectionTitle"  ToolTip.Tip="{loc:Loc ta38be99cc20e0ba4}"/><Button Content="{loc:Loc t9698fc80d82c4cde}" Command="{Binding ShowJavaSettingsCommand}" HorizontalAlignment="Left" /></StackPanel></Border>
        <views:JavaTrustToolsView DataContext="{Binding JavaTrust}" />
      </StackPanel>
    </ScrollViewer>
    <ScrollViewer Grid.Column="1" Name="ToolboxPage" IsVisible="{Binding IsToolbox}" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="25" Spacing="15" DataContext="{Binding Toolbox}">
        <Border Name="ToolCommunityCard" Classes="card"><StackPanel Spacing="10"><TextBlock Text="{loc:Loc t7b224bc0c731704f}" Classes="sectionTitle" /><WrapPanel><Button Content="{loc:Loc tcc4b37166fcb77a3}" Command="{Binding Root.Home.OpenWikiCommand}" Margin="0,0,10,0" /><Button Content="{loc:Loc t527baa645f1698e1}" Command="{Binding Root.Home.OpenGuideCommand}" Margin="0,0,10,0" /><Button Name="ToolCommunityUpdatesButton" Content="{loc:Loc tfc45eb94060a2412}" Command="{Binding OpenCommunityUpdatesCommand}" Margin="0,0,10,0" /><Button Content="{loc:Loc t62c7a471a9e4bdc9}" Command="{Binding Root.ShowLogsCommand}" /></WrapPanel></StackPanel></Border>
        <Border Name="ToolboxActionsCard" Classes="card"><StackPanel Spacing="10">
          <DockPanel><views:LoadingGlyph DockPanel.Dock="Right" Width="24" Height="24" IsVisible="{Binding IsActionsBusy}" /><TextBlock Text="{loc:Loc t7b2a5133349a7018}" Classes="sectionTitle" LineHeight="18" /></DockPanel>
          <WrapPanel Margin="10,0,0,0"><Button Name="ScanGameLogsButton" Content="{loc:Loc t2ffa8e0e69fa8eb3}" Command="{Binding ScanCleanupCommand}" ToolTip.Tip="{loc:Loc t5d8cd20d31c86087}" MinWidth="120" Height="35" Margin="0,0,15,0" /><Button Name="DailyFortuneButton" Content="{loc:Loc t803a2627eed3f457}" Command="{Binding FortuneCommand}" MinWidth="100" Height="35" Margin="0,0,15,0" /><Button Name="CreateLauncherShortcutButton" Content="{loc:Loc taf852212987fc97d}" Click="CreateShortcut_Click" IsEnabled="{Binding CanUseTools}" MinWidth="120" Height="35" Margin="0,0,15,0" /><Button Name="ToolLaunchCountButton" Content="{loc:Loc taa7108333483e90e}" Command="{Binding LaunchCountCommand}" MinWidth="120" Height="35" /></WrapPanel>
          <TextBlock Name="ToolActionFeedback" Text="{Binding ActionFeedback}" IsVisible="{Binding HasActionFeedback}" TextWrapping="Wrap" />
          <StackPanel IsVisible="{Binding HasCleanupPreview}" Spacing="8">
            <ListBox Name="ToolCleanupFiles" ItemsSource="{Binding CleanupFiles}" MaxHeight="150"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding RelativePath}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding RelativePath}" /></DataTemplate></ListBox.ItemTemplate></ListBox>
            <CheckBox Name="ConfirmToolCleanup" Content="{loc:Loc tb384e1a1f1d60c93}" IsChecked="{Binding ConfirmCleanup}" IsEnabled="{Binding CanUseTools}" />
            <Button Name="MoveToolLogsButton" Content="{loc:Loc t8403e0cafe60b618}" Command="{Binding MoveCleanupCommand}" HorizontalAlignment="Left" />
          </StackPanel>
          <WrapPanel IsVisible="{Binding HasCleanupControls}"><Button Name="RestoreToolLogsButton" Classes="flat" Content="{loc:Loc ta722be7756e1fc76}" Command="{Binding RestoreCleanupCommand}" ToolTip.Tip="{loc:Loc t60a858211dee3b61}" /></WrapPanel>
          <Button Content="{loc:Loc t2cd0f3be8738a86c}" Command="{Binding CancelCommand}" IsVisible="{Binding IsActionsBusy}" HorizontalAlignment="Left" />
        </StackPanel></Border>
        <Border Name="LauncherCacheCard" Classes="card"><StackPanel Spacing="10">
          <DockPanel><views:LoadingGlyph DockPanel.Dock="Right" Width="24" Height="24" IsVisible="{Binding IsCacheBusy}" /><TextBlock Text="{loc:Loc tb8ba15d4796732d9}" Classes="sectionTitle" /></DockPanel>
          <Button Name="ScanLauncherCacheButton" Content="{loc:Loc t8a839ce77df0440e}" Command="{Binding ScanCacheCommand}" HorizontalAlignment="Left" ToolTip.Tip="{loc:Loc t607ab1620f6391d1}" />
          <TextBlock Name="LauncherCacheFeedback" Text="{Binding CacheFeedback}" IsVisible="{Binding HasCacheFeedback}" TextWrapping="Wrap" />
          <StackPanel IsVisible="{Binding HasCachePreview}" Spacing="8"><ListBox Name="LauncherCachePreview" ItemsSource="{Binding CacheFiles}" MaxHeight="140"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding RelativePath}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding RelativePath}" /></DataTemplate></ListBox.ItemTemplate></ListBox><CheckBox Name="ConfirmLauncherCacheCleanup" Content="{loc:Loc t1edab91bd1649eed}" IsChecked="{Binding ConfirmCache}" /><Button Name="ClearLauncherCacheButton" Content="{loc:Loc tb2fd2e2a883cd7a2}" Command="{Binding ClearCacheCommand}" HorizontalAlignment="Left" /></StackPanel>
          <Button Name="CancelLauncherCacheButton" Content="{loc:Loc t2cd0f3be8738a86c}" IsVisible="{Binding IsCacheBusy}" Command="{Binding CancelCommand}" HorizontalAlignment="Left" />
        </StackPanel></Border>
        <Border Name="CustomDownloadCard" Classes="card" MinHeight="240"><StackPanel Spacing="10" VerticalAlignment="Top">
          <DockPanel><views:LoadingGlyph DockPanel.Dock="Right" Width="24" Height="24" IsVisible="{Binding IsDownloadBusy}" /><TextBlock Name="CustomDownloadTitle" Text="{loc:Loc td1647ab99edddd86}" Classes="sectionTitle" ToolTip.Tip="{loc:Loc t673b2f5bb190baeb}" LineHeight="18" /></DockPanel>
          <Grid ColumnDefinitions="78,*" RowDefinitions="Auto,10,Auto,10,Auto" Margin="10,0">
            <TextBlock Text="{loc:Loc t7b2e800cb995cee6}" VerticalAlignment="Center" /><TextBox Height="28" Grid.Column="1" Name="CustomDownloadUrl" Text="{Binding DownloadUrl}" IsEnabled="{Binding CanUseTools}" />
            <TextBlock Grid.Row="2" Text="{loc:Loc te31cccd7bba006f5}" VerticalAlignment="Center" /><Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*,8,45"><TextBox Name="ToolDownloadDirectory" Height="28" Text="{Binding DownloadDirectory}" IsEnabled="{Binding CanUseTools}" /><Button Name="PickToolDownloadDirectoryButton" Grid.Column="2" Classes="flat" Content="{loc:Loc tc11330b85234f9c0}" Click="PickDownloadDirectory_Click" IsEnabled="{Binding CanUseTools}" /></Grid>
            <TextBlock Grid.Row="4" Text="{loc:Loc ta6e48adc26d686d7}" VerticalAlignment="Center" /><TextBox Name="ToolDownloadFileName" Height="28" Grid.Row="4" Grid.Column="1" Text="{Binding DownloadName}" IsEnabled="{Binding CanUseTools}" />
          </Grid>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="15"><Button Name="CustomDownloadButton" Content="{loc:Loc t541961415c3d4b09}" Command="{Binding DownloadCommand}" MinWidth="140" Height="35" /><Button Content="{loc:Loc tfcf8b4bff0df782d}" Command="{Binding OpenDownloadDirectoryCommand}" MinWidth="140" Height="35" /><Button Content="{loc:Loc t2cd0f3be8738a86c}" Command="{Binding CancelCommand}" IsVisible="{Binding IsDownloadBusy}" /></StackPanel>
          <TextBlock Name="ToolDownloadFeedback" Text="{Binding DownloadFeedback}" IsVisible="{Binding HasDownloadFeedback}" TextWrapping="Wrap" />
        </StackPanel></Border>
        <Border Name="SkinDownloadCard" Classes="card" MinHeight="149"><StackPanel Spacing="12">
          <DockPanel><views:LoadingGlyph DockPanel.Dock="Right" Width="24" Height="24" IsVisible="{Binding IsSkinBusy}" /><TextBlock Text="{loc:Loc t3b9c27e43bbdafc2}" Classes="sectionTitle" LineHeight="18" /></DockPanel>
          <Grid ColumnDefinitions="90,*" Margin="10,10,10,0"><TextBlock Text="{loc:Loc t23f40c8649af757e}" VerticalAlignment="Center" /><TextBox Name="ToolSkinPlayerName" Height="28" Grid.Column="1" Text="{Binding SkinPlayerName}" IsEnabled="{Binding CanUseTools}" /></Grid>
          <StackPanel Orientation="Horizontal" Spacing="10"><Button Name="SavePublicSkinButton" Content="{loc:Loc t772d00472094988f}" Click="SavePublicSkin_Click" IsEnabled="{Binding CanUseTools}" MinWidth="140" Margin="10,0" Height="35" /><Button Content="{loc:Loc t2cd0f3be8738a86c}" Command="{Binding CancelCommand}" IsVisible="{Binding IsSkinBusy}" /></StackPanel>
          <TextBlock Name="ToolSkinFeedback" Text="{Binding SkinFeedback}" IsVisible="{Binding HasSkinFeedback}" TextWrapping="Wrap" />
        </StackPanel></Border>
        <Border Name="ServerQueryCard" Classes="card"><StackPanel Spacing="6">
          <DockPanel><views:LoadingGlyph DockPanel.Dock="Right" Width="24" Height="24" IsVisible="{Binding IsServerBusy}" /><TextBlock Text="{loc:Loc t8a991189eccf79e6}" Classes="sectionTitle" LineHeight="18" /></DockPanel>
          <Grid ColumnDefinitions="*,15,60"><TextBox Height="28" Name="ToolServerAddress" PlaceholderText="{loc:Loc td9b0c560be91190d}" Text="{Binding ServerAddress}" IsEnabled="{Binding CanUseTools}" /><Button Name="QueryToolServerButton" Grid.Column="2" Content="{loc:Loc tbcd6771e08ec7cc7}" Command="{Binding QueryServerCommand}" /></Grid>
          <TextBlock Name="ToolServerFeedback" Text="{Binding ServerFeedback}" IsVisible="{Binding HasServerFeedback}" TextWrapping="Wrap" /><Button Content="{loc:Loc t2cd0f3be8738a86c}" Command="{Binding CancelCommand}" IsVisible="{Binding IsServerBusy}" HorizontalAlignment="Left" />
        </StackPanel></Border>
        <Expander Name="AchievementGenerator" Classes="toolGenerator" Header="{loc:Loc t75634ded8879d1fd}"><StackPanel Margin="25,0,25,20" Spacing="10">
          <ComboBox Name="LegacyAchievementIconSelector" ItemsSource="{Binding LegacyItemNames}" SelectedItem="{Binding ItemId}" PlaceholderText="{loc:Loc tc11d47b1f0ae67cc}" IsEnabled="{Binding CanUseTools}" /><Grid ColumnDefinitions="116,*" RowDefinitions="Auto,10,Auto,10,Auto,10,Auto"><TextBlock Text="{loc:Loc t99ccd224125072c0}" VerticalAlignment="Center" /><Grid Grid.Column="1" ColumnDefinitions="*,10,Auto"><TextBox Name="ToolAchievementItem" Text="{Binding ItemId}" IsEnabled="{Binding CanUseTools}" ToolTip.Tip="{loc:Loc tf6455df7788dd4b1}" /><Button Name="PickAchievementIconButton" Grid.Column="2" Content="{loc:Loc t6d8adad124d0987f}" Click="PickItemIcon_Click" IsEnabled="{Binding CanUseTools}" /></Grid><TextBlock Grid.Row="2" Text="{loc:Loc t286ca3cb5a195748}" VerticalAlignment="Center" /><TextBox Name="ToolAchievementTitle" Grid.Row="2" Grid.Column="1" Text="{Binding AchievementTitle}" IsEnabled="{Binding CanUseTools}" /><TextBlock Grid.Row="4" Text="{loc:Loc t5e9d0ede025b4748}" VerticalAlignment="Center" /><TextBox Name="ToolAchievementLine1" Height="28" Grid.Row="4" Grid.Column="1" Text="{Binding AchievementLine1}" IsEnabled="{Binding CanUseTools}" /><TextBlock Grid.Row="6" Text="{loc:Loc t8190cc058c7298e2}" VerticalAlignment="Center" /><TextBox Name="ToolAchievementLine2" Height="28" Grid.Row="6" Grid.Column="1" Text="{Binding AchievementLine2}" IsEnabled="{Binding CanUseTools}" /></Grid>
          <Image Name="ToolAchievementPreview" Source="{Binding AchievementPreview}" IsVisible="{Binding HasAchievement}" MaxWidth="640" Stretch="Uniform" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="15" Margin="0,7,0,0"><Button Name="PreviewToolAchievementButton" Content="{loc:Loc t1c85853c3c254289}" Classes="primary" Command="{Binding PreviewAchievementCommand}" MinWidth="140" Height="35" /><Button Name="SaveToolAchievementButton" Content="{loc:Loc t850de13a01d9b482}" Click="SaveAchievement_Click" IsEnabled="{Binding HasAchievement}" MinWidth="140" Height="35" /></StackPanel>
          <TextBlock Text="{Binding ImageFeedback}" IsVisible="{Binding HasImageFeedback}" TextWrapping="Wrap" />
        </StackPanel></Expander>
        <Expander Name="AvatarGenerator" Classes="toolGenerator" Header="{loc:Loc tc93593d81c35f544}"><StackPanel Margin="25,0,25,20" Spacing="10">
          <Grid ColumnDefinitions="76,*"><TextBlock Text="{loc:Loc t9d345873c5e799d2}" VerticalAlignment="Center" /><ComboBox Name="ToolAvatarSize" Grid.Column="1" SelectedIndex="{Binding AvatarSizeIndex}" IsEnabled="{Binding CanUseTools}"><ComboBoxItem Content="64×64" /><ComboBoxItem Content="128×128" /><ComboBoxItem Content="256×256" /></ComboBox></Grid>
          <Image Name="ToolAvatarPreview" Source="{Binding AvatarPreview}" IsVisible="{Binding HasAvatar}" Width="128" Height="128" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="None" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10"><Button Name="PickToolAvatarSkinButton" Content="{loc:Loc t8e3726813b56a63d}" Click="PickAvatarSkin_Click" IsEnabled="{Binding CanUseTools}" MinWidth="140" Height="35" /><Button Name="SaveToolAvatarButton" Content="{loc:Loc t36217e670f6e322e}" Click="SaveAvatar_Click" IsEnabled="{Binding HasAvatar}" MinWidth="140" Height="35" /></StackPanel>
          <TextBlock Text="{Binding AvatarFeedback}" IsVisible="{Binding HasAvatarFeedback}" TextWrapping="Wrap" />
        </StackPanel></Expander>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
