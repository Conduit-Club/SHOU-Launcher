<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:themes="using:SHOU.Launcher.Desktop.Themes" xmlns:views="using:SHOU.Launcher.Desktop.Views" x:Class="SHOU.Launcher.Desktop.Views.ToolsView">
  <UserControl.Styles>

    <Style Selector="Expander.toolGenerator /template/ ToggleButton"><Setter Property="MinHeight" Value="39" /></Style>
  </UserControl.Styles>
  <Grid ColumnDefinitions="121,*">
    <Border Background="{DynamicResource ClubSidebar}" BorderBrush="{DynamicResource ClubBorder}" BorderThickness="0,0,1,0">
      <StackPanel>
        <TextBlock Classes="contextHeading" Text="运行环境" />
        <ToggleButton Name="JavaTrustNavigationButton" Classes="contextNavigation" IsChecked="{Binding IsJavaTrust, Mode=OneWay}" Command="{Binding ShowJavaTrustCommand}">
          <StackPanel Orientation="Horizontal" Spacing="10"><views:ClubIcon Classes="contextIcon" Kind="{x:Static themes:ClubIcons.Settings}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" /><TextBlock Text="Java 证书" Classes="navigationLabel" /></StackPanel>
        </ToggleButton>
        <TextBlock Classes="contextHeading" Text="奇妙小工具" />
        <ToggleButton Name="ToolboxNavigationButton" Classes="contextNavigation" IsChecked="{Binding IsToolbox, Mode=OneWay}" Command="{Binding ShowToolboxCommand}">
          <StackPanel Orientation="Horizontal" Spacing="10"><views:ClubIcon Classes="contextIcon" Kind="{x:Static themes:ClubIcons.Toolbox}" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" /><TextBlock Text="百宝箱" Classes="navigationLabel" /></StackPanel>
        </ToggleButton>
      </StackPanel>
    </Border>
    <ScrollViewer Grid.Column="1" Name="JavaTrustPage" IsVisible="{Binding IsJavaTrust}" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="25" Spacing="15">
        <Border Classes="card"><StackPanel Spacing="10"><TextBlock Text="Java 证书诊断与修复" Classes="sectionTitle"  ToolTip.Tip="检查所选 Java；需要修复时创建独立副本，核验后由你决定是否选用。"/><Button Content="管理默认 Java" Command="{Binding ShowJavaSettingsCommand}" HorizontalAlignment="Left" /></StackPanel></Border>
        <views:JavaTrustToolsView DataContext="{Binding JavaTrust}" />
      </StackPanel>
    </ScrollViewer>
    <ScrollViewer Grid.Column="1" Name="ToolboxPage" IsVisible="{Binding IsToolbox}" HorizontalScrollBarVisibility="Disabled">
      <StackPanel Margin="25" Spacing="15" DataContext="{Binding Toolbox}">
        <Border Name="ToolCommunityCard" Classes="card"><StackPanel Spacing="10"><TextBlock Text="社团入口" Classes="sectionTitle" /><WrapPanel><Button Content="社团 Wiki" Command="{Binding Root.Home.OpenWikiCommand}" Margin="0,0,10,0" /><Button Content="登录与入服指南" Command="{Binding Root.Home.OpenGuideCommand}" Margin="0,0,10,0" /><Button Name="ToolCommunityUpdatesButton" Content="社团更新日志" Command="{Binding OpenCommunityUpdatesCommand}" Margin="0,0,10,0" /><Button Content="启动器日志" Command="{Binding Root.ShowLogsCommand}" /></WrapPanel></StackPanel></Border>
        <Border Name="ToolboxActionsCard" Classes="card"><StackPanel Spacing="10">
          <DockPanel><views:LoadingGlyph DockPanel.Dock="Right" Width="24" Height="24" IsVisible="{Binding IsActionsBusy}" /><TextBlock Text="百宝箱" Classes="sectionTitle" LineHeight="18" /></DockPanel>
          <WrapPanel Margin="10,0,0,0"><Button Name="ScanGameLogsButton" Content="清理游戏垃圾" Command="{Binding ScanCleanupCommand}" ToolTip.Tip="预览超过一天的游戏日志、崩溃报告，确认后移入可恢复目录。保留存档、模组、截图和配置。" MinWidth="120" Height="35" Margin="0,0,15,0" /><Button Name="DailyFortuneButton" Content="今日人品" Command="{Binding FortuneCommand}" MinWidth="100" Height="35" Margin="0,0,15,0" /><Button Name="CreateLauncherShortcutButton" Content="创建快捷方式" Click="CreateShortcut_Click" IsEnabled="{Binding CanUseTools}" MinWidth="120" Height="35" Margin="0,0,15,0" /><Button Name="ToolLaunchCountButton" Content="查看启动计数" Command="{Binding LaunchCountCommand}" MinWidth="120" Height="35" /></WrapPanel>
          <TextBlock Name="ToolActionFeedback" Text="{Binding ActionFeedback}" IsVisible="{Binding HasActionFeedback}" TextWrapping="Wrap" />
          <StackPanel IsVisible="{Binding HasCleanupPreview}" Spacing="8">
            <ListBox Name="ToolCleanupFiles" ItemsSource="{Binding CleanupFiles}" MaxHeight="150"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding RelativePath}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding RelativePath}" /></DataTemplate></ListBox.ItemTemplate></ListBox>
            <CheckBox Name="ConfirmToolCleanup" Content="确认将以上日志移入回收目录" IsChecked="{Binding ConfirmCleanup}" IsEnabled="{Binding CanUseTools}" />
            <Button Name="MoveToolLogsButton" Content="移入回收目录" Command="{Binding MoveCleanupCommand}" HorizontalAlignment="Left" />
          </StackPanel>
          <WrapPanel IsVisible="{Binding HasCleanupControls}"><Button Name="RestoreToolLogsButton" Classes="flat" Content="恢复最近一次清理" Command="{Binding RestoreCleanupCommand}" ToolTip.Tip="恢复最近一次仍有回收文件的清理；原位置有同名文件时不会覆盖。" /></WrapPanel>
          <Button Content="取消" Command="{Binding CancelCommand}" IsVisible="{Binding IsActionsBusy}" HorizontalAlignment="Left" />
        </StackPanel></Border>
        <Border Name="LauncherCacheCard" Classes="card"><StackPanel Spacing="10">
          <DockPanel><views:LoadingGlyph DockPanel.Dock="Right" Width="24" Height="24" IsVisible="{Binding IsCacheBusy}" /><TextBlock Text="启动器缓存" Classes="sectionTitle" /></DockPanel>
          <Button Name="ScanLauncherCacheButton" Content="扫描缓存" Command="{Binding ScanCacheCommand}" HorizontalAlignment="Left" ToolTip.Tip="扫描可重新下载的版本目录、资源、依赖与旧临时文件；保留导出、账户、实例、Java 和正在下载的文件。" />
          <TextBlock Name="LauncherCacheFeedback" Text="{Binding CacheFeedback}" IsVisible="{Binding HasCacheFeedback}" TextWrapping="Wrap" />
          <StackPanel IsVisible="{Binding HasCachePreview}" Spacing="8"><ListBox Name="LauncherCachePreview" ItemsSource="{Binding CacheFiles}" MaxHeight="140"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding RelativePath}" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding RelativePath}" /></DataTemplate></ListBox.ItemTemplate></ListBox><CheckBox Name="ConfirmLauncherCacheCleanup" Content="确认清理预览中的缓存，之后按需重新下载" IsChecked="{Binding ConfirmCache}" /><Button Name="ClearLauncherCacheButton" Content="清理缓存" Command="{Binding ClearCacheCommand}" HorizontalAlignment="Left" /></StackPanel>
          <Button Name="CancelLauncherCacheButton" Content="取消" IsVisible="{Binding IsCacheBusy}" Command="{Binding CancelCommand}" HorizontalAlignment="Left" />
        </StackPanel></Border>
        <Border Name="CustomDownloadCard" Classes="card" MinHeight="240"><StackPanel Spacing="10" VerticalAlignment="Top">
          <DockPanel><views:LoadingGlyph DockPanel.Dock="Right" Width="24" Height="24" IsVisible="{Binding IsDownloadBusy}" /><TextBlock Name="CustomDownloadTitle" Text="下载自定义文件" Classes="sectionTitle" ToolTip.Tip="保存 HTTP(S) 文件，最多 512 MiB；不会运行下载内容，已有文件不会被覆盖。" LineHeight="18" /></DockPanel>
          <Grid ColumnDefinitions="78,*" RowDefinitions="Auto,10,Auto,10,Auto" Margin="10,0">
            <TextBlock Text="下载地址" VerticalAlignment="Center" /><TextBox Height="28" Grid.Column="1" Name="CustomDownloadUrl" Text="{Binding DownloadUrl}" IsEnabled="{Binding CanUseTools}" />
            <TextBlock Grid.Row="2" Text="保存到" VerticalAlignment="Center" /><Grid Grid.Row="2" Grid.Column="1" ColumnDefinitions="*,8,45"><TextBox Name="ToolDownloadDirectory" Height="28" Text="{Binding DownloadDirectory}" IsEnabled="{Binding CanUseTools}" /><Button Name="PickToolDownloadDirectoryButton" Grid.Column="2" Classes="flat" Content="选择" Click="PickDownloadDirectory_Click" IsEnabled="{Binding CanUseTools}" /></Grid>
            <TextBlock Grid.Row="4" Text="文件名" VerticalAlignment="Center" /><TextBox Name="ToolDownloadFileName" Height="28" Grid.Row="4" Grid.Column="1" Text="{Binding DownloadName}" IsEnabled="{Binding CanUseTools}" />
          </Grid>
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="15"><Button Name="CustomDownloadButton" Content="开始下载" Command="{Binding DownloadCommand}" MinWidth="140" Height="35" /><Button Content="打开文件夹" Command="{Binding OpenDownloadDirectoryCommand}" MinWidth="140" Height="35" /><Button Content="取消" Command="{Binding CancelCommand}" IsVisible="{Binding IsDownloadBusy}" /></StackPanel>
          <TextBlock Name="ToolDownloadFeedback" Text="{Binding DownloadFeedback}" IsVisible="{Binding HasDownloadFeedback}" TextWrapping="Wrap" />
        </StackPanel></Border>
        <Border Name="SkinDownloadCard" Classes="card" MinHeight="149"><StackPanel Spacing="12">
          <DockPanel><views:LoadingGlyph DockPanel.Dock="Right" Width="24" Height="24" IsVisible="{Binding IsSkinBusy}" /><TextBlock Text="下载正版玩家的皮肤" Classes="sectionTitle" LineHeight="18" /></DockPanel>
          <Grid ColumnDefinitions="90,*" Margin="10,10,10,0"><TextBlock Text="正版玩家名" VerticalAlignment="Center" /><TextBox Name="ToolSkinPlayerName" Height="28" Grid.Column="1" Text="{Binding SkinPlayerName}" IsEnabled="{Binding CanUseTools}" /></Grid>
          <StackPanel Orientation="Horizontal" Spacing="10"><Button Name="SavePublicSkinButton" Content="保存皮肤" Click="SavePublicSkin_Click" IsEnabled="{Binding CanUseTools}" MinWidth="140" Margin="10,0" Height="35" /><Button Content="取消" Command="{Binding CancelCommand}" IsVisible="{Binding IsSkinBusy}" /></StackPanel>
          <TextBlock Name="ToolSkinFeedback" Text="{Binding SkinFeedback}" IsVisible="{Binding HasSkinFeedback}" TextWrapping="Wrap" />
        </StackPanel></Border>
        <Border Name="ServerQueryCard" Classes="card"><StackPanel Spacing="6">
          <DockPanel><views:LoadingGlyph DockPanel.Dock="Right" Width="24" Height="24" IsVisible="{Binding IsServerBusy}" /><TextBlock Text="瞅眼服务器" Classes="sectionTitle" LineHeight="18" /></DockPanel>
          <Grid ColumnDefinitions="*,15,60"><TextBox Height="28" Name="ToolServerAddress" PlaceholderText="输入服务器地址" Text="{Binding ServerAddress}" IsEnabled="{Binding CanUseTools}" /><Button Name="QueryToolServerButton" Grid.Column="2" Content="查询" Command="{Binding QueryServerCommand}" /></Grid>
          <TextBlock Name="ToolServerFeedback" Text="{Binding ServerFeedback}" IsVisible="{Binding HasServerFeedback}" TextWrapping="Wrap" /><Button Content="取消" Command="{Binding CancelCommand}" IsVisible="{Binding IsServerBusy}" HorizontalAlignment="Left" />
        </StackPanel></Border>
        <Expander Name="AchievementGenerator" Classes="toolGenerator" Header="自定义成就图片生成器（仅支持英文）"><StackPanel Margin="25,0,25,20" Spacing="10">
          <ComboBox Name="LegacyAchievementIconSelector" ItemsSource="{Binding LegacyItemNames}" SelectedItem="{Binding ItemId}" PlaceholderText="旧物品图标库" IsEnabled="{Binding CanUseTools}" /><Grid ColumnDefinitions="116,*" RowDefinitions="Auto,10,Auto,10,Auto,10,Auto"><TextBlock Text="物品名（ID）" VerticalAlignment="Center" /><Grid Grid.Column="1" ColumnDefinitions="*,10,Auto"><TextBox Name="ToolAchievementItem" Text="{Binding ItemId}" IsEnabled="{Binding CanUseTools}" ToolTip.Tip="支持旧生成器全部 39 个图标；数字 1–39 是图标序号，也可使用英文名或自选 PNG。" /><Button Name="PickAchievementIconButton" Grid.Column="2" Content="选择图标" Click="PickItemIcon_Click" IsEnabled="{Binding CanUseTools}" /></Grid><TextBlock Grid.Row="2" Text="成就名" VerticalAlignment="Center" /><TextBox Name="ToolAchievementTitle" Grid.Row="2" Grid.Column="1" Text="{Binding AchievementTitle}" IsEnabled="{Binding CanUseTools}" /><TextBlock Grid.Row="4" Text="第一行" VerticalAlignment="Center" /><TextBox Name="ToolAchievementLine1" Height="28" Grid.Row="4" Grid.Column="1" Text="{Binding AchievementLine1}" IsEnabled="{Binding CanUseTools}" /><TextBlock Grid.Row="6" Text="第二行（可选）" VerticalAlignment="Center" /><TextBox Name="ToolAchievementLine2" Height="28" Grid.Row="6" Grid.Column="1" Text="{Binding AchievementLine2}" IsEnabled="{Binding CanUseTools}" /></Grid>
          <Image Name="ToolAchievementPreview" Source="{Binding AchievementPreview}" IsVisible="{Binding HasAchievement}" MaxWidth="640" Stretch="Uniform" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="15" Margin="0,7,0,0"><Button Name="PreviewToolAchievementButton" Content="预览成就图像" Classes="primary" Command="{Binding PreviewAchievementCommand}" MinWidth="140" Height="35" /><Button Name="SaveToolAchievementButton" Content="保存图片" Click="SaveAchievement_Click" IsEnabled="{Binding HasAchievement}" MinWidth="140" Height="35" /></StackPanel>
          <TextBlock Text="{Binding ImageFeedback}" IsVisible="{Binding HasImageFeedback}" TextWrapping="Wrap" />
        </StackPanel></Expander>
        <Expander Name="AvatarGenerator" Classes="toolGenerator" Header="皮肤头像生成器"><StackPanel Margin="25,0,25,20" Spacing="10">
          <Grid ColumnDefinitions="76,*"><TextBlock Text="头像大小：" VerticalAlignment="Center" /><ComboBox Name="ToolAvatarSize" Grid.Column="1" SelectedIndex="{Binding AvatarSizeIndex}" IsEnabled="{Binding CanUseTools}"><ComboBoxItem Content="64×64" /><ComboBoxItem Content="128×128" /><ComboBoxItem Content="256×256" /></ComboBox></Grid>
          <Image Name="ToolAvatarPreview" Source="{Binding AvatarPreview}" IsVisible="{Binding HasAvatar}" Width="128" Height="128" Stretch="Uniform" RenderOptions.BitmapInterpolationMode="None" />
          <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10"><Button Name="PickToolAvatarSkinButton" Content="选择皮肤" Click="PickAvatarSkin_Click" IsEnabled="{Binding CanUseTools}" MinWidth="140" Height="35" /><Button Name="SaveToolAvatarButton" Content="保存头像" Click="SaveAvatar_Click" IsEnabled="{Binding HasAvatar}" MinWidth="140" Height="35" /></StackPanel>
          <TextBlock Text="{Binding AvatarFeedback}" IsVisible="{Binding HasAvatarFeedback}" TextWrapping="Wrap" />
        </StackPanel></Expander>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
