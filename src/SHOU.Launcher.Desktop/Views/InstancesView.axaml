<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="using:SHOU.Launcher.Desktop.Localization" xmlns:themes="using:SHOU.Launcher.Desktop.Themes" xmlns:views="using:SHOU.Launcher.Desktop.Views" x:Class="SHOU.Launcher.Desktop.Views.InstancesView" x:Name="InstancePage" AttachedToVisualTree="WorkspaceAttached" DetachedFromVisualTree="WorkspaceDetached" DataContextChanged="WorkspaceDataContextChanged">
  <UserControl.Resources><views:SettingsPreferenceLabelConverter x:Key="GamePreferenceLabel" /><views:InstanceInfoConverter x:Key="InstanceInfo" /></UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="Button.resourceTool"><Setter Property="Margin" Value="3,0"/><Setter Property="Padding" Value="5,3"/><Setter Property="Height" Value="32"/><Setter Property="HorizontalAlignment" Value="Stretch"/><Setter Property="HorizontalContentAlignment" Value="Center"/></Style>
    <Style Selector="Button.resourceIcon"><Setter Property="Width" Value="24"/><Setter Property="Height" Value="24"/><Setter Property="MinHeight" Value="0"/><Setter Property="Padding" Value="3"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Foreground" Value="{DynamicResource ClubAccent}"/></Style>
    <Style Selector="Button.updateGlyph"><Setter Property="Width" Value="19"/><Setter Property="Height" Value="19"/><Setter Property="Opacity" Value="0.6"/></Style>
    <Style Selector="TextBox.resourceSearch /template/ Border#PART_BorderElement"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style Selector="ToggleButton.resourceFilter"><Setter Property="Padding" Value="10,4"/><Setter Property="MinHeight" Value="28"/><Setter Property="CornerRadius" Value="16"/><Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="{DynamicResource ClubAccent}"/><Setter Property="BorderThickness" Value="0"/><Setter Property="Template"><ControlTemplate><ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" Background="{TemplateBinding Background}" Foreground="{TemplateBinding Foreground}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"/></ControlTemplate></Setter></Style>
    <Style Selector="ToggleButton.resourceFilter:pointerover"><Setter Property="Background" Value="{DynamicResource ClubHover}"/></Style>
    <Style Selector="ToggleButton.resourceFilter:checked"><Setter Property="Background" Value="{DynamicResource ClubAccent}"/><Setter Property="Foreground" Value="{DynamicResource ClubTitleForeground}"/></Style>
    <Style Selector="ToggleButton.resourceFilter:checked /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="{DynamicResource ClubAccent}"/><Setter Property="Foreground" Value="{DynamicResource ClubTitleForeground}"/></Style>
    <Style Selector="Border.resourceRow"><Setter Property="Padding" Value="5,0"/><Setter Property="CornerRadius" Value="3"/><Setter Property="BorderThickness" Value="1"/><Setter Property="BorderBrush" Value="Transparent"/></Style>
    <Style Selector="Border.resourceRow.selected"><Setter Property="Background" Value="{DynamicResource ClubSelection}"/><Setter Property="BorderBrush" Value="{DynamicResource ClubBorder}"/></Style>
    <Style Selector="StackPanel.rowActions, CheckBox.resourceSelection"><Setter Property="Opacity" Value="0"/></Style>
    <Style Selector="ListBoxItem:pointerover StackPanel.rowActions, ListBoxItem:focus-within StackPanel.rowActions, Border.resourceRow.selected StackPanel.rowActions, ListBoxItem:focus-within CheckBox.resourceSelection, Border.resourceRow.selected CheckBox.resourceSelection"><Setter Property="Opacity" Value="1"/></Style>
    <Style Selector="Border.resourceRow.selected Grid.resourceArtwork"><Setter Property="Opacity" Value="0.2"/></Style>
    <Style Selector="ListBox#ExistingInstanceSelector ListBoxItem"><Setter Property="AutomationProperties.Name" Value="{Binding Name}" /></Style>
    <Style Selector="ListBox.instanceList"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style Selector="ListBox#InstanceFolderSelector ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="AutomationProperties.Name" Value="{Binding Title}"/></Style>
    <Style Selector="ListBox#InstanceFolderSelector ListBoxItem:selected /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource ClubSelection}"/></Style>
    <Style Selector="ListBox#InstanceFolderSelector ListBoxItem:selected TextBlock"><Setter Property="Foreground" Value="{DynamicResource ClubAccent}"/></Style>
    <Style Selector="ListBox.instanceList ListBoxItem"><Setter Property="Padding" Value="10,7"/><Setter Property="CornerRadius" Value="3"/><Setter Property="Margin" Value="0,1"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="AutomationProperties.Name" Value="{Binding Name}"/></Style>
    <Style Selector="ListBox.instanceList ListBoxItem:selected /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource ClubSelection}"/></Style>
    <Style Selector="TextBlock.instanceLabel"><Setter Property="Width" Value="105"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
    <Style Selector="ListBox.instanceNavigation ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="MinHeight" Value="36"/><Setter Property="Margin" Value="0"/><Setter Property="AutomationProperties.Name" Value="{Binding Title}"/></Style>
    <Style Selector="ListBox.instanceNavigation ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="{DynamicResource ClubSelectionForeground}"/><Setter Property="BorderThickness" Value="3,0,0,0"/></Style>
    <Style Selector="ListBox.instanceNavigation ListBoxItem:selected TextBlock"><Setter Property="Foreground" Value="{DynamicResource ClubSelectionForeground}"/></Style>
    <Style Selector="ListBox.instanceNavigation ListBoxItem:selected Path"><Setter Property="Stroke" Value="{DynamicResource ClubSelectionForeground}"/></Style>
    <Style Selector="ListBox.resourceList#InstanceContentList ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0"/><Setter Property="MinHeight" Value="0"/></Style>
    <Style Selector="ListBox.resourceList#InstanceContentList ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent"/></Style>
    <Style Selector="ListBox.resourceList#InstanceContentList ListBoxItem:pointerover Border.resourceRow"><Setter Property="Background" Value="{DynamicResource ClubHover}"/><Setter Property="BorderBrush" Value="{DynamicResource ClubBorder}"/></Style>
  </UserControl.Styles>
  <Grid>
    <Grid ColumnDefinitions="175,*" IsVisible="{Binding IsSelection}">
      <Border Background="{DynamicResource ClubSidebar}" Padding="12,15">
        <StackPanel Spacing="10"><TextBlock Text="文件夹列表" Classes="muted" LineHeight="16" FontSize="11"/>
          <ListBox Name="InstanceFolderSelector" ItemsSource="{Binding GameFolders}" SelectedItem="{Binding SelectedGameFolder}" Background="Transparent" BorderThickness="0" MaxHeight="200" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate><StackPanel Spacing="3" ToolTip.Tip="{Binding Path}"><TextBlock Text="{Binding Title}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxLines="1"/><TextBlock Text="{Binding Path}" IsVisible="{Binding HasPath}" Classes="muted" FontSize="11" LineHeight="16" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxLines="1"/></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox>
          <TextBlock Text="添加或导入" Classes="muted" FontSize="11" Margin="0,10,0,0"/>
          <Button Name="AttachExistingFolderButton" Click="PickExistingFolder_Click" IsEnabled="{Binding CanEdit}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Classes="flat"><Grid ColumnDefinitions="22,8,*"><views:ClubIcon Kind="folder-input"/><TextBlock Grid.Column="2" Text="添加已有文件夹"/></Grid></Button>
          <Button Name="OpenInstancePackImport" Command="{Binding OpenPackImportCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Classes="flat"><Grid ColumnDefinitions="22,8,*"><views:ClubIcon Kind="package-plus"/><TextBlock Grid.Column="2" Text="导入整合包"/></Grid></Button>
          <Button Name="ManageInstanceFoldersButton" Command="{Binding ManageGameDirectoryCommand}" HorizontalAlignment="Stretch" HorizontalContentAlignment="Left" Classes="flat"><Grid ColumnDefinitions="22,8,*"><views:ClubIcon Kind="settings"/><TextBlock Grid.Column="2" Text="管理游戏目录"/></Grid></Button>

        </StackPanel>
      </Border>
      <ScrollViewer Name="InstanceSelectionScroller" Grid.Column="1" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24" Spacing="12">
          <StackPanel Orientation="Horizontal" Spacing="8" IsVisible="{Binding IsFolderBusy}" HorizontalAlignment="Right"><views:LoadingGlyph Width="22" Height="22"/><Button Name="CancelInstanceFolderReadButton" Content="{loc:Loc t2cd0f3be8738a86c}" Command="{Binding Root.CancelOperationCommand}" Classes="flat"/></StackPanel>
          <Border Name="ExistingInstancePreviewCard" Classes="card" IsVisible="{Binding HasExistingCandidates}"><StackPanel Spacing="10"><TextBlock Text="{loc:Loc te4926ee48a96fb12}" Classes="sectionTitle" /><ListBox Name="ExistingInstanceSelector" ItemsSource="{Binding ExistingCandidates}" SelectedItem="{Binding ExistingCandidate}" MaxHeight="220"><ListBox.ItemTemplate><DataTemplate><StackPanel Spacing="3"><TextBlock Text="{Binding Name}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxLines="1" ToolTip.Tip="{Binding Name}"/><TextBlock Text="{Binding GameDirectory}" TextWrapping="NoWrap" Classes="muted" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding GameVersion}" Classes="muted" /></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><StackPanel Orientation="Horizontal" Spacing="8"><Button Name="ConfirmAllExistingInstancesButton" Content="{Binding AttachAllCaption}" Command="{Binding AttachAllExistingCommand}" IsVisible="{Binding CanBatchAttach}"/><Button Name="ConfirmExistingInstanceButton" Content="{loc:Loc t3f5213203fd586ed}" Command="{Binding AttachExistingCommand}" /><Button Content="{loc:Loc t2cd0f3be8738a86c}" Command="{Binding DismissExistingCommand}" /></StackPanel></StackPanel></Border>
          <TextBox Name="InstanceSearch" Text="{Binding SearchText}" PlaceholderText="{loc:Loc t84781588451401d1}"/>
          <Grid ColumnDefinitions="*,Auto"><ComboBox Name="InstanceCategoryFilter" ItemsSource="{Binding CategoryFilters}" SelectedItem="{Binding InstanceCategoryFilter}" MaxWidth="240" HorizontalAlignment="Left"/><CheckBox Grid.Column="1" Name="FavoriteInstancesFilter" Content="{loc:Loc tcedfafe1bbd6fb1c}" IsChecked="{Binding FavoritesOnly}"/></Grid>
          <Border Classes="card" IsVisible="{Binding HasExistingIssues}"><ItemsControl Name="ExistingInstanceIssues" ItemsSource="{Binding ExistingIssues}"><ItemsControl.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" ToolTip.Tip="{Binding Reason}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></Border>
          <Border Classes="card"><StackPanel Spacing="10"><TextBlock Text="{Binding InstanceCountSummary}" FontWeight="SemiBold"/>
            <ListBox Name="InstanceSelector" Classes="instanceList" ItemsSource="{Binding FilteredInstances}" SelectedItem="{Binding SelectedInstance}" IsEnabled="{Binding CanEdit}" DoubleTapped="OpenSelectedInstance_DoubleTapped" KeyDown="OpenSelectedInstance_KeyDown">
              <ListBox.ItemTemplate><DataTemplate><Grid ColumnDefinitions="38,*" MinHeight="36"><views:InstanceArtwork Instance="{Binding}" Width="30" Height="30" VerticalAlignment="Center"/>
                <StackPanel Grid.Column="1" Spacing="2" VerticalAlignment="Center"><TextBlock Name="InstanceRowName" Text="{Binding Name}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" MaxLines="1" ToolTip.Tip="{Binding Name}"/>
                  <StackPanel Orientation="Horizontal" Spacing="5"><Border Background="{DynamicResource ClubSelection}" CornerRadius="2" Padding="3,0"><TextBlock Text="{Binding Converter={StaticResource InstanceInfo}}" Classes="muted" LineHeight="16" FontSize="11" TextWrapping="NoWrap"/></Border><TextBlock Text="{Binding Converter={StaticResource InstanceInfo}, ConverterParameter=loader}" Classes="muted" LineHeight="16" FontSize="11" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis"/></StackPanel>
                </StackPanel></Grid></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Orientation="Horizontal" Spacing="8"><Button Name="OpenInstanceSettingsButton" Content="{loc:Loc tcb5c4d21c9d75f2f}" Command="{Binding OpenSelectedVisibleInstanceCommand}"/><Button Content="{loc:Loc t97555304b0d7e196}" Command="{Binding Root.ShowDownloadsCommand}"/></StackPanel>
          </StackPanel></Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
    <Grid ColumnDefinitions="150,*" IsVisible="{Binding !IsSelection}">
      <Border Background="{DynamicResource ClubSidebar}" IsVisible="{Binding !IsWorldDetails}"><ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto"><StackPanel Margin="0,14,0,0" Spacing="4">
        <TextBlock Text="{loc:Loc te9faa1792d4db0b2}" Classes="contextHeading" Margin="13,0,0,6"/>
<ListBox Name="InstanceSectionNavigation" Classes="navigation instanceNavigation" ItemsSource="{Binding GameSections}" SelectedItem="{Binding SelectedSection}"><ListBox.ItemTemplate><DataTemplate><Grid ColumnDefinitions="24,10,*" Margin="18,0,12,0" MinHeight="40"><views:ClubIcon Classes="contextIcon" Kind="{Binding IconKind}" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Classes="navigationLabel" Text="{Binding Title}" VerticalAlignment="Center"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
        <TextBlock Name="InstanceResourcesHeading" Text="{loc:Loc t9b4eaaa18caee368}" Classes="contextHeading" Margin="18,18,0,8" LineHeight="20"/>
        <ListBox Name="InstanceResourceNavigation" Classes="navigation instanceNavigation" ItemsSource="{Binding ResourceSections}" SelectedItem="{Binding SelectedSection}"><ListBox.ItemTemplate><DataTemplate><Grid ColumnDefinitions="24,10,*" Margin="18,0,12,0" MinHeight="40"><views:ClubIcon Classes="contextIcon" Kind="{Binding IconKind}" VerticalAlignment="Center"/><TextBlock Grid.Column="2" Classes="navigationLabel" Text="{Binding Title}" VerticalAlignment="Center"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
      </StackPanel></ScrollViewer></Border>
      <ScrollViewer Name="InstancePageScroller" IsVisible="{Binding !IsWorldWorkspaceSection}" Grid.Column="1" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24" Spacing="14">
          <Border Classes="card" Padding="15,10" IsVisible="{Binding IsOverview}"><Grid ColumnDefinitions="38,*"><views:InstanceArtwork Instance="{Binding SelectedInstance}" Service="{Binding ArtworkService}" Width="30" Height="30" VerticalAlignment="Center" /><StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="{Binding SelectedInstance.Name}" FontSize="15" LineHeight="20" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" MaxLines="1" ToolTip.Tip="{Binding SelectedInstance.Name}"/><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="{Binding GameVersionLabel}" Classes="muted" FontSize="11" LineHeight="16"/><TextBlock Text="{Binding LoaderLabel}" Classes="muted"/><TextBlock Text="{Binding SelectedInstance.LoaderVersion}" Classes="muted"/></StackPanel></StackPanel></Grid></Border>
          <StackPanel IsVisible="{Binding IsOverview}" Spacing="14">
            <Border Classes="card" Padding="15,12"><StackPanel Spacing="8"><TextBlock Text="{loc:Loc t92b742d80072559b}" Classes="sectionTitle" LineHeight="18"/>
              <WrapPanel>
                <StackPanel Orientation="Horizontal" Spacing="9" Margin="5,0,30,0"><views:ClubIcon Kind="file-box" Width="28" Height="28"/><StackPanel><TextBlock Text="{loc:Loc t713dffe3e706a2f8}" FontSize="14" LineHeight="20"/><TextBlock Name="InstanceLaunchCount" Text="{Binding LaunchCountLabel}" Classes="muted" FontSize="12" LineHeight="16" ToolTip.Tip="{loc:Loc t0a2d96fa6891f03c}"/></StackPanel></StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="9" Margin="0,0,30,0"><views:ClubIcon Kind="{x:Static themes:ClubIcons.Cube}" Width="28" Height="28" /><StackPanel><TextBlock Text="Minecraft" FontSize="14" LineHeight="20"/><TextBlock Text="{Binding GameVersionLabel}" Classes="muted" FontSize="12" LineHeight="16"/></StackPanel></StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="9" IsVisible="{Binding HasModLoader}"><views:ClubIcon Kind="{x:Static themes:ClubIcons.Cloth}" Width="28" Height="28" /><StackPanel><TextBlock Text="{Binding LoaderLabel}" FontSize="14" LineHeight="20"/><TextBlock Text="{Binding SelectedInstance.LoaderVersion}" Classes="muted" FontSize="12" LineHeight="16"/></StackPanel></StackPanel>
              </WrapPanel>
            </StackPanel></Border>
            <Border Classes="card"><StackPanel Spacing="12"><TextBlock Text="{loc:Loc t38c043e08502e710}" Classes="sectionTitle" LineHeight="18"/>
              <Grid ColumnDefinitions="60,*" Margin="10,0"><TextBlock Text="{loc:Loc t0d720eeea26466dd}" VerticalAlignment="Center"/><ComboBox Name="InstanceIconSelector" Grid.Column="1" ItemsSource="{Binding InstanceIcons}" SelectedItem="{Binding PresentationIcon}" IsEnabled="{Binding CanEdit}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></Grid>
              <Button Name="ChooseInstanceIconImageButton" Content="选择图片并裁剪…" Click="PickInstanceIcon_Click" IsEnabled="{Binding CanEdit}" Margin="70,0,0,0" HorizontalAlignment="Left"/>
              <Grid ColumnDefinitions="60,*" Margin="10,0"><TextBlock Text="{loc:Loc t515559957fd3acbd}" VerticalAlignment="Center"/><ComboBox Name="InstanceCategorySelector" Grid.Column="1" ItemsSource="{Binding InstanceCategories}" SelectedItem="{Binding PresentationCategory}" IsEnabled="{Binding CanEdit}"/></Grid>
              <WrapPanel Margin="10,3,0,7"><Button Name="SaveInstanceNameButton" Content="{loc:Loc t28a39ead5f71b8b2}" Command="{Binding BeginRenameCommand}" Width="140" Height="35" Margin="0,0,20,0"/><Button Name="EditInstanceDescription" Content="{loc:Loc tc9d9331f6df13c83}" Command="{Binding EditDescriptionCommand}" Width="140" Height="35" Margin="0,0,20,0"/><Button Name="ToggleInstanceFavorite" Content="{Binding FavoriteCaption}" Command="{Binding ToggleFavoriteCommand}" Width="140" Height="35"/></WrapPanel>
              <StackPanel Orientation="Horizontal" Spacing="10"><Button Name="SaveInstancePresentation" Content="{loc:Loc t88ecdc10bcaeed51}" Command="{Binding SavePresentationCommand}"/><TextBlock Text="{Binding PresentationSummary}" Classes="muted" TextWrapping="Wrap" MaxWidth="360" VerticalAlignment="Center"/></StackPanel>
            </StackPanel></Border>
            <Border Classes="card"><StackPanel Spacing="12"><TextBlock Text="{loc:Loc t6ab335864461b295}" Classes="sectionTitle" LineHeight="18"/><WrapPanel Margin="10,0,0,7"><Button Content="{loc:Loc t737dc0aa07b51649}" Command="{Binding OpenInstanceDirectoryCommand}" Width="140" Height="35" Margin="0,0,20,0"/><Button Content="{loc:Loc tf6e37bd65d12b035}" Click="OpenSavesDirectory_Click" Width="140" Height="35" Margin="0,0,20,0"/><Button Content="{loc:Loc tc87d9c833d9720b2}" Click="OpenModsDirectory_Click" Width="140" Height="35"/></WrapPanel></StackPanel></Border>
            <Border Classes="card"><StackPanel Spacing="12"><TextBlock Text="{loc:Loc t58dbf974977f7f52}" Classes="sectionTitle"/>
              <WrapPanel><Button Name="InstallInstanceButton" Content="{loc:Loc te5c51732660c8bb5}" Command="{Binding InstallCommand}" Margin="0,0,10,8"/><Button Name="LaunchGameButton" Content="{Binding LaunchCaption}" Command="{Binding LaunchCommand}" Margin="0,0,10,8"/><Button Content="{loc:Loc t026e2a6c2e9b63dc}" Command="{Binding InspectPlanCommand}" Margin="0,0,10,8"/><Button Name="ExportLaunchScriptButton" Content="{loc:Loc t633eb5f8529a10f6}" Click="ExportLaunchScript_Click" IsEnabled="{Binding CanPrepareSelectedInstance}" ToolTip.Tip="先保存设置并关闭启动器，再运行脚本。脚本通过启动器读取当前账户，不包含登录凭据。" Margin="0,0,10,8"/></WrapPanel>
              <TextBlock Text="{Binding LaunchPrerequisite}" Classes="muted" LineHeight="16" FontSize="11"/>
              <TextBox Text="{Binding PlanDiagnostics}" IsVisible="{Binding HasPlanDiagnostics}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90"/>
            </StackPanel></Border>
          </StackPanel>
          <StackPanel IsVisible="{Binding IsInstanceSettings}" Spacing="14">
            <Border Classes="card"><StackPanel Spacing="12"><TextBlock Text="{loc:Loc t8dd0655d53256a1f}" Classes="sectionTitle"/>
              <Grid ColumnDefinitions="105,*"><TextBlock Text="游戏目录隔离" Classes="instanceLabel"/><ComboBox Name="InstanceDirectoryModeSetting" Grid.Column="1" ItemsSource="{Binding DirectoryModes}" SelectedItem="{Binding DirectoryMode}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding ., Converter={StaticResource GamePreferenceLabel}}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></Grid>
              <TextBlock Name="InstanceDirectoryPreview" Text="{Binding DirectoryPreview}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" ToolTip.Tip="{Binding DirectoryPreview}" Classes="muted"/>
              <CheckBox Name="ConfirmInstanceDirectoryChange" Content="切换到以上目录，保留原目录文件" IsVisible="{Binding DirectoryWillChange}" IsChecked="{Binding DirectoryChangeConfirmed}"/>
              <Button Name="ReadLegacyInstanceSettingsButton" Content="读取此实例的旧版设置" IsVisible="{Binding HasLegacySettings}" Click="ReadLegacySettings_Click" IsEnabled="{Binding CanEdit}"/>

              <CheckBox Name="InstanceFollowJavaSetting" Content="{loc:Loc t90516b535fd78607}" IsChecked="{Binding UseGlobalJava}"/>
              <Grid ColumnDefinitions="105,*"><TextBlock Text="{loc:Loc t9b8295587af9906d}" Classes="instanceLabel"/><TextBox Name="InstanceJavaExecutableSetting" Grid.Column="1" Text="{Binding InstanceJavaExecutable}" IsEnabled="{Binding !UseGlobalJava}" PlaceholderText="{loc:Loc t5f7469894e0eb5b2}"/></Grid>
              <CheckBox Name="InstanceFollowMemorySetting" Content="{loc:Loc ta20ece0a9ee45404}" IsChecked="{Binding UseGlobalMemory}"/>
              <Grid ColumnDefinitions="105,*"><TextBlock Text="{loc:Loc t7414a2c95ffa0a13}" Classes="instanceLabel"/><NumericUpDown Name="InstanceMemorySetting" Grid.Column="1" Minimum="512" Maximum="32768" Increment="256" Value="{Binding InstanceMemoryMiB}" IsEnabled="{Binding !UseGlobalMemory}"/></Grid>
              <CheckBox Name="InstanceFollowLaunchSettings" Content="{loc:Loc tffa1692cb8aef60b}" IsChecked="{Binding UseGlobalLaunchOptions}" />
              <StackPanel IsEnabled="{Binding !UseGlobalLaunchOptions}" Spacing="9">
                <Grid ColumnDefinitions="105,*"><TextBlock Text="{loc:Loc t6dfa4ea7d8c811fd}" Classes="instanceLabel" /><ComboBox Name="InstancePrioritySetting" Grid.Column="1" ItemsSource="{Binding Root.Settings.PriorityChoices}" SelectedItem="{Binding InstancePriority}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding ., Converter={StaticResource GamePreferenceLabel}}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox></Grid>
                <Grid ColumnDefinitions="105,*"><TextBlock Text="{loc:Loc t3f85718d9a70a26b}" Classes="instanceLabel" /><ComboBox Name="InstanceIpSetting" Grid.Column="1" ItemsSource="{Binding Root.Settings.IpChoices}" SelectedItem="{Binding InstanceIpPreference}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding ., Converter={StaticResource GamePreferenceLabel}}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox></Grid>
                <Grid ColumnDefinitions="105,*"><TextBlock Text="{loc:Loc t87f5b03f0660fc3e}" Classes="instanceLabel" /><ComboBox Name="InstanceVisibilitySetting" Grid.Column="1" ItemsSource="{Binding Root.Settings.VisibilityChoices}" SelectedItem="{Binding InstanceVisibility}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding ., Converter={StaticResource GamePreferenceLabel}}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox></Grid>
                <Grid ColumnDefinitions="105,*"><TextBlock Text="{loc:Loc tcd959f842f08bb65}" Classes="instanceLabel" /><TextBox Name="InstanceWindowTitleSetting" Grid.Column="1" Text="{Binding InstanceWindowTitle}" IsEnabled="{Binding Root.Settings.CanCustomizeGameTitle}" /></Grid>
                <Grid ColumnDefinitions="105,*"><TextBlock Text="{loc:Loc tc9173ee83b6a7e8c}" Classes="instanceLabel" /><TextBox Name="InstanceJvmArgumentsSetting" Grid.Column="1" Text="{Binding InstanceJvmArguments}" AcceptsReturn="True" MinHeight="68" ToolTip.Tip="{loc:Loc tfd2d4eb005e182d0}" /></Grid>
                <CheckBox Name="InstanceInitialMemorySetting" Content="指定初始内存（-Xms）" IsChecked="{Binding InstanceInitialMemory}"/>
                <NumericUpDown Name="InstanceInitialMemoryValue" IsVisible="{Binding InstanceInitialMemory}" Minimum="512" Maximum="32768" Increment="256" Value="{Binding InstanceInitialMemoryMiB}"/>
                <Grid ColumnDefinitions="105,*"><TextBlock Text="附加 Classpath" Classes="instanceLabel"/><TextBox Name="InstanceClasspathSetting" Grid.Column="1" Text="{Binding InstanceClasspath}" AcceptsReturn="True" MinHeight="68" ToolTip.Tip="按列表顺序放在游戏库前；每行一个完整的本机 JAR 路径。"/></Grid>
                <Grid ColumnDefinitions="105,*"><TextBlock Text="启动前程序" Classes="instanceLabel"/><TextBox Name="InstanceBeforeExecutableSetting" Grid.Column="1" Text="{Binding InstanceBeforeExecutable}"/></Grid>
                <Grid ColumnDefinitions="105,*"><TextBlock Text="启动前程序参数" Classes="instanceLabel"/><TextBox Name="InstanceBeforeArgumentsSetting" Grid.Column="1" Text="{Binding InstanceBeforeArguments}"/></Grid>
                <CheckBox Name="InstanceConsoleJavaSetting" Content="使用 java.exe 而不是 javaw.exe" IsVisible="{Binding IsWindows}" IsChecked="{Binding InstanceConsoleJava}"/>
                <CheckBox Name="InstanceDebugLoggingSetting" Content="使用调试级别 log4j 配置文件" IsChecked="{Binding InstanceDebugLogging}"/>

                <CheckBox Name="InstanceLockMemorySetting" Content="{loc:Loc ta5faf266c2bf4bd1}" IsChecked="{Binding InstanceLockMemory}" />
                <Grid ColumnDefinitions="105,*"><TextBlock Text="{loc:Loc tc3cc36f628b16596}" Classes="instanceLabel" /><StackPanel Grid.Column="1" Spacing="6"><StackPanel Orientation="Horizontal" Spacing="16"><CheckBox Name="InstanceCustomWindowSetting" Content="{loc:Loc t4eafa9e925b30bcd}" IsChecked="{Binding InstanceCustomWindow}" /><CheckBox Name="InstanceFullscreenSetting" Content="{loc:Loc t22ea3f47fee80536}" IsChecked="{Binding InstanceFullscreen}" /></StackPanel><Grid IsVisible="{Binding InstanceCustomWindow}" ColumnDefinitions="*,20,*"><NumericUpDown Name="InstanceWindowWidthSetting" Minimum="320" Maximum="16384" FormatString="0" Value="{Binding InstanceWindowWidth}" /><TextBlock Grid.Column="1" Text="×" HorizontalAlignment="Center" VerticalAlignment="Center" /><NumericUpDown Name="InstanceWindowHeightSetting" Grid.Column="2" Minimum="320" Maximum="16384" FormatString="0" Value="{Binding InstanceWindowHeight}" /></Grid></StackPanel></Grid>
                <Grid ColumnDefinitions="105,*"><TextBlock Text="{loc:Loc tabc00290e88e742c}" Classes="instanceLabel" /><TextBox Name="InstanceCustomInfoSetting" Grid.Column="1" Text="{Binding InstanceCustomInfo}" /></Grid>
                <Grid ColumnDefinitions="105,*"><TextBlock Text="{loc:Loc t50509f2f2741a776}" Classes="instanceLabel" /><TextBox Name="InstanceGameArgumentsSetting" Grid.Column="1" Text="{Binding InstanceGameArguments}" /></Grid>
              </StackPanel>
              <Button Name="SaveInstanceSettingsButton" Content="{loc:Loc tc8ea0b805c649d5f}" Command="{Binding SaveInstanceSettingsCommand}"/>
            </StackPanel></Border>
            <Border Classes="card"><StackPanel Spacing="12"><TextBlock Text="{loc:Loc tbfb579e0b55c8526}" Classes="sectionTitle"/>
              <ComboBox Name="JavaSelector" ItemsSource="{Binding JavaInstallations}" SelectedItem="{Binding SelectedJava}" IsEnabled="{Binding CanEdit}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding FullVersion}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
              <Grid ColumnDefinitions="*,Auto"><TextBox Name="JavaPath" Text="{Binding JavaExecutable}"/><Button Grid.Column="1" Content="{loc:Loc t0617557e7bbc153d}" Click="PickJava_Click" Margin="8,0,0,0"/></Grid>
              <NumericUpDown Name="MemoryMiB" Minimum="512" Maximum="32768" Increment="256" Value="{Binding MemoryMiB}"/>
              <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="{loc:Loc t5e5ee0fe2602625c}" Command="{Binding DiscoverJavaCommand}"/><Button Content="{loc:Loc t782a5bacbed379f1}" Command="{Binding SaveRuntimeCommand}"/></StackPanel>
              <TextBlock Text="{Binding RuntimeDraftSummary}" Classes="muted" LineHeight="16" FontSize="11"/>
            </StackPanel></Border>
          </StackPanel>
          <StackPanel IsVisible="{Binding IsModify}" Spacing="14">
            <Border Classes="card"><StackPanel Spacing="12">
              <Grid ColumnDefinitions="*,Auto"><TextBlock Text="实例组件" Classes="sectionTitle"/><views:LoadingGlyph Grid.Column="1" IsVisible="{Binding IsComponentBusy}" Width="28" Height="28" Foreground="{DynamicResource ClubAccent}"/></Grid>
              <Grid ColumnDefinitions="80,*"><TextBlock Text="加载器" VerticalAlignment="Center"/><ComboBox Name="ComponentLoaderChoice" Grid.Column="1" ItemsSource="{Binding ComponentLoaderChoices}" SelectedItem="{Binding ComponentLoader}" IsEnabled="{Binding !IsComponentBusy}" HorizontalAlignment="Stretch"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></Grid>
              <Grid ColumnDefinitions="80,*" IsVisible="{Binding ComponentNeedsVersion}"><TextBlock Text="版本" VerticalAlignment="Center"/><ComboBox Name="ComponentVersionChoice" Grid.Column="1" ItemsSource="{Binding ComponentVersions}" SelectedItem="{Binding ComponentVersion}" IsEnabled="{Binding !IsComponentBusy}" HorizontalAlignment="Stretch"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayVersion}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></Grid>
              <CheckBox Name="ConfirmComponentChange" Content="确认修改所选实例的加载器" IsChecked="{Binding ConfirmComponentChange}" IsEnabled="{Binding !IsComponentBusy}" ToolTip.Tip="保留模组和资源文件。请先确认它们与新的加载器版本兼容。"/>
              <WrapPanel><Button Name="ChangeInstanceComponentButton" Content="应用修改" Command="{Binding ChangeInstanceComponentCommand}" Margin="0,0,8,0"/><Button Content="刷新" Command="{Binding RefreshComponentVersionsCommand}" Margin="0,0,8,0"/><Button Content="{loc:Loc t2cd0f3be8738a86c}" Command="{Binding CancelComponentWorkCommand}" IsVisible="{Binding IsComponentBusy}"/></WrapPanel>
              <TextBlock Text="{Binding ComponentFeedback}" TextWrapping="Wrap"/>
            </StackPanel></Border>
            <Border Classes="card"><Button Content="{loc:Loc ta7d8b0fac0530c5d}" Command="{Binding InstallCommand}"/></Border>
          </StackPanel>
          <StackPanel IsVisible="{Binding IsExport}" Spacing="14"><Border Classes="card"><StackPanel Spacing="12"><TextBlock Text="{loc:Loc ta5f60f01968f6b61}" Classes="sectionTitle" ToolTip.Tip="{loc:Loc t544148aa438ca527}"/><TextBlock Text="{loc:Loc te68f1ccd9cd2cd8d}" FontWeight="SemiBold"/>
            <CheckBox Content="{loc:Loc t83d2e0abb1be9fda}" IsChecked="{Binding IncludeWorlds}"/><Button Name="ExportInstanceButton" Content="{loc:Loc t88da633ca77352d5}" Command="{Binding ExportInstanceCommand}"/>
          </StackPanel></Border><Border Classes="card"><StackPanel Spacing="12"><TextBlock Text="{loc:Loc tdc4c94a1a3ea2d5e}" Classes="sectionTitle" ToolTip.Tip="{loc:Loc t58a5ad2bda3e2f92}"/>
            <Grid ColumnDefinitions="70,*"><TextBlock Text="{loc:Loc td44e9b3d3b31d37b}" VerticalAlignment="Center"/><TextBox Name="ExportPackName" Grid.Column="1" Text="{Binding ExportPackName}"/></Grid>
            <Grid ColumnDefinitions="70,*"><TextBlock Text="{loc:Loc t5f76b2bf82dd2c5d}" VerticalAlignment="Center"/><TextBox Name="ExportPackVersion" Grid.Column="1" Text="{Binding ExportPackVersion}"/></Grid>
            <CheckBox Content="{loc:Loc t09ef712618900f7e}" IsChecked="{Binding ExportPackConfig}"/>
            <CheckBox Content="{loc:Loc tefb82dfd5f5adf50}" IsChecked="{Binding ExportPackOptions}"/>
            <CheckBox Content="{loc:Loc t39ad239746a87b3b}" IsChecked="{Binding ExportPackLocalFiles}"/>
            <Button Name="ExportModrinthPackButton" Content="{loc:Loc t77587cdd53235518}" Command="{Binding ExportModrinthPackCommand}"/>
            <Button Name="ExportCurseForgePackButton" Content="导出 CurseForge 整合包" Command="{Binding ExportCurseForgePackCommand}"/>
          </StackPanel></Border></StackPanel>
          <StackPanel IsVisible="{Binding IsFileSection}" Spacing="14" Margin="{Binding ResourceListBottomMargin}">
            <Border Name="InstanceContentSearchCard" Classes="card" Padding="14,5" IsVisible="{Binding IsContentList}"><Grid ColumnDefinitions="18,10,*"><views:ClubIcon Kind="search" Width="16" Height="16" VerticalAlignment="Center"/><TextBox Name="InstanceContentSearch" Grid.Column="2" Classes="resourceSearch" Text="{Binding ContentSearchText}" PlaceholderText="{loc:Loc t858de76f2de899f6}" MinHeight="30" BorderThickness="0" Background="Transparent"/></Grid></Border>
            <Border Name="InstanceResourceToolbar" Classes="card" Padding="12,14" IsVisible="{Binding IsContentList}"><UniformGrid Name="InstanceContentActions" Columns="{Binding ResourceToolbarColumns}">
              <Button Name="OpenContentFolderButton" Classes="resourceTool primary" Content="{loc:Loc tfcf8b4bff0df782d}" Command="{Binding OpenContentDirectoryCommand}"/>
              <Button Name="ImportInstanceContentButton" Classes="resourceTool" Content="{loc:Loc t7bc03302e1e4f67c}" Click="ImportContent_Click" IsEnabled="{Binding CanImportContent}"/>
              <Button Name="DownloadInstanceResourcesButton" Classes="resourceTool" Content="{loc:Loc tfa7b98e0f04439e3}" Command="{Binding DownloadInstanceResourcesCommand}" IsVisible="{Binding IsResourceBrowserSection}"/>
              <Button Name="SelectAllModsButton" Classes="resourceTool" Content="{loc:Loc t3a5040b68abf75f9}" Command="{Binding SelectAllModsCommand}" ToolTip.Tip="全选 / 反选"/>
              <Button Name="ExportInstanceContentInfoButton" Classes="resourceTool" Content="{loc:Loc ta083aef147108081}" Click="ExportContentInfo_Click"/>
              <Button Name="InstanceModRelationsButton" Classes="resourceTool" Content="{loc:Loc t14e68ce7631adc07}" Command="{Binding DiagnoseModsCommand}" IsVisible="{Binding IsModsSection}"/>
            </UniformGrid></Border>
            <Button Content="{Binding OpenContentFolderCaption}" Command="{Binding OpenContentDirectoryCommand}" IsVisible="{Binding IsScreenshots}" HorizontalAlignment="Left"/>

            <Border Name="ContentTrashPanel" Classes="card" Padding="12,10" IsVisible="{Binding HasModTrash}"><Grid ColumnDefinitions="Auto,*,Auto,Auto">
              <TextBlock Text="{Binding ContentTrashTitle}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,8,0"/>
              <ComboBox Grid.Column="1" Name="ModTrashSelector" ItemsSource="{Binding ModTrash}" SelectedItem="{Binding SelectedModTrash}" MinWidth="100" Margin="0,0,8,0"><ComboBox.ItemTemplate><DataTemplate><TextBlock TextTrimming="CharacterEllipsis"><Run Text="{Binding Created, StringFormat='{}{0:g}'}"/><Run Text="  "/><Run Text="{Binding Files}"/><Run Text=" 个文件"/></TextBlock></DataTemplate></ComboBox.ItemTemplate></ComboBox>
              <Button Grid.Column="2" Name="RestoreModsButton" Content="{loc:Loc tfe4e0d291b7478d9}" Command="{Binding RestoreModsCommand}" Margin="0,0,8,0"/><Button Grid.Column="3" Name="CloseContentTrashButton" Content="{loc:Loc tafd4b783536b8297}" Command="{Binding CloseContentTrashCommand}"/>
            </Grid></Border>
            <Border Name="ModActionPrompt" Classes="card" IsVisible="{Binding HasModAction}"><StackPanel Spacing="10"><ScrollViewer MaxHeight="220"><TextBlock Text="{loc:Translate ModActionSummary}" TextWrapping="Wrap"/></ScrollViewer><WrapPanel><Button Name="ConfirmModActionButton" Content="{loc:Translate ModActionCaption}" Command="{Binding ConfirmModActionCommand}" Margin="0,0,8,0"/><Button Content="{loc:Loc t2cd0f3be8738a86c}" Command="{Binding CancelModActionCommand}"/></WrapPanel></StackPanel></Border>
            <Border Name="ModDetailsPanel" Classes="card" IsVisible="{Binding HasModDetail}"><StackPanel Spacing="8"><TextBlock Text="{Binding ModDetail}" TextWrapping="Wrap"/><WrapPanel><Button Name="OpenInstalledResourceProjectButton" Content="{loc:Loc taf9ab85222e0c4a2}" Command="{Binding OpenContentProjectCommand}" IsVisible="{Binding CanOpenContentProject}" Margin="0,0,8,0"/><Button Content="{loc:Loc t9071cfe7cd010bb1}" Command="{Binding CloseModDetailsCommand}"/></WrapPanel></StackPanel></Border>
            <Border Name="InstanceResourceListCard" Classes="card" Padding="14,12" IsVisible="{Binding IsContentList}"><StackPanel Spacing="7">
              <Grid Name="InstanceResourceListHeader" ColumnDefinitions="*,Auto">
                <ItemsControl Name="InstanceModFilters" ItemsSource="{Binding ModFilters}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><ToggleButton Classes="resourceFilter" Content="{Binding Title}" IsVisible="{Binding Shown}" IsChecked="{Binding Active, Mode=OneWay}" Command="{Binding SelectCommand}" Margin="0,0,4,0"/></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="3" VerticalAlignment="Top">
                  <views:LoadingGlyph Width="16" Height="16" IsVisible="{Binding IsModScanBusy}"/>
                  <Button Name="CheckInstanceModUpdatesButton" Classes="resourceIcon" Command="{Binding CheckModUpdatesCommand}" IsVisible="{Binding CanShowModUpdates}" ToolTip.Tip="{Binding CheckContentUpdatesCaption}" AutomationProperties.Name="{Binding CheckContentUpdatesCaption}"><views:ClubIcon Kind="refresh-cw" Width="16" Height="16"/></Button>
                  <Button Classes="resourceIcon" Command="{Binding CancelModScanCommand}" IsVisible="{Binding IsModScanBusy}" ToolTip.Tip="{loc:Loc t4d761bdef85f56ea}" AutomationProperties.Name="{loc:Loc t4d761bdef85f56ea}"><views:ClubIcon Kind="x" Width="16" Height="16"/></Button>
                  <views:ClubIcon Kind="arrow-up-down" Width="16" Height="16" VerticalAlignment="Center"/>
                  <TextBlock Text="{loc:Loc tde3c35c2a69a3102}" VerticalAlignment="Center"/>
                  <ComboBox Name="InstanceContentSort" Classes="resourceSort" ItemsSource="{Binding ContentSortChoices}" SelectedItem="{Binding ContentSort}" MinWidth="100" MaxWidth="125" BorderThickness="0" Background="Transparent"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{loc:Translate .}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                  <Button Name="InstanceResourceMoreButton" Content="⋯" Classes="resourceIcon" ToolTip.Tip="{loc:Loc t9f07d2ce4115f575}" AutomationProperties.Name="{loc:Loc t9f07d2ce4115f575}"><Button.Flyout><MenuFlyout>
                    <MenuItem Header="{loc:Loc tdf7392cc96bedc51}" Command="{Binding RefreshContentCommand}"/>
                    <MenuItem Header="{loc:Loc tbd50eff4af4697ff}" Command="{Binding OpenModChangelogCommand}" IsVisible="{Binding IsResourceBrowserSection}"/>
                    <MenuItem Name="ReadModTrashButton" Header="{loc:Loc tba35dc23b245e61e}" Command="{Binding RefreshModTrashCommand}" IsVisible="{Binding CanReadContentTrash}"/>
                  </MenuFlyout></Button.Flyout></Button>
                </StackPanel>
              </Grid>
              <TextBlock Text="{Binding ContentEmptyTitle}" IsVisible="{Binding IsContentEmpty}" Classes="muted" HorizontalAlignment="Center" Margin="0,30"/>
              <ListBox Name="InstanceContentList" Classes="instanceList resourceList" ItemsSource="{Binding FilteredContentRows}" SelectedItem="{Binding SelectedContentRow}" KeyDown="ContentList_KeyDown" ScrollViewer.HorizontalScrollBarVisibility="Disabled"><ListBox.ItemTemplate><DataTemplate>
                <Border Classes="resourceRow" Classes.selected="{Binding Selected}" Tapped="ContentRow_Tapped" ToolTip.Tip="{Binding Detail}"><Grid ColumnDefinitions="34,7,*,Auto" Height="42">
                  <Grid VerticalAlignment="Center" Width="34" Height="34">
                    <Grid Classes="resourceArtwork"><Border CornerRadius="6" ClipToBounds="True" Background="{DynamicResource ClubSelection}"><Grid><views:ClubIcon Kind="{Binding FallbackIcon}" Width="25" Height="25" HorizontalAlignment="Center" VerticalAlignment="Center" IsVisible="{Binding !Entry.HasIcon}"/><views:InstanceContentArtwork Entry="{Binding Entry}" Width="34" Height="34" Stretch="Uniform" IsVisible="{Binding Entry.HasIcon}"/></Grid></Border></Grid>
                    <CheckBox Name="ModRowSelection" Classes="resourceSelection" IsChecked="{Binding Selected}" HorizontalAlignment="Center" VerticalAlignment="Center" AutomationProperties.Name="{Binding Title}"/>
                  </Grid>
                  <Grid Grid.Column="2" RowDefinitions="20,18" VerticalAlignment="Center" ClipToBounds="True">
                    <StackPanel Orientation="Horizontal" Spacing="5"><TextBlock Name="InstanceContentRowTitle" Text="{Binding Title}" FontSize="14" LineHeight="20" TextTrimming="CharacterEllipsis" MaxWidth="{Binding TitleMaximum}"/><TextBlock Text="|" IsVisible="{Binding HasVersion}" Classes="muted" Opacity="0.5"/><TextBlock Name="InstanceContentRowVersion" Text="{Binding Version}" IsVisible="{Binding HasVersion}" Classes="muted" FontSize="12" Opacity="0.65" MaxWidth="140" TextTrimming="CharacterEllipsis"/><Button Name="ModRowUpdate" Classes="resourceIcon updateGlyph" IsVisible="{Binding HasUpdate}" Command="{Binding UpdateCommand}" IsEnabled="{Binding #InstancePage.DataContext.CanUpdateContent}" ToolTip.Tip="{Binding StateText}" AutomationProperties.Name="{Binding UpdateCaption}"><views:ClubIcon Kind="upload" Width="13" Height="13"/></Button></StackPanel>
                    <Grid Grid.Row="1" ColumnDefinitions="Auto,*"><ItemsControl ItemsSource="{Binding Tags}" MaxWidth="170"><ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Background="{DynamicResource ClubSelection}" CornerRadius="2" Padding="2,0" Margin="0,0,4,0"><TextBlock Text="{Binding}" FontSize="10" LineHeight="14" Classes="muted"/></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl><TextBlock Grid.Column="1" Name="InstanceContentRowDescription" Text="{Binding SecondaryText}" Classes="muted" FontSize="12" LineHeight="18" TextTrimming="CharacterEllipsis"/></Grid>
                  </Grid>
                  <StackPanel Grid.Column="3" Orientation="Horizontal" Spacing="1" Classes="rowActions" VerticalAlignment="Center" Margin="6,0,0,0">
                    <Button Name="ContentRowDetailsButton" Classes="resourceIcon" Command="{Binding DetailsCommand}" ToolTip.Tip="{loc:Loc ta748cc074f78de00}" AutomationProperties.Name="{loc:Loc ta748cc074f78de00}"><views:ClubIcon Kind="info" Width="16" Height="16"/></Button>
                    <Button Name="ContentRowRevealButton" Classes="resourceIcon" Command="{Binding RevealCommand}" ToolTip.Tip="{loc:Loc tfe76e31d24ddf33c}" AutomationProperties.Name="{loc:Loc tfe76e31d24ddf33c}"><views:ClubIcon Kind="folder-open" Width="16" Height="16"/></Button>
                    <Button Name="ContentRowToggleButton" Classes="resourceIcon" Command="{Binding ToggleCommand}" IsVisible="{Binding IsMod}" IsEnabled="{Binding #InstancePage.DataContext.CanManageMods}" ToolTip.Tip="{Binding ToggleCaption}" AutomationProperties.Name="{Binding ToggleCaption}"><views:ClubIcon Kind="{Binding ToggleIcon}" Width="16" Height="16"/></Button>
                    <Button Name="ContentRowTrashButton" Classes="resourceIcon" Command="{Binding TrashCommand}" IsVisible="{Binding #InstancePage.DataContext.CanReadContentTrash}" IsEnabled="{Binding #InstancePage.DataContext.CanTrashContent}" ToolTip.Tip="{loc:Loc t6a5b1cb18fb64c5c}" AutomationProperties.Name="{loc:Loc t6a5b1cb18fb64c5c}"><views:ClubIcon Kind="trash-2" Width="16" Height="16"/></Button>
                  </StackPanel>
                </Grid></Border>
              </DataTemplate></ListBox.ItemTemplate></ListBox>
              <StackPanel Name="InstanceModUpdatesPanel" Spacing="4" IsVisible="{Binding HasModUpdateStatus}"><TextBlock Name="ModUpdateSummary" Text="{loc:Translate ModUpdateSummary}" Classes="muted" FontSize="11" MaxLines="1" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding ModUpdateStatus}"/><Expander Name="ModUpdateNotices" Header="{loc:Loc t979a332955c855bf}" IsVisible="{Binding HasModUpdateDetails}" HorizontalAlignment="Stretch"><TextBlock Text="{loc:Translate ModUpdateDetails}" TextWrapping="Wrap" Classes="muted"/></Expander></StackPanel>
            </StackPanel></Border>
            <StackPanel IsVisible="{Binding IsScreenshots}" Spacing="12"><Button Name="RestoreLastScreenshot" Content="{loc:Loc tb00dda1796c8a1e3}" Command="{Binding RestoreScreenshotCommand}" HorizontalAlignment="Left"/><TextBlock Text="{Binding ScreenshotSummary}" IsVisible="{Binding HasTruncatedScreenshots}" Classes="muted" LineHeight="16" FontSize="11"/>
              <ItemsControl Name="ScreenshotGallery" ItemsSource="{Binding ScreenshotPreviews}" Margin="7,8,7,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
                <Border Classes="card" Padding="0" Margin="7,0,7,14" ClipToBounds="True"><StackPanel Spacing="0">
                  <Grid Height="120" Background="{DynamicResource ClubSidebar}"><Image Source="{Binding Preview}" Stretch="UniformToFill" IsVisible="{Binding HasPreview}"/><TextBlock Text="{loc:Loc tb825ccc758e9cba4}" IsVisible="{Binding !HasPreview}" Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip.Tip="{Binding Name}"/></Grid>
                  <Grid ColumnDefinitions="*,*,*" Margin="4,5"><Button Classes="flat" Content="{loc:Loc t4e1449e7d5e50593}" Command="{Binding RevealCommand}" Padding="4"/><Button Grid.Column="1" Classes="flat" Content="{loc:Loc t2f9daa828907b93f}" Command="{Binding RemoveCommand}" ToolTip.Tip="{loc:Loc tde3b627ba0b656e0}" Padding="4"/><Button Grid.Column="2" Classes="flat" Content="{loc:Loc t63d90d977348ab1f}" Click="CopyScreenshot_Click" IsEnabled="{Binding HasPreview}" Padding="4"/></Grid>
                </StackPanel></Border>
              </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </StackPanel>
          </StackPanel>
          <StackPanel Name="ModRelationsWorkspace" IsVisible="{Binding IsRelationsSection}" Spacing="10">
            <WrapPanel><Button Name="BackToModListButton" Content="{loc:Loc t4d91f7765d314387}" Command="{Binding BackToModsCommand}" Margin="0,0,8,0"/><Button Name="RefreshModRelationsButton" Content="{loc:Loc tdf7392cc96bedc51}" Command="{Binding RefreshModRelationsCommand}" Margin="0,0,8,0"/><Button Name="CancelModRelationsButton" Content="取消" Command="{Binding CancelModRelationsCommand}" IsVisible="{Binding IsModRelationsBusy}"/></WrapPanel>
            <TextBlock Text="{loc:Loc t1b81f418a6111381}" Classes="muted" TextWrapping="Wrap"/>
            <TextBox Name="ModRelationsSearch" Text="{Binding ModRelationSearch}" PlaceholderText="{loc:Loc t5d8e40ab8b8f94b5}"/>
            <CheckBox Name="ModRelationsIssuesOnly" Content="{loc:Loc t89a97de8a0609e18}" IsChecked="{Binding ModRelationIssuesOnly}"/>
            <TextBlock Name="ModRelationsSummary" Text="{Binding ModRelationSummary}" FontWeight="SemiBold"/>
            <TextBlock Name="ModRelationsStatus" Text="{Binding ModRelationStatus}" Classes="muted" TextWrapping="Wrap"/>
            <TextBlock Name="ModRelationsEmpty" Text="{loc:Loc t9c94bd277ebaa24f}" IsVisible="{Binding ModRelationsEmpty}" Classes="muted"/>
            <ComboBox Name="ModRelationHostSelector" ItemsSource="{Binding FilteredModRelationHosts}" SelectedItem="{Binding SelectedModRelationHost}" HorizontalAlignment="Stretch"><ComboBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding File}" Classes="muted" FontSize="11"/></StackPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox>
            <Border IsVisible="{Binding HasSelectedModRelationHost}"><StackPanel DataContext="{Binding SelectedModRelationHost}" Spacing="10">
              <Grid ColumnDefinitions="*,Auto"><TextBlock Text="{Binding File}" Classes="muted" TextTrimming="CharacterEllipsis"/><TextBlock Grid.Column="1" Text="{Binding State}" Foreground="{DynamicResource ClubAccent}" Margin="10,0,0,0"/></Grid>
              <TextBlock Text="{loc:Loc t8459c09fb5eaedee}" Classes="sectionTitle" IsVisible="{Binding HasDependencies}"/>
              <ItemsControl Name="ModDependencyDeclarations" ItemsSource="{Binding Dependencies}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource ClubBorder}" BorderThickness="0,0,0,1" Padding="0,8"><StackPanel Spacing="4"><TextBlock Text="{Binding Description}" TextWrapping="Wrap"/><TextBlock Text="{Binding Presence}" Foreground="{DynamicResource ClubAccent}"/><TextBlock Text="{Binding Providers}" IsVisible="{Binding HasProviders}" Classes="muted" FontSize="11" TextWrapping="Wrap"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
              <TextBlock Text="{loc:Loc t71c172084904b191}" Classes="sectionTitle"/>
              <ItemsControl Name="ModDeclarationTree" ItemsSource="{Binding Nodes}"><ItemsControl.ItemTemplate><DataTemplate><Border BorderBrush="{DynamicResource ClubBorder}" BorderThickness="2,0,0,0" Padding="10,5" Margin="{Binding Indent}"><StackPanel Spacing="3"><TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextWrapping="Wrap"/><TextBlock Text="{Binding Ids}" Foreground="{DynamicResource ClubAccent}" TextWrapping="Wrap"/><TextBlock Text="{Binding Path}" Classes="muted" FontSize="11" TextWrapping="Wrap"/><TextBlock Text="{Binding Notices}" IsVisible="{Binding HasNotices}" Foreground="{DynamicResource ClubAccent}" TextWrapping="Wrap"/></StackPanel></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </StackPanel></Border>
          </StackPanel>
          <Border Classes="card" IsVisible="{Binding IsOtherSection}"><StackPanel Spacing="10"><TextBlock Text="{Binding SectionTitle}" Classes="sectionTitle" ToolTip.Tip="{Binding CapabilityReason}"/><Button Content="{loc:Loc ta1ca2a6b2f93b4d6}" Command="{Binding OpenInstanceDirectoryCommand}"/></StackPanel></Border>
          <TextBlock Name="InstanceFeedback" IsVisible="{Binding HasFeedback}" Text="{loc:Translate Feedback}" TextWrapping="Wrap" Classes="muted"/>
        </StackPanel>
      </ScrollViewer>
      <views:InstanceWorldsView Grid.ColumnSpan="2" IsVisible="{Binding IsWorldWorkspaceSection}"/>
    </Grid>
    <Border Name="InstanceResourceSelectionBar" Classes="card" Padding="12,8" HorizontalAlignment="Right" VerticalAlignment="Bottom" MaxWidth="650" Margin="24" IsVisible="{Binding HasModSelection}"><WrapPanel Name="InstanceModSelectedActions">
              <TextBlock Text="{Binding ModSelectionSummary}" VerticalAlignment="Center" Margin="0,0,12,0"/>
              <Button Name="UpdateSelectedModsButton" Content="{loc:Loc t99f8f4f97cfdbdf1}" Command="{Binding UpdateSelectedModsCommand}" IsVisible="{Binding CanShowModUpdates}" Margin="0,0,6,0"/>
              <Button Content="{loc:Loc t26008950621fcb56}" Command="{Binding EnableSelectedModsCommand}" IsVisible="{Binding IsModsSection}" Margin="0,0,6,0"/>
              <Button Name="DisableSelectedModsButton" Content="{loc:Loc tc35ebeed062b488a}" Command="{Binding DisableSelectedModsCommand}" IsVisible="{Binding IsModsSection}" Margin="0,0,6,0"/>
              <Button Name="TrashSelectedModsButton" Content="{loc:Loc t435bf8a234fde6f2}" Command="{Binding TrashSelectedModsCommand}" IsVisible="{Binding CanReadContentTrash}" Margin="0,0,6,0"/>
              <Button Content="{loc:Loc ta083aef147108081}" Click="ExportContentInfo_Click" Margin="0,0,6,0"/>
              <Button Content="{loc:Loc t74966e20df2ea9fd}" Command="{Binding ClearModSelectionCommand}"/>
            </WrapPanel></Border>
    <Border Name="InstanceRenameOverlay" Background="#50000000" IsVisible="{Binding IsRenameEditorOpen}" KeyDown="RenameEditor_KeyDown">
      <Border Classes="card" Width="420" Padding="22" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel Spacing="16">
        <TextBlock Text="{loc:Loc t28a39ead5f71b8b2}" Classes="sectionTitle"/><TextBox Name="InstanceDisplayName" Text="{Binding RenameDraft}" PlaceholderText="{loc:Loc t4ae7b70e363dd219}"/>
        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right"><Button Content="{loc:Loc t2cd0f3be8738a86c}" Command="{Binding CancelRenameCommand}"/><Button Name="ConfirmInstanceRename" Content="{loc:Loc tfac2a67ad87807c4}" Command="{Binding SaveRenameCommand}" Classes="primary"/></StackPanel>
      </StackPanel></Border>
    </Border>
    <Border Name="InstanceDescriptionOverlay" Background="#50000000" IsVisible="{Binding IsDescriptionEditorOpen}">
      <Border Classes="card" Width="440" Padding="22" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel Spacing="16">
        <TextBlock Text="{loc:Loc tc9d9331f6df13c83}" Classes="sectionTitle"/><TextBox Name="InstanceDescription" Text="{Binding PresentationDescription}" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="4096" MinHeight="100" MaxHeight="240" PlaceholderText="{loc:Loc t46b738c9f0ee6737}"/>
        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right"><Button Content="{loc:Loc t2cd0f3be8738a86c}" Command="{Binding CancelDescriptionCommand}"/><Button Name="ConfirmInstanceDescription" Content="{loc:Loc ta3030bf8f16dc63c}" Command="{Binding SavePresentationCommand}" Classes="primary"/></StackPanel>
      </StackPanel></Border>
    </Border>
  </Grid>
</UserControl>
