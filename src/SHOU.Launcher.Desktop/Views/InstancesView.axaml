<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="using:SHOU.Launcher.Desktop.Localization" xmlns:themes="using:SHOU.Launcher.Desktop.Themes" xmlns:views="using:SHOU.Launcher.Desktop.Views" x:Class="SHOU.Launcher.Desktop.Views.InstancesView" x:Name="InstancePage" AttachedToVisualTree="WorkspaceAttached" DetachedFromVisualTree="WorkspaceDetached" DataContextChanged="WorkspaceDataContextChanged">
  <UserControl.Resources><views:SettingsPreferenceLabelConverter x:Key="GamePreferenceLabel" /></UserControl.Resources>
  <UserControl.Styles>
    <Style Selector="ListBox#ExistingInstanceSelector ListBoxItem"><Setter Property="AutomationProperties.Name" Value="{Binding Name}" /></Style>
    <Style Selector="ListBox.instanceList"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style Selector="ListBox.instanceList ListBoxItem"><Setter Property="Padding" Value="10,7"/><Setter Property="CornerRadius" Value="3"/><Setter Property="Margin" Value="0,1"/></Style>
    <Style Selector="ListBox.instanceList ListBoxItem:selected /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource ClubSelection}"/></Style>
    <Style Selector="TextBlock.instanceLabel"><Setter Property="Width" Value="105"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
    <Style Selector="ListBox.instanceNavigation ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="MinHeight" Value="36"/><Setter Property="Margin" Value="0"/><Setter Property="AutomationProperties.Name" Value="{Binding Title}"/></Style>
    <Style Selector="ListBox.instanceNavigation ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="{DynamicResource ClubSelectionForeground}"/><Setter Property="BorderThickness" Value="3,0,0,0"/></Style>
    <Style Selector="ListBox.instanceNavigation ListBoxItem:selected TextBlock"><Setter Property="Foreground" Value="{DynamicResource ClubSelectionForeground}"/></Style>
    <Style Selector="ListBox.instanceNavigation ListBoxItem:selected Path"><Setter Property="Stroke" Value="{DynamicResource ClubSelectionForeground}"/></Style>
  </UserControl.Styles>
  <Grid>
    <Grid ColumnDefinitions="175,*" IsVisible="{Binding IsSelection}">
      <Border Background="{DynamicResource ClubSidebar}" Padding="12,15">
        <StackPanel Spacing="10"><TextBlock Text="{loc:Loc ta03119e61efcbdf3}" Classes="muted" LineHeight="16" FontSize="11" ToolTip.Tip="{loc:Loc t149cea82a14e38fb}"/>
          <TextBlock Text="{Binding GameDirectorySummary}" TextWrapping="Wrap" LineHeight="16" FontSize="11"/>
          <Button Content="{loc:Loc t6a34849aee547b61}" Command="{Binding ManageGameDirectoryCommand}" HorizontalAlignment="Stretch"/>
          <Button Name="OpenInstancePackImport" Content="{loc:Loc t18dd417828ff3dfe}" Command="{Binding OpenPackImportCommand}" HorizontalAlignment="Stretch"/>
          <Button Name="AttachExistingFolderButton" Content="{loc:Loc td71fabe064ac0de3}" Click="PickExistingFolder_Click" IsEnabled="{Binding CanEdit}" HorizontalAlignment="Stretch" />
          <Separator Margin="0,4"/>

        </StackPanel>
      </Border>
      <ScrollViewer Name="InstanceSelectionScroller" Grid.Column="1" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24" Spacing="12">
          <views:LoadingGlyph Width="28" Height="28" IsVisible="{Binding IsFolderBusy}" HorizontalAlignment="Right" />
          <Border Name="ExistingInstancePreviewCard" Classes="card" IsVisible="{Binding HasExistingCandidates}"><StackPanel Spacing="10"><TextBlock Text="{loc:Loc te4926ee48a96fb12}" Classes="sectionTitle" /><ListBox Name="ExistingInstanceSelector" ItemsSource="{Binding ExistingCandidates}" SelectedItem="{Binding ExistingCandidate}" MaxHeight="220"><ListBox.ItemTemplate><DataTemplate><StackPanel Spacing="3"><TextBlock Text="{Binding Name}" /><TextBlock Text="{Binding GameDirectory}" Classes="muted" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding GameVersion}" Classes="muted" /></StackPanel></DataTemplate></ListBox.ItemTemplate></ListBox><StackPanel Orientation="Horizontal" Spacing="8"><Button Name="ConfirmExistingInstanceButton" Content="{loc:Loc t3f5213203fd586ed}" Command="{Binding AttachExistingCommand}" /><Button Content="{loc:Loc t2cd0f3be8738a86c}" Command="{Binding DismissExistingCommand}" /></StackPanel></StackPanel></Border>
          <TextBox Name="InstanceSearch" Text="{Binding SearchText}" PlaceholderText="{loc:Loc t84781588451401d1}"/>
          <CheckBox Name="FavoriteInstancesFilter" Content="{loc:Loc tcedfafe1bbd6fb1c}" IsChecked="{Binding FavoritesOnly}"/>
          <Border Classes="card"><StackPanel Spacing="10"><TextBlock Text="{Binding InstanceCountSummary}" FontWeight="SemiBold"/>
            <ListBox Name="InstanceSelector" Classes="instanceList" ItemsSource="{Binding FilteredInstances}" SelectedItem="{Binding SelectedInstance}" IsEnabled="{Binding CanEdit}" DoubleTapped="OpenSelectedInstance_DoubleTapped" KeyDown="OpenSelectedInstance_KeyDown">
              <ListBox.ItemTemplate><DataTemplate><Grid ColumnDefinitions="32,*"><Border Width="25" Height="25" Background="{DynamicResource ClubSelection}" CornerRadius="3"><views:ClubIcon Kind="box" Width="20" Height="20"/></Border>
                <StackPanel Grid.Column="1" Spacing="2"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                  <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="{Binding VersionId}" Classes="muted" LineHeight="16" FontSize="11"/><TextBlock Text="{Binding Loader}" Classes="muted" LineHeight="16" FontSize="11"/><TextBlock Text="{Binding LoaderVersion}" Classes="muted" LineHeight="16" FontSize="11"/></StackPanel>
                </StackPanel></Grid></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Orientation="Horizontal" Spacing="8"><Button Name="OpenInstanceSettingsButton" Content="{loc:Loc tcb5c4d21c9d75f2f}" Command="{Binding OpenSelectedVisibleInstanceCommand}"/><Button Content="{loc:Loc t97555304b0d7e196}" Command="{Binding Root.ShowDownloadsCommand}"/></StackPanel>
          </StackPanel></Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
    <Grid ColumnDefinitions="150,*" IsVisible="{Binding !IsSelection}">
      <Border Background="{DynamicResource ClubSidebar}" IsVisible="{Binding !IsWorldDetails}"><StackPanel Margin="0,14,0,0" Spacing="4">
        <TextBlock Text="{loc:Loc te9faa1792d4db0b2}" Classes="contextHeading" Margin="13,0,0,6"/>
        <ListBox Name="InstanceSectionNavigation" Classes="navigation instanceNavigation" ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}">
          <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="{loc:Loc t9b4eaaa18caee368}" IsVisible="{Binding StartsResources}" Classes="contextHeading" Margin="13,10,0,8"/><Grid ColumnDefinitions="24,6,*" Margin="14,0,0,0" MinHeight="36"><views:ClubIcon Classes="contextIcon" Kind="{Binding IconKind}" /><TextBlock Grid.Column="2" Classes="navigationLabel" Text="{Binding Title}"/></Grid></StackPanel></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
      </StackPanel></Border>
      <ScrollViewer Name="InstancePageScroller" IsVisible="{Binding !IsWorldWorkspaceSection}" Grid.Column="1" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24" Spacing="14">
          <Border Classes="card" Padding="15,10" IsVisible="{Binding IsOverview}"><Grid ColumnDefinitions="38,*"><views:ClubIcon Kind="{Binding InstanceIconKind}" Width="27" Height="29" VerticalAlignment="Center" /><StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="{Binding SelectedInstance.Name}" FontSize="15" LineHeight="20" TextTrimming="CharacterEllipsis"/><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="{Binding GameVersionLabel}" Classes="muted" FontSize="11" LineHeight="16"/><TextBlock Text="{Binding SelectedInstance.Loader}" Classes="muted"/><TextBlock Text="{Binding SelectedInstance.LoaderVersion}" Classes="muted"/></StackPanel></StackPanel></Grid></Border>
          <StackPanel IsVisible="{Binding IsOverview}" Spacing="14">
            <Border Classes="card" Padding="15,12"><StackPanel Spacing="8"><TextBlock Text="{loc:Loc t92b742d80072559b}" Classes="sectionTitle" LineHeight="18"/>
              <WrapPanel>
                <StackPanel Orientation="Horizontal" Spacing="9" Margin="5,0,30,0"><views:ClubIcon Kind="file-box" Width="28" Height="28"/><StackPanel><TextBlock Text="{loc:Loc t713dffe3e706a2f8}" FontSize="14" LineHeight="20"/><TextBlock Name="InstanceLaunchCount" Text="{Binding LaunchCountLabel}" Classes="muted" FontSize="12" LineHeight="16" ToolTip.Tip="{loc:Loc t0a2d96fa6891f03c}"/></StackPanel></StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="9" Margin="0,0,30,0"><views:ClubIcon Kind="{x:Static themes:ClubIcons.Cube}" Width="28" Height="28" /><StackPanel><TextBlock Text="Minecraft" FontSize="14" LineHeight="20"/><TextBlock Text="{Binding GameVersionLabel}" Classes="muted" FontSize="12" LineHeight="16"/></StackPanel></StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="9" IsVisible="{Binding HasModLoader}"><views:ClubIcon Kind="{x:Static themes:ClubIcons.Cloth}" Width="28" Height="28" /><StackPanel><TextBlock Text="{Binding LoaderLabel}" FontSize="14" LineHeight="20"/><TextBlock Text="{Binding SelectedInstance.LoaderVersion}" Classes="muted" FontSize="12" LineHeight="16"/></StackPanel></StackPanel>
              </WrapPanel>
            </StackPanel></Border>
            <Border Classes="card"><StackPanel Spacing="12"><TextBlock Text="{loc:Loc t38c043e08502e710}" Classes="sectionTitle" LineHeight="18"/>
              <Grid ColumnDefinitions="60,*" Margin="10,0"><TextBlock Text="{loc:Loc t0d720eeea26466dd}" VerticalAlignment="Center"/><ComboBox Name="InstanceIconSelector" Grid.Column="1" ItemsSource="{Binding InstanceIcons}" SelectedItem="{Binding PresentationIcon}" IsEnabled="{Binding CanEdit}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></Grid>
              <Grid ColumnDefinitions="60,*" Margin="10,0"><TextBlock Text="{loc:Loc t515559957fd3acbd}" VerticalAlignment="Center"/><ComboBox Name="InstanceCategorySelector" Grid.Column="1" ItemsSource="{Binding InstanceCategories}" SelectedItem="{Binding PresentationCategory}" IsEnabled="{Binding CanEdit}"/></Grid>
              <WrapPanel Margin="10,3,0,7"><Button Name="SaveInstanceNameButton" Content="{loc:Loc t28a39ead5f71b8b2}" Command="{Binding BeginRenameCommand}" Width="140" Height="35" Margin="0,0,20,0"/><Button Name="EditInstanceDescription" Content="{loc:Loc tc9d9331f6df13c83}" Command="{Binding EditDescriptionCommand}" Width="140" Height="35" Margin="0,0,20,0"/><Button Name="ToggleInstanceFavorite" Content="{Binding FavoriteCaption}" Command="{Binding ToggleFavoriteCommand}" Width="140" Height="35"/></WrapPanel>
              <StackPanel Orientation="Horizontal" Spacing="10"><Button Name="SaveInstancePresentation" Content="{loc:Loc t88ecdc10bcaeed51}" Command="{Binding SavePresentationCommand}"/><TextBlock Text="{Binding PresentationSummary}" Classes="muted" TextWrapping="Wrap" MaxWidth="360" VerticalAlignment="Center"/></StackPanel>
            </StackPanel></Border>
            <Border Classes="card"><StackPanel Spacing="12"><TextBlock Text="{loc:Loc t6ab335864461b295}" Classes="sectionTitle" LineHeight="18"/><WrapPanel Margin="10,0,0,7"><Button Content="{loc:Loc t737dc0aa07b51649}" Command="{Binding OpenInstanceDirectoryCommand}" Width="140" Height="35" Margin="0,0,20,0"/><Button Content="{loc:Loc tf6e37bd65d12b035}" Click="OpenSavesDirectory_Click" Width="140" Height="35" Margin="0,0,20,0"/><Button Content="{loc:Loc tc87d9c833d9720b2}" Click="OpenModsDirectory_Click" Width="140" Height="35"/></WrapPanel></StackPanel></Border>
            <Border Classes="card"><StackPanel Spacing="12"><TextBlock Text="{loc:Loc t58dbf974977f7f52}" Classes="sectionTitle"/>
              <WrapPanel><Button Name="InstallInstanceButton" Content="{loc:Loc te5c51732660c8bb5}" Command="{Binding InstallCommand}" Margin="0,0,10,8"/><Button Name="LaunchGameButton" Content="{loc:Loc t853aab6ecaacb35b}" Command="{Binding LaunchCommand}" Margin="0,0,10,8"/><Button Content="{loc:Loc t026e2a6c2e9b63dc}" Command="{Binding InspectPlanCommand}" Margin="0,0,10,8"/><Button Content="{loc:Loc t633eb5f8529a10f6}" IsEnabled="False" ToolTip.Tip="{loc:Loc te4178a23f86691f0}" Margin="0,0,10,8"/></WrapPanel>
              <TextBlock Text="{Binding LaunchPrerequisite}" Classes="muted" LineHeight="16" FontSize="11"/>
              <TextBox Text="{Binding PlanDiagnostics}" IsVisible="{Binding HasPlanDiagnostics}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90"/>
            </StackPanel></Border>
          </StackPanel>
          <StackPanel IsVisible="{Binding IsInstanceSettings}" Spacing="14">
            <Border Classes="card"><StackPanel Spacing="12"><TextBlock Text="{loc:Loc t8dd0655d53256a1f}" Classes="sectionTitle"/>
              <CheckBox Name="InstanceFollowJavaSetting" Content="{loc:Loc t90516b535fd78607}" IsChecked="{Binding UseGlobalJava}"/>
              <Grid ColumnDefinitions="105,*"><TextBlock Text="{loc:Loc t9b8295587af9906d}" Classes="instanceLabel"/><TextBox Name="InstanceJavaExecutableSetting" Grid.Column="1" Text="{Binding InstanceJavaExecutable}" IsEnabled="{Binding !UseGlobalJava}" PlaceholderText="{loc:Loc t5f7469894e0eb5b2}"/></Grid>
              <CheckBox Name="InstanceFollowMemorySetting" Content="{loc:Loc ta20ece0a9ee45404}" IsChecked="{Binding UseGlobalMemory}"/>
              <Grid ColumnDefinitions="105,*"><TextBlock Text="{loc:Loc t7414a2c95ffa0a13}" Classes="instanceLabel"/><NumericUpDown Name="InstanceMemorySetting" Grid.Column="1" Minimum="512" Maximum="32768" Increment="256" Value="{Binding InstanceMemoryMiB}" IsEnabled="{Binding !UseGlobalMemory}"/></Grid>
              <CheckBox Name="InstanceFollowLaunchSettings" Content="{loc:Loc tffa1692cb8aef60b}" IsChecked="{Binding UseGlobalLaunchOptions}" />
              <StackPanel IsEnabled="{Binding !UseGlobalLaunchOptions}" Spacing="9">
                <Grid ColumnDefinitions="105,*"><TextBlock Text="{loc:Loc t6dfa4ea7d8c811fd}" Classes="instanceLabel" /><ComboBox Name="InstancePrioritySetting" Grid.Column="1" ItemsSource="{Binding Root.Settings.PriorityChoices}" SelectedItem="{Binding InstancePriority}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding ., Converter={StaticResource GamePreferenceLabel}}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox></Grid>
                <Grid ColumnDefinitions="105,*"><TextBlock Text="{loc:Loc t3f85718d9a70a26b}" Classes="instanceLabel" /><ComboBox Name="InstanceIpSetting" Grid.Column="1" ItemsSource="{Binding Root.Settings.IpChoices}" SelectedItem="{Binding InstanceIpPreference}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding ., Converter={StaticResource GamePreferenceLabel}}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox></Grid>
                <Grid ColumnDefinitions="105,*"><TextBlock Text="{loc:Loc t87f5b03f0660fc3e}" Classes="instanceLabel" /><ComboBox Name="InstanceVisibilitySetting" Grid.Column="1" ItemsSource="{Binding Root.Settings.VisibilityChoices}" SelectedItem="{Binding InstanceVisibility}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding ., Converter={StaticResource GamePreferenceLabel}}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox></Grid>
                <Grid ColumnDefinitions="105,*"><TextBlock Text="{loc:Loc tcd959f842f08bb65}" Classes="instanceLabel" /><TextBox Name="InstanceWindowTitleSetting" Grid.Column="1" Text="{Binding InstanceWindowTitle}" IsEnabled="{Binding Root.Settings.CanCustomizeGameTitle}" /></Grid>
                <Grid ColumnDefinitions="105,*"><TextBlock Text="{loc:Loc tc9173ee83b6a7e8c}" Classes="instanceLabel" /><TextBox Name="InstanceJvmArgumentsSetting" Grid.Column="1" Text="{Binding InstanceJvmArguments}" AcceptsReturn="True" MinHeight="68" ToolTip.Tip="{loc:Loc tfd2d4eb005e182d0}" /></Grid>
                <CheckBox Name="InstanceLockMemorySetting" Content="{loc:Loc ta5faf266c2bf4bd1}" IsChecked="{Binding InstanceLockMemory}" />
                <Grid ColumnDefinitions="105,*"><TextBlock Text="{loc:Loc tc3cc36f628b16596}" Classes="instanceLabel" /><StackPanel Grid.Column="1" Spacing="6"><StackPanel Orientation="Horizontal" Spacing="16"><CheckBox Name="InstanceCustomWindowSetting" Content="{loc:Loc t4eafa9e925b30bcd}" IsChecked="{Binding InstanceCustomWindow}" /><CheckBox Name="InstanceFullscreenSetting" Content="{loc:Loc t22ea3f47fee80536}" IsChecked="{Binding InstanceFullscreen}" /></StackPanel><Grid IsVisible="{Binding InstanceCustomWindow}" ColumnDefinitions="*,20,*"><NumericUpDown Name="InstanceWindowWidthSetting" Minimum="320" Maximum="16384" FormatString="0" Value="{Binding InstanceWindowWidth}" /><TextBlock Grid.Column="1" Text="×" HorizontalAlignment="Center" VerticalAlignment="Center" /><NumericUpDown Name="InstanceWindowHeightSetting" Grid.Column="2" Minimum="320" Maximum="16384" FormatString="0" Value="{Binding InstanceWindowHeight}" /></Grid></StackPanel></Grid>
                <Grid ColumnDefinitions="105,*"><TextBlock Text="{loc:Loc tabc00290e88e742c}" Classes="instanceLabel" /><TextBox Name="InstanceCustomInfoSetting" Grid.Column="1" Text="{Binding InstanceCustomInfo}" /></Grid>
                <Grid ColumnDefinitions="105,*"><TextBlock Text="{loc:Loc t50509f2f2741a776}" Classes="instanceLabel" /><TextBox Name="InstanceGameArgumentsSetting" Grid.Column="1" Text="{Binding InstanceGameArguments}" /></Grid>
              </StackPanel>
              <Button Name="SaveInstanceSettingsButton" Content="{loc:Loc tc8ea0b805c649d5f}" Command="{Binding SaveInstanceSettingsCommand}"/>
            </StackPanel></Border>
            <Border Classes="card"><StackPanel Spacing="12"><TextBlock Text="{loc:Loc tbfb579e0b55c8526}" Classes="sectionTitle"/>
              <ComboBox Name="JavaSelector" ItemsSource="{Binding JavaInstallations}" SelectedItem="{Binding SelectedJava}" IsEnabled="{Binding CanEdit}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding FullVersion}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
              <Grid ColumnDefinitions="*,Auto"><TextBox Name="JavaPath" Text="{Binding JavaExecutable}"/><Button Grid.Column="1" Content="{loc:Loc t0617557e7bbc153d}" Click="PickJava_Click" Margin="8,0,0,0"/></Grid>
              <NumericUpDown Name="MemoryMiB" Minimum="512" Maximum="32768" Increment="256" Value="{Binding MemoryMiB}"/>
              <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="{loc:Loc t5e5ee0fe2602625c}" Command="{Binding DiscoverJavaCommand}"/><Button Content="{loc:Loc t782a5bacbed379f1}" Command="{Binding SaveRuntimeCommand}"/></StackPanel>
              <TextBlock Text="{Binding RuntimeDraftSummary}" Classes="muted" LineHeight="16" FontSize="11"/>
            </StackPanel></Border>
          </StackPanel>
          <StackPanel IsVisible="{Binding IsModify}" Spacing="14">
            <Border Classes="card"><StackPanel Spacing="12">
              <Grid ColumnDefinitions="*,Auto"><TextBlock Text="实例组件" Classes="sectionTitle"/><views:LoadingGlyph Grid.Column="1" IsVisible="{Binding IsComponentBusy}" Width="28" Height="28" Foreground="{DynamicResource ClubAccent}"/></Grid>
              <Grid ColumnDefinitions="80,*"><TextBlock Text="加载器" VerticalAlignment="Center"/><ComboBox Name="ComponentLoaderChoice" Grid.Column="1" ItemsSource="{Binding ComponentLoaderChoices}" SelectedItem="{Binding ComponentLoader}" IsEnabled="{Binding !IsComponentBusy}" HorizontalAlignment="Stretch"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></Grid>
              <Grid ColumnDefinitions="80,*" IsVisible="{Binding ComponentNeedsVersion}"><TextBlock Text="版本" VerticalAlignment="Center"/><ComboBox Name="ComponentVersionChoice" Grid.Column="1" ItemsSource="{Binding ComponentVersions}" SelectedItem="{Binding ComponentVersion}" IsEnabled="{Binding !IsComponentBusy}" HorizontalAlignment="Stretch"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding DisplayVersion}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></Grid>
              <CheckBox Name="ConfirmComponentChange" Content="确认修改所选实例的加载器" IsChecked="{Binding ConfirmComponentChange}" IsEnabled="{Binding !IsComponentBusy}" ToolTip.Tip="保留模组和资源文件。请先确认它们与新的加载器版本兼容。"/>
              <WrapPanel><Button Name="ChangeInstanceComponentButton" Content="应用修改" Command="{Binding ChangeInstanceComponentCommand}" Margin="0,0,8,0"/><Button Content="刷新" Command="{Binding RefreshComponentVersionsCommand}" Margin="0,0,8,0"/><Button Content="取消" Command="{Binding CancelComponentWorkCommand}" IsVisible="{Binding IsComponentBusy}"/></WrapPanel>
              <TextBlock Text="{Binding ComponentFeedback}" TextWrapping="Wrap"/>
            </StackPanel></Border>
            <Border Classes="card"><Button Content="{loc:Loc ta7d8b0fac0530c5d}" Command="{Binding InstallCommand}"/></Border>
          </StackPanel>
          <StackPanel IsVisible="{Binding IsExport}" Spacing="14"><Border Classes="card"><StackPanel Spacing="12"><TextBlock Text="{loc:Loc ta5f60f01968f6b61}" Classes="sectionTitle" ToolTip.Tip="{loc:Loc t544148aa438ca527}"/><TextBlock Text="{loc:Loc te68f1ccd9cd2cd8d}" FontWeight="SemiBold"/>
            <CheckBox Content="{loc:Loc t83d2e0abb1be9fda}" IsChecked="{Binding IncludeWorlds}"/><Button Name="ExportInstanceButton" Content="{loc:Loc t88da633ca77352d5}" Command="{Binding ExportInstanceCommand}"/>
          </StackPanel></Border><Border Classes="card"><StackPanel Spacing="12"><TextBlock Text="{loc:Loc tdc4c94a1a3ea2d5e}" Classes="sectionTitle" ToolTip.Tip="{loc:Loc t58a5ad2bda3e2f92}"/>
            <Grid ColumnDefinitions="70,*"><TextBlock Text="{loc:Loc td44e9b3d3b31d37b}" VerticalAlignment="Center"/><TextBox Name="ExportPackName" Grid.Column="1" Text="{Binding ExportPackName}"/></Grid>
            <Grid ColumnDefinitions="70,*"><TextBlock Text="{loc:Loc t5f76b2bf82dd2c5d}" VerticalAlignment="Center"/><TextBox Name="ExportPackVersion" Grid.Column="1" Text="{Binding ExportPackVersion}"/></Grid>
            <CheckBox Content="{loc:Loc t09ef712618900f7e}" IsChecked="{Binding ExportPackConfig}"/>
            <CheckBox Content="{loc:Loc tefb82dfd5f5adf50}" IsChecked="{Binding ExportPackOptions}"/>
            <CheckBox Content="{loc:Loc t39ad239746a87b3b}" IsChecked="{Binding ExportPackLocalFiles}"/>
            <Button Name="ExportModrinthPackButton" Content="{loc:Loc t77587cdd53235518}" Command="{Binding ExportModrinthPackCommand}"/>
            <Button Name="ExportCurseForgePackButton" Content="导出 CurseForge 整合包" Command="{Binding ExportCurseForgePackCommand}"/>
          </StackPanel></Border></StackPanel>
          <StackPanel IsVisible="{Binding IsFileSection}" Spacing="14">
            <Border Classes="card"><StackPanel Spacing="10"><TextBlock Text="{loc:Loc t899432d83d98c3bf}" Classes="sectionTitle" LineHeight="18"/>
              <WrapPanel Margin="10,0,0,5"><Button Content="{Binding OpenContentFolderCaption}" Command="{Binding OpenContentDirectoryCommand}" MinWidth="140" Height="35" Margin="0,0,8,0"/><Button Content="{loc:Loc t7bc03302e1e4f67c}" Click="ImportContent_Click" IsVisible="{Binding IsContentList}" IsEnabled="{Binding CanImportContent}" Margin="0,0,8,0"/><Button Content="{loc:Loc taee88743413144a2}" Command="{Binding RefreshContentCommand}" IsVisible="{Binding IsContentList}" Margin="0,0,8,0"/><Button Content="{loc:Loc tc5e3c735e678f439}" IsVisible="{Binding IsModsSection}" Command="{Binding ToggleModCommand}"/></WrapPanel>
            </StackPanel></Border>
            <Border Classes="card" IsVisible="{Binding IsContentEmpty}" Margin="70,52"><StackPanel Spacing="8" ToolTip.Tip="{Binding CapabilityReason}"><TextBlock Text="{Binding ContentEmptyTitle}" Foreground="{DynamicResource ClubSelectionForeground}" HorizontalAlignment="Center"/><Separator/></StackPanel></Border>
            <StackPanel IsVisible="{Binding IsScreenshots}" Spacing="12"><Button Name="RestoreLastScreenshot" Content="{loc:Loc tb00dda1796c8a1e3}" Command="{Binding RestoreScreenshotCommand}" HorizontalAlignment="Left"/><TextBlock Text="{Binding ScreenshotSummary}" IsVisible="{Binding HasTruncatedScreenshots}" Classes="muted" LineHeight="16" FontSize="11"/>
              <ItemsControl Name="ScreenshotGallery" ItemsSource="{Binding ScreenshotPreviews}" Margin="7,8,7,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
                <Border Classes="card" Padding="0" Margin="7,0,7,14" ClipToBounds="True"><StackPanel Spacing="0">
                  <Grid Height="120" Background="{DynamicResource ClubSidebar}"><Image Source="{Binding Preview}" Stretch="UniformToFill" IsVisible="{Binding HasPreview}"/><TextBlock Text="{loc:Loc tb825ccc758e9cba4}" IsVisible="{Binding !HasPreview}" Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center" ToolTip.Tip="{Binding Name}"/></Grid>
                  <Grid ColumnDefinitions="*,*,*" Margin="4,5"><Button Classes="flat" Content="{loc:Loc t4e1449e7d5e50593}" Command="{Binding RevealCommand}" Padding="4"/><Button Grid.Column="1" Classes="flat" Content="{loc:Loc t2f9daa828907b93f}" Command="{Binding RemoveCommand}" ToolTip.Tip="{loc:Loc tde3b627ba0b656e0}" Padding="4"/><Button Grid.Column="2" Classes="flat" Content="{loc:Loc t63d90d977348ab1f}" Click="CopyScreenshot_Click" IsEnabled="{Binding HasPreview}" Padding="4"/></Grid>
                </StackPanel></Border>
              </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </StackPanel>
            <ListBox Name="InstanceContentList" IsVisible="{Binding IsContentList}" Classes="instanceList" ItemsSource="{Binding ContentEntries}" SelectedItem="{Binding SelectedContent}"><ListBox.ItemTemplate><DataTemplate><Grid ColumnDefinitions="30,*,110"><views:ClubIcon Kind="file-input" Width="18" Height="20"/><StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding RelativePath}" Classes="muted" LineHeight="14" FontSize="10"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding Bytes, StringFormat='{}{0:N0} B'}" LineHeight="14" FontSize="10" Classes="muted" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
          </StackPanel>
          <Border Classes="card" IsVisible="{Binding IsOtherSection}"><StackPanel Spacing="10"><TextBlock Text="{Binding SectionTitle}" Classes="sectionTitle" ToolTip.Tip="{Binding CapabilityReason}"/><Button Content="{loc:Loc ta1ca2a6b2f93b4d6}" Command="{Binding OpenInstanceDirectoryCommand}"/></StackPanel></Border>
          <TextBlock Name="InstanceFeedback" IsVisible="{Binding HasFeedback}" Text="{loc:Translate Feedback}" TextWrapping="Wrap" Classes="muted"/>
        </StackPanel>
      </ScrollViewer>
      <views:InstanceWorldsView Grid.ColumnSpan="2" IsVisible="{Binding IsWorldWorkspaceSection}"/>
    </Grid>
    <Border Name="InstanceRenameOverlay" Background="#50000000" IsVisible="{Binding IsRenameEditorOpen}" KeyDown="RenameEditor_KeyDown">
      <Border Classes="card" Width="420" Padding="22" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel Spacing="16">
        <TextBlock Text="{loc:Loc t28a39ead5f71b8b2}" Classes="sectionTitle"/><TextBox Name="InstanceDisplayName" Text="{Binding RenameDraft}" PlaceholderText="{loc:Loc t4ae7b70e363dd219}"/>
        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right"><Button Content="{loc:Loc t2cd0f3be8738a86c}" Command="{Binding CancelRenameCommand}"/><Button Name="ConfirmInstanceRename" Content="{loc:Loc tfac2a67ad87807c4}" Command="{Binding SaveRenameCommand}" Classes="primary"/></StackPanel>
      </StackPanel></Border>
    </Border>
    <Border Name="InstanceDescriptionOverlay" Background="#50000000" IsVisible="{Binding IsDescriptionEditorOpen}">
      <Border Classes="card" Width="440" Padding="22" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel Spacing="16">
        <TextBlock Text="{loc:Loc tc9d9331f6df13c83}" Classes="sectionTitle"/><TextBox Name="InstanceDescription" Text="{Binding PresentationDescription}" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="4096" MinHeight="100" MaxHeight="240" PlaceholderText="{loc:Loc t46b738c9f0ee6737}"/>
        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right"><Button Content="{loc:Loc t2cd0f3be8738a86c}" Command="{Binding CancelDescriptionCommand}"/><Button Name="ConfirmInstanceDescription" Content="{loc:Loc ta3030bf8f16dc63c}" Command="{Binding SavePresentationCommand}" Classes="primary"/></StackPanel>
      </StackPanel></Border>
    </Border>
  </Grid>
</UserControl>
