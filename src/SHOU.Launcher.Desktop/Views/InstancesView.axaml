<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:themes="using:SHOU.Launcher.Desktop.Themes" xmlns:views="using:SHOU.Launcher.Desktop.Views" x:Class="SHOU.Launcher.Desktop.Views.InstancesView" x:Name="InstancePage" AttachedToVisualTree="WorkspaceAttached" DetachedFromVisualTree="WorkspaceDetached" DataContextChanged="WorkspaceDataContextChanged">
  <UserControl.Styles>
    <Style Selector="ListBox.instanceList"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/></Style>
    <Style Selector="ListBox.instanceList ListBoxItem"><Setter Property="Padding" Value="10,7"/><Setter Property="CornerRadius" Value="3"/><Setter Property="Margin" Value="0,1"/></Style>
    <Style Selector="ListBox.instanceList ListBoxItem:selected /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource ClubSelection}"/></Style>
    <Style Selector="TextBlock.instanceLabel"><Setter Property="Width" Value="105"/><Setter Property="VerticalAlignment" Value="Center"/></Style>
    <Style Selector="ListBox.instanceNavigation ListBoxItem"><Setter Property="Padding" Value="0"/><Setter Property="MinHeight" Value="36"/><Setter Property="Margin" Value="0"/></Style>
    <Style Selector="ListBox.instanceNavigation ListBoxItem:selected /template/ ContentPresenter#PART_ContentPresenter"><Setter Property="Background" Value="Transparent"/><Setter Property="BorderBrush" Value="{DynamicResource ClubSelectionForeground}"/><Setter Property="BorderThickness" Value="3,0,0,0"/></Style>
    <Style Selector="ListBox.instanceNavigation ListBoxItem:selected TextBlock"><Setter Property="Foreground" Value="{DynamicResource ClubSelectionForeground}"/></Style>
    <Style Selector="ListBox.instanceNavigation ListBoxItem:selected Path"><Setter Property="Stroke" Value="{DynamicResource ClubSelectionForeground}"/></Style>
  </UserControl.Styles>
  <Grid>
    <Grid ColumnDefinitions="175,*" IsVisible="{Binding IsSelection}">
      <Border Background="{DynamicResource ClubSidebar}" Padding="12,15">
        <StackPanel Spacing="10"><TextBlock Text="游戏目录" Classes="muted" FontSize="11"/>
          <TextBlock Text="{Binding GameDirectorySummary}" TextWrapping="Wrap" FontSize="11"/>
          <Button Content="管理游戏目录" Command="{Binding Root.ShowSettingsCommand}" HorizontalAlignment="Stretch"/>
          <Button Name="OpenInstancePackImport" Content="导入整合包" Command="{Binding OpenPackImportCommand}" HorizontalAlignment="Stretch"/>
          <Separator Margin="0,4"/>
          <TextBlock Text="选择实例后可双击或按 Enter 进入实例设置。" Classes="muted" FontSize="11"/>
        </StackPanel>
      </Border>
      <ScrollViewer Name="InstanceSelectionScroller" Grid.Column="1" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24" Spacing="12">
          <TextBox Name="InstanceSearch" Text="{Binding SearchText}" PlaceholderText="搜索实例名称、版本或加载器"/>
          <CheckBox Name="FavoriteInstancesFilter" Content="只显示收藏的实例" IsChecked="{Binding FavoritesOnly}"/>
          <Border Classes="card"><StackPanel Spacing="10"><TextBlock Text="{Binding InstanceCountSummary}" FontWeight="SemiBold"/>
            <ListBox Name="InstanceSelector" Classes="instanceList" ItemsSource="{Binding FilteredInstances}" SelectedItem="{Binding SelectedInstance}" IsEnabled="{Binding CanEdit}" DoubleTapped="OpenSelectedInstance_DoubleTapped" KeyDown="OpenSelectedInstance_KeyDown">
              <ListBox.ItemTemplate><DataTemplate><Grid ColumnDefinitions="32,*"><Border Width="25" Height="25" Background="{DynamicResource ClubSelection}" CornerRadius="3"><Path Data="M9,0 L17,4 L17,13 L9,18 L1,13 L1,4 Z M1,4 L9,9 L17,4 M9,9 L9,18" Width="20" Height="20" Stretch="Uniform" Stroke="{DynamicResource ClubForeground}" StrokeThickness="1.3"/></Border>
                <StackPanel Grid.Column="1" Spacing="2"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/>
                  <StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="{Binding VersionId}" Classes="muted" FontSize="11"/><TextBlock Text="{Binding Loader}" Classes="muted" FontSize="11"/><TextBlock Text="{Binding LoaderVersion}" Classes="muted" FontSize="11"/></StackPanel>
                </StackPanel></Grid></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Orientation="Horizontal" Spacing="8"><Button Name="OpenInstanceSettingsButton" Content="实例设置" Command="{Binding OpenVisibleInstanceCommand}" CommandParameter="{Binding #InstanceSelector.SelectedItem}"/><Button Content="下载新版本" Command="{Binding Root.ShowDownloadsCommand}"/></StackPanel>
          </StackPanel></Border>
        </StackPanel>
      </ScrollViewer>
    </Grid>
    <Grid ColumnDefinitions="150,*" IsVisible="{Binding !IsSelection}">
      <Border Background="{DynamicResource ClubSidebar}" IsVisible="{Binding !IsWorldDetails}"><StackPanel Margin="0,14,0,0" Spacing="4">
        <TextBlock Text="游戏本体" Classes="muted" FontSize="11" Margin="13,0,0,6"/>
        <ListBox Name="InstanceSectionNavigation" Classes="navigation instanceNavigation" ItemsSource="{Binding Sections}" SelectedItem="{Binding SelectedSection}">
          <ListBox.ItemTemplate><DataTemplate><StackPanel><TextBlock Text="游戏资源" IsVisible="{Binding StartsResources}" Classes="muted" FontSize="11" Margin="13,10,0,8"/><Grid ColumnDefinitions="28,*" Margin="13,0,0,0" MinHeight="36"><Path Data="{Binding IconPath}" Width="18" Height="18" Stretch="Uniform" Stroke="{DynamicResource ClubForeground}" StrokeThickness="1.5" VerticalAlignment="Center"/><TextBlock Grid.Column="1" Text="{Binding Title}" VerticalAlignment="Center"/></Grid></StackPanel></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
      </StackPanel></Border>
      <ScrollViewer Name="InstancePageScroller" IsVisible="{Binding !IsWorldWorkspaceSection}" Grid.Column="1" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="24" Spacing="14">
          <Border Classes="card" Padding="15,10" IsVisible="{Binding IsOverview}"><Grid ColumnDefinitions="38,*"><Path Data="{Binding InstanceIconPath}" Width="27" Height="29" Stretch="Uniform" Stroke="{DynamicResource ClubForeground}" StrokeThickness="1.5" VerticalAlignment="Center"/><StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="{Binding SelectedInstance.Name}" FontSize="15" LineHeight="20" TextTrimming="CharacterEllipsis"/><StackPanel Orientation="Horizontal" Spacing="6"><TextBlock Text="{Binding GameVersionLabel}" Classes="muted" FontSize="11" LineHeight="16"/><TextBlock Text="{Binding SelectedInstance.Loader}" Classes="muted"/><TextBlock Text="{Binding SelectedInstance.LoaderVersion}" Classes="muted"/></StackPanel></StackPanel></Grid></Border>
          <StackPanel IsVisible="{Binding IsOverview}" Spacing="14">
            <Border Classes="card" Padding="15,12"><StackPanel Spacing="8"><TextBlock Text="实例信息" Classes="sectionTitle" LineHeight="18"/>
              <WrapPanel>
                <StackPanel Orientation="Horizontal" Spacing="9" Margin="5,0,30,0"><Path Data="M2,2 H20 V20 H2 Z M7,7 H15 V15 H7 Z M11,0 V4 M11,18 V22 M0,11 H4 M18,11 H22" Width="28" Height="28" Stretch="Uniform" Stroke="{DynamicResource ClubForeground}" StrokeThickness="1.4"/><StackPanel><TextBlock Text="启动次数" FontSize="14" LineHeight="20"/><TextBlock Name="InstanceLaunchCount" Text="{Binding LaunchCountLabel}" Classes="muted" FontSize="12" LineHeight="16" ToolTip.Tip="从此版本开始记录成功创建游戏进程的次数。"/></StackPanel></StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="9" Margin="0,0,30,0"><Path Data="{x:Static themes:ClubIcons.Cube}" Width="28" Height="28" Stretch="Uniform" Stroke="{DynamicResource ClubForeground}" StrokeThickness="1.4"/><StackPanel><TextBlock Text="Minecraft" FontSize="14" LineHeight="20"/><TextBlock Text="{Binding GameVersionLabel}" Classes="muted" FontSize="12" LineHeight="16"/></StackPanel></StackPanel>
                <StackPanel Orientation="Horizontal" Spacing="9" IsVisible="{Binding HasModLoader}"><Path Data="{x:Static themes:ClubIcons.Cloth}" Width="28" Height="28" Stretch="Uniform" Stroke="{DynamicResource ClubForeground}" StrokeThickness="1.4"/><StackPanel><TextBlock Text="{Binding LoaderLabel}" FontSize="14" LineHeight="20"/><TextBlock Text="{Binding SelectedInstance.LoaderVersion}" Classes="muted" FontSize="12" LineHeight="16"/></StackPanel></StackPanel>
              </WrapPanel>
            </StackPanel></Border>
            <Border Classes="card"><StackPanel Spacing="12"><TextBlock Text="个性化" Classes="sectionTitle" LineHeight="18"/>
              <Grid ColumnDefinitions="60,*" Margin="10,0"><TextBlock Text="图标" VerticalAlignment="Center"/><ComboBox Name="InstanceIconSelector" Grid.Column="1" ItemsSource="{Binding InstanceIcons}" SelectedItem="{Binding PresentationIcon}" IsEnabled="{Binding CanEdit}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox></Grid>
              <Grid ColumnDefinitions="60,*" Margin="10,0"><TextBlock Text="分类" VerticalAlignment="Center"/><ComboBox Name="InstanceCategorySelector" Grid.Column="1" ItemsSource="{Binding InstanceCategories}" SelectedItem="{Binding PresentationCategory}" IsEnabled="{Binding CanEdit}"/></Grid>
              <WrapPanel Margin="10,3,0,7"><Button Name="SaveInstanceNameButton" Content="修改实例名" Command="{Binding BeginRenameCommand}" Width="140" Height="35" Margin="0,0,20,0"/><Button Name="EditInstanceDescription" Content="修改实例描述" Command="{Binding EditDescriptionCommand}" Width="140" Height="35" Margin="0,0,20,0"/><Button Name="ToggleInstanceFavorite" Content="{Binding FavoriteCaption}" Command="{Binding ToggleFavoriteCommand}" Width="140" Height="35"/></WrapPanel>
              <StackPanel Orientation="Horizontal" Spacing="10"><Button Name="SaveInstancePresentation" Content="保存个性化" Command="{Binding SavePresentationCommand}"/><TextBlock Text="{Binding PresentationSummary}" Classes="muted" TextWrapping="Wrap" MaxWidth="360" VerticalAlignment="Center"/></StackPanel>
            </StackPanel></Border>
            <Border Classes="card"><StackPanel Spacing="12"><TextBlock Text="快捷方式" Classes="sectionTitle" LineHeight="18"/><WrapPanel Margin="10,0,0,7"><Button Content="实例文件夹" Command="{Binding OpenInstanceDirectoryCommand}" Width="140" Height="35" Margin="0,0,20,0"/><Button Content="存档文件夹" Click="OpenSavesDirectory_Click" Width="140" Height="35" Margin="0,0,20,0"/><Button Content="模组文件夹" Click="OpenModsDirectory_Click" Width="140" Height="35"/></WrapPanel></StackPanel></Border>
            <Border Classes="card"><StackPanel Spacing="12"><TextBlock Text="高级管理" Classes="sectionTitle"/>
              <WrapPanel><Button Name="InstallInstanceButton" Content="补全 / 校验文件" Command="{Binding InstallCommand}" Margin="0,0,10,8"/><Button Name="LaunchGameButton" Content="测试游戏" Command="{Binding LaunchCommand}" Margin="0,0,10,8"/><Button Content="检查启动计划" Command="{Binding InspectPlanCommand}" Margin="0,0,10,8"/><Button Content="导出启动脚本" IsEnabled="False" ToolTip.Tip="受保护启动参数不可作为明文脚本导出。" Margin="0,0,10,8"/></WrapPanel>
              <TextBlock Text="{Binding LaunchPrerequisite}" Classes="muted" FontSize="11"/>
              <TextBox Text="{Binding PlanDiagnostics}" IsVisible="{Binding HasPlanDiagnostics}" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="90"/>
            </StackPanel></Border>
          </StackPanel>
          <StackPanel IsVisible="{Binding IsInstanceSettings}" Spacing="14">
            <Border Classes="card"><StackPanel Spacing="12"><TextBlock Text="启动选项" Classes="sectionTitle"/>
              <CheckBox Content="Java 跟随全局设置" IsChecked="{Binding UseGlobalJava}"/>
              <Grid ColumnDefinitions="105,*"><TextBlock Text="独立 Java 路径" Classes="instanceLabel"/><TextBox Grid.Column="1" Text="{Binding InstanceJavaExecutable}" IsEnabled="{Binding !UseGlobalJava}" PlaceholderText="Java 可执行文件的绝对路径"/></Grid>
              <CheckBox Content="内存跟随全局设置" IsChecked="{Binding UseGlobalMemory}"/>
              <Grid ColumnDefinitions="105,*"><TextBlock Text="最大内存（MiB）" Classes="instanceLabel"/><NumericUpDown Grid.Column="1" Minimum="512" Maximum="32768" Increment="256" Value="{Binding InstanceMemoryMiB}" IsEnabled="{Binding !UseGlobalMemory}"/></Grid>
              <Button Name="SaveInstanceSettingsButton" Content="保存实例设置" Command="{Binding SaveInstanceSettingsCommand}"/>
            </StackPanel></Border>
            <Border Classes="card"><StackPanel Spacing="12"><TextBlock Text="全局 Java 与内存" Classes="sectionTitle"/>
              <ComboBox Name="JavaSelector" ItemsSource="{Binding JavaInstallations}" SelectedItem="{Binding SelectedJava}" IsEnabled="{Binding CanEdit}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding FullVersion}"/></DataTemplate></ComboBox.ItemTemplate></ComboBox>
              <Grid ColumnDefinitions="*,Auto"><TextBox Name="JavaPath" Text="{Binding JavaExecutable}"/><Button Grid.Column="1" Content="浏览…" Click="PickJava_Click" Margin="8,0,0,0"/></Grid>
              <NumericUpDown Name="MemoryMiB" Minimum="512" Maximum="32768" Increment="256" Value="{Binding MemoryMiB}"/>
              <StackPanel Orientation="Horizontal" Spacing="8"><Button Content="发现 Java" Command="{Binding DiscoverJavaCommand}"/><Button Content="应用 Java 与内存" Command="{Binding SaveRuntimeCommand}"/></StackPanel>
              <TextBlock Text="{Binding RuntimeDraftSummary}" Classes="muted" FontSize="11"/>
            </StackPanel></Border>
          </StackPanel>
          <StackPanel IsVisible="{Binding IsModify}" Spacing="14"><Border Classes="card"><StackPanel Spacing="10"><TextBlock Text="修改实例" Classes="sectionTitle"/><TextBlock Text="{Binding CapabilityReason}" Classes="muted"/><Button Content="重新校验当前实例" Command="{Binding InstallCommand}"/><Button Content="下载其他版本" Command="{Binding Root.ShowDownloadsCommand}"/></StackPanel></Border></StackPanel>
          <StackPanel IsVisible="{Binding IsExport}" Spacing="14"><Border Classes="card"><StackPanel Spacing="12"><TextBlock Text="导出实例" Classes="sectionTitle"/><TextBlock Text="SHOU 实例 ZIP" FontWeight="SemiBold"/><TextBlock Text="包含实例清单、模组、配置和资源；不包含启动器账户或凭据。游戏本体与运行库可按清单重新安装。" Classes="muted"/>
            <CheckBox Content="包含存档" IsChecked="{Binding IncludeWorlds}"/><Button Name="ExportInstanceButton" Content="开始导出" Command="{Binding ExportInstanceCommand}"/>
          </StackPanel></Border><Border Classes="card"><StackPanel Spacing="12"><TextBlock Text="Modrinth 客户端整合包（.mrpack）" Classes="sectionTitle"/><TextBlock Text="支持原版与Fabric。已登记资源优先导出校验后的下载清单；本地文件须明确选入，不包含启动器账户、日志或缓存。" Classes="muted" TextWrapping="Wrap"/>
            <Grid ColumnDefinitions="70,*"><TextBlock Text="名称" VerticalAlignment="Center"/><TextBox Name="ExportPackName" Grid.Column="1" Text="{Binding ExportPackName}"/></Grid>
            <Grid ColumnDefinitions="70,*"><TextBlock Text="版本" VerticalAlignment="Center"/><TextBox Name="ExportPackVersion" Grid.Column="1" Text="{Binding ExportPackVersion}"/></Grid>
            <CheckBox Content="包含现有 config 配置目录" IsChecked="{Binding ExportPackConfig}"/>
            <CheckBox Content="包含 options.txt 客户端设置" IsChecked="{Binding ExportPackOptions}"/>
            <CheckBox Content="打包本机模组、资源包与光影文件" IsChecked="{Binding ExportPackLocalFiles}"/>
            <Button Name="ExportModrinthPackButton" Content="导出 .mrpack" Command="{Binding ExportModrinthPackCommand}"/>
          </StackPanel></Border></StackPanel>
          <StackPanel IsVisible="{Binding IsFileSection}" Spacing="14">
            <Border Classes="card"><StackPanel Spacing="10"><TextBlock Text="快捷操作" Classes="sectionTitle" LineHeight="18"/>
              <WrapPanel Margin="10,0,0,5"><Button Content="{Binding OpenContentFolderCaption}" Command="{Binding OpenContentDirectoryCommand}" MinWidth="140" Height="35" Margin="0,0,8,0"/><Button Content="从文件安装" Click="ImportContent_Click" IsVisible="{Binding IsContentList}" IsEnabled="{Binding CanImportContent}" Margin="0,0,8,0"/><Button Content="刷新" Command="{Binding RefreshContentCommand}" IsVisible="{Binding IsContentList}" Margin="0,0,8,0"/><Button Content="启用 / 禁用模组" IsVisible="{Binding IsModsSection}" Command="{Binding ToggleModCommand}"/></WrapPanel>
            </StackPanel></Border>
            <Border Classes="card" IsVisible="{Binding IsContentEmpty}" Margin="70,52"><StackPanel Spacing="8"><TextBlock Text="{Binding ContentEmptyTitle}" Foreground="{DynamicResource ClubSelectionForeground}" HorizontalAlignment="Center"/><Separator/><TextBlock Text="{Binding CapabilityReason}" Classes="muted" TextAlignment="Center" FontSize="11"/></StackPanel></Border>
            <StackPanel IsVisible="{Binding IsScreenshots}" Spacing="12"><Button Name="RestoreLastScreenshot" Content="恢复最近删除" Command="{Binding RestoreScreenshotCommand}" HorizontalAlignment="Left"/><TextBlock Text="{Binding ScreenshotSummary}" IsVisible="{Binding HasTruncatedScreenshots}" Classes="muted" FontSize="11"/>
              <ItemsControl Name="ScreenshotGallery" ItemsSource="{Binding ScreenshotPreviews}" Margin="7,8,7,0"><ItemsControl.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="3"/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate>
                <Border Classes="card" Padding="0" Margin="7,0,7,14" ClipToBounds="True" ToolTip.Tip="{Binding Name}"><StackPanel Spacing="0">
                  <Grid Height="120" Background="{DynamicResource ClubSidebar}"><Image Source="{Binding Preview}" Stretch="UniformToFill" IsVisible="{Binding HasPreview}"/><TextBlock Text="无法预览" IsVisible="{Binding !HasPreview}" Classes="muted" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid>
                  <Grid ColumnDefinitions="*,*,*" Margin="4,5"><Button Classes="flat" Content="显示" Command="{Binding RevealCommand}" Padding="4"/><Button Grid.Column="1" Classes="flat" Content="删除" Command="{Binding RemoveCommand}" ToolTip.Tip="移入当前实例的截图回收站，可恢复。" Padding="4"/><Button Grid.Column="2" Classes="flat" Content="复制" Click="CopyScreenshot_Click" IsEnabled="{Binding HasPreview}" Padding="4"/></Grid>
                </StackPanel></Border>
              </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </StackPanel>
            <ListBox Name="InstanceContentList" IsVisible="{Binding IsContentList}" Classes="instanceList" ItemsSource="{Binding ContentEntries}" SelectedItem="{Binding SelectedContent}"><ListBox.ItemTemplate><DataTemplate><Grid ColumnDefinitions="30,*,110"><Path Data="M3,1 H11 L16,6 V19 H3 Z M11,1 V6 H16" Width="18" Height="20" Stretch="Uniform" Stroke="{DynamicResource ClubForeground}" StrokeThickness="1.3"/><StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding RelativePath}" Classes="muted" FontSize="10"/></StackPanel><TextBlock Grid.Column="2" Text="{Binding Bytes, StringFormat='{}{0:N0} B'}" FontSize="10" Classes="muted" VerticalAlignment="Center" HorizontalAlignment="Right"/></Grid></DataTemplate></ListBox.ItemTemplate></ListBox>
          </StackPanel>
          <Border Classes="card" IsVisible="{Binding IsOtherSection}"><StackPanel Spacing="10"><TextBlock Text="{Binding SectionTitle}" Classes="sectionTitle"/><TextBlock Text="{Binding CapabilityReason}" Classes="muted"/><Button Content="打开实例文件夹" Command="{Binding OpenInstanceDirectoryCommand}"/></StackPanel></Border>
          <TextBlock Name="InstanceFeedback" IsVisible="{Binding HasFeedback}" Text="{Binding Feedback}" TextWrapping="Wrap" Classes="muted"/>
        </StackPanel>
      </ScrollViewer>
      <views:InstanceWorldsView Grid.ColumnSpan="2" IsVisible="{Binding IsWorldWorkspaceSection}"/>
    </Grid>
    <Border Name="InstanceRenameOverlay" Background="#50000000" IsVisible="{Binding IsRenameEditorOpen}" KeyDown="RenameEditor_KeyDown">
      <Border Classes="card" Width="420" Padding="22" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel Spacing="16">
        <TextBlock Text="修改实例名" Classes="sectionTitle"/><TextBox Name="InstanceDisplayName" Text="{Binding RenameDraft}" PlaceholderText="新的实例名称"/>
        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right"><Button Content="取消" Command="{Binding CancelRenameCommand}"/><Button Name="ConfirmInstanceRename" Content="确定" Command="{Binding SaveRenameCommand}" Classes="primary"/></StackPanel>
      </StackPanel></Border>
    </Border>
    <Border Name="InstanceDescriptionOverlay" Background="#50000000" IsVisible="{Binding IsDescriptionEditorOpen}">
      <Border Classes="card" Width="440" Padding="22" HorizontalAlignment="Center" VerticalAlignment="Center"><StackPanel Spacing="16">
        <TextBlock Text="修改实例描述" Classes="sectionTitle"/><TextBox Name="InstanceDescription" Text="{Binding PresentationDescription}" AcceptsReturn="True" TextWrapping="Wrap" MaxLength="4096" MinHeight="100" MaxHeight="240" PlaceholderText="描述此实例的用途"/>
        <StackPanel Orientation="Horizontal" Spacing="10" HorizontalAlignment="Right"><Button Content="取消" Command="{Binding CancelDescriptionCommand}"/><Button Name="ConfirmInstanceDescription" Content="保存" Command="{Binding SavePresentationCommand}" Classes="primary"/></StackPanel>
      </StackPanel></Border>
    </Border>
  </Grid>
</UserControl>
