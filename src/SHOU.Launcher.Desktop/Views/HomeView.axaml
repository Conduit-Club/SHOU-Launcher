<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:views="using:SHOU.Launcher.Desktop.Views" x:Class="SHOU.Launcher.Desktop.Views.HomeView">
  <Grid ColumnDefinitions="300,*">
    <Border Grid.Column="1" ClipToBounds="True">
      <Grid>
        <Image Source="avares://SHOU.Launcher.Desktop/Assets/Conduit/campus-lake.jpg" Stretch="UniformToFill"><Image.Effect><BlurEffect Radius="9" /></Image.Effect></Image>
        <Border Background="#35FFFFFF" />
      </Grid>
    </Border>
    <Border Name="LaunchAccountPanel" Background="{DynamicResource ClubSidebar}">
      <Grid RowDefinitions="*,Auto">
        <views:AccountsView DataContext="{Binding Root.Accounts}" />
        <StackPanel Grid.Row="1" Margin="20,5,20,20" Spacing="10">
          <Button Name="HomeLaunchButton" Classes="primary" Command="{Binding Root.Instances.LaunchCommand}" HorizontalAlignment="Stretch" Height="54" ToolTip.Tip="{Binding Root.Instances.LaunchPrerequisite}">
            <StackPanel Spacing="3"><TextBlock Text="启动游戏" HorizontalAlignment="Center" /><TextBlock Text="{Binding SelectedInstanceName}" Classes="muted" FontSize="11" TextTrimming="CharacterEllipsis" MaxWidth="232" HorizontalAlignment="Center" /></StackPanel>
          </Button>
          <Grid ColumnDefinitions="*,10,*">
            <Button Name="HomeSelectInstanceButton" Content="实例选择" Command="{Binding Root.ShowInstancesCommand}" HorizontalAlignment="Stretch" Height="35" />
            <Button Grid.Column="2" Name="HomeInstanceSettingsButton" Content="实例设置" Command="{Binding Root.Instances.ShowInstanceSettingsCommand}" HorizontalAlignment="Stretch" Height="35" />
          </Grid>
        </StackPanel>
      </Grid>
    </Border>
    <ScrollViewer Grid.Column="1" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
      <StackPanel Spacing="15" Margin="25">
        <Border Classes="card" Padding="20" IsVisible="{Binding ShowClubIntroduction}">
          <StackPanel Spacing="14">
            <DockPanel>
              <Border DockPanel.Dock="Right" Background="{DynamicResource ClubSelection}" CornerRadius="6" Padding="10,5" Margin="12,0,0,0"><StackPanel><TextBlock Text="社团在线" Classes="muted" FontSize="11" HorizontalAlignment="Center" /><TextBlock Text="{Binding OnlinePlayerSummary}" FontSize="20" FontWeight="Bold" HorizontalAlignment="Center" /></StackPanel></Border>
              <StackPanel Orientation="Horizontal" Spacing="15"><Image Source="avares://SHOU.Launcher.Desktop/Assets/Conduit/club-logo.png" Width="44" Height="44" /><StackPanel VerticalAlignment="Center"><TextBlock Name="BrandTitle" Text="{Binding ClubName}" FontSize="24" FontWeight="Bold" Foreground="{DynamicResource ClubAccent}" /><TextBlock Text="五湖四海之士，汇于东海之滨" /></StackPanel></StackPanel>
            </DockPanel>
            <WrapPanel>
              <Button Content="社团 Wiki" Command="{Binding OpenWikiCommand}" Height="32" Margin="0,0,8,0" />
              <Button Content="登录与入服指南" Command="{Binding OpenGuideCommand}" Height="32" Margin="0,0,8,0" />
              <Button Content="社团更新日志" Command="{Binding OpenReleasesCommand}" Height="32" Margin="0,0,8,0" />
              <TextBlock Text="QQ群 756155087" FontSize="12" VerticalAlignment="Center" Margin="0,5,0,0" />
            </WrapPanel>
          </StackPanel>
        </Border>
        <Border Classes="card" IsVisible="{Binding ShowClubServers}">
          <StackPanel Spacing="8">
            <DockPanel Margin="0,0,0,1"><Button Name="RefreshServersButton" DockPanel.Dock="Right" Classes="flat" Content="刷新状态" Command="{Binding RefreshServersCommand}" FontSize="11" MinHeight="18" Height="18" Padding="6,1" /><TextBlock Text="启动后前往" Classes="sectionTitle" VerticalAlignment="Center" /></DockPanel>
            <ListBox Name="ServerSelector" Classes="serverCards" ItemsSource="{Binding Servers}" SelectedItem="{Binding SelectedServer}" IsEnabled="{Binding CanEdit}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
              <ListBox.ItemsPanel><ItemsPanelTemplate><UniformGrid Columns="2" /></ItemsPanelTemplate></ListBox.ItemsPanel>
              <ListBox.ItemTemplate><DataTemplate><StackPanel Spacing="3" ToolTip.Tip="{Binding Status}"><TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold" /><TextBlock Text="{Binding Detail}" Classes="muted" FontSize="12" TextTrimming="CharacterEllipsis" /></StackPanel></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <TextBlock Name="DestinationSummary" Text="{Binding DestinationSummary}" Foreground="{DynamicResource ClubAccent}" TextWrapping="Wrap" Margin="5,0" FontSize="12" />
          </StackPanel>
        </Border>
      </StackPanel>
    </ScrollViewer>
  </Grid>
</UserControl>
