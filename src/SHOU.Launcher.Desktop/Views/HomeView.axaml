<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="SHOU.Launcher.Desktop.Views.HomeView">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="18">
    <Border CornerRadius="12" ClipToBounds="True" Height="180">
      <Grid><Image Source="avares://SHOU.Launcher.Desktop/Assets/Conduit/campus-lake.jpg" Stretch="UniformToFill" /><Border Background="#8A171B26" />
        <StackPanel Margin="24" VerticalAlignment="Bottom" Spacing="8"><TextBlock Name="BrandTitle" Text="{Binding BrandName}" FontSize="28" FontWeight="SemiBold" Foreground="White" /><TextBlock Text="从校园还原到自由创造" Foreground="White" FontSize="16" /></StackPanel>
      </Grid>
    </Border>
    <Border Classes="card"><StackPanel Spacing="12">
      <DockPanel><Button Name="RefreshServersButton" DockPanel.Dock="Right" Content="刷新状态" Command="{Binding RefreshServersCommand}" /><TextBlock Classes="sectionTitle" Text="启动后前往" VerticalAlignment="Center" /></DockPanel>
      <ListBox Name="ServerSelector" ItemsSource="{Binding Servers}" SelectedItem="{Binding SelectedServer}" IsEnabled="{Binding CanEdit}" BorderThickness="0" Background="Transparent">
        <ListBox.ItemTemplate><DataTemplate><Grid ColumnDefinitions="*,Auto" Margin="4,6"><StackPanel Spacing="3"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" /><TextBlock Text="{Binding Detail}" Classes="muted" FontSize="12" /></StackPanel><TextBlock Grid.Column="1" Text="{Binding Status}" Classes="muted" VerticalAlignment="Center" Margin="12,0,0,0" /></Grid></DataTemplate></ListBox.ItemTemplate>
      </ListBox>
      <TextBlock Name="DestinationSummary" Text="{Binding DestinationSummary}" Classes="muted" />
    </StackPanel></Border>
    <Border Classes="card"><StackPanel Spacing="12"><TextBlock Text="社团入口" Classes="sectionTitle" /><WrapPanel>
      <Button Content="社团 Wiki" Command="{Binding OpenWikiCommand}" Margin="0,0,8,8" /><Button Content="登录与入服指南" Command="{Binding OpenGuideCommand}" Margin="0,0,8,8" /><Button Content="版本与更新" Command="{Binding OpenReleasesCommand}" Margin="0,0,8,8" />
    </WrapPanel><TextBlock Text="QQ群 756155087" Classes="muted" /></StackPanel></Border>
    <Expander Header="平台与数据目录"><StackPanel Spacing="9" Margin="0,12"><TextBlock Text="{Binding PlatformSummary}" TextWrapping="Wrap" /><TextBlock Text="{Binding DataDirectory}" Classes="muted" /><TextBlock Text="{Binding CapabilitiesSummary}" Classes="muted" /><Button Content="打开数据目录" Command="{Binding OpenDataDirectoryCommand}" /></StackPanel></Expander>
  </StackPanel></ScrollViewer>
</UserControl>
