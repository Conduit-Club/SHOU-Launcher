<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="using:SHOU.Launcher.Desktop.Localization" xmlns:themes="using:SHOU.Launcher.Desktop.Themes" xmlns:views="using:SHOU.Launcher.Desktop.Views" x:Class="SHOU.Launcher.Desktop.Views.InstanceWorldsView" FontSize="13" KeyDown="Workspace_KeyDown">
  <UserControl.Styles>
    <Style Selector="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /></Style>
    <Style Selector="Button.worldQuick"><Setter Property="MinHeight" Value="34" /><Setter Property="Margin" Value="0,0,12,4" /></Style>
    <Style Selector="Button.worldNavigation"><Setter Property="HorizontalAlignment" Value="Stretch" /><Setter Property="HorizontalContentAlignment" Value="Left" /><Setter Property="Height" Value="36" /><Setter Property="Padding" Value="14,0" /><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /><Setter Property="CornerRadius" Value="0" /></Style>
    <Style Selector="Button.worldNavigation.selected"><Setter Property="Background" Value="Transparent" /><Setter Property="Foreground" Value="{DynamicResource ClubSelectionForeground}" /><Setter Property="BorderBrush" Value="{DynamicResource ClubSelectionForeground}" /><Setter Property="BorderThickness" Value="3,0,0,0" /><Setter Property="Padding" Value="11,0,14,0" /></Style>
    <Style Selector="ListBox.worldFiles"><Setter Property="Background" Value="Transparent" /><Setter Property="BorderThickness" Value="0" /></Style>
    <Style Selector="ListBox.worldFiles ListBoxItem"><Setter Property="Padding" Value="7,6" /><Setter Property="HorizontalContentAlignment" Value="Stretch" /></Style>
    <Style Selector="ListBox.worldFiles ListBoxItem:selected /template/ ContentPresenter"><Setter Property="Background" Value="{DynamicResource ClubSelection}" /></Style>
    <Style Selector="TextBlock.worldLabel"><Setter Property="VerticalAlignment" Value="Center" /></Style>
    <Style Selector="TextBlock.worldHint"><Setter Property="FontSize" Value="11" /><Setter Property="Foreground" Value="{DynamicResource ClubMuted}" /></Style>
    <Style Selector="Button.worldNavigation.selected TextBlock"><Setter Property="Foreground" Value="{DynamicResource ClubSelectionForeground}"/></Style>
    <Style Selector="Button.worldNavigation.selected Path"><Setter Property="Stroke" Value="{DynamicResource ClubSelectionForeground}"/></Style>
  </UserControl.Styles>
  <Grid ColumnDefinitions="150,*">
    <Border Grid.Column="0" Background="{DynamicResource ClubSurface}" IsVisible="{Binding IsWorldDetails}">
      <StackPanel Margin="0,14,0,0" Spacing="3">
        <Button Name="WorldInformationNavigation" Classes="worldNavigation" Classes.selected="{Binding IsWorldInformationPage}" Command="{Binding ShowWorldInformationCommand}"><StackPanel Orientation="Horizontal" Spacing="10"><views:ClubIcon Classes="contextIcon" Kind="info"/><TextBlock Classes="navigationLabel" Text="{loc:Loc te7028601e7da793d}" VerticalAlignment="Center" /></StackPanel></Button>
        <Button Name="WorldDatapacksNavigation" Classes="worldNavigation" Classes.selected="{Binding IsWorldDatapacksPage}" Command="{Binding ShowWorldDatapacksCommand}"><StackPanel Orientation="Horizontal" Spacing="10"><views:ClubIcon Classes="contextIcon" Kind="{x:Static themes:ClubIcons.Document}" /><TextBlock Classes="navigationLabel" Text="{loc:Loc t10f8430565994663}" VerticalAlignment="Center" /></StackPanel></Button>
        <TextBlock Text="{loc:Loc t899432d83d98c3bf}" Classes="worldHint" Margin="13,12,0,4" />
        <Button Classes="worldNavigation" Command="{Binding OpenWorldDirectoryCommand}" ><StackPanel Orientation="Horizontal" Spacing="10"><views:ClubIcon Classes="contextIcon" Kind="folder-open" /><TextBlock Classes="navigationLabel" Text="{loc:Loc tfcf8b4bff0df782d}" /></StackPanel></Button>
        <Button Name="BackToWorldListButton" Classes="worldNavigation" Command="{Binding BackFromWorldCommand}" ><StackPanel Orientation="Horizontal" Spacing="10"><views:ClubIcon Classes="contextIcon" Kind="arrow-left" /><TextBlock Classes="navigationLabel" Text="{loc:Loc tf6380d0e2176efe9}" /></StackPanel></Button>
      </StackPanel>
    </Border>
    <Border Grid.Column="1" Background="{DynamicResource ClubBackground}">
      <Grid>
        <ScrollViewer Name="WorldListScroller" IsVisible="{Binding IsWorldListPage}" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="24" Spacing="14">
            <Border Classes="card" Padding="12,6"><TextBox Name="WorldSearchBox" Text="{Binding WorldSearchText}" PlaceholderText="{loc:Loc t46c10fbcd79ec83e}" BorderThickness="0" Background="Transparent" /></Border>
            <Border Classes="card"><StackPanel Spacing="10"><TextBlock Text="{loc:Loc t899432d83d98c3bf}" Classes="sectionTitle" /><WrapPanel><Button Classes="worldQuick" Content="{loc:Loc tb716ad55bffa744e}" Command="{Binding OpenWorldSavesDirectoryCommand}" /><Button Name="DownloadWorldResourcesButton" Classes="worldQuick" Content="{loc:Loc tfa7b98e0f04439e3}" Command="{Binding DownloadWorldResourcesCommand}" /><Button Name="ImportLocalWorldButton" Classes="worldQuick" Content="导入本地世界 ZIP" Click="ImportLocalWorld_Click" IsEnabled="{Binding CanSelectLocalWorldArchive}" /><Button Name="PasteLocalWorldButton" Classes="worldQuick" Content="{loc:Loc t787851c9802de7b9}" Click="PasteLocalWorld_Click" IsEnabled="{Binding CanSelectLocalWorldArchive}" /><Button Name="RefreshWorldsButton" Classes="worldQuick" Content="{loc:Loc tdf7392cc96bedc51}" Command="{Binding RefreshWorldsCommand}" ToolTip.Tip="{Binding WorldWorkspaceCapability}" /></WrapPanel><TextBlock Text="{Binding WorldWorkspaceCapability}" IsVisible="{Binding ShowWorldWorkspaceCapability}" Classes="worldHint" /></StackPanel></Border>
            <Border Name="LocalWorldImportPanel" Classes="card" IsVisible="{Binding IsLocalWorldImportOpen}"><StackPanel Spacing="10">
              <TextBlock Text="导入本地世界" Classes="sectionTitle" /><TextBlock Name="LocalWorldArchiveName" Text="{Binding LocalWorldArchiveName}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
              <Grid ColumnDefinitions="105,*"><TextBlock Text="新存档文件夹" VerticalAlignment="Center" /><TextBox Name="LocalWorldDirectoryName" Grid.Column="1" Text="{Binding LocalWorldDirectoryName}" MaxLength="120" IsEnabled="{Binding CanSelectLocalWorldArchive}" /></Grid>
              <TextBlock Name="LocalWorldPreviewSummary" Text="{Binding LocalWorldPreviewSummary}" IsVisible="{Binding HasLocalWorldPreview}" TextWrapping="Wrap" />
              <Grid ColumnDefinitions="Auto,*"><views:LoadingGlyph Name="LocalWorldImportLoading" IsVisible="{Binding IsLocalWorldImportBusy}" Width="32" Height="32" Margin="0,0,10,0" /><TextBlock Grid.Column="1" Name="LocalWorldImportStatus" Text="{Binding LocalWorldImportStatus}" TextWrapping="Wrap" VerticalAlignment="Center" /></Grid>
              <WrapPanel><Button Name="PreviewLocalWorldImportButton" Content="检查归档" Command="{Binding PreviewLocalWorldImportCommand}" Margin="0,0,8,0" /><Button Name="ConfirmLocalWorldImportButton" Content="确认导入" Command="{Binding ConfirmLocalWorldImportCommand}" IsVisible="{Binding HasLocalWorldPreview}" Margin="0,0,8,0" /><Button Name="CancelLocalWorldImportButton" Content="取消" Command="{Binding CancelLocalWorldImportCommand}" /></WrapPanel>
            </StackPanel></Border>
            <Border Classes="card"><StackPanel Spacing="10">
              <Grid ColumnDefinitions="*,Auto"><TextBlock Name="WorldCountText" Text="{Binding WorldCountSummary}" FontWeight="SemiBold" /><TextBlock Grid.Column="1" Text="{loc:Loc tfda9e77c937bce24}" Classes="muted" /></Grid>
              <TextBlock Name="WorldListStatusText" Text="{Binding WorldListStatus}" IsVisible="{Binding ShowWorldListStatus}" Classes="muted" Margin="8,12" />
              <ItemsControl Name="InstanceWorldList" ItemsSource="{Binding WorldRows}"><ItemsControl.ItemTemplate><DataTemplate>
                <Grid ColumnDefinitions="38,*,30" Margin="8,6"><Border Width="31" Height="31" Background="{DynamicResource ClubSelection}" CornerRadius="3"><views:ClubIcon Kind="{x:Static themes:ClubIcons.Globe}" Width="23" Height="23" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
                  <StackPanel Grid.Column="1" Spacing="1"><Button Name="OpenWorldDetailsButton" Classes="flat" Content="{Binding Name}" Command="{Binding OpenCommand}" Padding="0" MinHeight="23" HorizontalAlignment="Left" /><TextBlock Text="{Binding Subtitle}" Classes="worldHint" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" /></StackPanel>
                  <Button Grid.Column="2" IsEnabled="False" ToolTip.Tip="{loc:Loc tb4bc4d1127969966}" Padding="3"  AutomationProperties.Name="{loc:Loc t1ad2d5463a1d2b08}" ><views:ClubIcon Kind="play" Width="16" Height="16" /></Button>
                </Grid>
              </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
            </StackPanel></Border>
          </StackPanel>
        </ScrollViewer>
        <ScrollViewer Name="WorldInformationScroller" IsVisible="{Binding IsWorldInformationPage}" HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="24" Spacing="14">
            <Border Classes="card"><StackPanel Spacing="9"><TextBlock Text="{loc:Loc td70e7288e1af0694}" Classes="sectionTitle" />
              <Grid ColumnDefinitions="105,*"><TextBlock Classes="worldLabel" Text="{loc:Loc t2936050efd476c66}" /><TextBlock Grid.Column="1" Name="WorldVersionText" Text="{Binding WorldDetailVersion}" /></Grid>
              <Grid ColumnDefinitions="105,*"><TextBlock Classes="worldLabel" Text="{loc:Loc t90e4538f0770c4c9}" /><TextBlock Grid.Column="1" Name="WorldNameText" Text="{Binding WorldDetailName}" /></Grid>
              <Grid ColumnDefinitions="105,*,Auto"><TextBlock Classes="worldLabel" Text="{loc:Loc t5e20fc223736c86a}" /><TextBlock Grid.Column="1" Name="WorldSeedText" Text="{Binding WorldSeedText}" /><Button Grid.Column="2" Content="{loc:Loc t63d90d977348ab1f}" Click="CopyWorldSeed_Click" IsEnabled="{Binding HasWorldSeed}" Padding="6,1" MinHeight="22" /></Grid>
              <Grid ColumnDefinitions="105,*"><TextBlock Classes="worldLabel" Text="{loc:Loc te6df2ef62df6b8ea}" /><TextBlock Grid.Column="1" Name="WorldLastPlayedText" Text="{Binding WorldDetailLastPlayed}" /></Grid>
              <Grid ColumnDefinitions="105,*"><TextBlock Classes="worldLabel" Text="{loc:Loc t9c12568c3e340a4c}" /><TextBlock Name="WorldSpawnText" Grid.Column="1" Text="{Binding WorldSpawnText}" /></Grid>
              <Grid ColumnDefinitions="105,*"><TextBlock Classes="worldLabel" Text="{loc:Loc tfda0e5d87bac4091}" /><TextBlock Grid.Column="1" Text="{Binding WorldGameModeText}" /></Grid>
              <Grid ColumnDefinitions="105,*"><TextBlock Classes="worldLabel" Text="{loc:Loc tff0b169fcecb9fbd}" /><TextBlock Grid.Column="1" Text="{Binding WorldHardcoreText}" /></Grid>
              <Grid ColumnDefinitions="105,*"><TextBlock Classes="worldLabel" Text="{loc:Loc t5ffb479ba1fe7570}" /><TextBlock Name="WorldRuntimeText" Grid.Column="1" Text="{Binding WorldRuntimeText}" /></Grid>
            </StackPanel></Border>
            <Border Classes="card"><StackPanel Spacing="9"><Grid ColumnDefinitions="*,Auto"><TextBlock Text="{loc:Loc tac50792e77e73837}" Classes="sectionTitle" /><Button Name="RefreshWorldSettingsButton" Grid.Column="1" Content="{loc:Loc tdf7392cc96bedc51}" Command="{Binding RefreshWorldEditCommand}" ToolTip.Tip="{Binding WorldWorkspaceCapability}" /></Grid><Grid ColumnDefinitions="105,120,*"><TextBlock Classes="worldLabel" Text="{loc:Loc td85f6fb029fcb14d}" /><ComboBox Name="WorldAllowCommandsSelector" Grid.Column="1" ItemsSource="{Binding WorldPermissionChoices}" SelectedItem="{Binding SelectedWorldPermission}" IsEnabled="{Binding CanEditWorldMetadata}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox></Grid><Grid ColumnDefinitions="105,120,*"><TextBlock Classes="worldLabel" Text="{loc:Loc t10fc628593208200}" /><ComboBox Name="WorldDifficultySelector" Grid.Column="1" ItemsSource="{Binding WorldDifficultyChoices}" SelectedItem="{Binding SelectedWorldDifficulty}" IsEnabled="{Binding CanEditWorldDifficulty}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox><CheckBox Name="WorldDifficultyLockedCheckBox" Grid.Column="2" Content="{loc:Loc t99d61ea4514d645f}" IsChecked="{Binding WorldDifficultyLocked}" IsEnabled="{Binding CanEditWorldMetadata}" Margin="12,0" /></Grid><TextBlock Name="WorldSettingsStatusText" Text="{Binding WorldSettingsStatus}" Classes="worldHint" /><WrapPanel Name="WorldSettingsSaveActions" IsVisible="{Binding ShowWorldSettingsSaveActions}"><Button Name="SaveWorldSettingsButton" Classes="primary" Content="{loc:Loc t71c204b076f78898}" Command="{Binding SaveWorldSettingsCommand}" Margin="0,0,8,0" /><Button Name="DiscardWorldSettingsButton" Content="{loc:Loc ted487cbd69c0ebdd}" Command="{Binding DiscardWorldSettingsCommand}" /></WrapPanel><TextBlock Name="WorldSettingsFeedbackText" Text="{Binding WorldSettingsFeedback}" Classes="worldHint" /></StackPanel></Border>
            <Border Classes="card" IsVisible="{Binding HasWorldEditBackup}"><StackPanel Spacing="5"><TextBlock Text="{loc:Loc t7debbccfe6a63270}" FontWeight="SemiBold" /><TextBlock Name="WorldEditBackupPathText" Text="{Binding WorldEditBackupPath}" Classes="worldHint" /></StackPanel></Border>
            <TextBlock Text="{Binding WorldWorkspaceCapability}" IsVisible="{Binding ShowWorldWorkspaceCapability}" Classes="worldHint" />
          </StackPanel>
        </ScrollViewer>
        <DockPanel IsVisible="{Binding IsWorldDatapacksPage}">
          <Border Name="WorldDatapackSelectionBar" DockPanel.Dock="Bottom" Classes="card" IsVisible="{Binding HasSelectedDatapacks}" Margin="24,4,24,12" Padding="12,8">
            <StackPanel Spacing="6"><TextBlock Text="{Binding DatapackSelectionSummary}" HorizontalAlignment="Center" /><WrapPanel HorizontalAlignment="Center"><Button Name="ReadDatapackUpdatesButton" Content="{loc:Loc t3055a035f0eb7a8b}" Command="{Binding ReadDatapackUpdatesCommand}" /><Button Name="EnableWorldDatapacksButton" Content="{loc:Loc tf4f0ead1116b5b62}" Command="{Binding EnableWorldDatapacksCommand}" IsEnabled="{Binding CanEnableSelectedDatapacks}" ToolTip.Tip="{loc:Loc t64a44b4d2ca30888}" Margin="6,0" /><Button Name="DisableWorldDatapacksButton" Content="{loc:Loc t7df5c456c765e4c3}" Command="{Binding DisableWorldDatapacksCommand}" IsEnabled="{Binding CanDisableSelectedDatapacks}" ToolTip.Tip="{loc:Loc t72f1685f08bc9ab6}" /><Button Name="RecycleWorldDatapacksButton" Content="{loc:Loc t2f9daa828907b93f}" Command="{Binding RequestRecycleWorldDatapacksCommand}" ToolTip.Tip="移入当前存档的回收记录，可恢复原文件与启停状态。" Margin="6,0" /><Button Name="ClearWorldDatapackSelectionButton" Content="{loc:Loc t74966e20df2ea9fd}" Command="{Binding ClearWorldDatapackSelectionCommand}" /></WrapPanel></StackPanel>
          </Border>
          <ScrollViewer Name="WorldDatapacksScroller" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="24" Spacing="14">
            <Border Name="DatapackManagementStatusPanel" Classes="card" IsVisible="{Binding ShowDatapackManagementStatus}"><Grid ColumnDefinitions="Auto,*,Auto"><views:LoadingGlyph Width="32" Height="32" Margin="0,0,10,0" IsVisible="{Binding IsDatapackManagementBusy}" /><TextBlock Grid.Column="1" Name="DatapackManagementFeedback" Text="{Binding DatapackManagementFeedback}" TextWrapping="Wrap" VerticalAlignment="Center" /><Button Grid.Column="2" Name="CancelDatapackManagementButton" Content="取消 / 放弃草稿" Command="{Binding CancelDatapackManagementCommand}" Margin="10,0,0,0" /></Grid></Border>
            <Border Name="DatapackOrderPanel" Classes="card" IsVisible="{Binding IsDatapackOrderOpen}"><StackPanel Spacing="10"><TextBlock Text="加载顺序（从低到高）" Classes="sectionTitle" ToolTip.Tip="后面的数据包优先级更高；内建条目保持原位。" /><ListBox Name="DatapackOrderList" ItemsSource="{Binding DatapackOrderItems}" SelectedItem="{Binding SelectedDatapackOrderItem}" MaxHeight="240"><ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" /></DataTemplate></ListBox.ItemTemplate></ListBox><WrapPanel><Button Name="MoveDatapackOrderUpButton" Content="上移" Command="{Binding MoveDatapackOrderUpCommand}" Margin="0,0,8,0" /><Button Name="MoveDatapackOrderDownButton" Content="下移" Command="{Binding MoveDatapackOrderDownCommand}" Margin="0,0,8,0" /><Button Name="SaveDatapackOrderButton" Content="保存加载顺序" Command="{Binding SaveDatapackOrderCommand}" /></WrapPanel><TextBlock Name="DatapackOrderWarnings" Text="{Binding DatapackOrderWarnings}" TextWrapping="Wrap" /></StackPanel></Border>
            <Border Name="DatapackUpdatePanel" Classes="card" IsVisible="{Binding IsDatapackUpdateOpen}"><StackPanel Spacing="10"><TextBlock Text="更新数据包" Classes="sectionTitle" /><TextBlock Text="{Binding DatapackUpdateOrigin}" TextWrapping="Wrap" /><ComboBox Name="DatapackUpdateVersionSelector" IsVisible="{Binding HasDatapackUpdateChoices}" ItemsSource="{Binding DatapackUpdateChoices}" SelectedItem="{Binding SelectedDatapackUpdateChoice}" IsEnabled="{Binding CanChooseLocalDatapackUpdate}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate></ComboBox><WrapPanel><Button Name="PreviewDatapackUpdateButton" IsVisible="{Binding HasDatapackUpdateChoices}" Content="检查所选版本" Command="{Binding PreviewDatapackUpdateCommand}" Margin="0,0,8,0" /><Button Name="ChooseDatapackReplacementButton" Content="选择本地 ZIP 替换…" Click="ChooseDatapackReplacement_Click" IsEnabled="{Binding CanChooseLocalDatapackUpdate}" /></WrapPanel><TextBlock Name="DatapackUpdateSummary" Text="{Binding DatapackUpdateSummary}" IsVisible="{Binding HasDatapackUpdatePreview}" TextWrapping="Wrap" /><Button Name="ConfirmDatapackUpdateButton" Content="确认更新并备份" Command="{Binding ConfirmDatapackUpdateCommand}" IsVisible="{Binding HasDatapackUpdatePreview}" HorizontalAlignment="Left" /></StackPanel></Border>
              <Border Name="DatapackBackupsPanel" Classes="card" IsVisible="{Binding IsDatapackBackupsOpen}">
                <StackPanel Spacing="10"><TextBlock Text="数据包更新备份" Classes="sectionTitle" />
                  <ComboBox Name="DatapackBackupSelector" ItemsSource="{Binding DatapackBackups}" SelectedItem="{Binding SelectedDatapackBackup}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
                  <TextBlock Text="{Binding DatapackBackupStatus}" TextWrapping="Wrap" />
                  <WrapPanel><Button Name="PreviewDatapackRestoreButton" Content="检查恢复" Command="{Binding PreviewDatapackRestoreCommand}" Margin="0,0,8,0" /><Button Name="OpenDatapackBackupDirectoryButton" Content="打开备份文件夹" Command="{Binding OpenDatapackBackupDirectoryCommand}" /></WrapPanel>
                  <TextBlock Name="DatapackRestoreSummary" Text="{Binding DatapackRestoreSummary}" TextWrapping="Wrap" IsVisible="{Binding HasDatapackRestorePreview}" />
                  <Button Name="ConfirmDatapackRestoreButton" Content="确认恢复并保留替换版本" Command="{Binding ConfirmDatapackRestoreCommand}" IsVisible="{Binding HasDatapackRestorePreview}" HorizontalAlignment="Left" />
                </StackPanel>
              </Border>

              <Border Name="WorldPackRemovalConfirmation" Classes="card" IsVisible="{Binding HasWorldPackRemovalConfirmation}"><StackPanel Spacing="10"><TextBlock Text="确认回收以下数据包？" FontWeight="SemiBold" /><TextBlock Text="{Binding WorldPackRemovalNames}" TextWrapping="Wrap" /><WrapPanel><Button Name="ConfirmRecycleWorldDatapacksButton" Content="确认回收" Command="{Binding ConfirmRecycleWorldDatapacksCommand}" Margin="0,0,8,0" /><Button Content="取消" Command="{Binding CancelRecycleWorldDatapacksCommand}" /></WrapPanel></StackPanel></Border>
            <Expander Header="数据包回收记录" HorizontalContentAlignment="Stretch"><StackPanel Spacing="10"><Button Name="RefreshWorldDatapackTrashButton" Content="读取回收记录" Command="{Binding RefreshWorldDatapackTrashCommand}" HorizontalAlignment="Left" /><ComboBox Name="WorldDatapackTrashSelector" ItemsSource="{Binding WorldDatapackTrash}" SelectedItem="{Binding SelectedWorldDatapackTrash}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Label}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" /></DataTemplate></ComboBox.ItemTemplate></ComboBox><TextBlock Text="{Binding SelectedWorldTrashStatus}" TextWrapping="Wrap" /><Button Name="RestoreWorldDatapacksButton" Content="恢复这一批数据包" Command="{Binding RestoreWorldDatapacksCommand}" HorizontalAlignment="Left" /></StackPanel></Expander>
            <Border Classes="card" Padding="12,6"><TextBox Name="DatapackSearchBox" Text="{Binding DatapackSearchText}" PlaceholderText="{loc:Loc tae02379509c337da}" BorderThickness="0" Background="Transparent" /></Border>
            <Border Classes="card"><WrapPanel><Button Classes="worldQuick" Content="{loc:Loc tfcf8b4bff0df782d}" Command="{Binding OpenWorldDatapacksDirectoryCommand}" /><Button Name="ImportWorldDatapackButton" Classes="worldQuick" Content="{loc:Loc t7bc03302e1e4f67c}" Click="ImportWorldDatapack_Click" IsEnabled="{Binding CanImportWorldDatapack}" /><Button Name="DownloadWorldDatapacksButton" Classes="worldQuick" Content="{loc:Loc tdfab0dd8cfeb41a6}" Command="{Binding DownloadWorldDatapacksCommand}" /><Button Name="PasteWorldDatapackButton" Classes="worldQuick" Content="从剪贴板导入" Click="PasteWorldDatapack_Click" IsEnabled="{Binding CanImportWorldDatapack}" /><Button Name="ReadDatapackBackupsButton" Classes="worldQuick" Content="更新备份" Command="{Binding ReadDatapackBackupsCommand}" /><Button Name="ReadDatapackOrderButton" Classes="worldQuick" Content="加载顺序" Command="{Binding ReadDatapackOrderCommand}" /><Button Name="SelectAllWorldDatapacksButton" Classes="worldQuick" Content="{loc:Loc t3a5040b68abf75f9}" Command="{Binding SelectAllWorldDatapacksCommand}" /><Button Classes="worldQuick" Content="{loc:Loc tdf7392cc96bedc51}" Command="{Binding RefreshWorldDatapacksCommand}" /></WrapPanel></Border>
            <Border Classes="card"><StackPanel Spacing="9"><Grid ColumnDefinitions="*,Auto"><StackPanel Orientation="Horizontal" Spacing="16"><TextBlock Name="WorldDatapackCountText" Text="{Binding DatapackCountSummary}" FontWeight="SemiBold" /><TextBlock Text="{loc:Loc t96dbd1b6f55c6a9c}" Classes="muted" /></StackPanel><TextBlock Grid.Column="1" Text="{loc:Loc tfda9e77c937bce24}" Classes="muted" /></Grid>
              <TextBlock Name="WorldDatapackStatusText" Text="{Binding DatapackListStatus}" Classes="worldHint" />
              <ListBox Name="WorldDatapackList" Classes="worldFiles" ItemsSource="{Binding DatapackRows}" SelectedItems="{Binding SelectedDatapacks, Mode=OneWay}" SelectionMode="Multiple,Toggle">
                <ListBox.ItemTemplate><DataTemplate><Grid ColumnDefinitions="38,*"><Border Width="31" Height="31" Background="{DynamicResource ClubSelection}" CornerRadius="3"><views:ClubIcon Kind="file-archive" Width="23" Height="23" Foreground="{DynamicResource ClubForeground}" HorizontalAlignment="Center" /></Border><StackPanel Grid.Column="1" Spacing="2"><TextBlock Text="{Binding Name}" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" /><TextBlock Text="{Binding Subtitle}" Classes="worldHint" /><TextBlock Text="{Binding Status}" Classes="status worldHint" LineHeight="14" FontSize="10" /></StackPanel></Grid></DataTemplate></ListBox.ItemTemplate>
              </ListBox>
            </StackPanel></Border>
            <TextBlock Text="{Binding WorldWorkspaceFeedback}" Classes="status muted" />
            <TextBlock Name="DatapackEditStatusText" Text="{Binding WorldSettingsStatus}" Classes="worldHint" /><TextBlock Name="DatapackEditFeedbackText" Text="{Binding WorldSettingsFeedback}" Classes="worldHint" /><Button Name="ReloadWorldDatapackStateButton" Content="{loc:Loc tfce9129f09fcdc94}" Command="{Binding DiscardWorldSettingsCommand}" IsVisible="{Binding HasWorldSettingsConflict}" HorizontalAlignment="Left" /><TextBlock Text="{Binding WorldEditBackupPath}" IsVisible="{Binding HasWorldEditBackup}" Classes="worldHint" />
          </StackPanel></ScrollViewer>
        </DockPanel>
        <DockPanel IsVisible="{Binding IsInstanceServersPage}">
          <Border Name="InstanceServersSaveBar" DockPanel.Dock="Bottom" Classes="card" IsVisible="{Binding IsServerDraftDirty}" Margin="24,4,24,12" Padding="12,8">
            <StackPanel Spacing="7"><TextBlock Name="ServerDraftStatusText" Text="{Binding ServerDraftStatus}" Classes="worldHint" /><StackPanel Orientation="Horizontal" Spacing="8"><Button Name="SaveInstanceServersButton" Classes="primary" Content="{loc:Loc t5cd0696d4bb99d54}" Command="{Binding SaveInstanceServersCommand}" /><Button Name="DiscardInstanceServersButton" Content="{loc:Loc ted487cbd69c0ebdd}" Command="{Binding DiscardInstanceServersCommand}" /></StackPanel></StackPanel>
          </Border>
          <ScrollViewer Name="InstanceServersScroller" HorizontalScrollBarVisibility="Disabled"><StackPanel Margin="24" Spacing="14">
            <Border Classes="card"><StackPanel Spacing="10"><TextBlock Text="{loc:Loc t899432d83d98c3bf}" Classes="sectionTitle" /><WrapPanel><Button Name="RefreshInstanceServersButton" Classes="worldQuick" Content="{loc:Loc taf22c7ed89133605}" Command="{Binding RefreshInstanceServersCommand}" ToolTip.Tip="{Binding WorldWorkspaceCapability}" /><Button Name="AddInstanceServerButton" Classes="worldQuick" Content="{loc:Loc t7471e181a1530af4}" Command="{Binding AddInstanceServerCommand}" /></WrapPanel><TextBlock Text="{Binding WorldWorkspaceCapability}" IsVisible="{Binding ShowWorldWorkspaceCapability}" Classes="worldHint" /></StackPanel></Border>
            <TextBlock Name="ServerListStatusText" Text="{Binding ServerListStatus}" Classes="worldHint" />
            <Button Name="RefreshInstanceServerStatusButton" Content="{loc:Loc tf06fb3f71f88681b}" Command="{Binding RefreshInstanceServerStatusCommand}" HorizontalAlignment="Left"/>
            <ListBox Name="InstanceServerList" Classes="worldFiles" ItemsSource="{Binding InstanceServerRows}" SelectedItem="{Binding SelectedInstanceServer}">
              <ListBox.ItemTemplate><DataTemplate><Border Classes="card" Padding="10,8" Margin="0,3"><Border.ContextMenu><ContextMenu><MenuItem Header="{loc:Loc t4c6de01bbe86b3d8}" Click="CopyInstanceServerAddress_Click"/></ContextMenu></Border.ContextMenu><Grid ColumnDefinitions="44,*,Auto" ColumnSpacing="8">
                <Grid Width="40" Height="40"><Image Source="{Binding StatusIcon}" IsVisible="{Binding HasStatusIcon}"/><views:ClubIcon Kind="server" Width="26" Height="26" IsVisible="{Binding !HasStatusIcon}"/></Grid>
                <StackPanel Grid.Column="1" Spacing="3"><TextBlock Text="{Binding Name}"/><TextBlock Text="{Binding Address}" Classes="worldHint"/><TextBlock Text="{Binding Motd}" IsVisible="{Binding HasMotd}" TextTrimming="CharacterEllipsis" MaxLines="2"/><TextBlock Text="{Binding StatusSummary}" Classes="worldHint"/></StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="4" VerticalAlignment="Center">
                  <Button Name="RefreshSingleInstanceServerButton" Classes="flat" Command="{Binding $parent[UserControl].DataContext.RefreshSingleServerStatusCommand}" CommandParameter="{Binding}" ToolTip.Tip="{loc:Loc tf06fb3f71f88681b}" AutomationProperties.Name="{loc:Loc tf06fb3f71f88681b}"><views:ClubIcon Kind="refresh-cw" Width="16" Height="16"/></Button>
                  <Button Name="CopyInstanceServerAddressButton" Classes="flat" Click="CopyInstanceServerAddress_Click" ToolTip.Tip="{loc:Loc t4c6de01bbe86b3d8}" AutomationProperties.Name="{loc:Loc t4c6de01bbe86b3d8}"><views:ClubIcon Kind="copy" Width="16" Height="16"/></Button>
                  <Button Name="ConnectInstanceServerButton" Classes="flat" Command="{Binding $parent[UserControl].DataContext.ConnectInstanceServerCommand}" CommandParameter="{Binding}" ToolTip.Tip="{loc:Loc td52291a26b912a86}" AutomationProperties.Name="{loc:Loc t1ad2d5463a1d2b08}"><views:ClubIcon Kind="play" Width="16" Height="16"/></Button>
                  <Button Name="EditInstanceServerButton" Classes="flat" Tag="{Binding}" Click="EditInstanceServer_Click" AutomationProperties.Name="{loc:Loc t7dc5cd68ff29a1fd}"><views:ClubIcon Kind="settings" Width="16" Height="16"/></Button>
                </StackPanel>
              </Grid></Border></DataTemplate></ListBox.ItemTemplate>
            </ListBox>
            <Border Classes="card" IsVisible="{Binding HasServerBackup}"><StackPanel Spacing="5"><TextBlock Text="{loc:Loc tf987690e16e5366c}" FontWeight="SemiBold" /><TextBlock Name="ServerBackupPathText" Text="{Binding ServerBackupPath}" Classes="worldHint" /></StackPanel></Border>
            <TextBlock Name="WorldWorkspaceFeedbackText" Text="{Binding WorldWorkspaceFeedback}" Classes="status muted" />
          </StackPanel></ScrollViewer>
        </DockPanel>
      </Grid>
    </Border>
    <Grid Grid.ColumnSpan="2" Name="InstanceServerEditorOverlay" IsVisible="{Binding IsServerEditorOpen}" Background="#66000000">
      <Border Classes="card" Width="420" MaxWidth="600" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="20">
        <StackPanel Spacing="12"><TextBlock Text="{Binding ServerEditorTitle}" Classes="sectionTitle" /><Grid ColumnDefinitions="66,*"><TextBlock Text="{loc:Loc td44e9b3d3b31d37b}" VerticalAlignment="Center" /><TextBox Name="InstanceServerNameDraft" Grid.Column="1" Text="{Binding ServerNameDraft}" MaxLength="128" IsEnabled="{Binding WorldWorkspaceCanWrite}" /></Grid><Grid ColumnDefinitions="66,*"><TextBlock Text="{loc:Loc t37aac5b4e639b93b}" VerticalAlignment="Center" /><TextBox Name="InstanceServerAddressDraft" Grid.Column="1" Text="{Binding ServerAddressDraft}" PlaceholderText="{loc:Loc t309fc62253abc35a}" MaxLength="1024" IsEnabled="{Binding WorldWorkspaceCanWrite}" /></Grid><TextBlock Text="{loc:Loc t9d08baee81d15811}" Classes="worldHint" />
          <WrapPanel HorizontalAlignment="Right"><Button Name="RemoveInstanceServerDraftButton" Content="{loc:Loc teeb1584afb53da6d}" Command="{Binding RemoveInstanceServerCommand}" IsVisible="{Binding IsEditingExistingServer}" Margin="0,0,8,0" /><Button Name="CancelInstanceServerEditorButton" Content="{loc:Loc t2cd0f3be8738a86c}" Command="{Binding CancelInstanceServerEditorCommand}" Margin="0,0,8,0" /><Button Name="ApplyInstanceServerDraftButton" Classes="primary" Content="{loc:Loc t2354c137ceb3b688}" Command="{Binding ApplyInstanceServerDraftCommand}" IsDefault="True" /></WrapPanel>
        </StackPanel>
      </Border>
    </Grid>
  </Grid>
</UserControl>
