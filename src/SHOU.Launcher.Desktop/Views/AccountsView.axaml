<UserControl xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" x:Class="SHOU.Launcher.Desktop.Views.AccountsView">
  <ScrollViewer HorizontalScrollBarVisibility="Disabled"><StackPanel Spacing="18">
    <Border Classes="card"><StackPanel Spacing="10"><TextBlock Classes="sectionTitle" Text="当前账户与角色" />
      <ComboBox Name="AccountSelector" ItemsSource="{Binding Accounts}" SelectedItem="{Binding SelectedAccount}" IsEnabled="{Binding CanEdit}"><ComboBox.ItemTemplate><DataTemplate><StackPanel Spacing="2"><TextBlock Text="{Binding DisplayName}" /><TextBlock Text="{Binding AuthenticationServer}" Classes="muted" FontSize="11" /></StackPanel></DataTemplate></ComboBox.ItemTemplate></ComboBox>
      <TextBlock Text="{Binding AccountDetail}" Classes="muted" /><TextBlock Text="{Binding PersistenceSummary}" Classes="muted" FontSize="12" />
      <Button Name="RefreshAccountButton" Content="刷新授权" Command="{Binding RefreshAccountCommand}" />
      <Expander Header="移除本机账户"><StackPanel Margin="0,10" Spacing="8"><CheckBox Name="ConfirmAccountRemoval" Content="确认仅从本机移除当前所选账户" IsChecked="{Binding ConfirmRemoval}" IsEnabled="{Binding CanEdit}" /><Button Name="RemoveAccountButton" Content="移除账户" Command="{Binding RemoveAccountCommand}" /></StackPanel></Expander>
    </StackPanel></Border>
    <Border Classes="card"><StackPanel Spacing="10"><TextBlock Classes="sectionTitle" Text="添加账户" />
      <ComboBox Name="LoginProviderSelector" ItemsSource="{Binding Providers}" SelectedItem="{Binding SelectedProvider}" IsEnabled="{Binding CanEdit}"><ComboBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Name}" /></DataTemplate></ComboBox.ItemTemplate></ComboBox>
      <StackPanel IsVisible="{Binding IsOffline}" Spacing="10"><TextBox Name="OfflinePlayerName" Text="{Binding PlayerName}" PlaceholderText="离线角色名称" IsEnabled="{Binding CanEdit}" /><TextBlock Text="离线角色可用于单机测试，不能进入需认证的社团服。" Classes="muted" /><Button Name="AddOfflineButton" Content="添加离线角色" Command="{Binding AddOfflineCommand}" /></StackPanel>
      <StackPanel IsVisible="{Binding IsMicrosoft}" Spacing="10"><TextBlock Text="使用社团应用的设备代码授权，在微软官网完成登录；启动器不会询问微软密码。" Classes="muted" /><Button Name="LoginMicrosoftButton" Classes="primary" Content="开始微软设备授权" Command="{Binding LoginMicrosoftCommand}" /></StackPanel>
      <StackPanel IsVisible="{Binding IsYggdrasil}" Spacing="10"><TextBlock Text="用户名与密码仅提交给当前选择的皮肤站。" Classes="muted" /><TextBox Name="YggdrasilUsername" Text="{Binding Username}" PlaceholderText="皮肤站邮箱 / 用户名" IsEnabled="{Binding CanEdit}" /><TextBox Name="YggdrasilPassword" Text="{Binding Password}" PasswordChar="●" PlaceholderText="皮肤站密码" IsEnabled="{Binding CanEdit}" /><Button Name="LoginYggdrasilButton" Classes="primary" Content="登录并获取角色" Command="{Binding LoginYggdrasilCommand}" /></StackPanel>
      <Border Name="DeviceCodePanel" IsVisible="{Binding HasDeviceChallenge}" BorderBrush="{DynamicResource ClubBorder}" BorderThickness="1" CornerRadius="8" Padding="18"><StackPanel Spacing="10"><TextBlock Name="DeviceCodeText" Text="{Binding DeviceCode}" FontSize="30" FontWeight="SemiBold" LetterSpacing="3" /><TextBlock Text="{Binding DeviceInstructions}" Classes="muted" /><WrapPanel><Button Content="打开微软授权页" Command="{Binding OpenVerificationCommand}" Margin="0,0,8,4" /><Button Content="复制授权代码" Click="CopyDeviceCode_Click" Margin="0,0,8,4" /></WrapPanel><TextBlock Text="可在底部取消当前授权。" Classes="muted" /></StackPanel></Border>
    </StackPanel></Border>
    <TextBlock Text="头像与跨平台 3D 皮肤预览尚未接入。账户列表以独立档案 ID 切换，不合并同名角色。" Classes="muted" FontSize="12" />
  </StackPanel></ScrollViewer>
</UserControl>
