<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SHOU.Launcher.Desktop.ViewModels" xmlns:views="using:SHOU.Launcher.Desktop.Views"
        x:Class="SHOU.Launcher.Desktop.Views.MainWindow" Title="{Binding WindowTitle}" Width="1140" Height="790" MinWidth="880" MinHeight="620" WindowStartupLocation="CenterScreen">
  <Window.DataTemplates>
    <DataTemplate DataType="{x:Type vm:HomePageViewModel}"><views:HomeView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:InstancesPageViewModel}"><views:InstancesView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:DownloadsPageViewModel}"><views:DownloadsView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:AccountsPageViewModel}"><views:AccountsView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:SettingsPageViewModel}"><views:SettingsView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:LogsPageViewModel}"><views:LogsView /></DataTemplate>
  </Window.DataTemplates>
  <Grid ColumnDefinitions="214,*" RowDefinitions="*,Auto">
    <Border Grid.RowSpan="2" Background="{DynamicResource ClubSidebar}" Padding="18,26,18,18">
      <DockPanel>
        <StackPanel DockPanel.Dock="Top" Spacing="10" Margin="6,0,6,24">
          <Image Source="avares://SHOU.Launcher.Desktop/Assets/Conduit/club-logo.png" Width="54" Height="54" HorizontalAlignment="Left" />
          <TextBlock Text="潮涌核心社" FontSize="21" FontWeight="SemiBold" />
          <TextBlock Text="CONDUIT CLUB" FontSize="10" LetterSpacing="2" Classes="muted" />
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Spacing="5" Margin="8,18,0,0">
          <TextBlock Text="{Binding BuildSummary}" Classes="muted" FontSize="11" />
          <TextBlock Text="{Binding SourceSummary}" Classes="muted" FontSize="10" />
          <TextBlock Text="社团开发候选" Classes="muted" FontSize="10" />
        </StackPanel>
        <ListBox Name="PageNavigation" Classes="navigation" ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}">
          <ListBox.ItemTemplate><DataTemplate><TextBlock Text="{Binding Title}" /></DataTemplate></ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>
    <Grid Grid.Column="1" RowDefinitions="Auto,Auto,*" Margin="28,25,28,20">
      <StackPanel Spacing="6" Margin="0,0,0,18"><TextBlock Classes="pageTitle" Text="{Binding SelectedPage.Title}" /><TextBlock Classes="muted" Text="{Binding SelectedPage.Description}" /></StackPanel>
      <Border Grid.Row="1" Name="GlobalError" IsVisible="{Binding HasError}" Background="{DynamicResource ClubErrorBackground}" CornerRadius="9" Padding="14" Margin="0,0,0,16">
        <DockPanel><Button DockPanel.Dock="Right" Content="关闭提示" Command="{Binding DismissErrorCommand}" Margin="12,0,0,0" /><TextBlock Name="GlobalErrorText" Text="{Binding ErrorMessage}" Foreground="{DynamicResource ClubErrorForeground}" TextWrapping="Wrap" VerticalAlignment="Center" /></DockPanel>
      </Border>
      <ContentControl Grid.Row="2" Name="PageContent" Content="{Binding SelectedPage}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
    </Grid>
    <Border Grid.Row="1" Grid.Column="1" BorderBrush="{DynamicResource ClubBorder}" BorderThickness="0,1,0,0" Padding="20,10">
      <DockPanel>
        <Button Name="CancelOperationButton" DockPanel.Dock="Right" Content="取消当前操作" Command="{Binding CancelOperationCommand}" Margin="12,0,0,0" />
        <ProgressBar DockPanel.Dock="Right" IsVisible="{Binding IsBusy}" IsIndeterminate="True" Width="100" Height="4" Margin="15,0" />
        <StackPanel VerticalAlignment="Center" Spacing="2"><TextBlock Name="OperationStatus" Text="{Binding StateSummary}" /><TextBlock Text="{Binding PlatformSummary}" Classes="muted" FontSize="10" /></StackPanel>
      </DockPanel>
    </Border>
  </Grid>
</Window>
