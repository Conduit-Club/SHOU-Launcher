<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:loc="using:SHOU.Launcher.Desktop.Localization"
        xmlns:vm="using:SHOU.Launcher.Desktop.ViewModels" xmlns:views="using:SHOU.Launcher.Desktop.Views"
        x:Class="SHOU.Launcher.Desktop.Views.MainWindow" Title="{Binding WindowTitle}"
        Width="976" Height="636" MinWidth="880" MinHeight="560" WindowDecorations="None" Opacity="{Binding Home.WindowOpacity}" WindowStartupLocation="CenterScreen">
  <Window.DataTemplates>
    <DataTemplate DataType="{x:Type vm:HomePageViewModel}"><views:HomeView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:InstancesPageViewModel}"><views:InstancesView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:DownloadsPageViewModel}"><views:DownloadsView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:AccountsPageViewModel}"><views:AccountsView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:SettingsPageViewModel}"><views:SettingsView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:LogsPageViewModel}"><views:LogsView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:ToolsPageViewModel}"><views:ToolsView /></DataTemplate>
  </Window.DataTemplates>
  <Border Name="WindowSurface" CornerRadius="6" ClipToBounds="True" Background="{DynamicResource ClubPageGradient}">
    <Grid RowDefinitions="48,Auto,*">
      <Border Name="LauncherTitleBar" Background="{DynamicResource ClubTitleBar}" PointerPressed="TitleBar_PointerPressed">
        <Grid Name="TitleBarLayout" ColumnDefinitions="300,*,112">
          <StackPanel Name="WindowBrand" Orientation="Horizontal" Spacing="9" Margin="16,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsVisible="{Binding !IsContextPage}">
            <Image Name="BrandLogo" Source="avares://SHOU.Launcher.Desktop/Assets/Conduit/club-logo.png" Width="26" Height="26" />
            <Image Name="CustomBrandImage" IsVisible="False" MaxWidth="190" Height="30" Stretch="Uniform" />
            <TextBlock Name="WindowBrandTitle" Text="{Binding BrandTitle}" Foreground="{DynamicResource ClubTitleForeground}" LineHeight="18" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" MaxWidth="150" TextTrimming="CharacterEllipsis" />
            <Border Name="ShouBadge" Background="{DynamicResource ClubTitleForeground}" CornerRadius="3" Width="40" Height="24" VerticalAlignment="Center">
              <TextBlock Text="SHOU" Foreground="{DynamicResource ClubAccent}" FontFamily="Arial, Helvetica, sans-serif" FontSize="12" FontWeight="Bold" LineHeight="16" VerticalAlignment="Center" HorizontalAlignment="Center" />
            </Border>
          </StackPanel>
          <StackPanel Name="PrimaryNavigation" Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="17,0,0,0" IsVisible="{Binding !IsContextPage}">
            <ToggleButton Name="LaunchNavigationButton" Classes="topNavigation" IsChecked="{Binding IsLaunchSelected, Mode=OneWay}" Command="{Binding ShowHomeCommand}" AutomationProperties.Name="{loc:Loc t56410fc65314dfb5}">
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><views:ClubIcon Kind="play" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" /><TextBlock Text="{loc:Loc t56410fc65314dfb5}" VerticalAlignment="Center" LineHeight="20" /></StackPanel>
            </ToggleButton>
            <ToggleButton Name="DownloadsNavigationButton" Classes="topNavigation" IsChecked="{Binding IsDownloadsSelected, Mode=OneWay}" Command="{Binding ShowDownloadsCommand}" AutomationProperties.Name="{loc:Loc t4673a23061656125}">
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><views:ClubIcon Kind="download" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" /><TextBlock Text="{loc:Loc t4673a23061656125}" VerticalAlignment="Center" LineHeight="20" /></StackPanel>
            </ToggleButton>
            <ToggleButton Name="SettingsNavigationButton" Classes="topNavigation" IsChecked="{Binding IsSettingsSelected, Mode=OneWay}" Command="{Binding ShowSettingsCommand}" AutomationProperties.Name="{loc:Loc tdf3d58c7d84b85f2}">
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><views:ClubIcon Kind="settings" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" /><TextBlock Text="{loc:Loc tdf3d58c7d84b85f2}" VerticalAlignment="Center" LineHeight="20" /></StackPanel>
            </ToggleButton>
            <ToggleButton Name="ToolsNavigationButton" Classes="topNavigation" IsChecked="{Binding IsToolsSelected, Mode=OneWay}" Command="{Binding ShowToolsCommand}" AutomationProperties.Name="{loc:Loc t5ca6730d44152201}">
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><views:ClubIcon Kind="wrench" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" /><TextBlock Text="{loc:Loc t5ca6730d44152201}" VerticalAlignment="Center" LineHeight="20" /></StackPanel>
            </ToggleButton>
          </StackPanel>
          <Grid Name="ContextHeader" Grid.ColumnSpan="2" ColumnDefinitions="32,*" VerticalAlignment="Center" Margin="10,0" IsVisible="{Binding IsContextPage}">
            <Button Name="BackNavigationButton" Classes="windowControl" Command="{Binding BackCommand}" AutomationProperties.Name="{loc:Loc t572cf45ba43634b3}"><views:ClubIcon Kind="arrow-left" Width="16" Height="16" Foreground="{DynamicResource ClubTitleForeground}" /></Button>
            <TextBlock Name="ContextTitle" Grid.Column="1" Margin="6,0,0,0" Text="{loc:Translate NavigationTitle}" Foreground="{DynamicResource ClubTitleForeground}" LineHeight="20" FontSize="14" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
          </Grid>
          <StackPanel Name="CustomWindowControls" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
            <Button Name="MinimizeWindowButton" Classes="windowControl" Click="MinimizeWindow_Click" AutomationProperties.Name="{loc:Loc tac29e57a46f41c30}"><Path Data="M 0,0 L 12,0" Width="12" Height="1" Stroke="{DynamicResource ClubTitleForeground}" StrokeThickness="1.5" /></Button>
            <Button Name="MaximizeWindowButton" Classes="windowControl" Click="MaximizeWindow_Click" AutomationProperties.Name="{loc:Loc t82c4aa13b7ca109e}" ToolTip.Tip="{loc:Loc t82c4aa13b7ca109e}"><Path Name="MaximizeGlyph" Data="M 1,1 H 11 V 11 H 1 Z" Width="12" Height="12" Stretch="Uniform" Stroke="{DynamicResource ClubTitleForeground}" StrokeThickness="1.3" /></Button>
            <Button Name="CloseWindowButton" Classes="windowControl" Click="CloseWindow_Click" AutomationProperties.Name="{loc:Loc t1ae6b0a0f8266382}"><Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Width="10" Height="10" Stroke="{DynamicResource ClubTitleForeground}" StrokeThickness="1.5" /></Button>
          </StackPanel>
        </Grid>
      </Border>
      <Border Grid.Row="1" Name="GlobalError" IsVisible="{Binding HasError}" Background="{DynamicResource ClubErrorBackground}" Padding="12,8" BorderBrush="{DynamicResource ClubBorder}" BorderThickness="0,0,0,1">
        <DockPanel><Button Name="OpenCrashAnalysisButton" DockPanel.Dock="Right" Content="查看崩溃分析" Command="{Binding ShowCrashAnalysisCommand}" IsVisible="{Binding HasCrashAnalysis}" Margin="8,0"/><Button DockPanel.Dock="Right" Classes="flat" Content="{loc:Loc td301bc1258334c7c}" Command="{Binding DismissErrorCommand}" Margin="10,0,0,0" /><TextBlock Name="GlobalErrorText" Text="{loc:Translate ErrorMessage}" Foreground="{DynamicResource ClubErrorForeground}" TextWrapping="Wrap" VerticalAlignment="Center" /></DockPanel>
      </Border>
      <ContentControl Grid.Row="2" Name="PageContent" Content="{Binding SelectedPage}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
      <Border Grid.Row="2" Name="OperationBar" IsVisible="{Binding ShowOperationStatus}" Margin="{Binding OperationInset}" Background="#22000000">
        <Border Classes="card" HorizontalAlignment="Center" VerticalAlignment="Center" MinWidth="180" MaxWidth="320" Padding="22,18">
          <StackPanel Spacing="12"><views:LoadingGlyph HorizontalAlignment="Center" Foreground="{DynamicResource ClubAccent}"/><TextBlock Name="OperationStatus" Text="{loc:Translate StateSummary}" FontSize="15" LineHeight="22" TextAlignment="Center" TextWrapping="Wrap" Foreground="{DynamicResource ClubAccent}"/><TextBlock Name="OperationTransferSummary" Text="{Binding OperationTransferSummary}" IsVisible="{Binding HasOperationTransferSummary}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis" MaxHeight="72" FontSize="11" LineHeight="16" TextAlignment="Center" /><Button Name="CancelOperationButton" Content="{loc:Loc t2cd0f3be8738a86c}" Command="{Binding CancelOperationCommand}" HorizontalAlignment="Center"/></StackPanel>
        </Border>
      </Border>
      <Border Name="TaskNotification" Grid.RowSpan="3" IsVisible="{Binding IsTaskNotificationVisible}" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="16" Width="330" Padding="16" Background="{DynamicResource ClubSurface}" BorderBrush="{DynamicResource ClubBorder}" BorderThickness="1" CornerRadius="8">
        <StackPanel Spacing="8"><DockPanel><Button Name="DismissTaskNotificationButton" DockPanel.Dock="Right" Content="×" Classes="flat" Command="{Binding DismissTaskNotificationCommand}" AutomationProperties.Name="关闭任务通知"/><TextBlock Text="{Binding TaskNotificationTitle}" FontWeight="Bold" TextWrapping="Wrap" VerticalAlignment="Center"/></DockPanel><TextBlock Text="{Binding TaskNotificationMessage}" TextWrapping="Wrap" Classes="muted"/><Button Name="ViewTaskNotificationButton" Content="查看任务进度" Command="{Binding ViewTaskNotificationCommand}" HorizontalAlignment="Right"/></StackPanel>
      </Border>
      <Border Name="StartupLogoOverlay" Grid.RowSpan="3" IsVisible="False" Background="{DynamicResource ClubSurface}"><Image Source="avares://SHOU.Launcher.Desktop/Assets/Conduit/club-logo.png" Width="96" Height="96" HorizontalAlignment="Center" VerticalAlignment="Center" /></Border>
      <Border Name="WindowCloseOverlay" Grid.RowSpan="3" IsVisible="False" Background="#66000000" KeyDown="ClosePrompt_KeyDown" KeyboardNavigation.TabNavigation="Cycle">
        <Border Background="{DynamicResource ClubSurface}" CornerRadius="9" Padding="24" Margin="28" MaxWidth="520" HorizontalAlignment="Center" VerticalAlignment="Center">
          <StackPanel Spacing="18"><TextBlock Text="关闭启动器" FontSize="21" LineHeight="30" FontWeight="Bold" /><TextBlock Name="WindowClosePrompt" TextWrapping="Wrap" /><WrapPanel Orientation="Horizontal"><Button Name="DiscardAndCloseButton" Content="放弃修改并关闭" Click="DiscardAndClose_Click" Margin="0,0,8,8" /><Button Name="CancelWindowCloseButton" Content="返回" Click="CancelWindowClose_Click" Margin="0,0,0,8" /></WrapPanel></StackPanel>
        </Border>
      </Border>
    </Grid>
  </Border>
</Window>
