<Window xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:SHOU.Launcher.Desktop.ViewModels" xmlns:views="using:SHOU.Launcher.Desktop.Views"
        x:Class="SHOU.Launcher.Desktop.Views.MainWindow" Title="{Binding WindowTitle}"
        Width="976" Height="636" MinWidth="880" MinHeight="560" WindowDecorations="None" Opacity="{Binding Home.WindowOpacity}" WindowStartupLocation="CenterScreen">
  <Window.DataTemplates>
    <DataTemplate DataType="{x:Type vm:HomePageViewModel}"><views:HomeView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:InstancesPageViewModel}"><views:InstancesView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:DownloadsPageViewModel}"><views:DownloadsView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:AccountsPageViewModel}"><views:AccountsView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:SettingsPageViewModel}"><views:SettingsView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:LogsPageViewModel}"><views:LogsView /></DataTemplate>
    <DataTemplate DataType="{x:Type vm:ToolsPageViewModel}"><views:ToolsView /></DataTemplate>
  </Window.DataTemplates>
  <Border Name="WindowSurface" CornerRadius="6" ClipToBounds="True" Background="{DynamicResource ClubPageGradient}">
    <Grid RowDefinitions="48,Auto,*,Auto">
      <Border Name="LauncherTitleBar" Background="{DynamicResource ClubTitleBar}" PointerPressed="TitleBar_PointerPressed">
        <Grid Name="TitleBarLayout" ColumnDefinitions="300,*,112">
          <StackPanel Name="WindowBrand" Orientation="Horizontal" Spacing="9" Margin="16,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" IsVisible="{Binding !IsContextPage}">
            <Image Source="avares://SHOU.Launcher.Desktop/Assets/Conduit/club-logo.png" Width="26" Height="26" />
            <TextBlock Name="WindowBrandTitle" Text="{Binding WindowTitle}" Foreground="{DynamicResource ClubTitleForeground}" FontSize="13" FontWeight="Bold" VerticalAlignment="Center" MaxWidth="150" TextTrimming="CharacterEllipsis" />
            <Border Name="ShouBadge" Background="{DynamicResource ClubTitleForeground}" CornerRadius="3" Width="40" Height="24" VerticalAlignment="Center">
              <TextBlock Text="SHOU" Foreground="{DynamicResource ClubAccent}" FontFamily="Arial, Helvetica, sans-serif" FontSize="12" FontWeight="Bold" LineHeight="16" VerticalAlignment="Center" HorizontalAlignment="Center" />
            </Border>
          </StackPanel>
          <StackPanel Name="PrimaryNavigation" Grid.Column="1" Orientation="Horizontal" Spacing="10" VerticalAlignment="Center" Margin="17,0,0,0" IsVisible="{Binding !IsContextPage}">
            <ToggleButton Name="LaunchNavigationButton" Classes="topNavigation" IsChecked="{Binding IsLaunchSelected, Mode=OneWay}" Command="{Binding ShowHomeCommand}" AutomationProperties.Name="启动">
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><views:ClubIcon Kind="play" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" /><TextBlock Text="启动" VerticalAlignment="Center" LineHeight="20" /></StackPanel>
            </ToggleButton>
            <ToggleButton Name="DownloadsNavigationButton" Classes="topNavigation" IsChecked="{Binding IsDownloadsSelected, Mode=OneWay}" Command="{Binding ShowDownloadsCommand}" AutomationProperties.Name="下载">
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><views:ClubIcon Kind="download" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" /><TextBlock Text="下载" VerticalAlignment="Center" LineHeight="20" /></StackPanel>
            </ToggleButton>
            <ToggleButton Name="SettingsNavigationButton" Classes="topNavigation" IsChecked="{Binding IsSettingsSelected, Mode=OneWay}" Command="{Binding ShowSettingsCommand}" AutomationProperties.Name="设置">
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><views:ClubIcon Kind="settings" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" /><TextBlock Text="设置" VerticalAlignment="Center" LineHeight="20" /></StackPanel>
            </ToggleButton>
            <ToggleButton Name="ToolsNavigationButton" Classes="topNavigation" IsChecked="{Binding IsToolsSelected, Mode=OneWay}" Command="{Binding ShowToolsCommand}" AutomationProperties.Name="工具">
              <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center"><views:ClubIcon Kind="wrench" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" /><TextBlock Text="工具" VerticalAlignment="Center" LineHeight="20" /></StackPanel>
            </ToggleButton>
          </StackPanel>
          <Grid Name="ContextHeader" Grid.ColumnSpan="2" ColumnDefinitions="32,*" VerticalAlignment="Center" Margin="10,0" IsVisible="{Binding IsContextPage}">
            <Button Name="BackNavigationButton" Classes="windowControl" Command="{Binding BackCommand}" AutomationProperties.Name="返回"><Path Data="M 10,1 L 3,8 L 10,15 M 3,8 L 17,8" Width="16" Height="16" Stretch="Uniform" Stroke="{DynamicResource ClubTitleForeground}" StrokeThickness="1.5" /></Button>
            <TextBlock Name="ContextTitle" Grid.Column="1" Margin="6,0,0,0" Text="{Binding NavigationTitle}" Foreground="{DynamicResource ClubTitleForeground}" FontSize="14" VerticalAlignment="Center" TextWrapping="NoWrap" TextTrimming="CharacterEllipsis" />
          </Grid>
          <StackPanel Name="CustomWindowControls" Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,10,0">
            <Button Name="MinimizeWindowButton" Classes="windowControl" Click="MinimizeWindow_Click" AutomationProperties.Name="最小化"><Path Data="M 0,0 L 12,0" Width="12" Height="1" Stroke="{DynamicResource ClubTitleForeground}" StrokeThickness="1.5" /></Button>
            <Button Name="MaximizeWindowButton" Classes="windowControl" Click="MaximizeWindow_Click" AutomationProperties.Name="最大化" ToolTip.Tip="最大化"><Path Name="MaximizeGlyph" Data="M 1,1 H 11 V 11 H 1 Z" Width="12" Height="12" Stretch="Uniform" Stroke="{DynamicResource ClubTitleForeground}" StrokeThickness="1.3" /></Button>
            <Button Name="CloseWindowButton" Classes="windowControl" Click="CloseWindow_Click" AutomationProperties.Name="关闭窗口"><Path Data="M 0,0 L 10,10 M 10,0 L 0,10" Width="10" Height="10" Stroke="{DynamicResource ClubTitleForeground}" StrokeThickness="1.5" /></Button>
          </StackPanel>
        </Grid>
      </Border>
      <Border Grid.Row="1" Name="GlobalError" IsVisible="{Binding HasError}" Background="{DynamicResource ClubErrorBackground}" Padding="12,8" BorderBrush="{DynamicResource ClubBorder}" BorderThickness="0,0,0,1">
        <DockPanel><Button DockPanel.Dock="Right" Classes="flat" Content="关闭提示" Command="{Binding DismissErrorCommand}" Margin="10,0,0,0" /><TextBlock Name="GlobalErrorText" Text="{Binding ErrorMessage}" Foreground="{DynamicResource ClubErrorForeground}" TextWrapping="Wrap" VerticalAlignment="Center" /></DockPanel>
      </Border>
      <ContentControl Grid.Row="2" Name="PageContent" Content="{Binding SelectedPage}" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" />
      <Border Grid.Row="3" Name="OperationBar" IsVisible="{Binding ShowOperationStatus}" Background="{DynamicResource ClubSidebar}" BorderBrush="{DynamicResource ClubBorder}" BorderThickness="0,1,0,0" Padding="12,5">
        <DockPanel>
          <Button Name="CancelOperationButton" DockPanel.Dock="Right" Content="取消当前操作" Command="{Binding CancelOperationCommand}" IsVisible="{Binding IsBusy}" Margin="10,0,0,0" />
          <ProgressBar DockPanel.Dock="Right" IsVisible="{Binding IsBusy}" IsIndeterminate="True" Width="100" Height="3" Margin="12,0" />
          <TextBlock Name="OperationStatus" Text="{Binding StateSummary}" VerticalAlignment="Center" />
        </DockPanel>
      </Border>
    </Grid>
  </Border>
</Window>
