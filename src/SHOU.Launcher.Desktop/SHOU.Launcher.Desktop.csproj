<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType><TargetFramework>net10.0</TargetFramework>
    <AssemblyName>SHOU.Launcher.Desktop</AssemblyName>
    <RuntimeIdentifiers>osx-arm64;win-x64;win-arm64;linux-x64</RuntimeIdentifiers>
    <AvaloniaUseCompiledBindingsByDefault>false</AvaloniaUseCompiledBindingsByDefault>
    <PublishSingleFile Condition="'$(PublishSingleFile)' == ''">false</PublishSingleFile><PublishTrimmed>false</PublishTrimmed><PublishAot>false</PublishAot>
    <ApplicationIcon>../../Plain Craft Launcher 2/Images/Conduit/club.ico</ApplicationIcon>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="SHOU.Launcher.Desktop.Tests" />
    <ProjectReference Include="../SHOU.Launcher.Core/SHOU.Launcher.Core.csproj" />
    <PackageReference Include="Avalonia.Desktop" Version="12.1.5" />
    <PackageReference Include="Avalonia.Themes.Fluent" Version="12.1.5" />
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="10.0.14" />
    <PackageReference Include="PlainToolkit.CngProtectedData" Version="2.1.0" />
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
    <PackageReference Include="BitMiracle.LibTiff.NET" Version="2.4.660" />
    <AvaloniaResource Include="Assets/**" />
    <EmbeddedResource Include="Localization/Resources/zh-CN.json;Localization/Resources/zh-TW.json;Localization/Resources/en-US.json" />
    <Content Include="Assets/AchievementIcons/LICENSE.txt" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" TargetPath="licenses/mcgen.txt" Condition="'$(PublishSingleFile)' != 'true'" />
    <Content Include="Assets/AchievementIcons/README.md" CopyToOutputDirectory="PreserveNewest" CopyToPublishDirectory="PreserveNewest" TargetPath="licenses/achievement-icons.md" Condition="'$(PublishSingleFile)' != 'true'" />
  </ItemGroup>
  <ItemGroup Condition="'$(DesktopDocumentsArchive)' != '' and Exists('$(DesktopDocumentsArchive)')">
    <EmbeddedResource Include="$(DesktopDocumentsArchive)" LogicalName="SHOU.Desktop.Documents.zip" />
  </ItemGroup>
  <ItemGroup Condition="'$(JavaBootstrapJarPath)' != '' and Exists('$(JavaBootstrapJarPath)')">
    <EmbeddedResource Include="$(JavaBootstrapJarPath)" LogicalName="SHOU.Launcher.Desktop.JavaBootstrap.jar" />
    <AssemblyMetadata Include="SHOU.JavaBootstrap.Sha256" Value="$(JavaBootstrapSha256)" />
  </ItemGroup>
  <Target Name="ExcludeWindowsSingleFileDebugSidecars" BeforeTargets="_ComputeFilesToBundle"
          Condition="'$(PublishSingleFile)' == 'true' and $([System.String]::Copy('$(RuntimeIdentifier)').StartsWith('win-'))">
    <ItemGroup>
      <!-- Native NuGet PDBs cannot be consumed from the bundle. Managed symbols are embedded. -->
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)" Condition="'%(ResolvedFileToPublish.Extension)' == '.pdb'" />
    </ItemGroup>
  </Target>
</Project>
