<Grid x:Class="PCL.ClubSkinPreviewWindow"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:PCL"
      Width="560" Height="530" Margin="20" HorizontalAlignment="Center" VerticalAlignment="Center"
      UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Border CornerRadius="8" Background="{DynamicResource ColorBrushBackground}">
        <Border.Effect>
            <DropShadowEffect Color="{DynamicResource ColorObjectMsgBoxShadow}" BlurRadius="20"
                              ShadowDepth="2" Opacity="0.8" />
        </Border.Effect>
        <Grid Margin="22,18">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <DockPanel Margin="0,0,0,6">
                <local:MyButton DockPanel.Dock="Right" Text="关闭" Padding="12,3" Click="Close_Click" />
                <TextBlock Text="3D 皮肤与披风" FontSize="21" FontWeight="SemiBold"
                           Foreground="{DynamicResource ColorBrush2}" VerticalAlignment="Center" />
            </DockPanel>
            <StackPanel Grid.Row="1" Margin="0,0,0,10">
                <TextBlock x:Name="ProfileName" FontSize="13" TextTrimming="CharacterEllipsis" />
                <TextBlock x:Name="StatusText" Text="正在加载当前装备的皮肤与披风……" FontSize="11"
                           Foreground="{DynamicResource ColorBrushGray3}" TextWrapping="Wrap" Margin="0,4,0,0" />
            </StackPanel>
            <Border Grid.Row="2" x:Name="ViewportHost" Background="{DynamicResource ColorBrush8}"
                    CornerRadius="6" ClipToBounds="True" Focusable="True" Cursor="Hand"
                    MouseLeftButtonDown="Viewport_MouseDown" MouseLeftButtonUp="Viewport_MouseUp"
                    MouseMove="Viewport_MouseMove" MouseWheel="Viewport_MouseWheel" KeyDown="Viewport_KeyDown"
                    SizeChanged="Viewport_SizeChanged"
                    ToolTip="拖动旋转，滚轮缩放；方向键旋转，+ / - 缩放，Home 复位。">
                <Grid>
                    <Viewport3D x:Name="Viewport" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="NearestNeighbor">
                        <Viewport3D.Camera>
                            <PerspectiveCamera x:Name="Camera" Position="0,3,66" LookDirection="0,-3,-66"
                                               UpDirection="0,1,0" FieldOfView="36" />
                        </Viewport3D.Camera>
                        <ModelVisual3D>
                            <ModelVisual3D.Content>
                                <Model3DGroup>
                                    <AmbientLight Color="#AAAAAA" />
                                    <DirectionalLight Color="#888888" Direction="-1,-2,-3" />
                                </Model3DGroup>
                            </ModelVisual3D.Content>
                        </ModelVisual3D>
                        <ModelVisual3D x:Name="PlayerModel">
                            <ModelVisual3D.Transform>
                                <Transform3DGroup>
                                    <RotateTransform3D>
                                        <RotateTransform3D.Rotation>
                                            <AxisAngleRotation3D x:Name="Yaw" Axis="0,1,0" Angle="-25" />
                                        </RotateTransform3D.Rotation>
                                    </RotateTransform3D>
                                    <RotateTransform3D>
                                        <RotateTransform3D.Rotation>
                                            <AxisAngleRotation3D x:Name="Pitch" Axis="1,0,0" Angle="-8" />
                                        </RotateTransform3D.Rotation>
                                    </RotateTransform3D>
                                </Transform3DGroup>
                            </ModelVisual3D.Transform>
                        </ModelVisual3D>
                    </Viewport3D>
                    <TextBlock x:Name="EmptyText" Text="正在加载皮肤……" HorizontalAlignment="Center"
                               VerticalAlignment="Center" Foreground="{DynamicResource ColorBrushGray3}" />
                </Grid>
            </Border>
            <DockPanel Grid.Row="3" Margin="0,12,0,0">
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <local:MyButton Text="复位" Padding="10,3" Margin="0,0,8,0" Click="Reset_Click" />
                    <local:MyButton x:Name="RefreshButton" Text="刷新" Padding="10,3" Click="Refresh_Click" />
                </StackPanel>
                <WrapPanel VerticalAlignment="Center">
                    <CheckBox x:Name="OuterLayerToggle" Content="皮肤外层" IsChecked="True" Margin="0,0,14,0"
                              Checked="OptionsChanged" Unchecked="OptionsChanged" />
                    <CheckBox x:Name="CapeToggle" Content="显示披风" IsChecked="True" IsEnabled="False"
                              Checked="OptionsChanged" Unchecked="OptionsChanged" />
                </WrapPanel>
            </DockPanel>
            <TextBlock Grid.Row="4" Text="拖动旋转 · 滚轮缩放 · Esc 关闭" FontSize="11" Margin="0,10,0,0"
                       Foreground="{DynamicResource ColorBrushGray3}" />
        </Grid>
    </Border>
</Grid>
