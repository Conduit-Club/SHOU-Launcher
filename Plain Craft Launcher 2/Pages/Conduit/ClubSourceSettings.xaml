<UserControl x:Class="PCL.ClubSourceSettings"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PCL">
 <local:MyCard Title="自定义下载源与优先级" Margin="0,15,0,15">
  <StackPanel Margin="25,40,25,20">
   <local:MyCheckBox x:Name="UseOrder" Text="按下列优先级下载，并在失败或版本缺失时回退" Height="26" />
   <TextBlock Text="数值越小越优先：BMCLAPI (0) → 社团镜像 (100) → 官方 (200) → 其他 (300)。分别管理三类下载源，修改后点击下方保存。" TextWrapping="Wrap" Opacity="0.75" Margin="0,4,0,14" />
   <TabControl x:Name="CategoryTabs" SelectedIndex="0" Background="Transparent" BorderThickness="0">
    <TabControl.Template>
     <ControlTemplate TargetType="{x:Type TabControl}">
      <Grid KeyboardNavigation.TabNavigation="Local">
       <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
       <UniformGrid IsItemsHost="True" Columns="3" Margin="0,0,0,14" />
       <ContentPresenter x:Name="PART_SelectedContentHost" Grid.Row="1" ContentSource="SelectedContent" />
      </Grid>
     </ControlTemplate>
    </TabControl.Template>
    <TabControl.Resources>
     <Style TargetType="{x:Type TabItem}">
      <Setter Property="Foreground" Value="{DynamicResource ColorBrushGray1}" />
      <Setter Property="Background" Value="{DynamicResource ColorBrushWhite}" />
      <Setter Property="BorderBrush" Value="{DynamicResource ColorBrushGray6}" />
      <Setter Property="Template">
       <Setter.Value>
        <ControlTemplate TargetType="{x:Type TabItem}">
         <Border x:Name="HeaderBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="8,10" Margin="2,0">
          <ContentPresenter x:Name="HeaderLabel" ContentSource="Header" HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True" />
         </Border>
         <ControlTemplate.Triggers>
          <Trigger Property="IsSelected" Value="True"><Setter Property="BorderBrush" Value="{DynamicResource ColorBrush3}" /><Setter TargetName="HeaderLabel" Property="TextElement.Foreground" Value="{DynamicResource ColorBrush1}" /><Setter TargetName="HeaderLabel" Property="TextElement.FontWeight" Value="SemiBold" /></Trigger>
          <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="HeaderBorder" Property="BorderBrush" Value="{DynamicResource ColorBrush3}" /></Trigger>
          <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="HeaderBorder" Property="BorderThickness" Value="2" /></Trigger>
         </ControlTemplate.Triggers>
        </ControlTemplate>
       </Setter.Value>
      </Setter>
     </Style>
    </TabControl.Resources>
    <TabItem Header="Minecraft 游戏本体"><local:ClubSourceCategorySettings x:Name="MinecraftSources" Category="Minecraft" /></TabItem>
    <TabItem Header="Mod / 整合包"><local:ClubSourceCategorySettings x:Name="ModSources" Category="Mod" /></TabItem>
    <TabItem Header="Mod Loader"><local:ClubSourceCategorySettings x:Name="LoaderSources" Category="Loader" /></TabItem>
   </TabControl>
   <local:MyButton Text="保存下载源设置" Height="32" HorizontalAlignment="Left" Padding="14,0" Click="SaveSources" Margin="0,14,0,0" />
   <TextBlock x:Name="Status" TextWrapping="Wrap" Margin="0,8,0,0" />
  </StackPanel>
 </local:MyCard>
</UserControl>
