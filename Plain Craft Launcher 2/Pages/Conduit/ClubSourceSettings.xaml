<UserControl x:Class="PCL.ClubSourceSettings"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PCL">
 <local:MyCard Title="自定义下载源与优先级" Margin="0,15,0,15">
  <StackPanel Margin="25,40,25,20">
   <local:MyCheckBox x:Name="UseOrder" Text="按下列优先级下载，并在失败或版本缺失时回退" Height="26" />
   <TextBlock Text="数值越小越优先：BMCLAPI (0) → 社团镜像 (100) → 官方 (200) → 其他 (300)。启用后接管旧版下载源选项。社团镜像只含选定的 Minecraft 版本。" TextWrapping="Wrap" Opacity="0.75" Margin="0,4,0,10" />
   <ListBox x:Name="Sources" Height="165" SelectionChanged="SelectSource" Background="{DynamicResource ColorBrushWhite}" Foreground="{DynamicResource ColorBrushGray1}" BorderBrush="{DynamicResource ColorBrushGray6}" />
   <WrapPanel Margin="0,10,0,8">
    <local:MyButton Text="添加源" Padding="12,0" Height="30" Click="AddSource" Margin="0,0,8,4" />
    <local:MyButton Text="删除所选" Padding="12,0" Height="30" Click="DeleteSource" Margin="0,0,8,4" />
    <local:MyButton Text="恢复默认" Padding="12,0" Height="30" Click="ResetSources" Margin="0,0,8,4" />
   </WrapPanel>
   <Grid x:Name="Editor">
    <Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
    <Grid.RowDefinitions><RowDefinition Height="36" /><RowDefinition Height="36" /><RowDefinition Height="36" /><RowDefinition Height="36" /><RowDefinition Height="36" /><RowDefinition Height="36" /><RowDefinition Height="32" /></Grid.RowDefinitions>
    <TextBlock Text="源名称" VerticalAlignment="Center" /><local:MyTextBox x:Name="SourceName" Grid.Column="1" />
    <TextBlock Text="资源分类" Grid.Row="1" VerticalAlignment="Center" />
    <local:MyComboBox x:Name="Category" Grid.Row="1" Grid.Column="1"><local:MyComboBoxItem Content="Minecraft" /><local:MyComboBoxItem Content="Mod Loader" /><local:MyComboBoxItem Content="Mod / 整合包 / 资源" /></local:MyComboBox>
    <TextBlock Text="源格式" Grid.Row="2" VerticalAlignment="Center" />
    <local:MyComboBox x:Name="Layout" Grid.Row="2" Grid.Column="1"><local:MyComboBoxItem Content="官方地址" /><local:MyComboBoxItem Content="BMCLAPI 兼容" /><local:MyComboBoxItem Content="SHOU-MCMirror" /><local:MyComboBoxItem Content="自定义 URL 前缀替换" /></local:MyComboBox>
    <TextBlock Text="镜像根地址" Grid.Row="3" VerticalAlignment="Center" /><local:MyTextBox x:Name="BaseUrl" Grid.Row="3" Grid.Column="1" />
    <TextBlock Text="官方 URL 前缀" Grid.Row="4" VerticalAlignment="Center" /><local:MyTextBox x:Name="Origin" Grid.Row="4" Grid.Column="1" />
    <TextBlock Text="优先级" Grid.Row="5" VerticalAlignment="Center" /><local:MyTextBox x:Name="Priority" Grid.Row="5" Grid.Column="1" />
    <local:MyCheckBox x:Name="Enabled" Text="启用此源" Grid.Row="6" Grid.ColumnSpan="2" VerticalAlignment="Center" />
   </Grid>
   <TextBlock Text="前缀替换示例：官方 https://meta.fabricmc.net → 镜像 https://mirror.example/fabric-meta。使用相同响应格式，自动保留路径与查询参数；Mod 下载文件和 API 可分别添加规则。" TextWrapping="Wrap" Opacity="0.75" Margin="0,6,0,10" />
   <local:MyButton Text="保存下载源设置" Height="32" HorizontalAlignment="Left" Padding="14,0" Click="SaveSources" />
   <TextBlock x:Name="Status" TextWrapping="Wrap" Margin="0,8,0,0" />
  </StackPanel>
 </local:MyCard>
</UserControl>
