<Grid x:Class="PCL.ClubUpdateHistoryWindow"
      xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
      xmlns:local="clr-namespace:PCL"
      RenderTransformOrigin="0,0.5" UseLayoutRounding="True" SnapsToDevicePixels="True"
      Width="700" Height="420" MinWidth="480" MinHeight="300" Margin="25"
      HorizontalAlignment="Center" VerticalAlignment="Center">
    <Grid.RenderTransform>
        <TransformGroup>
            <RotateTransform x:Name="TransformRotate" Angle="-4" />
            <TranslateTransform x:Name="TransformPos" X="0" Y="40" />
        </TransformGroup>
    </Grid.RenderTransform>
    <Border x:Name="PanBorder" CornerRadius="7" Background="{DynamicResource ColorBrushBackground}">
        <Border.Effect>
            <DropShadowEffect Color="{DynamicResource ColorObjectMsgBoxShadow}" BlurRadius="20" ShadowDepth="2"
                              RenderingBias="Performance" Opacity="0.8" />
        </Border.Effect>
        <Grid Margin="22,20,22,20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="2" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <DockPanel Grid.Row="0" LastChildFill="False" Margin="7,-1,0,9">
                <local:MyButton DockPanel.Dock="Right" Text="关闭" Padding="12,3" Click="Close_Click" />
                <TextBlock Text="社团更新日志" FontSize="23" FontWeight="SemiBold"
                           Foreground="{DynamicResource ColorBrush2}" VerticalAlignment="Center" />
            </DockPanel>
            <Rectangle Grid.Row="1" Height="2" Fill="{DynamicResource ColorBrush2}" Margin="7,0,0,0" />
            <TextBlock Grid.Row="2" x:Name="StatusText" Text="正在加载……" Margin="7,6,70,0"
                       Foreground="{DynamicResource ColorBrushGray1}" TextWrapping="Wrap" />

            <local:MyScrollViewer Grid.Row="3" x:Name="HistoryScroll" Padding="7,0,15,0"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  DeltaMult="0.7">
                <Grid>
                    <TextBlock x:Name="EmptyText" Text="暂无可显示的更新记录。"
                               Foreground="{DynamicResource ColorBrushGray1}" Visibility="Collapsed"
                               TextWrapping="Wrap" />
                    <ItemsControl x:Name="HistoryItems">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <local:MyCard CanSwap="True" IsSwapped="True" Margin="0,0,0,10"
                                              Title="{Binding HeaderText}">
                                    <StackPanel Margin="15,40,15,15">
                                        <local:MyScrollViewer MaxHeight="250" VerticalScrollBarVisibility="Auto"
                                                              HorizontalScrollBarVisibility="Disabled" DeltaMult="0.7">
                                            <TextBlock Text="{Binding BodyText}" TextWrapping="Wrap"
                                                       Foreground="{DynamicResource ColorBrush1}" FontSize="14"
                                                       LineHeight="19" />
                                        </local:MyScrollViewer>
                                        <local:MyButton Text="打开原文" Padding="10,2" Margin="0,10,0,0"
                                                        HorizontalAlignment="Left" Tag="{Binding Notice.Url}"
                                                        Click="OpenArticle_Click" />
                                    </StackPanel>
                                </local:MyCard>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </local:MyScrollViewer>

            <DockPanel Grid.Row="4" Margin="7,12,0,0" LastChildFill="False">
                <TextBlock Text="断网时显示本地缓存。"
                           FontSize="11" Foreground="{DynamicResource ColorBrushGray1}"
                           VerticalAlignment="Center" TextWrapping="Wrap" />
                <local:MyButton x:Name="RefreshButton" DockPanel.Dock="Right" Text="刷新" Padding="12,3"
                                Margin="12,0,8,0" ColorType="Highlight" Click="Refresh_Click" />
            </DockPanel>
        </Grid>
    </Border>
</Grid>
