<UserControl x:Class="PCL.ClubSourceCategorySettings"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PCL">
 <StackPanel>
  <TextBlock x:Name="CategoryHint" TextWrapping="Wrap" Opacity="0.75" Margin="0,0,0,10" />
  <ListBox x:Name="Sources" Height="165" SelectionChanged="SelectSource" Background="{DynamicResource ColorBrushWhite}" Foreground="{DynamicResource ColorBrushGray1}" BorderBrush="{DynamicResource ColorBrushGray6}" />
  <WrapPanel Margin="0,10,0,8">
   <local:MyButton Text="添加源" Padding="12,0" Height="30" Click="AddSource" Margin="0,0,8,4" />
   <local:MyButton Text="删除所选" Padding="12,0" Height="30" Click="DeleteSource" Margin="0,0,8,4" />
   <local:MyButton Text="恢复本页默认" Padding="12,0" Height="30" Click="ResetSources" Margin="0,0,8,4" />
  </WrapPanel>
  <Grid x:Name="Editor">
   <Grid.ColumnDefinitions><ColumnDefinition Width="100" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
   <Grid.RowDefinitions><RowDefinition Height="36" /><RowDefinition Height="36" /><RowDefinition Height="36" /><RowDefinition Height="36" /><RowDefinition Height="36" /><RowDefinition Height="32" /></Grid.RowDefinitions>
   <TextBlock Text="源名称" VerticalAlignment="Center" /><local:MyTextBox x:Name="SourceName" Grid.Column="1" />
   <TextBlock Text="源格式" Grid.Row="1" VerticalAlignment="Center" /><local:MyComboBox x:Name="Layout" Grid.Row="1" Grid.Column="1" />
   <TextBlock Text="镜像根地址" Grid.Row="2" VerticalAlignment="Center" /><local:MyTextBox x:Name="BaseUrl" Grid.Row="2" Grid.Column="1" />
   <TextBlock Text="官方 URL 前缀" Grid.Row="3" VerticalAlignment="Center" /><local:MyTextBox x:Name="Origin" Grid.Row="3" Grid.Column="1" />
   <TextBlock Text="优先级" Grid.Row="4" VerticalAlignment="Center" /><local:MyTextBox x:Name="Priority" Grid.Row="4" Grid.Column="1" />
   <local:MyCheckBox x:Name="Enabled" Text="启用此源" Grid.Row="5" Grid.ColumnSpan="2" VerticalAlignment="Center" />
  </Grid>
  <TextBlock Text="自定义 URL 前缀替换要求镜像接口与官方响应格式兼容，会保留路径与查询参数。" TextWrapping="Wrap" Opacity="0.75" Margin="0,6,0,0" />
  <TextBlock x:Name="Status" TextWrapping="Wrap" Margin="0,8,0,0" />
 </StackPanel>
</UserControl>
