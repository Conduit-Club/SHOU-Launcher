<UserControl x:Class="PCL.ClubHomeSettings"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PCL">
 <local:MyCard Title="首页定制" Margin="0,0,0,15">
  <StackPanel Margin="25,40,25,20">
   <local:MyCheckBox x:Name="Intro" Text="显示社团介绍与顶部提示" Height="26" Change="Save" />
   <local:MyCheckBox x:Name="Servers" Text="显示社团服务器切换" Height="26" Change="Save" />
   <TextBlock Text="关闭服务器切换后只启动游戏，不自动进入此前选择的社团服务器。" TextWrapping="Wrap" Opacity="0.75" Margin="0,4,0,12" />
   <WrapPanel>
    <local:MyButton Text="替换首页轮播图片" Height="32" Padding="12,0" Click="ChoosePictures" Margin="0,0,8,8" />
    <local:MyButton Text="恢复内置轮播" Height="32" Padding="12,0" Click="ResetPictures" Margin="0,0,0,8" />
   </WrapPanel>
   <TextBlock x:Name="PicturesStatus" TextWrapping="Wrap" />
   <TextBlock Text="可多选 PNG / JPG / WebP / BMP 图片。按选择顺序轮播；保留原文件，图片失效时自动使用内置图片。轮播开关在下方背景设置中。" TextWrapping="Wrap" Opacity="0.75" Margin="0,6,0,0" />
  </StackPanel>
 </local:MyCard>
</UserControl>
