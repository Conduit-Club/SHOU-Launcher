<UserControl x:Class="PCL.ClubAria2Settings"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PCL">
 <local:MyCard Title="aria2 RPC · 外部下载与断点续传" Margin="0,0,0,15">
  <StackPanel Margin="25,40,25,20">
   <local:MyCheckBox x:Name="Enabled" Text="使用外部 aria2 下载文件" Height="26" />
   <TextBlock Text="RPC 地址" Margin="0,8,0,4" /><local:MyTextBox x:Name="Endpoint" />
   <TextBlock Text="RPC Secret（加密保存）" Margin="0,8,0,4" /><PasswordBox x:Name="Secret" Padding="8" Background="{DynamicResource ColorBrushWhite}" Foreground="{DynamicResource ColorBrushGray1}" />
   <TextBlock Text="自行启动 aria2 RPC 后连接；默认使用本机 6800 端口。取消任务会暂停并保留 .aria2.part 与控制文件，再次下载同一文件会续传。启用后连接失败会明确报错。远程 aria2 需与启动器共享相同文件路径；速度与代理使用 aria2 自身配置。" TextWrapping="Wrap" Opacity="0.75" Margin="0,10,0,10" />
   <WrapPanel><local:MyButton Text="保存 RPC 设置" Height="32" Padding="12,0" Click="Save" Margin="0,0,8,0" /><local:MyButton Text="测试连接" Height="32" Padding="12,0" Click="Test" /></WrapPanel>
   <TextBlock x:Name="Status" TextWrapping="Wrap" Margin="0,8,0,0" />
  </StackPanel>
 </local:MyCard>
</UserControl>
