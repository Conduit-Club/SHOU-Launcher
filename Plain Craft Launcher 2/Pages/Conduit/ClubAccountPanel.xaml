<UserControl x:Class="PCL.ClubAccountPanel" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:PCL">
 <UserControl.Resources>  <Style x:Key="ClubActionButton" TargetType="Button">
   <Setter Property="Foreground" Value="{DynamicResource ColorBrush2}" />
   <Setter Property="Background" Value="{DynamicResource ColorBrushWhite}" />
   <Setter Property="BorderBrush" Value="{DynamicResource ColorBrush4}" />
   <Setter Property="Cursor" Value="Hand" />
   <Setter Property="Template">
    <Setter.Value><ControlTemplate TargetType="Button">
     <Border x:Name="Frame" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="5" Padding="{TemplateBinding Padding}">
      <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
     </Border>
     <ControlTemplate.Triggers>
      <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource ColorBrush8}" /></Trigger>
      <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Frame" Property="BorderThickness" Value="2" /></Trigger>
      <Trigger Property="IsPressed" Value="True"><Setter TargetName="Frame" Property="Background" Value="{DynamicResource ColorBrush7}" /></Trigger>
      <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Frame" Property="Opacity" Value="0.5" /></Trigger>
     </ControlTemplate.Triggers>
    </ControlTemplate></Setter.Value>
   </Setter>
  </Style>
</UserControl.Resources>
 <StackPanel>
  <UniformGrid Columns="3" Margin="0,0,0,6">
   <Button x:Name="MicrosoftButton" Content="微软(正版) (0)" Tag="microsoft" Click="Provider_Click" Style="{StaticResource ClubActionButton}" Height="34" Margin="0,0,3,0" FontSize="10" />
   <Button x:Name="LittleButton" Content="LittleSkin (0)" Tag="littleskin" Click="Provider_Click" Style="{StaticResource ClubActionButton}" Height="34" Margin="0,0,3,0" FontSize="10" />
   <Button x:Name="MuaButton" Content="MUA (0)" Tag="mua" Click="Provider_Click" Style="{StaticResource ClubActionButton}" Height="34" FontSize="10" />
  </UniformGrid>
  <DockPanel Margin="0,2,0,4">
   <Button Content="其他" Tag="other" Click="Provider_Click" DockPanel.Dock="Right" Style="{StaticResource ClubActionButton}" Padding="6,2" FontSize="11" />
   <Button Content="＋ 添加" Click="Add_Click" DockPanel.Dock="Right" Style="{StaticResource ClubActionButton}" Padding="6,2" Margin="0,0,4,0" FontSize="11" />
   <TextBlock x:Name="AccountSummary" FontWeight="SemiBold" VerticalAlignment="Center" />
  </DockPanel>
  <TextBlock x:Name="EmptyHint" Text="尚无此来源账户，请在下方登录。" FontSize="11" TextWrapping="Wrap" />
  <ScrollViewer MaxHeight="100" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
   <ItemsControl x:Name="Accounts"><ItemsControl.ItemTemplate><DataTemplate>
    <Grid><Grid.ColumnDefinitions><ColumnDefinition /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
     <local:MyListItem Title="{Binding Title}" Info="{Binding Info}" Tag="{Binding Profile}" Type="Clickable" Click="Account_Click" MinHeight="45" />
     <Button Grid.Column="1" Content="×" ToolTip="移除此账户" Tag="{Binding Profile}" Click="RemoveAccount_Click" Style="{StaticResource ClubActionButton}" Padding="5,0" Height="24" />
    </Grid>
   </DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
  </ScrollViewer>
  <TextBlock x:Name="LoginStatus" FontSize="10" TextWrapping="Wrap" Margin="0,4" Opacity="0.7" />
  <DockPanel>
   <local:MyButton Text="微软登录配置" Click="MicrosoftConfig_Click" Height="25" Padding="6,0" DockPanel.Dock="Right" />
   <TextBlock x:Name="MicrosoftStatus" FontSize="10" VerticalAlignment="Center" TextWrapping="Wrap" Opacity="0.7" />
  </DockPanel>
 </StackPanel>
</UserControl>
