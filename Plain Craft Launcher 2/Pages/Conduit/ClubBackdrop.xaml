<UserControl x:Class="PCL.ClubBackdrop"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 IsHitTestVisible="False" Focusable="False" ClipToBounds="True">
 <Grid>
  <Grid Margin="-18" Opacity="0.65">
   <Grid.Effect><BlurEffect Radius="12" RenderingBias="Performance" /></Grid.Effect>
   <Image x:Name="PreviousImage" Stretch="UniformToFill" />
   <Image x:Name="CurrentImage" Stretch="UniformToFill" />
  </Grid>
  <Border Background="{DynamicResource ColorBrushBackground}" Opacity="0.2" />
 </Grid>
</UserControl>
