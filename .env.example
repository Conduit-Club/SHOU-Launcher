# Copy to .env and set the public Application (client) ID from Microsoft Entra.
# This is not a client secret. Process environment takes precedence.
PCL_MS_CLIENT_ID=
# Optional: your project's approved CurseForge API key, also available as GitHub Secret CURSEFORGE_API_KEY.
# CURSEFORGE_API_KEY and CURSEFORGE_API are accepted aliases; the PCL_ name takes precedence.
# Values may be unquoted or enclosed in literal single/double quotes. No interpolation is performed.
PCL_CURSEFORGE_API_KEY=
